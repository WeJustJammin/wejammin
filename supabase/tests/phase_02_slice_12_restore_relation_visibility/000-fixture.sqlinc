-- Inherit the existing S10 guarded type/target and transaction-local unapproved
-- workflow evidence bootstrap. Relations themselves are authored only by public
-- cms_create_entry/create_revision. This is not activation/provider acceptance.
create temp table s12rv_calls(
  label text primary key, transport_role text, state text, message text,
  detail text, response jsonb
) on commit drop;

create or replace function pg_temp.s12rv_call(p_label text, p_sql text)
returns jsonb language plpgsql as $body$
declare
  prior_role text := current_user;
  observed_role text;
  result jsonb;
  error_state text := '00000';
  error_message text;
  error_detail text;
begin
  begin
    set local role service_role;
    observed_role := current_user;
    execute p_sql into result;
    execute format('set local role %I', prior_role);
  exception when others then
    get stacked diagnostics error_state = returned_sqlstate,
      error_message = message_text, error_detail = pg_exception_detail;
    execute format('set local role %I', prior_role);
  end;
  insert into s12rv_calls values
    (p_label, observed_role, error_state, error_message, error_detail, result);
  return result;
end;
$body$;

-- Complete row images, independently hashed per durable CMS store, plus actual
-- idempotency/audit/outbox rows. Exclude ONLY the separately mutated target entry
-- and its assignments; their exact states are asserted independently. No count-only
-- fingerprint, timestamp stripping, source-row exclusion or producer response oracle.
create or replace function pg_temp.s12rv_image(p_target uuid)
returns jsonb language plpgsql as $body$
declare
  relation record;
  rows_image jsonb;
  image jsonb := '{}'::jsonb;
  predicate text;
begin
  for relation in
    select n.nspname, c.relname from pg_catalog.pg_class c
    join pg_catalog.pg_namespace n on n.oid = c.relnamespace
    where c.relkind in ('r', 'p') and (
      (n.nspname = 'platform_private' and (
        c.relname like 'cms\_%' escape '\'
        or c.relname in ('idempotency_records', 'outbox_events')))
      or (n.nspname = 'audit_private' and c.relname = 'audit_events'))
    order by n.nspname, c.relname
  loop
    predicate := case relation.relname
      when 'cms_content_entries' then '($1 is null or r.id <> $1)'
      when 'cms_entry_assignments' then '($1 is null or r.entry_id <> $1)'
      else 'true' end;
    execute format(
      'select coalesce(jsonb_agg(to_jsonb(r) order by to_jsonb(r)::text), ''[]''::jsonb) from %I.%I r where %s',
      relation.nspname, relation.relname, predicate)
      into rows_image using p_target;
    image := image || jsonb_build_object(relation.nspname || '.' || relation.relname,
      platform_private.cms_jcs_sha256(rows_image));
  end loop;
  return image;
end;
$body$;

create or replace function pg_temp.s12rv_source_image(p_revision uuid)
returns text language sql stable as $body$
  select platform_private.cms_jcs_sha256(jsonb_build_object(
    'revision', (select to_jsonb(r) from platform_private.cms_entry_revisions r where r.id = p_revision),
    'values', (select coalesce(jsonb_agg(to_jsonb(v) order by v.id), '[]'::jsonb)
      from platform_private.cms_entry_field_values v where v.revision_id = p_revision),
    'relations', (select coalesce(jsonb_agg(to_jsonb(r) order by r.id), '[]'::jsonb)
      from platform_private.cms_entry_relations r where r.revision_id = p_revision),
    'composition', (select coalesce(jsonb_agg(to_jsonb(c) order by c.id), '[]'::jsonb)
      from platform_private.cms_composition_instances c where c.revision_id = p_revision)))
$body$;

create or replace function pg_temp.s12rv_prepare(p_label text)
returns jsonb language plpgsql as $body$
declare
  target_id uuid := gen_random_uuid();
  prior_flag text := current_setting('app.cms_rpc', true);
  created jsonb;
  appended jsonb;
  entry_id text;
  source_id text;
  request jsonb;
begin
  perform pg_temp.s10r_seed_article(target_id, gen_random_uuid(), 'active', true);
  perform set_config('app.cms_rpc', coalesce(prior_flag, ''), true);
  perform pg_temp.s10_rpc_as(
    (select value::uuid from s10_ids where key = 'creatorAuth'),
    (select value::uuid from s10_ids where key = 'organization'));
  created := pg_temp.s12rv_call(p_label || '-create', pg_temp.s10r_create_sql(
    jsonb_build_object('title', 'RRV source ' || p_label,
      'related', pg_temp.s10r_rel(target_id::text)), 's12rv-' || p_label || '-create'));
  if created is null then return null; end if;
  entry_id := created->'entry'->>'id';
  source_id := created->'revision'->>'id';
  appended := pg_temp.s12rv_call(p_label || '-append', pg_temp.s10r_revision_sql(
    entry_id, jsonb_build_object('title', 'RRV current ' || p_label),
    '1', '1', 's12rv-' || p_label || '-append'));
  if appended is null then return null; end if;
  request := jsonb_build_object('entryId', entry_id, 'revisionId', source_id,
    'migrationChainId', platform_private.cms_restore_chain_manifest_id(
      platform_private.cms_restore_chain_derive(
        (select value::uuid from s10r_ids where key = 'typeId'),
        (select value::uuid from s10r_ids where key = 'versionId'),
        (select value::uuid from s10r_ids where key = 'versionId'))->>'hash'),
    'expectedVersion', '2', 'idempotencyKey', 's12rv-' || p_label || '-restore',
    'context', jsonb_build_object(
      'actingPartyId', (select value from s10_ids where key = 'organization'),
      'actingContextId', 'a9100000-0000-4000-8000-000000000094',
      'correlationId', 'a9100000-0000-4000-8000-000000000095'));
  return jsonb_build_object('targetId', target_id, 'entryId', entry_id,
    'sourceId', source_id, 'request', request);
exception when others then
  perform set_config('app.cms_rpc', coalesce(prior_flag, ''), true);
  raise;
end;
$body$;
