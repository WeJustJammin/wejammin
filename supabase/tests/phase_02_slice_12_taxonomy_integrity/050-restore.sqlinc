-- CMS-03B-04 restore translation of term assignments (BE03c Receiving obligations from Slice 10 (DEC-141) item 3;
-- BE03b Recorded taxonomy and composition references in comparison and restore; P2-S12-AC-244): each `active` TermAssignment of the
-- source revision is carried to the new revision: an `active` or `deprecated` term unchanged, a `merged` term re-pointed to its
-- surviving successor, an unknown or other-vocabulary term fails the restore 409 migration_chain_incomplete; the new revision's
-- taxonomy_version_ids are the vocabularies' current `active` version ids.  Driven through the real create, append and restore
-- commands over the gallery type.

create or replace function pg_temp.ti_restore_sql(p_entry text, p_revision text, p_key text) returns text language sql as $body$
  select 'select platform_api.cms_restore_revision(' || quote_literal(jsonb_build_object(
    'entryId', p_entry, 'revisionId', p_revision,
    'migrationChainId', platform_private.cms_restore_chain_manifest_id(
      platform_private.cms_restore_chain_derive(
        (select value::uuid from s10g_ids where key = 'typeId'),
        (select value::uuid from s10g_ids where key = 'versionId'),
        (select value::uuid from s10g_ids where key = 'versionId'))->>'hash'),
    'expectedVersion', (select version::text from platform_private.cms_content_entries where id = p_entry::uuid),
    'idempotencyKey', p_key,
    'context', jsonb_build_object(
      'actingPartyId', (select value from s10_ids where key = 'organization'),
      'actingContextId', 'a9100000-0000-4000-8000-000000000094',
      'correlationId', 'a9100000-0000-4000-8000-000000000095'))::text) || '::jsonb)' $body$;
create or replace function pg_temp.ti_restore(p_label text, p_entry text, p_revision uuid) returns void language sql as $body$
  select pg_temp.ti_call(p_label, pg_temp.ti_restore_sql(p_entry, p_revision::text, 's12ti-restore-' || p_label)) $body$;
create or replace function pg_temp.ti_restored(p_label text) returns uuid language sql stable as $body$
  select (response->'resource'->>'id')::uuid from ti_calls where label = p_label $body$;

select pg_temp.ti_term('ra', pg_temp.ti_org(), 'vg1', 'vg1', 'ra');
select pg_temp.ti_term('rd', pg_temp.ti_org(), 'vg1', 'vg1', 'rd');
select pg_temp.ti_term('rm', pg_temp.ti_org(), 'vg1', 'vg1', 'rm');
select pg_temp.ti_term('rm2', pg_temp.ti_org(), 'vg1', 'vg1', 'rm2');
select pg_temp.ti_term('rm3', pg_temp.ti_org(), 'vg1', 'vg1', 'rm3');
select pg_temp.ti_term('rs', pg_temp.ti_org(), 'vg1', 'vg1', 'rs');

select pg_temp.ti_create('rs_c', jsonb_build_object('title', 'Restore', 'tags', pg_temp.ti_terms(array['ra', 'rd', 'rm', 'rm2'])));
select pg_temp.ti_append('rs_a', pg_temp.ti_entry('rs_c'), jsonb_build_object('title', 'Restore b'), '1', '1');
select is(pg_temp.ti_out('rs_c') || '/' || pg_temp.ti_out('rs_a') || '/' || pg_temp.ti_assignments(pg_temp.ti_rev('rs_c')),
  '00000:/00000:/ra:active:1:0|rd:active:1:1|rm:active:1:2|rm2:active:1:3',
  'fixture: a source revision holding four assignments and a newer draft');

select pg_temp.ti_term_to('rd', 'deprecated');
select pg_temp.ti_term_to('rm2', 'merged', 'rm3');
select pg_temp.ti_term_to('rm3', 'merged', 'rs');
select pg_temp.ti_term_to('rm', 'merged', 'rs');

-- Unconverged source: the merged terms are re-pointed to the terminal survivor (rm -> rs; rm2 -> rm3 -> rs, collapsed).
select pg_temp.ti_restore('rs_r1', pg_temp.ti_entry('rs_c'), pg_temp.ti_rev('rs_c'));
select is(pg_temp.ti_out('rs_r1'), '00000:', 'restore of a revision with active, deprecated and merged terms succeeds [P2-S12-AC-244]');
select is(pg_temp.ti_assignments(pg_temp.ti_restored('rs_r1')), 'ra:active:1:0|rd:active:1:1|rs:active:1:2',
  'an active and a deprecated term carry unchanged, a merged term is re-pointed to its survivor (the chain followed), and two sources of one survivor collapse to one assignment at the smaller position [P2-S12-AC-244]');
select is((select value from platform_private.cms_entry_field_values
            where revision_id = pg_temp.ti_restored('rs_r1') and field_id = pg_temp.s10g_fid('tags')::uuid),
  pg_temp.ti_terms(array['ra', 'rd', 'rs']),
  'the restored tags value names the carried terms in position order [P2-S12-AC-244]');
select is(pg_temp.ti_revision_ids(pg_temp.ti_restored('rs_r1')), jsonb_build_array(pg_temp.ti_uuid('vg1')),
  'the new revision records the vocabulary''s current active version id [P2-S12-AC-244]');
select is(response->'resource'->'taxonomyVersionIds', jsonb_build_array(pg_temp.ti_uuid('vg1')),
  'and the restore response reports it [P2-S12-AC-244]') from ti_calls where label = 'rs_r1';
select is(pg_temp.ti_assignments(pg_temp.ti_rev('rs_c')), 'ra:active:1:0|rd:active:1:1|rm:active:1:2|rm2:active:1:3',
  'the source revision is unchanged (immutable history) [P2-S12-AC-244]');

-- Converged source: the superseded retired-term row is not an active assignment; the survivor row is.
select pg_temp.ti_converge('rm');
select is(pg_temp.ti_assignments(pg_temp.ti_rev('rs_c')) like '%rs:active:1:2%rm:active:1:2%' or pg_temp.ti_assignments(pg_temp.ti_rev('rs_c')) like '%rm:active:1:2%rm:superseded:2:2%',
  true, 'fixture: convergence appended a superseded version for rm and an active one for rs on the source revision');
select pg_temp.ti_restore('rs_r2', pg_temp.ti_entry('rs_c'), pg_temp.ti_rev('rs_c'));
select is(pg_temp.ti_out('rs_r2') || '/' || pg_temp.ti_assignments(pg_temp.ti_restored('rs_r2')),
  '00000:/ra:active:1:0|rd:active:1:1|rs:active:1:2',
  'a converged source restores to the same assignments: only active assignments are carried [P2-S12-AC-244]');

-- A recorded version of a vocabulary with no carried assignment is not carried (DEC-240, BE03c item 3); the empty case records none.
select pg_temp.ti_create('rs_e', jsonb_build_object('title', 'Empty restore'));
select pg_temp.ti_append('rs_ea', pg_temp.ti_entry('rs_e'), jsonb_build_object('title', 'Empty b'), '1', '1');
select pg_temp.ti_restore('rs_re', pg_temp.ti_entry('rs_e'), pg_temp.ti_rev('rs_e'));
select is(pg_temp.ti_out('rs_re') || '/' || pg_temp.ti_assignments(pg_temp.ti_restored('rs_re')) || '/' || pg_temp.ti_revision_ids(pg_temp.ti_restored('rs_re'))::text,
  '00000://[]', 'a source with no assignment and no recorded version restores none [P2-S12-AC-244]');
select pg_temp.ti_create('rs_p', jsonb_build_object('title', 'Pinned restore'));
select pg_temp.ti_append('rs_pa', pg_temp.ti_entry('rs_p'), jsonb_build_object('title', 'Pinned b'), '1', '1');
select pg_temp.h11_raw_exec('platform_private.cms_entry_revisions',
  format('update platform_private.cms_entry_revisions set taxonomy_version_ids = %L::jsonb where id = %L::uuid',
    jsonb_build_array(pg_temp.ti_uuid('rs7')), pg_temp.ti_rev('rs_p')));
select pg_temp.ti_restore('rs_rp', pg_temp.ti_entry('rs_p'), pg_temp.ti_rev('rs_p'));
select is(pg_temp.ti_out('rs_rp') || '/' || pg_temp.ti_revision_ids(pg_temp.ti_restored('rs_rp'))::text,
  '00000:/[]',
  'a recorded retired version with no carried assignment is not carried: it still resolves in the owner scope, so the restore succeeds and records none (DEC-240) [P2-S12-AC-244]');
select pg_temp.h11_raw_exec('platform_private.cms_entry_revisions',
  format('update platform_private.cms_entry_revisions set taxonomy_version_ids = %L::jsonb where id = %L::uuid',
    jsonb_build_array(pg_temp.ti_uuid('nobody')), pg_temp.ti_rev('rs_pa')));
select pg_temp.ti_restore('rs_rn', pg_temp.ti_entry('rs_p'), pg_temp.ti_rev('rs_pa'));
select is(pg_temp.ti_out('rs_rn'), 'P0001:migration_chain_incomplete',
  'a recorded taxonomy version that no longer resolves in the owner scope still fails the restore migration_chain_incomplete [P2-S12-AC-244]');

-- Refusals: nothing is written.  Assignments forged on source revisions (labelled fixture: the producers never write these).
create or replace function pg_temp.ti_forge_assignment(p_revision uuid, p_term text, p_position integer) returns void language plpgsql as $body$
begin
  -- The stored composite foreign key pins an assignment to its term's owner and write-version.
  perform pg_temp.h11_raw_exec('platform_private.cms_term_assignments', format(
    'insert into platform_private.cms_term_assignments(owner_id, state, version, revision_id, field_definition_id, term_id, taxonomy_version_id, position, provenance, created_by)
     select term.owner_id, ''active'', 1, %L::uuid, %L::uuid, term.id, term.taxonomy_version_id, %s, ''authored'', %L::uuid
       from platform_private.cms_terms term where term.id = %L::uuid',
    p_revision,
    (select field.id from platform_private.cms_field_definition_versions field
      where field.stable_field_id = pg_temp.s10g_fid('tags')::uuid
        and field.content_type_version_id = (select value::uuid from s10g_ids where key = 'versionId')),
    p_position, pg_temp.ti_creator(), pg_temp.ti_uuid(p_term)));
end;
$body$;
create temp table ti_rc(label text primary key, before_counts text not null, after_counts text) on commit drop;
create or replace function pg_temp.ti_restore_marked(p_label text, p_entry text, p_revision uuid) returns void language plpgsql as $body$
begin
  insert into ti_rc(label, before_counts) values (p_label, pg_temp.ti_counts());
  perform pg_temp.ti_restore(p_label, p_entry, p_revision);
  update ti_rc set after_counts = pg_temp.ti_counts() where label = p_label;
end;
$body$;
-- (An assignment to a term of another owner or to an unknown term cannot exist: the stored foreign keys pin an assignment to a term, its
-- write-version and the revision's owner, so those two source shapes are unreachable; the plan still refuses them.)
select pg_temp.ti_create('rf_c2', jsonb_build_object('title', 'Refuse two'));
select pg_temp.ti_append('rf_a2', pg_temp.ti_entry('rf_c2'), jsonb_build_object('title', 'Refuse two b'), '1', '1');
select pg_temp.ti_forge_assignment(pg_temp.ti_rev('rf_c2'), 'wrongfield', 0);
select pg_temp.ti_restore_marked('rf_othervocab', pg_temp.ti_entry('rf_c2'), pg_temp.ti_rev('rf_c2'));
select is(pg_temp.ti_out('rf_othervocab'), 'P0001:migration_chain_incomplete',
  'an assignment to a term of a vocabulary whose active version does not list this content type and field (other-vocabulary) fails the restore migration_chain_incomplete [P2-S12-AC-244]');

select pg_temp.ti_create('rf_c3', jsonb_build_object('title', 'Refuse three'));
select pg_temp.ti_append('rf_a3', pg_temp.ti_entry('rf_c3'), jsonb_build_object('title', 'Refuse three b'), '1', '1');
select pg_temp.ti_forge_assignment(pg_temp.ti_rev('rf_c3'), 'ghost', 0);
select pg_temp.ti_restore_marked('rf_noversion', pg_temp.ti_entry('rf_c3'), pg_temp.ti_rev('rf_c3'));
select is(pg_temp.ti_out('rf_noversion'), 'P0001:migration_chain_incomplete',
  'an assignment to a term of a vocabulary with no active version to bind to fails the restore migration_chain_incomplete (BOUNDARY) [P2-S12-AC-244]');
select is((select count(*)::integer from ti_rc where before_counts = after_counts), 2,
  'the two refused restores committed no entry, revision, value, assignment, reservation, outbox or audit row [P2-S12-AC-244]');
