-- Shared world helpers for the taxonomy-terms suites (CMS-03C-03 term actions, cmsTaxonomyTermsRead, CMS-03C-17 selector).
-- Include AFTER the S09 DEC-108 fragments, governed_submit/000 + 005, governed_assignment/000-world and governed_activation/000-world
-- (the s12ga_* and s12gb_* helpers).  Everything here is pg_temp and dies with the rolled-back transaction; every governed row, every
-- vocabulary and every term is written by a named platform_api producer under the real service_role.  The only labelled fixture
-- forgeries are the S09 membership tenures, the second organization's curator grant (a negative-control actor), the role facet
-- assertions that feed the role provider (Shard 01 owns the facet command), entry and revision rows and term assignment rows
-- (the Shard 03b assignment writer does not exist yet).

-- The lineage id of a vocabulary tag and its first/latest version row.
create or replace function pg_temp.s12tt_lineage(p_tag text) returns uuid language sql stable as $body$
  select value::uuid from s12gov_ids where key = 'tt:' || p_tag $body$;
create or replace function pg_temp.s12tt_active(p_tax uuid) returns text language sql stable as $body$
  select version::text from platform_private.cms_taxonomy_versions where taxonomy_id = p_tax and state = 'active' $body$;
create or replace function pg_temp.s12tt_active_id(p_tax uuid) returns uuid language sql stable as $body$
  select id from platform_private.cms_taxonomy_versions where taxonomy_id = p_tax and state = 'active' $body$;

-- One CMS-03C-03 private request.  expectedVersion = ifMatch = the vocabulary's active definition version unless patched.
create or replace function pg_temp.s12tt_req(
  p_label text, p_tax uuid, p_action text, p_key text, p_patch jsonb default '{}'::jsonb
) returns jsonb language sql stable as $body$
  select jsonb_build_object(
    'taxonomyId', p_tax, 'action', p_action, 'termKey', p_key, 'parentId', null::text, 'survivorId', null::text,
    'labels', jsonb_build_array(jsonb_build_object('locale', 'en-US', 'label', 'Label ' || p_key)),
    'aliases', '[]'::jsonb,
    'expectedVersion', coalesce(pg_temp.s12tt_active(p_tax), '1'), 'ifMatch', coalesce(pg_temp.s12tt_active(p_tax), '1'),
    'idempotencyKey', 's12tt-' || p_label) || p_patch
$body$;

create or replace function pg_temp.s12tt_act(
  p_label text, p_actor text, p_tax uuid, p_action text, p_key text,
  p_patch jsonb default '{}'::jsonb, p_unset text[] default array[]::text[]
) returns void language plpgsql as $body$
begin
  perform pg_temp.s12ga_rpc(p_label, 'platform_api.cms_act_taxonomy_term', p_actor,
    pg_temp.s12tt_req(p_label, p_tax, p_action, p_key, p_patch) - p_unset);
end;
$body$;

-- 'ok' or '<sqlstate>:<message>' followed by '#<detail>' (JSON detail normalized as jsonb text).
create or replace function pg_temp.s12tt_oc(p_label text) returns text language sql stable as $body$
  select pg_temp.s12ga_out(p_label) || coalesce('#' || nullif(
    case when pg_temp.s12ga_det(p_label) ~ '^[\[{]' then pg_temp.s12ga_det(p_label)::jsonb::text
         else pg_temp.s12ga_det(p_label) end, ''), '')
$body$;

create or replace function pg_temp.s12tt_term(p_tax uuid, p_key text) returns jsonb language sql stable as $body$
  select to_jsonb(term_row) from platform_private.cms_terms term_row where term_row.taxonomy_id = p_tax and term_row.term_key = p_key $body$;
create or replace function pg_temp.s12tt_term_id(p_tax uuid, p_key text) returns uuid language sql stable as $body$
  select (pg_temp.s12tt_term(p_tax, p_key)->>'id')::uuid $body$;
-- The current label of every locale of a term (the highest version of each locale, state active) as a locale-ordered array.
create or replace function pg_temp.s12tt_labels(p_term uuid) returns jsonb language sql stable as $body$
  select coalesce(jsonb_agg(jsonb_build_object('locale', current_label.locale, 'label', current_label.label)
                            order by current_label.locale collate "C"), '[]'::jsonb)
    from (select distinct on (label_row.locale) label_row.locale, label_row.label, label_row.state
            from platform_private.cms_term_labels label_row where label_row.term_id = p_term
           order by label_row.locale, label_row.version desc) current_label
   where current_label.state = 'active'
$body$;

-- A store digest a refusal must leave identical (full content hashes for the mutable stores, counts for the append-only ones).
create or replace function pg_temp.s12tt_snap() returns text language sql stable as $body$
  select jsonb_build_object(
    'versions', (select md5(coalesce(string_agg(to_jsonb(r)::text, '|' order by r.id), '')) from platform_private.cms_taxonomy_versions r),
    'terms', (select md5(coalesce(string_agg(to_jsonb(r)::text, '|' order by r.id), '')) from platform_private.cms_terms r),
    'labels', (select md5(coalesce(string_agg(to_jsonb(r)::text, '|' order by r.id), '')) from platform_private.cms_term_labels r),
    'assignments', (select md5(coalesce(string_agg(to_jsonb(r)::text, '|' order by r.id), '')) from platform_private.cms_term_assignments r),
    'idempotency', (select md5(coalesce(string_agg(to_jsonb(r)::text, '|' order by r.id), '')) from platform_private.idempotency_records r),
    'audit', (select count(*) from audit_private.audit_events),
    'outbox', (select count(*) from platform_private.outbox_events),
    'jobs', (select count(*) from platform_private.jobs))::text
$body$;
create temp table s12tt_snaps(label text primary key, snapshot text not null) on commit drop;
create or replace function pg_temp.s12tt_mark(p_label text) returns void language sql as $body$
  insert into s12tt_snaps(label, snapshot) values (p_label, pg_temp.s12tt_snap())
  on conflict (label) do update set snapshot = excluded.snapshot $body$;
create or replace function pg_temp.s12tt_same(p_label text) returns boolean language sql stable as $body$
  select pg_temp.s12tt_snap() = (select snapshot from s12tt_snaps where label = p_label) $body$;

-- A vocabulary through the real producers: CMS-03C-16 create (a first version, or the successor of p_parent_tag), CMS-03C-06 submit,
-- CMS-03C-08 assignment, CMS-03C-07 approval by rev1 and CMS-03C-09 activation.  Returns the lineage id and records it under
-- 'tt:<tag>' (version row under 'ttv:<tag>').  Any producer refusal aborts the suite with the refusal named.
create or replace function pg_temp.s12tt_vocab(
  p_tag text, p_shape text, p_domains jsonb default '[]'::jsonb, p_activate boolean default true,
  p_parent_tag text default null, p_fields jsonb default '["title"]'::jsonb, p_actor text default 'owner'
) returns uuid language plpgsql as $body$
declare
  v_expected text; v_subject uuid; v_lineage uuid; v_review uuid; v_type_key text;
begin
  select type_key into v_type_key from platform_private.cms_content_types where id = (select value::uuid from s12gov_ids where key = 'typeA');
  if p_parent_tag is not null then
    select version::text into v_expected from platform_private.cms_taxonomy_versions
     where taxonomy_id = pg_temp.s12tt_lineage(p_parent_tag) order by version desc limit 1;
  end if;
  perform pg_temp.s12ga_rpc('vc-' || p_tag, 'platform_api.cms_create_taxonomy_version', p_actor,
    jsonb_build_object('taxonomyKey', 's12tt-' || coalesce(p_parent_tag, p_tag), 'shape', p_shape,
      'allowedTypeKeys', jsonb_build_array(v_type_key), 'allowedFieldKeys', p_fields,
      'canonicalOverlapDomains', p_domains, 'expectedVersion', v_expected, 'idempotencyKey', 's12tt-vc-' || p_tag)
    || case when v_expected is null then '{}'::jsonb else jsonb_build_object('ifMatch', v_expected) end);
  if pg_temp.s12ga_out('vc-' || p_tag) <> 'ok' then
    raise exception 's12tt fixture: the real taxonomy-version producer refused %: %', p_tag, pg_temp.s12tt_oc('vc-' || p_tag);
  end if;
  v_subject := (pg_temp.s12ga_body('vc-' || p_tag)->>'id')::uuid;
  v_lineage := (pg_temp.s12ga_body('vc-' || p_tag)->>'taxonomyId')::uuid;
  insert into s12gov_ids(key, value) values ('tt:' || p_tag, v_lineage::text), ('ttv:' || p_tag, v_subject::text)
    on conflict (key) do update set value = excluded.value;
  insert into s12gov_ids(key, value) values (p_tag || ':subject', v_subject::text)
    on conflict (key) do update set value = excluded.value;
  if not p_activate then return v_lineage; end if;
  perform pg_temp.s12ga_rpc('vs-' || p_tag, 'platform_api.cms_submit_governed_review', p_actor, jsonb_build_object(
    'subjectKind', 'taxonomy_version', 'subjectId', v_subject,
    'subjectHash', (select content_hash::text from platform_private.cms_taxonomy_versions where id = v_subject),
    'idempotencyKey', 's12tt-vs-' || p_tag));
  if pg_temp.s12ga_out('vs-' || p_tag) <> 'ok' then
    raise exception 's12tt fixture: the real submit producer refused %: %', p_tag, pg_temp.s12tt_oc('vs-' || p_tag);
  end if;
  v_review := (pg_temp.s12ga_body('vs-' || p_tag)->>'id')::uuid;
  insert into s12gov_ids(key, value) values (p_tag || ':review', v_review::text)
    on conflict (key) do update set value = excluded.value;
  perform pg_temp.s12ga_assign('va-' || p_tag, p_actor, v_review, 'rev1', interval '20 hours');
  perform pg_temp.s12ga_decide('vd-' || p_tag, 'rev1', v_review, 'approve');
  perform pg_temp.s12gb_act('vact-' || p_tag, p_actor, v_review, 'activate');
  if pg_temp.s12ga_out('va-' || p_tag) <> 'ok' or pg_temp.s12ga_out('vd-' || p_tag) <> 'ok'
     or pg_temp.s12ga_out('vact-' || p_tag) <> 'ok'
     or (select state from platform_private.cms_taxonomy_versions where id = v_subject) <> 'active' then
    raise exception 's12tt fixture: % did not reach active (% / % / %)', p_tag, pg_temp.s12tt_oc('va-' || p_tag),
      pg_temp.s12tt_oc('vd-' || p_tag), pg_temp.s12tt_oc('vact-' || p_tag);
  end if;
  return v_lineage;
end;
$body$;

-- An entry with one draft revision of the ordinary active type (the rows the Shard 03b create command would write; a labelled
-- fixture, seeded the way phase_02_slice_10_rpc/001-fixtures seeds its draft).  Returns the revision id, recorded as 'rev:<tag>'.
create or replace function pg_temp.s12tt_seed_revision(p_tag text) returns uuid language plpgsql as $body$
declare
  v_entry uuid := extensions.gen_random_uuid(); v_revision uuid := extensions.gen_random_uuid();
  v_party uuid; v_auth uuid; v_person uuid; v_at timestamptz := timestamptz '2026-10-14T12:00:00Z';
begin
  select party_id, auth_user_id, person_id into v_party, v_auth, v_person from s09d_actor where key = 'owner';
  perform set_config('app.cms_rpc', 'true', true);
  insert into platform_private.cms_content_entries(id, owner_id, content_type_id, owner_party_id, lifecycle,
    current_draft_revision_id, version, created_by, created_at, updated_at)
  values (v_entry, v_party, (select value::uuid from s12gov_ids where key = 'typeA'), v_party, 'active', null, 1, v_auth, v_at, v_at);
  insert into platform_private.cms_entry_revisions(id, owner_id, entry_id, revision_number, schema_version_id, template_version_id,
    taxonomy_version_ids, parent_revision_ids, locale, payload_hash, author_person_id, acting_party_id, state, version,
    validation_state, validation_report, created_at, updated_at)
  values (v_revision, v_party, v_entry, 1, (select value::uuid from s12gov_ids where key = 'typeVersionA'), null,
    '[]'::jsonb, '[]'::jsonb, 'en-US', platform_private.cms_jcs_sha256(jsonb_build_object('tag', p_tag))::char(64),
    v_person, v_party, 'draft', 1, 'valid', '{}'::jsonb, v_at, v_at);
  update platform_private.cms_content_entries set current_draft_revision_id = v_revision where id = v_entry;
  insert into s12gov_ids(key, value) values ('rev:' || p_tag, v_revision::text)
    on conflict (key) do update set value = excluded.value;
  return v_revision;
end;
$body$;
create or replace function pg_temp.s12tt_rev(p_tag text) returns uuid language sql stable as $body$
  select value::uuid from s12gov_ids where key = 'rev:' || p_tag $body$;

-- One assignment version row (the rows the Shard 03b assignment writer would append; a labelled fixture).  The term's own write-version
-- is the taxonomy_version_id the stored composite foreign key demands.
create or replace function pg_temp.s12tt_assignment(
  p_revision uuid, p_term uuid, p_version integer, p_state text, p_position integer default 0, p_provenance text default 'authored'
) returns uuid language plpgsql as $body$
declare v_id uuid := extensions.gen_random_uuid();
begin
  perform set_config('app.cms_rpc', 'true', true);
  insert into platform_private.cms_term_assignments(id, owner_id, state, version, revision_id, field_definition_id, term_id,
    taxonomy_version_id, position, provenance, created_by)
  select v_id, owner.party_id, p_state, p_version, p_revision,
         (select field.id from platform_private.cms_field_definition_versions field
           where field.content_type_version_id = (select value::uuid from s12gov_ids where key = 'typeVersionA') and field.field_key = 'title'),
         p_term, term.taxonomy_version_id, p_position, p_provenance, owner.auth_user_id
    from s09d_actor owner, platform_private.cms_terms term where owner.key = 'owner' and term.id = p_term;
  return v_id;
end;
$body$;

-- The current (highest version) assignment rows of a revision, as '<term key>:<state>:<version>' ordered text.
create or replace function pg_temp.s12tt_assignments(p_revision uuid) returns text language sql stable as $body$
  select coalesce(string_agg(term.term_key || ':' || assignment.state || ':' || assignment.version || ':' || assignment.position,
                             '|' order by term.term_key collate "C", assignment.version), '')
    from platform_private.cms_term_assignments assignment join platform_private.cms_terms term on term.id = assignment.term_id
   where assignment.revision_id = p_revision $body$;

-- The convergence batch under the RPC context a command would hold (the forced-RLS tables answer no row without it).
create or replace function pg_temp.s12tt_converge(p_term uuid, p_batch integer) returns jsonb language plpgsql as $body$
begin
  perform set_config('app.cms_rpc', 'true', true);
  return platform_private.cms_converge_taxonomy_merge(p_term, p_batch);
end;
$body$;
-- 'ok:<result>' or '<sqlstate>:<message>' of a statement that may refuse, run under the RPC context in a subtransaction (a select
-- returns its first column; any other statement returns 'ok:').
create or replace function pg_temp.s12tt_try(p_sql text) returns text language plpgsql as $body$
declare v_res text; v_state text; v_msg text;
begin
  perform set_config('app.cms_rpc', 'true', true);
  begin
    if p_sql ~* '^\s*select' then
      execute p_sql into v_res;
    else
      execute p_sql;
    end if;
    return 'ok:' || coalesce(v_res, '');
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_msg = message_text;
    return v_state || ':' || v_msg;
  end;
end;
$body$;
-- The SQLSTATE alone ('00000' when the statement ran).
create or replace function pg_temp.s12tt_sqlstate(p_sql text) returns text language sql as $body$
  select split_part(pg_temp.s12tt_try(p_sql), ':', 1) $body$;

-- An anonymous caller: the Worker sends no verified human.  Same receipt table, no session actor.
create or replace function pg_temp.s12tt_anonymous(p_label text, p_function text, p_request jsonb) returns void language plpgsql security invoker as $body$
declare
  v_user text := current_user; v_role text := current_setting('role'); v_rpc_user text;
  v_response jsonb; v_state text := '00000'; v_message text; v_detail text;
begin
  perform pg_temp.s09d_session('owner');
  perform set_config('app.auth_user_id', '', true);
  perform set_config('app.actor_auth_user_id', '', true);
  perform set_config('app.actor_person_id', '', true);
  perform set_config('app.acting_party_id', '', true);
  execute 'set local role service_role';
  v_rpc_user := current_user;
  begin
    execute format('select %s($1)', p_function) into v_response using p_request || jsonb_build_object('context', jsonb_build_object(
      'requestId', extensions.gen_random_uuid(), 'correlationId', extensions.gen_random_uuid()));
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_message = message_text, v_detail = pg_exception_detail;
  end;
  perform set_config('role', v_role, true);
  insert into pg_temp.s12ga_rcpt(label, body, state, message, detail, rpc_user, before_user, after_user)
  values (p_label, v_response, v_state, v_message, v_detail, v_rpc_user, v_user, current_user);
end;
$body$;


-- The registered continuation transport (platform_api.cms_run_taxonomy_merge_converge) under the real service_role.  The RPC context is
-- CLEARED first, so the transport (not a helper) must set what the forced-RLS term tables need.  The outcome is 'ok:<answer>' or
-- '<sqlstate>:<message>[#detail]'.
create or replace function pg_temp.s12tt_run(p_label text, p_request jsonb) returns void language plpgsql as $body$
begin
  perform set_config('app.cms_rpc', '', true);
  perform pg_temp.s12gb_call(p_label, 'platform_api.cms_run_taxonomy_merge_converge', p_request);
end;
$body$;
create or replace function pg_temp.s12tt_rout(p_label text) returns text language sql stable as $body$
  select case when pg_temp.s12gb_sout(p_label) = 'ok' then 'ok:' || pg_temp.s12gb_sbody(p_label)::text
              else pg_temp.s12gb_sout(p_label) || coalesce('#' || nullif(pg_temp.s12gb_sdet(p_label), ''), '') end $body$;

-- The BE00 lease the handler fences on.  A job is claimed through platform_api.claim_job under the real service_role (the Worker's
-- claim; it only delegates to platform_private.claim_job); the claimed version and lease token are remembered by label.
create temp table s12tt_claims(label text primary key, job_id uuid not null, version bigint not null, token uuid not null) on commit drop;
create or replace function pg_temp.s12tt_claim(p_label text, p_job uuid, p_expected bigint, p_seconds integer default 840) returns void language plpgsql as $body$
declare v_role text := current_setting('role'); v_token uuid := extensions.gen_random_uuid(); v_version bigint;
begin
  execute 'set local role service_role';
  select claimed.version into v_version from platform_api.claim_job(p_job, p_expected, v_token, p_seconds) claimed;
  perform set_config('role', v_role, true);
  if v_version is null then
    raise exception 's12tt fixture: platform_api.claim_job refused % (job %, expected version %)', p_label, p_job, p_expected;
  end if;
  insert into s12tt_claims(label, job_id, version, token) values (p_label, p_job, v_version, v_token)
    on conflict (label) do update set job_id = excluded.job_id, version = excluded.version, token = excluded.token;
end;
$body$;
-- The strict transport request of a claimed job: { claimedJob: { jobId, version, leaseToken }, batch? }.
create or replace function pg_temp.s12tt_claimed(p_label text, p_batch integer default null) returns jsonb language sql stable as $body$
  select jsonb_build_object('claimedJob', jsonb_build_object('jobId', claim.job_id, 'version', claim.version::text, 'leaseToken', claim.token))
         || case when p_batch is null then '{}'::jsonb else jsonb_build_object('batch', p_batch) end
    from s12tt_claims claim where claim.label = p_label $body$;
-- One BE00 outcome through platform_api.apply_job_outcome under the real service_role (the Worker records the job done).
create or replace function pg_temp.s12tt_outcome(p_label text, p_state text, p_result jsonb, p_error text) returns boolean language plpgsql as $body$
declare v_role text := current_setting('role'); v_ok boolean; v_job uuid; v_version bigint; v_token uuid;
begin
  select claim.job_id, claim.version, claim.token into v_job, v_version, v_token from s12tt_claims claim where claim.label = p_label;
  execute 'set local role service_role';
  select platform_api.apply_job_outcome(v_job, v_version, v_token, p_state::platform_private.job_state, p_result, p_error, false) into v_ok;
  perform set_config('role', v_role, true);
  return v_ok;
end;
$body$;
-- Drains a continuation chain the way the Worker does: claim the job, run the registered transport, record the job succeeded with the
-- answer, follow continuationJobId.  Returns { hops, converged, remaining, maxAttempts, jobIds } (maxAttempts = the most attempt summaries any
-- hop's job row holds; BE00 caps a job at 32).
create or replace function pg_temp.s12tt_drain(p_job uuid, p_batch integer) returns jsonb language plpgsql as $body$
declare
  v_job uuid := p_job; v_label text; v_answer jsonb; v_hops integer := 0; v_converged bigint := 0;
  v_max integer := 0; v_ids jsonb := '[]'::jsonb; v_attempts integer;
begin
  loop
    v_hops := v_hops + 1;
    v_label := 'drain-' || v_hops;
    perform pg_temp.s12tt_claim(v_label, v_job, 1);
    perform pg_temp.s12tt_run(v_label, pg_temp.s12tt_claimed(v_label, p_batch));
    if pg_temp.s12gb_sout(v_label) <> 'ok' then
      raise exception 's12tt drain: hop % refused: %', v_hops, pg_temp.s12tt_rout(v_label);
    end if;
    v_answer := pg_temp.s12gb_sbody(v_label);
    if not pg_temp.s12tt_outcome(v_label, 'succeeded', v_answer, null) then
      raise exception 's12tt drain: hop % outcome was not applied', v_hops;
    end if;
    select pg_catalog.jsonb_array_length(job.attempts) into v_attempts from platform_private.jobs job where job.id = v_job;
    v_max := greatest(v_max, v_attempts);
    v_ids := v_ids || to_jsonb(v_job);
    v_converged := v_converged + (v_answer->>'converged')::bigint;
    exit when v_answer->>'continuationJobId' is null;
    v_job := (v_answer->>'continuationJobId')::uuid;
  end loop;
  return jsonb_build_object('hops', v_hops, 'converged', v_converged, 'remaining', (v_answer->>'remaining')::bigint,
                            'maxAttempts', v_max, 'jobIds', v_ids);
end;
$body$;

-- The number of unconverged assignments of merged terms of an owner, read under the RPC context a command would hold (forced RLS).
create or replace function pg_temp.s12tt_work(p_owner uuid) returns integer language plpgsql as $body$
begin
  perform set_config('app.cms_rpc', 'true', true);
  return (select pg_catalog.count(*)::integer from platform_private.cms_taxonomy_merge_work(p_owner, null));
end;
$body$;

-- p_count entries with one draft revision each, and one ACTIVE assignment of p_term at version 1 per revision (the rows the Shard 03b
-- create command and assignment writer would write; the same labelled fixture forgery as s12tt_seed_revision and s12tt_assignment, set-based
-- so that 5,001 of them are practical).  Returns the number of assignments written.
create or replace function pg_temp.s12tt_seed_bulk(p_tag text, p_count integer, p_term uuid) returns integer language plpgsql as $body$
declare
  v_party uuid; v_auth uuid; v_person uuid; v_at timestamptz := timestamptz '2026-10-14T12:00:00Z';
  v_type uuid := (select value::uuid from s12gov_ids where key = 'typeA');
  v_version uuid := (select value::uuid from s12gov_ids where key = 'typeVersionA');
  v_field uuid; v_taxonomy_version uuid; v_written integer;
begin
  select party_id, auth_user_id, person_id into v_party, v_auth, v_person from s09d_actor where key = 'owner';
  select field.id into v_field from platform_private.cms_field_definition_versions field
   where field.content_type_version_id = v_version and field.field_key = 'title';
  select term.taxonomy_version_id into v_taxonomy_version from platform_private.cms_terms term where term.id = p_term;
  perform set_config('app.cms_rpc', 'true', true);
  create temp table if not exists s12tt_bulk(tag text not null, i integer not null, entry_id uuid not null, revision_id uuid not null, primary key (tag, i)) on commit drop;
  insert into s12tt_bulk(tag, i, entry_id, revision_id)
  select p_tag, series.i, extensions.gen_random_uuid(), extensions.gen_random_uuid() from generate_series(1, p_count) series(i);
  insert into platform_private.cms_content_entries(id, owner_id, content_type_id, owner_party_id, lifecycle, current_draft_revision_id, version,
                                                   created_by, created_at, updated_at)
  select bulk.entry_id, v_party, v_type, v_party, 'active', null, 1, v_auth, v_at, v_at from s12tt_bulk bulk where bulk.tag = p_tag;
  insert into platform_private.cms_entry_revisions(id, owner_id, entry_id, revision_number, schema_version_id, template_version_id,
    taxonomy_version_ids, parent_revision_ids, locale, payload_hash, author_person_id, acting_party_id, state, version,
    validation_state, validation_report, created_at, updated_at)
  select bulk.revision_id, v_party, bulk.entry_id, 1, v_version, null, '[]'::jsonb, '[]'::jsonb, 'en-US',
         platform_private.cms_jcs_sha256(jsonb_build_object('tag', p_tag, 'i', bulk.i))::char(64), v_person, v_party, 'draft', 1, 'valid', '{}'::jsonb, v_at, v_at
    from s12tt_bulk bulk where bulk.tag = p_tag;
  update platform_private.cms_content_entries entry set current_draft_revision_id = bulk.revision_id
    from s12tt_bulk bulk where bulk.tag = p_tag and entry.id = bulk.entry_id;
  insert into platform_private.cms_term_assignments(owner_id, state, version, revision_id, field_definition_id, term_id, taxonomy_version_id,
                                                   position, provenance, created_by)
  select v_party, 'active', 1, bulk.revision_id, v_field, p_term, v_taxonomy_version, 0, 'authored', v_auth from s12tt_bulk bulk where bulk.tag = p_tag;
  get diagnostics v_written = row_count;
  return v_written;
end;
$body$;
