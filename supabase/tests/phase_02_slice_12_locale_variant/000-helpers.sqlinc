-- Slice 12 locale lane helpers (BE03c CMS-03C-04, CMS-03C-20).  Include AFTER
-- phase_02_slice_10_rpc/000-helpers.sqlinc and 001-fixtures.sqlinc.  Everything
-- resolves through pg_catalog or a probe so an absent object yields a failing
-- assertion instead of aborting the run (a RED run must report every gap).

-- SQLSTATE and message of a statement ('OK' when it succeeds).
create or replace function pg_temp.l12_try(p_sql text)
returns text
language plpgsql
as $body$
begin
  execute p_sql;
  return 'OK';
exception when others then
  return sqlstate || ':' || sqlerrm;
end;
$body$;

-- Scalar jsonb result of a statement, or {"__error": "<sqlstate>:<message>"}.
create or replace function pg_temp.l12_json(p_sql text)
returns jsonb
language plpgsql
as $body$
declare
  result jsonb;
begin
  execute p_sql into result;
  return result;
exception when others then
  return jsonb_build_object('__error', sqlstate || ':' || sqlerrm);
end;
$body$;

-- Scalar text result of a statement, or '__error <sqlstate>:<message>'.
create or replace function pg_temp.l12_text(p_sql text)
returns text
language plpgsql
as $body$
declare
  result text;
begin
  execute p_sql into result;
  return result;
exception when others then
  return '__error ' || sqlstate || ':' || sqlerrm;
end;
$body$;

-- DETAIL of the exception a statement raises (null when it succeeds).
create or replace function pg_temp.l12_detail(p_sql text)
returns text
language plpgsql
as $body$
declare
  detail_text text;
begin
  execute p_sql;
  return null;
exception when others then
  get stacked diagnostics detail_text = pg_exception_detail;
  return detail_text;
end;
$body$;

create or replace function pg_temp.l12_entry()
returns uuid language sql stable as $body$
  select value::uuid from s10_ids where key = 'entryId'
$body$;

-- The newest source-locale (en-US) revision of the fixture entry.
create or replace function pg_temp.l12_source()
returns uuid language sql stable as $body$
  select revision.id from platform_private.cms_entry_revisions revision
  where revision.entry_id = pg_temp.l12_entry() and revision.locale = 'en-US'
  order by revision.revision_number desc limit 1
$body$;

create or replace function pg_temp.l12_field(p_key text)
returns uuid language sql stable as $body$
  select value::uuid from s10_ids where key = p_key
$body$;

-- A CMS-03C-04 request built from live state: the newest source revision and
-- its hash, the current entry version as the strong If-Match, the active chain
-- of the locale.  p_overrides replaces members.
create or replace function pg_temp.l12_req(
  p_locale text, p_fields jsonb, p_key text, p_overrides jsonb default '{}'::jsonb
)
returns jsonb
language sql
as $body$
  select jsonb_build_object(
    'entryId', pg_temp.l12_entry(),
    'locale', p_locale,
    'sourceRevisionId', pg_temp.l12_source(),
    'sourceHash', (select btrim(payload_hash::text) from platform_private.cms_entry_revisions
                    where id = pg_temp.l12_source()),
    'fields', p_fields,
    'fallbackChain', jsonb_build_array('en-US'),
    'noFallbackFieldIds', '[]'::jsonb,
    'expectedVersion', (select version::text from platform_private.cms_content_entries
                         where id = pg_temp.l12_entry()),
    'ifMatch', (select version::text from platform_private.cms_content_entries
                 where id = pg_temp.l12_entry()),
    'idempotencyKey', p_key
  ) || p_overrides
$body$;

create or replace function pg_temp.l12_author(p_request jsonb)
returns jsonb
language sql
as $body$
  select pg_temp.l12_json(format('select platform_api.cms_author_locale_variant(%L::jsonb)', p_request::text))
$body$;

create or replace function pg_temp.l12_title_field(p_value text)
returns jsonb
language sql
as $body$
  select jsonb_build_array(jsonb_build_object(
    'fieldId', pg_temp.l12_field('typeFieldId'), 'value', to_jsonb(p_value)))
$body$;

-- Appends a newer source-locale (en-US) revision with the given field values the way every real
-- revision writer does (cms_create_revision, cms_resolve_conflict, cms_restore_revision): the revision
-- row first, then its values, and only then the draft head moves to it under the entry version CAS
-- (BE03c 1393, 20261014050310).  p_move_head false stops before the head move, to prove the fan-out
-- waits for it.
create or replace function pg_temp.l12_source_edit(p_values jsonb, p_move_head boolean default true)
returns uuid
language plpgsql
as $body$
declare
  source_row platform_private.cms_entry_revisions%rowtype;
  new_id uuid := extensions.gen_random_uuid();
  number_next bigint;
  snapshot_time timestamptz := pg_catalog.clock_timestamp();
  item record;
  definition_id uuid;
begin
  perform set_config('app.cms_rpc', 'true', true);
  select * into source_row from platform_private.cms_entry_revisions revision
  where revision.id = pg_temp.l12_source();
  select coalesce(max(revision_number), 0) + 1 into number_next
  from platform_private.cms_entry_revisions revision
  where revision.entry_id = source_row.entry_id and revision.locale = source_row.locale;
  insert into platform_private.cms_entry_revisions(
    id, owner_id, entry_id, revision_number, schema_version_id,
    template_version_id, taxonomy_version_ids, parent_revision_ids, locale,
    payload_hash, author_person_id, acting_party_id, state, version,
    validation_state, validation_report, created_at, updated_at
  ) values (
    new_id, source_row.owner_id, source_row.entry_id, number_next,
    source_row.schema_version_id, source_row.template_version_id,
    source_row.taxonomy_version_ids, jsonb_build_array(source_row.id),
    source_row.locale, platform_private.cms_jcs_sha256(p_values)::char(64),
    source_row.author_person_id, source_row.acting_party_id, 'draft', 1,
    'valid', '{}'::jsonb, snapshot_time, snapshot_time
  );
  for item in select key, value from jsonb_each(p_values) loop
    select definition.id into definition_id
    from platform_private.cms_field_definition_versions definition
    where definition.content_type_version_id = source_row.schema_version_id
      and definition.stable_field_id = item.key::uuid;
    insert into platform_private.cms_entry_field_values(
      owner_id, state, version, revision_id, field_id, field_definition_id,
      locale, value, provenance, value_hash, created_at, updated_at
    ) values (
      source_row.owner_id, 'active', 1, new_id, item.key::uuid, definition_id,
      source_row.locale, item.value, 'authored',
      platform_private.cms_jcs_sha256(item.value)::char(64),
      snapshot_time, snapshot_time
    );
  end loop;
  if p_move_head then
    perform pg_temp.l12_move_head(new_id);
  end if;
  return new_id;
end;
$body$;

-- The head move of a revision writer: the entry points at the revision and its version advances.
create or replace function pg_temp.l12_move_head(p_revision_id uuid)
returns void
language plpgsql
as $body$
begin
  perform set_config('app.cms_rpc', 'true', true);
  update platform_private.cms_content_entries
     set current_draft_revision_id = p_revision_id,
         version = version + 1,
         updated_at = pg_catalog.clock_timestamp()
   where id = pg_temp.l12_entry();
  if not found then raise exception 'l12_move_head: entry not found'; end if;
end;
$body$;

-- The stored stale_field_ids of the newest row of the locale, as a sorted jsonb array.
create or replace function pg_temp.l12_stored_stale(p_locale text)
returns jsonb
language sql
as $body$
  select coalesce((select jsonb_agg(item order by item)
                     from jsonb_array_elements_text(latest.stale_field_ids) item), '[]'::jsonb)
    from (select variant.stale_field_ids
            from platform_private.cms_locale_variants variant
           where variant.entry_id = pg_temp.l12_entry() and variant.locale = p_locale
           order by variant.version desc limit 1) latest
$body$;

-- Independent RFC 4122 UUIDv5 (textual construction, not the production code).
create or replace function pg_temp.l12_v5(p_namespace uuid, p_name text)
returns uuid
language sql
as $body$
  with digest as (
    select encode(extensions.digest(
      decode(replace(p_namespace::text, '-', ''), 'hex') || convert_to(p_name, 'utf8'), 'sha1'
    ), 'hex') as hex
  )
  select (substr(hex, 1, 8) || '-' || substr(hex, 9, 4) || '-5' || substr(hex, 14, 3) || '-'
    || to_hex(((('x' || substr(hex, 17, 1))::bit(4)::int) & 3) | 8) || substr(hex, 18, 3) || '-'
    || substr(hex, 21, 12))::uuid
  from digest
$body$;

create or replace function pg_temp.l12_aggregate(p_entry uuid, p_locale text)
returns uuid
language sql
as $body$
  select pg_temp.l12_v5(
    pg_temp.l12_v5('6ba7b810-9dad-11d1-80b4-00c04fd430c8'::uuid, 'cms.locale.aggregate.v1'),
    lower(p_entry::text) || ':' || lower(p_locale))
$body$;

-- The localization outbox rows of the fixture entry as (type, id, version) text.
create or replace function pg_temp.l12_events(p_locale text default null)
returns text
language sql
as $body$
  select coalesce(string_agg(aggregate_type || '/' || aggregate_id || '/' || aggregate_version,
                             ',' order by occurred_at, aggregate_version, id), '')
  from platform_private.outbox_events
  where event_type = 'cms.localization.changed.v1'
    and payload->>'entryId' = pg_temp.l12_entry()::text
    and (p_locale is null or payload->>'locale' = p_locale)
$body$;

-- Runs the author command and rolls every effect back: {"response": <201 resource>} on success,
-- {"error": "<sqlstate>:<message>", "detail": <DETAIL text or null>} on refusal.
create or replace function pg_temp.l12_author_rolled_back(p_request jsonb)
returns jsonb
language plpgsql
as $body$
declare
  result jsonb;
  detail_text text;
begin
  begin
    result := platform_api.cms_author_locale_variant(p_request);
    raise exception 'L12_PROBE_ROLLBACK' using errcode = 'P0001', detail = result::text;
  exception when others then
    get stacked diagnostics detail_text = pg_exception_detail;
    if sqlerrm = 'L12_PROBE_ROLLBACK' then
      return jsonb_build_object('response', detail_text::jsonb);
    end if;
    return jsonb_build_object('error', sqlstate || ':' || sqlerrm, 'detail', detail_text);
  end;
end;
$body$;
