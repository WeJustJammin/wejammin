-- Closed identity sets and independent authored-order expectations, not helpers
-- under test. Pending rendering is BE03c:1487, never a pending copy policy.
create or replace function pg_temp.s12cb_blocks(p_pairs jsonb) returns jsonb language sql stable as $body$
 select coalesce(jsonb_agg(jsonb_build_object('id',b.id,'hash',b.release_digest::text)
  order by b.id::text collate "C"),'[]'::jsonb)
 from jsonb_array_elements(p_pairs) wanted
 join platform_private.cms_block_definition_versions b on b.block_key=wanted->>0 and b.block_version=(wanted->>1)::integer
$body$;
create or replace function pg_temp.s12cb_pattern(p_labels text[]) returns jsonb language sql stable as $body$
 select coalesce(jsonb_agg(jsonb_build_object('id',v.id,'hash',v.content_hash::text)
  order by v.id::text collate "C"),'[]'::jsonb)
 from (select distinct (pg_temp.s12pd_body(label)->>'id')::uuid as id from unnest(p_labels) label) named
 join platform_private.cms_pattern_versions v on v.id=named.id
$body$;
select tap.* from (values ('cs-b-parity'),('cs-b-json'),('cs-b-solo'),('cs-b-long'),
 ('cs-b-order'),('cs-b-pending'),('cs-b-reuse'),('cs-b-special')) cases(tag)
 cross join lateral pg_temp.s12cb_reads(tag) tap;

select is(pg_temp.s12cs_answer('cb-manifest-cs-b-parity')->'blocks',
 pg_temp.s12cb_blocks('[["s12cs.root",2],["s12cs.leaf",2]]'),
 'CB-M01: repeated descendant tuple occurs exactly once in the complete block group');
select is(pg_temp.s12cs_answer('cb-manifest-cs-b-parity')->'patterns',pg_temp.s12cb_pattern(array['cs-b-repeat-pattern']),
 'CB-M02: nonnull-tree head retains exactly its provenance version row');
select is(pg_temp.s12cs_answer('cb-manifest-cs-b-order')->'blocks',
 pg_temp.s12cb_blocks('[["s12cs.root",2],["s12cs.leaf",2],["s12cs.tail",1]]'),
 'CB-M03: complete template union includes the unused allowed root, deduplicating placed leaf/tail tuples');
select is(pg_temp.s12cs_answer('cb-manifest-cs-b-order')->'patterns',pg_temp.s12cb_pattern(array['cs-b-forest1','cs-b-forest2']),
 'CB-M04: six rows under two slots freeze each exact provenance version once');
select is(pg_temp.s12cs_answer('cb-manifest-cs-b-solo')->'patterns','[]'::jsonb,'CB-M05: standalone has no invented provenance');
select is(pg_temp.s12cs_answer('cb-manifest-cs-b-solo')->'blocks',pg_temp.s12cb_blocks('[["s12cs.leaf",2]]'),
 'CB-M06: standalone retains its one registered block');
select is(pg_temp.s12cs_answer('cb-manifest-cs-b-pending')->'blocks',pg_temp.s12cb_blocks('[["s12cs.root",1]]'),
 'CB-P01: pending head renders unchanged B, never the newer active target block');
select is(pg_temp.s12cs_answer('cb-manifest-cs-b-pending')->'patterns',pg_temp.s12cb_pattern(array['cs-b-pending1']),
 'CB-P02: pending head retains the exact old version-row pin');
select is(jsonb_array_length(pg_temp.s12cs_answer('cb-plan-cs-b-pending')),1,'CB-P03: pending supersedes older history, one root renders');
select is(pg_temp.s12cs_answer('cb-plan-cs-b-pending')#>'{0,identity}',jsonb_build_object('kind','block',
 'pointer','/composition/'||pg_temp.s12pu_head('cs-b-pending','/panel'),'blockKey','s12cs.root','blockVersion',1),
 'CB-P04: pending row owns the unchanged pinned root identity');
select is(pg_temp.s12cs_answer('cb-quality-cs-b-pending')#>>'{nodes,0,accessibleName}','PINNED',
 'CB-P05: public quality loader reads pending B props, not TARGET or null');
select is((select count(*)::integer from platform_private.cms_composition_instances where revision_id=pg_temp.s12pl_rev('cs-b-reuse')
 and path='/gone' and state='retired'),1,'CB-H01 premise: a real historical retired row remains');
select is(pg_temp.s12pu_row(pg_temp.s12pu_head('cs-b-reuse','/gone'))->>'position','0','CB-H02 premise: re-placement kept authored position');
select is(jsonb_array_length(pg_temp.s12cs_answer('cb-plan-cs-b-reuse')),1,'CB-H03: active re-placement is neither suppressed nor duplicated by history');
select is(pg_temp.s12cs_answer('cb-quality-cs-b-reuse')#>>'{nodes,0,accessibleName}','RETURNED',
 'CB-H04: newest active re-placement wins over both old active and retired records');
select is(pg_temp.s12cs_answer('cb-manifest-cs-b-reuse')->'patterns',pg_temp.s12cb_pattern(array['cs-b-replacement']),
 'CB-H05: no retired/history pin is resurrected into provenance');

-- Literal path sequence discriminates slot ordinal, authored position and two
-- separate placements. Sorting these rows by path or UUID cannot satisfy it.
select is((select jsonb_agg(c.path::text order by ord) from jsonb_array_elements(
 pg_temp.s12cs_answer('cb-plan-cs-b-order')) with ordinality e(p,ord)
 join platform_private.cms_composition_instances c on c.id=(p->>'instance_id')::uuid),
 '["/zeta/zeta","/zeta/alpha","/zeta/omega","/zeta/beta","/alpha/zeta","/alpha/alpha"]'::jsonb,
 'CB-O01: complete render order is slot, position, path/id, not key/UUID order');
select is((select jsonb_agg(p->'plan_position' order by ord) from jsonb_array_elements(
 pg_temp.s12cs_answer('cb-plan-cs-b-order')) with ordinality e(p,ord)),
 '[1,2,3,4,5,6]'::jsonb,'CB-O02: all plan positions are consecutive and one-based');
select is((select jsonb_agg(n->'accessibleName' order by ord) from jsonb_array_elements(
 pg_temp.s12cs_answer('cb-quality-cs-b-order')->'nodes') with ordinality e(n,ord)),
 '["Z","A","O","B","Z","A"]'::jsonb,'CB-O03: actual public checker input preserves full authored order');
select is(jsonb_array_length(pg_temp.s12cs_answer('cb-plan-cs-b-long')),2,'CB-L01: expanded reference chain renders every block, no reference pseudo-node');
select ok((select jsonb_array_length(r.detached_tree#>'{nodes,1,keySegments}')=6
 and octet_length(array_to_string(array(select jsonb_array_elements_text(r.detached_tree#>'{nodes,1,keySegments}')),'/'))>256
 from platform_private.cms_composition_instances r where r.id=pg_temp.s12pu_head('cs-b-long','/panel')),
 'CB-L02 premise: actual detached child has six namespace segments and a >256-character expanded address');
select ok(not exists(select 1 from jsonb_array_elements(pg_temp.s12cs_answer('cb-plan-cs-b-long')) p
 where p->>'instance_id' is distinct from pg_temp.s12pu_head('cs-b-long','/panel')::text
 or length(p#>>'{identity,pointer}')>256
 or (p#>>'{identity,pointer}') !~ '^(/([A-Za-z0-9_.-]|~[01])+){1,32}$'),
 'CB-L03: every actual long-namespace location is selected-head anchored and fits unchanged Worker pointer grammar');
select is(pg_temp.s12cs_answer('cb-plan-cs-b-long')#>>'{1,identity,pointer}',
 '/composition/'||pg_temp.s12pu_head('cs-b-long','/panel')||'/nodes/1',
 'CB-L04: private canonical ordinal projection does not concatenate expanded namespaces');
select is(pg_temp.s12cs_answer('cb-manifest-cs-b-long')->'blocks',pg_temp.s12cb_blocks('[["s12cs.root",2],["s12cs.leaf",2]]'),
 'CB-L05: long reference namespace does not change reachable identity set');

-- Independent literal expected identity range, never a production expander.
select * from pg_temp.s12cs_call('cb-limit128','platform_private.cms_build_dependency_manifest',
 jsonb_build_object('revisionId',pg_temp.s12pl_rev('cs-b-limit127')));
select is(pg_temp.s12cs_answer('cb-limit128')->'blocks',pg_temp.s12cb_blocks(
 (select jsonb_agg(jsonb_build_array('s12cb.limit',n) order by n) from generate_series(1,127) n)
 ||'[["s12cb.branch",1]]'::jsonb),'CB-B01: actual builder accepts exactly 128 reachable distinct blocks in canonical UUID order');
select * from pg_temp.s12cb_refused('cs-b-limit128','dependency_manifest_too_large');
select * from pg_temp.s12cb_refused('cs-b-missing','DEPENDENCY_UNAVAILABLE');
select is((select count(*)::integer from platform_private.cms_block_definition_versions where block_key='s12cb.missing'),0,
 'CB-U01 premise: missing standalone registry record was never fabricated');
select is(pg_temp.s12cs_answer('cb-manifest-'||tag)-array['blocks','patterns','template']::text[],
 pg_temp.s12cs_answer('manifest-cs-detached')-array['blocks','patterns','template']::text[],
 'CB-G01 '||tag||': schema/terms/locale/settings/relations/checker groups stay byte-identical to same-owner zero-field control')
 from (values ('cs-b-parity'),('cs-b-json'),('cs-b-solo'),('cs-b-long'),
 ('cs-b-order'),('cs-b-pending'),('cs-b-reuse'),('cs-b-special')) cases(tag);

-- DEC-198 / BE03b1709: newest pending content remains visible to D5. These
-- are isolated guarded READ pairs, not ordinary append/carry producer evidence.
select * from pg_temp.s12pu_place('cs-b-pending-target','cs-b-pending2');
select * from pg_temp.s12cs_pair('cs-b-pending','cs-b-pending-target');
select is((select jsonb_agg(jsonb_build_object('state',c.state,'version',c.version,'pin',c.pattern_version,
 'blockVersion',c.block_version,'mode',c.link_mode,'props',c.props,'tree',c.detached_tree) order by c.version)
 from platform_private.cms_composition_instances c where c.revision_id=pg_temp.s12pl_rev('cs-b-pending-d5-left')),
 '[{"state":"active","version":1,"pin":1,"blockVersion":1,"mode":"linked","props":{},"tree":null},
   {"state":"pending_diff","version":2,"pin":1,"blockVersion":1,"mode":"linked","props":{},"tree":null}]'::jsonb,
 'CB-D5-P01 premise: older active history and newest pending head both retain literal B, never active T');
create or replace function pg_temp.s12cb_pending_side_hash(p_version integer) returns text language sql stable as $body$
 select platform_private.cms_jcs_sha256(jsonb_build_object('blockKey','s12cs.root','blockVersion',p_version,
 'blockRegistryDigest',platform_private.cms_jcs_sha256(jsonb_build_array(jsonb_build_object(
  'blockKey','s12cs.root','blockVersion',p_version,'releaseDigest',repeat('e',64),'propsSchemaHash',repeat('a',64),
  'rendererRef','cms/renderers/hero/1','lifecycle','supported'))),'mode','linked',
 'patternRef',jsonb_build_object('patternId',pg_temp.s12pd_body('cs-b-pending1')->'patternId','patternVersion',p_version),
 'props','{}'::jsonb,'bindings','{}'::jsonb))
$body$;
select tap.* from s12cs_pairs p cross join lateral pg_temp.s12cs_call('compare-cs-b-pending','platform_api.cms_list_revisions',
 jsonb_build_object('entryId',p.entry_id,'compareRevisionId',p.left_id,'locale','en-US','limit',25,
 'context',pg_temp.s09d_context('owner',true)),'owner','service_role') tap where p.tag='cs-b-pending';
select is(pg_temp.s12cs_answer('compare-cs-b-pending')#>'{compare,changes}',jsonb_build_array(jsonb_build_object(
 'domain','block','path','/blocks//panel','kind','changed','leftHash',pg_temp.s12cb_pending_side_hash(1),
 'rightHash',pg_temp.s12cb_pending_side_hash(2))),
 'CB-D5-P02: actual public D5 hashes newest pending pinned B against active T, not an absent or prematurely adopted side');
select is(jsonb_build_object('left',pg_temp.s12cs_answer('compare-cs-b-pending')#>'{compare,leftRevisionId}',
 'right',pg_temp.s12cs_answer('compare-cs-b-pending')#>'{compare,rightRevisionId}'),
 (select jsonb_build_object('left',left_id,'right',right_id) from s12cs_pairs where tag='cs-b-pending'),
 'CB-D5-P03: public comparison names the actual requested/newest readable revision pair');

-- DEC-198 guarded READ image of a pending head as the sole row of a fresh
-- revision. This is neither an actual carry producer nor scan evidence.
-- jsonb_populate_record ignores the future carried_from_id key before420;
-- its existence/provenance is deliberately NOT a prerequisite or assertion.
create or replace function pg_temp.s12cb_pending_only() returns setof text language plpgsql as $body$
declare donor platform_private.cms_composition_instances; row_id uuid:=extensions.gen_random_uuid(); target uuid;
 old_rows jsonb:=pg_temp.s12cs_history(pg_temp.s12pl_rev('cs-b-pending')); stored jsonb; stamp timestamptz;
 prior text:=coalesce(current_setting('app.cms_rpc',true),'');
begin
 perform set_config('app.cms_rpc','true',true);
 select * into strict donor from platform_private.cms_composition_instances
  where id=pg_temp.s12pu_head('cs-b-pending','/panel');
 if donor.state<>'pending_diff' then raise exception 'pending-only donor is not pending'; end if;
 target:=pg_temp.s12pl_entry('cs-b-pending-only'); stamp:=clock_timestamp();
 insert into platform_private.cms_composition_instances
 select (jsonb_populate_record(null::platform_private.cms_composition_instances,to_jsonb(donor)||jsonb_build_object(
  'id',row_id,'revision_id',target,'version',1,'carried_from_id',donor.id,'created_at',stamp,'updated_at',stamp))).*;
 stored:=pg_temp.s12pu_row(row_id);
 perform set_config('app.cms_rpc',prior,true);
 return next extensions.is((select count(*)::integer from platform_private.cms_composition_instances where revision_id=target),1,
  'CB-D5-Q01: guarded pending-only read revision has exactly one row, no older active fallback');
 return next extensions.is(stored-array['id','revision_id','version','carried_from_id','created_at','updated_at']::text[],
  to_jsonb(donor)-array['id','revision_id','version','carried_from_id','created_at','updated_at']::text[],
  'CB-D5-Q02: pending read image copies every other source semantic column exactly');
 return next extensions.is(jsonb_build_object('state',stored->'state','version',stored->'version','pin',stored->'pattern_version',
  'pending',stored->'pending_pattern_version','path',stored->'path','position',stored->'position','mode',stored->'link_mode',
  'blockKey',stored->'block_key','blockVersion',stored->'block_version','props',stored->'props',
  'bindings',stored->'bindings','tree',stored->'detached_tree'),
  '{"state":"pending_diff","version":1,"pin":1,"pending":2,"path":"/panel","position":0,"mode":"linked",
    "blockKey":"s12cs.root","blockVersion":1,"props":{},"bindings":{},"tree":null}'::jsonb,
  'CB-D5-Q03: literal pending-only B image, with T still unanswered');
 return next extensions.is(pg_temp.s12cs_history(pg_temp.s12pl_rev('cs-b-pending')),old_rows,
  'CB-D5-Q04: original active/scan-pending history stays byte-identical');
exception when others then
 perform set_config('app.cms_rpc',prior,true);
 return next extensions.fail('CB-D5 pending-only guarded read-image admission succeeds');
 return next extensions.diag(sqlstate||':'||sqlerrm);
end;
$body$;
select * from pg_temp.s12cb_pending_only();
select * from pg_temp.s12cs_pair('cs-b-pending-only','cs-b-pending-target');
select tap.* from s12cs_pairs p cross join lateral pg_temp.s12cs_call('compare-cs-b-pending-only','platform_api.cms_list_revisions',
 jsonb_build_object('entryId',p.entry_id,'compareRevisionId',p.left_id,'locale','en-US','limit',25,
 'context',pg_temp.s09d_context('owner',true)),'owner','service_role') tap where p.tag='cs-b-pending-only';
select is(pg_temp.s12cs_answer('compare-cs-b-pending-only')#>'{compare,changes}',jsonb_build_array(jsonb_build_object(
 'domain','block','path','/blocks//panel','kind','changed','leftHash',pg_temp.s12cb_pending_side_hash(1),
 'rightHash',pg_temp.s12cb_pending_side_hash(2))),
 'CB-D5-Q05: actual public D5 retains sole pending pinned B, so filtering to older active rows cannot pass');
select is(jsonb_build_object('left',pg_temp.s12cs_answer('compare-cs-b-pending-only')#>'{compare,leftRevisionId}',
 'right',pg_temp.s12cs_answer('compare-cs-b-pending-only')#>'{compare,rightRevisionId}'),
 (select jsonb_build_object('left',left_id,'right',right_id) from s12cs_pairs where tag='cs-b-pending-only'),
 'CB-D5-Q06: pending-only public comparison names actual requested/newest revisions');
