
-- EditorialDecision, PublicationSchedule and PublicationVersion canonical
-- records (BE03b Database Schema).

select ok(
  pg_temp.s10r_closed_check_labels(
    'platform_private.cms_editorial_decisions', 'state'
  ) = array['recorded']::text[]
    and pg_temp.s10r_closed_check_labels(
      'platform_private.cms_editorial_decisions', 'decision'
    ) = array['approve','reject']::text[]
    and pg_temp.s10r_has_default(
      'platform_private.cms_editorial_decisions', 'version'
    ),
  'decision state is recorded-only with a closed approve/reject union'
);

select ok(
  pg_temp.s10r_fk_target(
    'platform_private.cms_editorial_decisions', 'review_id'
  ) = 'platform_private.cms_editorial_reviews.id'
    and pg_temp.s10r_fk_target(
      'platform_private.cms_editorial_decisions', 'reviewer_person_id'
    ) = 'platform_private.person_party.party_id'
    and pg_temp.s10r_fk_target(
      'platform_private.cms_editorial_decisions', 'acting_party_id'
    ) = 'platform_private.party.id',
  'decision binds a real review, canonical reviewer and acting party'
);

select ok(
  pg_temp.s10r_unique_target('platform_private.cms_editorial_decisions')
    @> array['review_id,reviewer_person_id']::text[]
    and pg_temp.s10r_has_check(
      'platform_private.cms_editorial_decisions', 'updated_at = created_at'
    )
    -- Slice 11 (DEC-158a, BE03b amended 2026-10-08): the reason bound is Unicode
    -- code points, 1 to 2000, not octets.
    and pg_temp.s10r_has_check(
      'platform_private.cms_editorial_decisions',
      'char_length(reason) >= 1'
    )
    and pg_temp.s10r_has_check(
      'platform_private.cms_editorial_decisions',
      'char_length(reason) <= 2000'
    )
    and pg_temp.s10r_has_check(
      'platform_private.cms_editorial_decisions',
      'octet_length(capability) >= 1'
    ),
  'one decision per reviewer per review on immutable append-only evidence'
);

select ok(
  pg_temp.s10r_has_check(
    'platform_private.cms_editorial_decisions', 'comment_hash IS NULL'
  )
    and pg_temp.s10r_has_check(
      'platform_private.cms_editorial_decisions', '^[a-f0-9]{64}$'
    )
    and pg_temp.s10r_col_notnull(
      'platform_private.cms_editorial_decisions', 'reviewed_hash'
    ),
  'optional comment hash and mandatory reviewed hash stay 64-hex'
);

select ok(
  pg_temp.s10r_closed_check_labels(
    'platform_private.cms_publication_schedules', 'state'
  ) = array[
    'blocked','cancelled','completed','executing','failed_retryable','pending'
  ]::text[]
    and pg_temp.s10r_closed_check_labels(
      'platform_private.cms_publication_schedules', 'action'
    ) = array['archive','expire','publish','unpublish']::text[]
    and pg_temp.s10r_closed_check_labels(
      'platform_private.cms_publication_schedules', 'disambiguation'
    ) = array['earlier','later','none']::text[],
  'schedule state, action and DST disambiguation are closed unions'
);

select ok(
  pg_temp.s10r_fk_target(
    'platform_private.cms_publication_schedules', 'entry_id'
  ) = 'platform_private.cms_content_entries.id'
    and pg_temp.s10r_fk_target(
      'platform_private.cms_publication_schedules', 'revision_id'
    ) = 'platform_private.cms_entry_revisions.id'
    and pg_temp.s10r_fk_target(
      'platform_private.cms_publication_schedules', 'created_by'
    ) = 'platform_private.person_party.party_id'
    and pg_temp.s10r_column_type(
      'platform_private.cms_publication_schedules', 'local_datetime'
    ) = 'timestamp'
    and pg_temp.s10r_column_type(
      'platform_private.cms_publication_schedules', 'resolved_at_utc'
    ) = 'timestamptz',
  'schedule separates naive local time from the resolved UTC instant'
);

select ok(
  pg_temp.s10r_unique_target('platform_private.cms_publication_schedules')
    -- Slice 11 (BE03b E9): the lineage audience is part of the duplicate key.
    @> array['entry_id,revision_id,action,local_datetime,timezone,audience']::text[]
    and pg_temp.s10r_has_check(
      'platform_private.cms_publication_schedules', 'expected_version > 0'
    )
    and pg_temp.s10r_has_check(
      'platform_private.cms_publication_schedules', 'octet_length(timezone) >= 1'
    )
    and pg_temp.s10r_has_check(
      'platform_private.cms_publication_schedules',
      'octet_length(tzdb_version) >= 1'
    ),
  'schedule identity is unique per audience and its version and tz evidence are bounded'
);

select ok(
  -- Slice 11 (BE03b E3): superseded is derived for a non-head publish row and
  -- pending is not a physical state, so the stored union is active | revoked.
  -- (The label inspector unions every literal of every CHECK that names the
  -- column, which now includes the action/state consistency rule, so the union
  -- is pinned on the state CHECK itself.)
  pg_temp.s10r_has_check(
    'platform_private.cms_publication_versions',
    'state = ANY (ARRAY[''active''::text, ''revoked''::text])'
  )
    and not pg_temp.s10r_has_check(
      'platform_private.cms_publication_versions', 'superseded'
    )
    and not pg_temp.s10r_has_check(
      'platform_private.cms_publication_versions', 'pending'
    )
    and pg_temp.s10r_has_default(
      'platform_private.cms_publication_versions', 'version'
    )
    and pg_temp.s10r_has_check(
      'platform_private.cms_publication_versions',
      'updated_at = created_at'
    ),
  'publication version state is a closed union on immutable evidence'
);

select ok(
  pg_temp.s10r_fk_target(
    'platform_private.cms_publication_versions', 'entry_id'
  ) = 'platform_private.cms_content_entries.id'
    and pg_temp.s10r_fk_target(
      'platform_private.cms_publication_versions', 'revision_id'
    ) = 'platform_private.cms_entry_revisions.id'
    and pg_temp.s10r_fk_target(
      'platform_private.cms_publication_versions', 'schema_version_id'
    ) = 'platform_private.cms_content_type_versions.id'
    and pg_temp.s10r_fk_target(
      'platform_private.cms_publication_versions', 'schema_artifact_id'
    ) = 'platform_private.cms_schema_artifacts.id'
    and pg_temp.s10r_has_check(
      'platform_private.cms_publication_versions',
      'cms_template_registry_valid'
    ),
  'publication version pins real schema, artifact and template-seam evidence'
);

select ok(
  -- Slice 11 (BE03b E3): the one-active partial index is replaced by the
  -- append-only lineage key; a prior head stays active physically and at most one
  -- head per lineage follows from UNIQUE (entry, locale, audience, version).
  to_regclass('platform_private.cms_publication_versions_active_identity_unique') is null
    and pg_temp.s10r_unique_target('platform_private.cms_publication_versions')
      @> array['entry_id,locale,audience,version', 'publication_id,version']::text[]
    and pg_temp.s10r_has_index(
      'platform_private.cms_publication_versions',
      'cms_publication_versions_lineage_head_idx',
      array['(entry_id, locale, audience, version DESC)']
    )
    and pg_temp.s10r_has_index(
      'platform_private.cms_publication_versions',
      'cms_publication_versions_revision_idx',
      array['(revision_id)']
    ),
  'publication lineage rows are unique per entry, locale, audience and version (the one-active partial index is replaced)'
);
