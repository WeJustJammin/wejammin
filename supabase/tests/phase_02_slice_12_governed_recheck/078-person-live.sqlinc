-- DEC-221 (review V4-05; BE03b "Write-path lock order and authority fencing" rule 4: "if the activation commits first, the revocation waits
-- and then commits"; BE03c "Reviewer-authority invalidation on revocation" and its changelog row "Governed lock failures and revocation
-- races"): the reviewer-authority invalidation reads its candidates BEFORE any lock, so a governed command that held the subject first (an
-- activation, a decision, an assignment revocation) may have activated, rejected or invalidated a candidate by the time the revocation gets
-- the subject lock.  The revocation must then find nothing left to invalidate: it re-reads the candidate under the subject lock, skips a
-- review that is no longer live and never fails on it.  Until DEC-221 the single-review invalidation was called on the stale candidate; for an
-- activated review its guard raises CONFLICT and the person function re-raised it, so the revoking transaction failed on a review it did not
-- concern.
-- A single session cannot interleave two commits inside one statement, so the race is reproduced at its seam: the stale candidate is exactly a
-- review that is not live when the per-candidate step runs, and the step is the private cms_governed_invalidate_review_if_live (subject lock,
-- plain re-read, invalidate only if live).  The interleaving itself is the post-promotion race R-3 (revocation versus activation), run by root.
-- Real producers only: rc1 is really activated, rc3 is really rejected, rc2 and rc4 are live; no row is written by hand.
select pg_temp.s12gb_approved('rc1', array['typeA'], 'rev2');   -- activated
select pg_temp.s12gb_approved('rc2', array['typeA'], 'rev2');   -- live, found by the person-level call
select pg_temp.s12gb_approved('rc4', array['typeA'], 'rev2');   -- live, invalidated by the step itself
select pg_temp.s12ga_open('rc3', 'owner', array['typeA'], 'owner');
select pg_temp.s12ga_assign('as-rc3', 'owner', pg_temp.s12ga_review('rc3'), 'rev2', interval '20 hours');
select pg_temp.s12ga_decide('rj-rc3', 'rev2', pg_temp.s12ga_review('rc3'), 'reject');
select pg_temp.s12gb_act('rc1-act', 'owner', pg_temp.s12ga_review('rc1'), 'activate');

create or replace function pg_temp.s12v4_if_live(p_review uuid) returns text language plpgsql as $body$
begin
  return platform_private.cms_governed_invalidate_review_if_live(
    p_review, 'reviewer_authority_changed', null, pg_temp.s12ga_org(), extensions.gen_random_uuid())::text;
exception when others then
  return sqlstate || ':' || sqlerrm;
end;
$body$;

select ok(pg_temp.s12ga_out('rc1-act') = 'ok' and pg_temp.s12ga_body('rc1-act')->>'subjectState' = 'active'
    and (select review.state = 'approved' and review.activated_at is not null
           from platform_private.cms_governed_reviews review where review.id = pg_temp.s12ga_review('rc1'))
    and (select subject.state = 'active' from platform_private.cms_template_versions subject where subject.id = pg_temp.s12ga_subject('rc1')),
  'fixture: rc1 is really activated (review approved with activated_at, subject active) [DEC-221]');
select ok((select review.state = 'rejected' and review.activated_at is null
             from platform_private.cms_governed_reviews review where review.id = pg_temp.s12ga_review('rc3'))
    and (select count(*) = 2 and bool_and(review.state = 'approved' and review.activated_at is null)
           from platform_private.cms_governed_reviews review
          where review.id in (pg_temp.s12ga_review('rc2'), pg_temp.s12ga_review('rc4'))),
  'fixture: rc3 is really rejected by its reviewer and rc2 and rc4 are live approved reviews [DEC-221]');
select pg_temp.s12gr_mark('rc1', 'rc1');
select pg_temp.s12gr_mark('rc3', 'rc3');
select pg_temp.s12gr_mark('rc4', 'rc4');
select pg_temp.s12gr_count_mark('rc:before');

select is(pg_temp.s12gr_err(format('select platform_private.cms_governed_invalidate_approved_review(%L, %L, null, %L, extensions.gen_random_uuid())',
            pg_temp.s12ga_review('rc1'), 'reviewer_authority_changed', pg_temp.s12ga_org())),
  'P0001:CONFLICT',
  'premise: the single-review invalidation refuses an ACTIVATED review with CONFLICT (BE03c review guard), which is what a stale candidate used to turn into a failed revocation [DEC-221]');

-- ----------------------------------------------- a candidate that is no longer live is skipped, never failed on
select is(pg_temp.s12v4_if_live(pg_temp.s12ga_review('rc1')), 'false',
  'a candidate the activation already committed (review activated, subject active) is skipped: the step answers false and raises nothing [DEC-221]');
select is(pg_temp.s12v4_if_live(pg_temp.s12ga_review('rc3')), 'false',
  'a candidate a decision already rejected is skipped [DEC-221]');
select is(pg_temp.s12v4_if_live(extensions.gen_random_uuid()), 'false',
  'a candidate that does not exist is skipped [DEC-221]');
select ok(pg_temp.s12gr_untouched('rc1', 'rc1') and pg_temp.s12gr_untouched('rc3', 'rc3')
    and (select audits = (select count(*) from audit_private.audit_events) and events = (select count(*) from platform_private.outbox_events)
           from s12gr_counts where label = 'rc:before'),
  'the skipped candidates are byte-identical (the activated subject is still active) and nothing was audited or emitted [DEC-221]');

-- control: a candidate that is still live is invalidated, once
select is(pg_temp.s12v4_if_live(pg_temp.s12ga_review('rc4')), 'true',
  'control: a candidate that is still live is invalidated by the step (answers true) [DEC-221]');
select ok(pg_temp.s12gr_invalidated('rc4', 'rc4', 'reviewer_authority_changed')
    and pg_temp.s12ga_audit('cms.governed.review.invalidate', pg_temp.s12ga_review('rc4')) = 1,
  'control: rc4 is invalidated reviewer_authority_changed (version + 1, subject back to draft) with one audit record [DEC-221]');
select pg_temp.s12gr_mark('rc4:invalidated', 'rc4');
select is(pg_temp.s12v4_if_live(pg_temp.s12ga_review('rc4')), 'false',
  'a candidate another writer invalidated meanwhile is skipped: the second step answers false [DEC-221]');
select ok(pg_temp.s12gr_untouched('rc4:invalidated', 'rc4') and pg_temp.s12ga_audit('cms.governed.review.invalidate', pg_temp.s12ga_review('rc4')) = 1,
  'the skipped invalidated review is unchanged and still has exactly one invalidation audit record [DEC-221]');

-- ---------------------------------- the person-level call: rev2 counted in all four reviews and then loses the capability
select pg_temp.s12gr_mark('rc2', 'rc2');
select pg_temp.s12fr_lapse(pg_temp.s09d_id('ownerOrg'), pg_temp.s12ga_person('rev2'), 'cms.reviewer');
select is(pg_temp.s12gr_inv_person(pg_temp.s12ga_person('rev2'), null), 1,
  'the revocation of rev2 transitions exactly the one live review it counted in (rc2): the activated, rejected and already invalidated reviews are not candidates and cannot fail it [DEC-221]');
select ok(pg_temp.s12gr_invalidated('rc2', 'rc2', 'reviewer_authority_changed')
    and pg_temp.s12gr_untouched('rc1', 'rc1') and pg_temp.s12gr_untouched('rc3', 'rc3') and pg_temp.s12gr_untouched('rc4:invalidated', 'rc4'),
  'rc2 is invalidated reviewer_authority_changed and rc1 (still active), rc3 and rc4 are unchanged [DEC-221]');
select pg_temp.s12fr_restore();
