-- P2-S12-AC-199 (BE03c "Governed review machinery", submit template_version): the frozen dependencies, the compatibility of every
-- compatibleTypeIds member and the recomputed block digest.
select pg_temp.p_register('gapg:blk', pg_temp.p_block_request('gapg.blk', 1));
select pg_temp.p_register('gapg:blk2', pg_temp.p_block_request('gapg.blk2', 1));
select pg_temp.p_register('gapg:blk3', pg_temp.p_block_request('gapg.blk3', 1));
select is(pg_temp.s09d_outcome('gapg:blk') || pg_temp.s09d_outcome('gapg:blk2') || pg_temp.s09d_outcome('gapg:blk3'), 'OKOKOK',
  'setup: the signed CMS-03A-05 producer registers gapg.blk, gapg.blk2 and gapg.blk3 [P2-S12-AC-199]');

-- A draft template through the real CMS-03C-01 command whose single slot allows the given registered block.
create or replace function pg_temp.g2_mint_block(p_tag text, p_block text, p_types text[] default array['typeA']) returns uuid
language plpgsql as $body$
declare v_subject uuid;
begin
  perform pg_temp.s12ga_rpc('mint:' || p_tag, 'platform_api.cms_define_template', 'owner', jsonb_build_object(
    'templateKey', 's12ga-' || p_tag,
    'compatibleTypeIds', (select jsonb_agg(bound.id order by bound.id) from (
       select (select value::uuid from s12gov_ids where key = k) as id from unnest(p_types) k) bound),
    'slots', jsonb_build_array(jsonb_build_object('key', 'primary', 'required', true,
      'allowedBlocks', jsonb_build_array(jsonb_build_object('blockKey', p_block, 'blockVersion', 1)), 'maxCount', 1)),
    'reservedRegions', jsonb_build_array('header', 'now', 'record', 'detail', 'provenance'),
    'bindings', '{}'::jsonb, 'locale', 'en-US', 'audience', 'public', 'expectedVersion', null,
    'idempotencyKey', 's12ga-mint-' || p_tag));
  if pg_temp.s12ga_out('mint:' || p_tag) <> 'ok' then
    raise exception 'gaps fixture: the template producer refused %: %', p_tag, pg_temp.s12ga_out('mint:' || p_tag);
  end if;
  v_subject := (pg_temp.s12ga_body('mint:' || p_tag)->>'id')::uuid;
  insert into s12gov_ids(key, value) values (p_tag || ':subject', v_subject::text)
    on conflict (key) do update set value = excluded.value;
  return v_subject;
end;
$body$;
-- A block-bearing template approved through the real submit, assignment and decision.
create or replace function pg_temp.g2_block_approved(p_tag text, p_block text) returns uuid language plpgsql as $body$
begin
  perform pg_temp.g2_mint_block(p_tag, p_block);
  perform pg_temp.s12ga_submit(p_tag, 'owner');
  perform pg_temp.s12ga_assign('as-' || p_tag, 'owner', pg_temp.s12ga_review(p_tag), 'rev1', interval '20 hours');
  perform pg_temp.s12ga_decide('ap-' || p_tag, 'rev1', pg_temp.s12ga_review(p_tag), 'approve');
  if (select state from platform_private.cms_governed_reviews where id = pg_temp.s12ga_review(p_tag)) <> 'approved' then
    raise exception 'gaps fixture: % did not reach approved', p_tag;
  end if;
  return pg_temp.s12ga_review(p_tag);
end;
$body$;
-- A direct copy of a draft template row (RPC context) with a patch over its columns; returns the new row id.
create or replace function pg_temp.g2_raw_template(p_from text, p_key text, p_patch jsonb) returns uuid language plpgsql as $body$
declare v_id uuid := extensions.gen_random_uuid(); prior text := coalesce(pg_catalog.current_setting('app.cms_rpc', true), '');
begin
  perform pg_catalog.set_config('app.cms_rpc', 'true', true);
  insert into platform_private.cms_template_versions
    select (jsonb_populate_record(null::platform_private.cms_template_versions,
      to_jsonb(t) || jsonb_build_object('id', v_id, 'template_id', null, 'template_key', p_key,
        'content_hash', md5(p_key) || md5(p_key || 'x')) || p_patch)).*
      from platform_private.cms_template_versions t where t.id = pg_temp.s12ga_subject(p_from);
  perform pg_catalog.set_config('app.cms_rpc', prior, true);
  insert into s12gov_ids(key, value) values (p_key || ':subject', v_id::text) on conflict (key) do update set value = excluded.value;
  return v_id;
end;
$body$;
create or replace function pg_temp.g2_submit_raw(p_label text, p_key text) returns void language plpgsql as $body$
begin
  perform pg_temp.s12ga_rpc(p_label, 'platform_api.cms_submit_governed_review', 'owner', jsonb_build_object(
    'subjectKind', 'template_version', 'subjectId', pg_temp.s12ga_subject(p_key),
    'subjectHash', (select content_hash::text from platform_private.cms_template_versions where id = pg_temp.s12ga_subject(p_key)),
    'idempotencyKey', 's12ga-' || p_label));
end;
$body$;
create or replace function pg_temp.g2_effects() returns jsonb language sql stable as $body$
  select jsonb_build_object('reviews', (select count(*) from platform_private.cms_governed_reviews),
    'deps', (select count(*) from platform_private.cms_governed_review_dependencies),
    'audit', (select count(*) from audit_private.audit_events), 'outbox', (select count(*) from platform_private.outbox_events),
    'idem', (select count(*) from platform_private.idempotency_records)) $body$;

-- ---- (1) a template whose slots reach a registered block freezes block + content_type dependencies
create or replace function pg_temp.g2_registry_image() returns text language sql stable as $body$
  select md5(coalesce((select string_agg(to_jsonb(b)::text, '|' order by b.id) from platform_private.cms_block_definition_versions b), '') || '#'
      || coalesce((select string_agg(to_jsonb(e)::text, '|' order by e.id) from platform_private.cms_block_definition_lifecycle_events e), '') || '#'
      || coalesce((select string_agg(to_jsonb(n)::text, '|' order by n.id) from platform_private.cms_release_nonce_receipts n), '')) $body$;
create temp table g2_reg_before on commit drop as select pg_temp.g2_registry_image() as image;
select pg_temp.g2_mint_block('g1', 'gapg.blk');
select ok(pg_temp.s12ga_out('mint:g1') = 'ok' and pg_temp.g2_registry_image() = (select image from g2_reg_before),
  'a successful CMS-03C-01 create over a registered block leaves the block registry, its lifecycle events and the release nonce receipts byte-identical [P2-S12-AC-194]');
select pg_temp.s12ga_submit('g1', 'owner');
select is((select jsonb_agg(jsonb_build_array(d.kind, d.ref_id) order by d.kind) from platform_private.cms_governed_review_dependencies d
    where d.review_id = pg_temp.s12ga_review('g1')),
  jsonb_build_array(jsonb_build_array('block', (pg_temp.s09d_resp('gapg:blk')->>'id')::uuid),
    jsonb_build_array('content_type', (select value::uuid from s12gov_ids where key = 'typeVersionA'))),
  'a template over one registered block freezes exactly one block dependency (ref_id = the registry record id) beside the content_type dependency of its compatible type [P2-S12-AC-199]');
select is((select r.block_registry_digest::text from platform_private.cms_governed_reviews r where r.id = pg_temp.s12ga_review('g1')),
  platform_private.cms_jcs_sha256(jsonb_build_array(jsonb_build_object(
    'blockKey', b.block_key, 'blockVersion', b.block_version, 'releaseDigest', btrim(b.release_digest::text),
    'propsSchemaHash', btrim(b.props_schema_hash::text), 'rendererRef', b.renderer_ref, 'lifecycle', 'supported')))
  , 'the review stores the block registry digest recomputed independently from the registered tuple [P2-S12-AC-199]')
  from platform_private.cms_block_definition_versions b where b.block_key = 'gapg.blk' and b.block_version = 1;

-- ---- (3) a stored block_registry_digest that differs from the recomputed one refuses the submit
select pg_temp.g2_mint_block('g3', 'gapg.blk3');
select pg_temp.g2_raw_template('g3', 'gapg-bad-digest', jsonb_build_object('block_registry_digest', repeat('f', 64)));
create temp table g2_before_bad on commit drop as select pg_temp.g2_effects() as e;
select pg_temp.g2_submit_raw('bad-digest', 'gapg-bad-digest');
select is(pg_temp.s12ga_out('bad-digest'), 'P0001:subject_not_submittable',
  'a stored block_registry_digest that differs from the recomputed one refuses the submit subject_not_submittable [P2-S12-AC-199]');
select is(pg_temp.g2_effects(), (select e from g2_before_bad),
  'the digest refusal commits no review, dependency, audit record, event or idempotency record [P2-S12-AC-199]');
select ok((select t.state = 'draft' and t.lifecycle_version = 1 from platform_private.cms_template_versions t where t.id = pg_temp.s12ga_subject('gapg-bad-digest')),
  'the refused template stays a draft at its first lifecycle step [P2-S12-AC-199]');
select pg_temp.g2_raw_template('g3', 'gapg-good-digest', '{}'::jsonb);
select pg_temp.g2_submit_raw('good-digest', 'gapg-good-digest');
select is(pg_temp.s12ga_out('good-digest'), 'ok',
  'control: the same copied draft with the true digest submits, so the refusal above is the digest and nothing in the copy [P2-S12-AC-199]');

-- ---- (2) a compatibleTypeIds member that is not an active compatible type refuses the submit
select pg_temp.g2_raw_template('g3', 'gapg-bad-member', jsonb_build_object('compatible_type_ids',
  jsonb_build_array((select value from s12gov_ids where key = 'typeA'), pg_temp.s09d_id('gapg-draft:type')::text)));
create temp table g2_before_member on commit drop as select pg_temp.g2_effects() as e;
select pg_temp.g2_submit_raw('bad-member', 'gapg-bad-member');
select is(pg_temp.s12ga_out('bad-member'), 'P0001:VALIDATION_FAILED',
  'a template naming a content type with no active version is refused VALIDATION_FAILED at submit [P2-S12-AC-199]');
select is(pg_temp.g2_effects(), (select e from g2_before_member),
  'the compatibility refusal commits no review, dependency, audit record, event or idempotency record [P2-S12-AC-199]');
