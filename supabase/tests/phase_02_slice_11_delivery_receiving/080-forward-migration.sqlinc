-- DEC-197 receiving storage only: BE04a registry/lifecycle entry and BE04c registry.
-- No compiler, delivery writer, pointer, API RPC, policy, principal or seed data.
-- Forward-only after use: preserve sealed history; rollback needs a separately
-- reviewed compensating migration. Any pre-COMMIT error rolls back all this DDL.
begin;

set local lock_timeout = '5s';

create table platform_private.route_manifest_version (
  id uuid primary key default pg_catalog.gen_random_uuid(),
  version_no bigint generated by default as identity
    (increment by 1 minvalue 1 start with 1 no cycle) not null,
  publication_set_hash text not null,
  state text not null,
  generated_at timestamptz not null,
  activated_at timestamptz null,
  constraint route_manifest_version_version_no_key unique (version_no),
  constraint route_manifest_version_version_no_check check (version_no > 0),
  constraint route_manifest_version_publication_set_hash_check
    check (publication_set_hash ~ '^[a-f0-9]{64}$'),
  constraint route_manifest_version_state_check
    check (state in ('ready', 'active', 'superseded')),
  constraint route_manifest_version_ready_activation_check
    check (state <> 'ready' or activated_at is null),
  constraint route_manifest_version_active_activation_check
    check (state = 'ready' or activated_at is not null),
  constraint route_manifest_version_activation_time_check
    check (activated_at is null or activated_at >= generated_at)
);

create unique index route_manifest_version_one_active_unique
  on platform_private.route_manifest_version (state) where state = 'active';
create index route_manifest_version_state_version_idx
  on platform_private.route_manifest_version (state, version_no desc);
create index route_manifest_version_generated_idx
  on platform_private.route_manifest_version (generated_at);

comment on table platform_private.route_manifest_version is
  'Private globally numbered sealed complete artifacts; allocation is monotonic, not gapless or publisher authority.';
comment on column platform_private.route_manifest_version.publication_set_hash is
  'SHA-256 of RFC8785 {"publicationVersions":[{"publicationVersionId":"...","publicationHash":"..."}]} for the complete frozen set, sorted by lowercase version UUID without duplicates, using immutable cms_publication_versions.publication_hash. Completeness is a future compiler obligation.';

create function platform_private.route_manifest_version_guard()
returns trigger
language plpgsql
security invoker
set search_path = ''
as $body$
begin
  if tg_op = 'DELETE' then
    raise exception 'sealed manifest deletion refused'
      using errcode = '23514', constraint = 'route_manifest_version_delete_check';
  end if;
  if tg_op = 'INSERT' then
    -- Unknown/null states reach their own CHECK/NOT NULL diagnostics.
    if new.state in ('active', 'superseded') then
      raise exception 'manifest must enter as ready'
        using errcode = '23514', constraint = 'route_manifest_version_transition_check';
    end if;
    return new;
  end if;
  if new.state is distinct from old.state
    and new.state in ('ready', 'active', 'superseded')
    and not ((old.state = 'ready' and new.state = 'active')
      or (old.state = 'active' and new.state = 'superseded')) then
    raise exception 'sealed manifest transition refused'
      using errcode = '23514', constraint = 'route_manifest_version_transition_check';
  end if;
  if row(new.id, new.version_no, new.publication_set_hash, new.generated_at)
    is distinct from row(old.id, old.version_no, old.publication_set_hash, old.generated_at) then
    raise exception 'sealed manifest fields are immutable'
      using errcode = '23514', constraint = 'route_manifest_version_immutable_check';
  end if;
  if old.activated_at is not null and new.activated_at is distinct from old.activated_at then
    raise exception 'manifest activation time is write-once'
      using errcode = '23514', constraint = 'route_manifest_version_activation_immutable_check';
  end if;
  return new;
end;
$body$;

create trigger route_manifest_version_guard
before insert or update or delete on platform_private.route_manifest_version
for each row execute function platform_private.route_manifest_version_guard();

create table platform_private.publication_projection (
  id uuid primary key default pg_catalog.gen_random_uuid(),
  publication_id uuid not null,
  route_manifest_id uuid not null,
  locale varchar(16) not null,
  audience varchar(48) not null,
  render_payload jsonb not null,
  render_hash text not null,
  discovery_hash text not null,
  required_refs jsonb not null,
  state text not null,
  version bigint not null,
  created_at timestamptz not null,
  updated_at timestamptz not null,
  constraint publication_projection_publication_fk foreign key (publication_id)
    references platform_private.cms_publication_versions (id) on update no action on delete no action,
  constraint publication_projection_manifest_fk foreign key (route_manifest_id)
    references platform_private.route_manifest_version (id) on update no action on delete no action,
  constraint publication_projection_render_payload_check check (jsonb_typeof(render_payload) = 'object'),
  constraint publication_projection_render_hash_check check (render_hash ~ '^[a-f0-9]{64}$'),
  constraint publication_projection_discovery_hash_check check (discovery_hash ~ '^[a-f0-9]{64}$'),
  constraint publication_projection_required_refs_check check (jsonb_typeof(required_refs) = 'array'),
  constraint publication_projection_state_check
    check (state in ('building', 'ready', 'blocked', 'failed_retryable', 'active', 'superseded', 'revoked')),
  constraint publication_projection_version_check check (version > 0),
  constraint publication_projection_publication_identity_unique unique (publication_id, id),
  constraint publication_projection_identity_unique
    unique (publication_id, route_manifest_id, locale, audience, version)
);

create index publication_projection_locale_audience_state_idx
  on platform_private.publication_projection (locale, audience, state);
create index publication_projection_publication_version_idx
  on platform_private.publication_projection (publication_id, version desc);
create index publication_projection_manifest_locale_audience_idx
  on platform_private.publication_projection (route_manifest_id, locale, audience);

comment on table platform_private.publication_projection is
  'Private receiving projection: publication_id is cms_publication_versions.id, the version row, not its lineage. No writer authority is granted here.';

alter table platform_private.route_manifest_version enable row level security;
alter table platform_private.route_manifest_version force row level security;
alter table platform_private.publication_projection enable row level security;
alter table platform_private.publication_projection force row level security;
revoke all on table platform_private.route_manifest_version, platform_private.publication_projection
  from public, anon, authenticated, service_role;
revoke all on function platform_private.route_manifest_version_guard()
  from public, anon, authenticated, service_role;

-- Remove runtime ACLs, including ordinary-definer/default grants, on NEW objects
-- only. Resolve the actual identity sequence, never an unrelated guessed name.
do $acl$
declare
  ordinal_sequence text := pg_catalog.pg_get_serial_sequence('platform_private.route_manifest_version', 'version_no');
  runtime_role_name text;
begin
  execute pg_catalog.format('revoke all on sequence %s from public, anon, authenticated, service_role', ordinal_sequence);
  for runtime_role_name in
    select case when permissions.grantee = 0 then 'public'
      else pg_catalog.quote_ident(pg_catalog.pg_get_userbyid(permissions.grantee)) end
    from (
      select distinct a.grantee from pg_catalog.pg_class c
      cross join lateral pg_catalog.aclexplode(c.relacl) a
      where c.oid in ('platform_private.route_manifest_version'::regclass,
        'platform_private.publication_projection'::regclass, ordinal_sequence::regclass)
        and a.grantee <> c.relowner
      union
      select a.grantee from pg_catalog.pg_proc p
      cross join lateral pg_catalog.aclexplode(p.proacl) a
      where p.oid = 'platform_private.route_manifest_version_guard()'::regprocedure
        and a.grantee <> p.proowner
    ) permissions
  loop
    execute pg_catalog.format('revoke all on table platform_private.route_manifest_version, platform_private.publication_projection from %s', runtime_role_name);
    execute pg_catalog.format('revoke all on sequence %s from %s', ordinal_sequence, runtime_role_name);
    execute pg_catalog.format('revoke all on function platform_private.route_manifest_version_guard() from %s', runtime_role_name);
  end loop;
end;
$acl$;

-- Normal ADD validates existing consumers immediately. Any orphan aborts this
-- transaction, including every preceding table, sequence, index, guard and ACL.
-- The existing publication FK, policy, CMS SELECT grant and write guard stay put.
alter table platform_private.projection_consumer_state
  add constraint projection_consumer_state_projection_fk foreign key (projection_id)
    references platform_private.publication_projection (id) on update no action on delete no action;
alter table platform_private.projection_consumer_state
  add constraint projection_consumer_state_publication_projection_fk foreign key (publication_id, projection_id)
    references platform_private.publication_projection (publication_id, id) on update no action on delete no action;

commit;
