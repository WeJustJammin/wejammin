-- Catalog queries use OIDs so absent objects return failed assertions, not 42P01.
select ok(to_regclass('platform_private.route_manifest_version') is not null,
  'DR-C01 manifest physical home exists [BE04a PostgreSQL registry; DEC-197]');
select ok(to_regclass('platform_private.publication_projection') is not null,
  'DR-C02 projection physical home exists [BE04c PostgreSQL registry; DEC-197]');
select is((select string_agg(a.attname || ':' || format_type(a.atttypid,a.atttypmod) || ':' || a.attnotnull,
  ',' order by a.attnum) from pg_attribute a where a.attrelid=to_regclass('platform_private.route_manifest_version')
  and a.attnum>0 and not a.attisdropped),
  'id:uuid:true,version_no:bigint:true,publication_set_hash:text:true,state:text:true,generated_at:timestamp with time zone:true,activated_at:timestamp with time zone:false',
  'DR-C03 manifest has exactly six ordered columns, types and nullability [BE04a registry]');
select is((select string_agg(a.attname || ':' || format_type(a.atttypid,a.atttypmod) || ':' || a.attnotnull,
  ',' order by a.attnum) from pg_attribute a where a.attrelid=to_regclass('platform_private.publication_projection')
  and a.attnum>0 and not a.attisdropped),
  'id:uuid:true,publication_id:uuid:true,route_manifest_id:uuid:true,locale:character varying(16):true,audience:character varying(48):true,render_payload:jsonb:true,render_hash:text:true,discovery_hash:text:true,required_refs:jsonb:true,state:text:true,version:bigint:true,created_at:timestamp with time zone:true,updated_at:timestamp with time zone:true',
  'DR-C04 projection has exactly thirteen ordered columns, no owner or extra timestamps [BE04c registry]');
select ok((select a.attidentity in ('a','d') from pg_attribute a
  where a.attrelid=to_regclass('platform_private.route_manifest_version') and a.attname='version_no'),
  'DR-C05 global ordinal is generated by a PostgreSQL identity sequence [DEC-197]');
select ok(exists(select 1 from pg_depend d join pg_class seq on seq.oid=d.objid
  join pg_namespace ns on ns.oid=seq.relnamespace
  where d.refobjid=to_regclass('platform_private.route_manifest_version')
    and d.refobjsubid=any(pg_temp.dr_attnums('platform_private.route_manifest_version',array['version_no']))
    and d.deptype='i' and seq.relkind='S' and ns.nspname='platform_private'),
  'DR-C06 identity sequence belongs to the manifest ordinal in the private schema [DEC-197]');

select ok(pg_temp.dr_key(t,k,cols) is not null, label)
from (values
  ('platform_private.route_manifest_version','p'::"char",array['id'],'DR-C07 manifest primary key is id'),
  ('platform_private.route_manifest_version','u'::"char",array['version_no'],'DR-C08 positive global ordinal is unique'),
  ('platform_private.publication_projection','p'::"char",array['id'],'DR-C09 projection primary key is id'),
  ('platform_private.publication_projection','u'::"char",array['publication_id','id'],'DR-C10 parent same-publication unique has ordered publication_id,id'),
  ('platform_private.publication_projection','u'::"char",array['publication_id','route_manifest_id','locale','audience','version'],
    'DR-C11 complete projection identity is the exact five-column unique')) q(t,k,cols,label);

select ok(pg_temp.dr_fk(t,cols,parent,parent_cols) is not null,label)
from (values
  ('platform_private.publication_projection',array['publication_id'],'platform_private.cms_publication_versions',array['id'],
    'DR-C12 validated projection publication VERSION FK, ordered columns and restrictive actions'),
  ('platform_private.publication_projection',array['route_manifest_id'],'platform_private.route_manifest_version',array['id'],
    'DR-C13 validated projection manifest FK, ordered columns and restrictive actions'),
  ('platform_private.projection_consumer_state',array['publication_id'],'platform_private.cms_publication_versions',array['id'],
    'DR-C14 existing validated consumer publication VERSION FK retained'),
  ('platform_private.projection_consumer_state',array['projection_id'],'platform_private.publication_projection',array['id'],
    'DR-C15 validated direct consumer projection FK, ordered columns and restrictive actions'),
  ('platform_private.projection_consumer_state',array['publication_id','projection_id'],
    'platform_private.publication_projection',array['publication_id','id'],
    'DR-C16 validated composite consumer FK binds the same publication in the exact column order'))
  q(t,cols,parent,parent_cols,label);

select is((select array_agg(regexp_replace(pg_get_indexdef(i.indexrelid),
  '^.* USING btree ', '') order by regexp_replace(pg_get_indexdef(i.indexrelid),'^.* USING btree ',''))
  from pg_index i where i.indrelid=to_regclass('platform_private.publication_projection') and not i.indisunique
    and i.indisvalid and i.indisready),
  array['(locale, audience, state)','(publication_id, version DESC)','(route_manifest_id, locale, audience)'],
  'DR-C17 projection has exactly the three required nonunique btree indexes [BE04c registry]');
select is((select array_agg(regexp_replace(pg_get_indexdef(i.indexrelid),'^.* USING btree ','')
  order by regexp_replace(pg_get_indexdef(i.indexrelid),'^.* USING btree ',''))
  from pg_index i where i.indrelid=to_regclass('platform_private.route_manifest_version') and not i.indisunique
    and i.indisvalid and i.indisready),array['(generated_at)','(state, version_no DESC)'],
  'DR-C18 manifest has exact state/descending-ordinal and generated-time indexes [BE04a registry]');
select is((select count(*)::integer from pg_index i
  where i.indrelid=to_regclass('platform_private.route_manifest_version') and i.indisunique
    and i.indisvalid and i.indisready and i.indnkeyatts=1 and i.indnatts=1
    and i.indkey::smallint[] @> pg_temp.dr_attnums('platform_private.route_manifest_version',array['state'])
    and regexp_replace(pg_get_expr(i.indpred,i.indrelid),'[()[:space:]]','','g')='state=''active''::text'),1,
  'DR-C19 one valid partial unique index permits at most one active manifest [DEC-197]');

select is(pg_temp.s11_labels('platform_private.route_manifest_version','state'),array['active','ready','superseded'],
  'DR-C20 manifest lifecycle is the closed sealed-artifact three-state set [BE04a registry]');
select is(pg_temp.s11_labels('platform_private.publication_projection','state'),
  array['active','blocked','building','failed_retryable','ready','revoked','superseded'],
  'DR-C21 projection retains its distinct exact seven states [BE04c registry]');
select ok(pg_temp.dr_check(t,fragments) is not null,label)
from (values
  ('platform_private.route_manifest_version',array['version_no > 0'],'DR-C22 positive manifest ordinal CHECK is validated'),
  ('platform_private.route_manifest_version',array['publication_set_hash','^[a-f0-9]{64}$'],'DR-C23 lowercase hex64 publication-set hash CHECK is validated'),
  ('platform_private.route_manifest_version',array['state','ready','activated_at IS NULL'],'DR-C24 ready has no activation instant CHECK'),
  ('platform_private.route_manifest_version',array['state','ready','activated_at IS NOT NULL'],'DR-C25 active/superseded require an activation CHECK'),
  ('platform_private.route_manifest_version',array['activated_at >= generated_at'],'DR-C26 activation cannot precede generation CHECK'),
  ('platform_private.publication_projection',array['render_payload','jsonb_typeof','object'],'DR-C27 render payload is a JSON object CHECK'),
  ('platform_private.publication_projection',array['required_refs','jsonb_typeof','array'],'DR-C28 required refs is a JSON array CHECK'),
  ('platform_private.publication_projection',array['render_hash','^[a-f0-9]{64}$'],'DR-C29 render hash lowercase hex64 CHECK'),
  ('platform_private.publication_projection',array['discovery_hash','^[a-f0-9]{64}$'],'DR-C30 discovery hash lowercase hex64 CHECK'),
  ('platform_private.publication_projection',array['version > 0'],'DR-C31 positive projection version CHECK')) q(t,fragments,label);

select is(pg_temp.dr_diag(pg_temp.dr_manifest_sql('bad-manifest',overrides)),
  '23514:' || coalesce(pg_temp.dr_check('platform_private.route_manifest_version',fragments),'<missing-check>'),label)
from (values
  ('{"version_no":0}'::jsonb,array['version_no > 0'],'DR-C32 zero global ordinal fails its CHECK'),
  ('{"version_no":-1}',array['version_no > 0'],'DR-C33 negative global ordinal fails its CHECK'),
  ('{"publication_set_hash":"ABC"}',array['publication_set_hash','^[a-f0-9]{64}$'],'DR-C34 malformed manifest hash fails its CHECK'),
  (jsonb_build_object('publication_set_hash',repeat('A',64)),array['publication_set_hash','^[a-f0-9]{64}$'],'DR-C35 uppercase manifest hash fails its CHECK'),
  ('{"state":"building","activated_at":"2026-10-16T12:00:00Z"}',array['state','superseded'],'DR-C36 projection-building is not a sealed manifest state'),
  ('{"state":"draft","activated_at":"2026-10-16T12:00:00Z"}',array['state','superseded'],'DR-C37 candidate draft is not a sealed manifest state'),
  ('{"activated_at":"2026-10-16T12:01:00Z"}',array['state','ready','activated_at IS NULL'],'DR-C38 ready plus activation fails the intended shape CHECK')) q(overrides,fragments,label);

select is(pg_temp.dr_diag(pg_temp.dr_projection_sql('bad-projection','a','manifest-a',overrides)),
  '23514:' || coalesce(pg_temp.dr_check('platform_private.publication_projection',fragments),'<missing-check>'),label)
from (values
  ('{"render_payload":[]}'::jsonb,array['render_payload','jsonb_typeof','object'],'DR-C39 array render payload fails object CHECK'),
  ('{"render_payload":"scalar"}',array['render_payload','jsonb_typeof','object'],'DR-C40 scalar render payload fails object CHECK'),
  ('{"required_refs":{}}',array['required_refs','jsonb_typeof','array'],'DR-C41 object required refs fails array CHECK'),
  ('{"render_hash":"bad"}',array['render_hash','^[a-f0-9]{64}$'],'DR-C42 bad render hash fails its CHECK'),
  (jsonb_build_object('discovery_hash',repeat('A',64)),array['discovery_hash','^[a-f0-9]{64}$'],'DR-C43 uppercase discovery hash fails its CHECK'),
  ('{"state":"converged"}',array['state','superseded'],'DR-C44 aggregate converged is not a projection storage state'),
  ('{"version":0}',array['version > 0'],'DR-C45 zero projection version fails its CHECK')) q(overrides,fragments,label);

-- jsonb_to_record maps JSON null to SQL NULL. Test the actual NOT NULL boundary,
-- including the reported column; do not falsely call it an object/array CHECK.
select is(r->>'state' || ':' || coalesce(r->>'constraint','') || ':' || coalesce(r->>'column',''),
  '23502::' || col,'DR-C46 manifest required column rejects SQL NULL: ' || col)
from unnest(array['id','version_no','publication_set_hash','state','generated_at']) col
cross join lateral (select pg_temp.dr_result(pg_temp.dr_manifest_sql('null-manifest',
  jsonb_build_object(col,null))) r) q;
select is(r->>'state' || ':' || coalesce(r->>'constraint','') || ':' || coalesce(r->>'column',''),
  '23502::' || col,'DR-C47 projection required column rejects SQL NULL: ' || col)
from unnest(array['id','publication_id','route_manifest_id','locale','audience','render_payload','render_hash',
  'discovery_hash','required_refs','state','version','created_at','updated_at']) col
cross join lateral (select pg_temp.dr_result(pg_temp.dr_projection_sql('null-projection','a','manifest-a',
  jsonb_build_object(col,null))) r) q;

select is(pg_temp.dr_diag(pg_temp.dr_projection_sql('empty-labels','a','manifest-a','{"locale":"","audience":""}')),
  '00000:','DR-C48 registry imposes varchar maxima without invented locale/audience minima or grammar');
select is(pg_temp.dr_diag(pg_temp.dr_projection_sql('max-labels','a','manifest-a',
  jsonb_build_object('locale',repeat('x',16),'audience',repeat('x',48)))),
  '00000:','DR-C49 exact locale16/audience48 maxima are accepted by the real table');
select is(pg_temp.dr_diag(pg_temp.dr_projection_sql('long-locale','a','manifest-a',
  jsonb_build_object('locale',repeat('x',17)))),'22001:',
  'DR-C50 locale17 fails actual varchar16 assignment with string-data-right-truncation and no constraint identity');
select is(pg_temp.dr_diag(pg_temp.dr_projection_sql('long-audience','a','manifest-a',
  jsonb_build_object('audience',repeat('x',49)))),'22001:',
  'DR-C51 audience49 fails actual varchar48 assignment with string-data-right-truncation and no constraint identity');
select is(pg_temp.dr_diag(pg_temp.dr_projection_sql('json-values','a','manifest-a',
  '{"version":2,"render_payload":{"nested":{"array":[null,true,4,"value",{}]}},"required_refs":[null,true,4,"value",{}]}')),
  '00000:','DR-C52 valid JSON values inside required object/array have no invented error-details restrictions');
select is(pg_temp.dr_diag(pg_temp.dr_projection_sql('all-projection-states','a','manifest-a',jsonb_build_object('state',state,'version',2))),
  '00000:','DR-C53 actual projection storage accepts registered state ' || state)
from unnest(array['building','ready','blocked','failed_retryable','active','superseded','revoked']) state;
select is(pg_temp.dr_diag(pg_temp.dr_manifest_sql('wrong-manifest-state',
  jsonb_build_object('state',state,'activated_at','2026-10-16T12:00:00Z'))),
  '23514:' || coalesce(pg_temp.dr_check('platform_private.route_manifest_version',array['state','superseded']),'<missing-state-check>'),
  'DR-C54 actual manifest storage refuses non-artifact state ' || state)
from unnest(array['review','approved','blocked','failed_retryable','revoked']) state;
