-- CMS-03C-19 retryable failure on e5: the workflow-policy evidence of the bound content type is unavailable (NULL: fail closed,
-- DEPENDENCY_UNAVAILABLE), so the run takes the 15 s retry step; the schedule is claimed again once due and then completes.
-- Isolated NEGATIVE fault, never positive evidence: the test-admin replaces the source of ONE existing function for this transaction
-- and restores it; no policy-row DML, no grant, no ownership change, no trigger toggle, no fake approval.
select pg_temp.s12gb_fault_on();
select pg_temp.s12gb_exec('x-e5-fault', pg_temp.s12gb_sid('e5'), pg_temp.s12gb_cver('e5'), pg_temp.s12gb_lease('e5'));
select is(pg_temp.s12gb_fault_off()::text, 'true', 'control: the policy-evidence resolver is restored byte for byte after the fault [P2-S12-AC-152]');
select ok(pg_temp.s12gb_sout('x-e5-fault') = 'ok'
    and pg_temp.s12gb_sbody('x-e5-fault') = jsonb_build_object('scheduleId', pg_temp.s12gb_sid('e5'), 'outcome', 'failed_retryable',
          'reasonCode', null, 'actualUtc', null, 'deviationSeconds', null),
  'a dependency that is unavailable (NULL policy evidence) is the retryable class: the run answers failed_retryable [P2-S12-AC-152]');
select ok(
  (select schedule.state = 'failed_retryable' and schedule.attempt_count = 1 and schedule.version = 3
          and schedule.lease_id is null and schedule.lease_until is null and schedule.reason_code is null
          and schedule.actual_at_utc is null
          and schedule.next_attempt_at between clock_timestamp() + interval '10 seconds' and clock_timestamp() + interval '16 seconds'
     from platform_private.cms_governed_activation_schedules schedule where schedule.review_id = pg_temp.s12ga_review('e5'))
  and (select subject.state = 'scheduled' and subject.lifecycle_version = 4
         from platform_private.cms_template_versions subject where subject.id = pg_temp.s12ga_subject('e5'))
  and pg_temp.s12gb_events('e5') = 0
  and (select count(*) = 1 from audit_private.audit_events
        where action = 'cms.governed.schedule.retry' and target_id = pg_temp.s12gb_sid('e5')),
  'the first failure sets attempt_count 1 and the 15 s retry step, releases the lease, keeps the subject scheduled, emits no event and writes one audit record [P2-S12-AC-152]');
select pg_temp.s12gb_claim('claim-4');
select pg_temp.s12gb_exec('x-e5-stale', pg_temp.s12gb_sid('e5'), pg_temp.s12gb_cver('e5'), pg_temp.s12gb_lease('e5'));
select ok(pg_temp.s12gb_sbody('claim-4') = '[]'::jsonb and pg_temp.s12gb_sout('x-e5-stale') = 'P0001:CONFLICT',
  'a failed_retryable schedule is not claimed before its retry instant, and the released lease no longer authorizes an execution [P2-S12-AC-152]');
select pg_sleep(16);
select pg_temp.s12gb_claim('claim-5');
select ok(jsonb_array_length(pg_temp.s12gb_sbody('claim-5')) = 1
    and pg_temp.s12gb_sbody('claim-5')->0->>'reviewId' = pg_temp.s12ga_review('e5')::text
    and pg_temp.s12gb_sbody('claim-5')->0->>'scheduleVersion' = '4'
    and pg_temp.s12gb_sbody('claim-5')->0->>'leaseId' <> pg_temp.s12gb_lease('e5')::text
    and (select schedule.state = 'executing' and schedule.attempt_count = 1 and schedule.next_attempt_at is null
         from platform_private.cms_governed_activation_schedules schedule where schedule.review_id = pg_temp.s12ga_review('e5')),
  'once due the retry is claimed again with a NEW lease at schedule version 4, keeping its attempt count [P2-S12-AC-152]');
select pg_temp.s12gb_exec('x-e5-retry', pg_temp.s12gb_sid('e5'), pg_temp.s12gb_sbody('claim-5')->0->>'expectedVersion',
  (pg_temp.s12gb_sbody('claim-5')->0->>'leaseId')::uuid);
select ok(pg_temp.s12gb_sout('x-e5-retry') = 'ok' and pg_temp.s12gb_sbody('x-e5-retry')->>'outcome' = 'completed'
    and (select schedule.state = 'completed' and schedule.version = 5 and schedule.attempt_count = 1 and schedule.lease_id is null
         from platform_private.cms_governed_activation_schedules schedule where schedule.review_id = pg_temp.s12ga_review('e5'))
    and (select subject.state = 'active' and subject.lifecycle_version = 5
         from platform_private.cms_template_versions subject where subject.id = pg_temp.s12ga_subject('e5'))
    and pg_temp.s12gb_events('e5') = 1,
  'the retry completes the activation: schedule completed at version 5 with its attempt count, subject active, exactly one event [P2-S12-AC-152]');
