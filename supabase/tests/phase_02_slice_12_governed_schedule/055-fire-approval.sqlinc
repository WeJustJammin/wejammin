-- CMS-03C-19 terminal block approval_invalidated at fire time (BE03c Scheduled activation: the execution re-reads the review as
-- `approved` with its live qualifying approvals): eb is approved by rev2 and scheduled; the cms.reviewer grant of rev2 then lapses by the
-- calendar (lag fixture 002-lapse-helpers: the term passes without any write), so rev2's standing authority is lost and the approval
-- no longer counts when the schedule falls due.  (Since P2-S12-AC-204 every authority loss that has an event - the CMS-03A-17 revocation, a
-- grant or tenure UPDATE or DELETE - invalidates the review and cancels the schedule in its own transaction, so the lag the execution must
-- catch is a loss no trigger covers.)  The suite waits for the schedule to fall due on the real clock; the lapse writes nothing.
select pg_temp.s12gb_approved('eb', array['typeA'], 'rev2');
create temp table s12gb_clock_eb(started timestamptz not null) on commit drop;
insert into s12gb_clock_eb(started) values (clock_timestamp());
select ok(not pg_temp.s12gb_lineage_lock_held('eb'),
  'control: before the schedule command the transaction holds no advisory lock of the eb lineage [P2-S12-AC-087]');
select pg_temp.s12gb_act('sch-eb', 'owner', pg_temp.s12ga_review('eb'), 'schedule', p_after => interval '62 seconds');
select ok(pg_temp.s12ga_out('sch-eb') = 'ok' and pg_temp.s12gb_lineage_lock_held('eb'),
  'a committed schedule command holds the lineage advisory lock, last in the lock order, so it serializes with an activation of the same lineage (BE03c 1326, 1348) [P2-S12-AC-087]');
select pg_temp.s12fr_lapse(pg_temp.s09d_id('ownerOrg'), pg_temp.s12ga_person('rev2'), 'cms.reviewer');
select ok(pg_temp.s12ga_approvals(pg_temp.s12ga_review('eb')) = 0
    and (select schedule.state = 'pending' from platform_private.cms_governed_activation_schedules schedule where schedule.review_id = pg_temp.s12ga_review('eb')),
  'control: the cms.reviewer grant of rev2, the only approver of eb, lapsed by the calendar after eb was scheduled: the schedule is still pending and the live recount is 0 [P2-S12-AC-146]');
select pg_sleep(greatest(0, 64 - extract(epoch from (clock_timestamp() - (select started from s12gb_clock_eb)))));
select pg_temp.s12gb_claim('claim-eb');
select pg_temp.s12gb_exec('x-eb', pg_temp.s12gb_sid('eb'), pg_temp.s12gb_claimed('claim-eb', 'eb')->>'expectedVersion',
  (pg_temp.s12gb_claimed('claim-eb', 'eb')->>'leaseId')::uuid);
select ok(pg_temp.s12ga_out('sch-eb') = 'ok' and jsonb_array_length(pg_temp.s12gb_sbody('claim-eb')) = 1
    and pg_temp.s12gb_sout('x-eb') = 'ok'
    and pg_temp.s12gb_sbody('x-eb') = jsonb_build_object('scheduleId', pg_temp.s12gb_sid('eb'), 'outcome', 'blocked',
          'reasonCode', 'approval_invalidated', 'actualUtc', null, 'deviationSeconds', null)
    and (select schedule.state = 'blocked' and schedule.reason_code = 'approval_invalidated' and schedule.version = 3
            and schedule.lease_id is null and schedule.lease_until is null and schedule.actual_at_utc is null
            and schedule.attempt_count = 0
       from platform_private.cms_governed_activation_schedules schedule where schedule.review_id = pg_temp.s12ga_review('eb'))
  and (select subject.state = 'blocked' and subject.lifecycle_version = 5 and subject.activated_at is null
         from platform_private.cms_template_versions subject where subject.id = pg_temp.s12ga_subject('eb'))
  and (select review.state = 'approved' and review.version = 2 and review.activated_at is null
         from platform_private.cms_governed_reviews review where review.id = pg_temp.s12ga_review('eb'))
  and pg_temp.s12gb_events('eb') = 0
  and (select count(*) = 1 from audit_private.audit_events
        where action = 'cms.governed.schedule.block' and target_id = pg_temp.s12gb_sid('eb')),
  'an approval that stopped counting between acceptance and fire blocks the schedule approval_invalidated: schedule blocked, subject blocked (lifecycle 5), the review untouched, no event, one audit record [P2-S12-AC-146]');
-- blocked -> draft: the recheck of a new CMS-03C-09 command finds the approval dead and commits the invalidation
select pg_temp.s12gb_act('eb-again', 'owner', pg_temp.s12ga_review('eb'), 'schedule', p_after => interval '600 seconds');
select ok(pg_temp.s12ga_out('eb-again') = 'ok'
    and pg_temp.s12ga_body('eb-again') = '{"kind": "refusal", "details": {}, "reasonCode": "dependency_changed"}'::jsonb
    and (select review.state = 'invalidated' and review.invalidated_reason = 'reviewer_authority_changed' and review.version = 3
         from platform_private.cms_governed_reviews review where review.id = pg_temp.s12ga_review('eb'))
    and (select subject.state = 'draft' and subject.lifecycle_version = 6
         from platform_private.cms_template_versions subject where subject.id = pg_temp.s12ga_subject('eb'))
    and (select count(*) = 1 from platform_private.cms_governed_activation_schedules schedule
          where schedule.review_id = pg_temp.s12ga_review('eb'))
    and pg_temp.s12gb_events('eb') = 0,
  'a new schedule command on the blocked subject whose approval is dead commits the invalidation (blocked -> draft, lifecycle 6) and creates no second schedule [P2-S12-AC-146]');
select pg_temp.s12fr_restore();
