-- cmsLocaleVariantRead function shape and grants (DEC-205; BE03c route registry, catalog; tracker P2-S12-AC-057).
-- The private reader and its Worker transport follow the DEC-195 read precedent: definer-owned, empty search_path,
-- the transport executable by service_role only, nothing by anon, authenticated or PUBLIC.

select ok(coalesce((select p.prosecdef and pg_get_userbyid(p.proowner) = 'wejammin_cms_definer'
                        and coalesce(p.proconfig, array[]::text[]) @> array['search_path=""']
                        and not has_function_privilege('anon', p.oid, 'execute')
                        and not has_function_privilege('authenticated', p.oid, 'execute')
                        and not has_function_privilege('service_role', p.oid, 'execute')
                        and not exists (select 1 from aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) acl
                                         where acl.grantee = 0 and acl.privilege_type = 'EXECUTE')
                   from pg_proc p where p.oid = to_regprocedure('platform_private.cms_get_locale_variant(jsonb)')), false),
  'cms_get_locale_variant is a private SECURITY DEFINER function of the CMS definer, empty search_path, no API-role execute [P2-S12-AC-057]');
select is(pg_get_function_result(to_regprocedure('platform_private.cms_get_locale_variant(jsonb)')), 'jsonb',
  'the private reader answers jsonb [P2-S12-AC-057]');
select ok(coalesce((select p.prosecdef and pg_get_userbyid(p.proowner) = 'wejammin_cms_definer'
                        and coalesce(p.proconfig, array[]::text[]) @> array['search_path=""']
                        and has_function_privilege('service_role', p.oid, 'execute')
                        and not has_function_privilege('anon', p.oid, 'execute')
                        and not has_function_privilege('authenticated', p.oid, 'execute')
                        and not exists (select 1 from aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) acl
                                         where acl.grantee = 0 and acl.privilege_type = 'EXECUTE')
                   from pg_proc p where p.oid = to_regprocedure('platform_api.cms_get_locale_variant(jsonb)')), false),
  'the Worker transport platform_api.cms_get_locale_variant is definer-owned, empty search_path and service_role-only [P2-S12-AC-057]');
select ok(coalesce(has_function_privilege('wejammin_cms_definer', to_regprocedure('platform_private.cms_get_locale_variant(jsonb)'), 'execute'), false),
  'the private reader is executable by its definer, which the transport runs as [P2-S12-AC-057]');
select is((select count(*)::integer from pg_proc proc join pg_namespace ns on ns.oid = proc.pronamespace
            where ns.nspname = 'platform_api' and proc.proname = 'cms_get_locale_variant'), 1,
  'exactly one transport overload exists [P2-S12-AC-057]');
select is((select count(*)::integer from pg_proc proc join pg_namespace ns on ns.oid = proc.pronamespace
            where ns.nspname = 'platform_private' and proc.proname = 'cms_get_locale_variant'), 1,
  'exactly one private overload exists [P2-S12-AC-057]');
select is(coalesce(pg_catalog.pg_get_functiondef(to_regprocedure('platform_private.cms_get_locale_variant(jsonb)')) !~* '\m(insert\s+into|update\s+platform_private|delete\s+from)', false), true,
  'the reader contains no insert, update or delete statement: a read writes nothing [P2-S12-AC-057]');
select is(coalesce(pg_catalog.pg_get_functiondef(to_regprocedure('platform_private.cms_get_locale_variant(jsonb)')) !~* 'for\s+(update|share|no key update|key share)', false), true,
  'the reader takes no row lock: a read locks nothing [P2-S12-AC-057]');
select is(coalesce(pg_catalog.pg_get_functiondef(to_regprocedure('platform_private.cms_get_locale_variant(jsonb)')) ~ 'cms_locale_resolutions', false), true,
  'the resolutions come from the CMS-03C-20 resolver core, not a second implementation [P2-S12-AC-152]');
select is(coalesce(pg_catalog.pg_get_functiondef(to_regprocedure('platform_private.cms_get_locale_variant(jsonb)')) ~ 'cms_require_entry_capability', false), true,
  'the authority is the CMS-03C-04 helper, not a copy [P2-S12-AC-270]');
