-- Second-pass A04 activation regressions: complete-set binding, exact block
-- lifecycle, plan creation evidence, worker review freshness, and move races.
select set_config('app.cms_rpc', 'true', true);
select set_config('app.cfg_rpc', 'true', true);

-- Build a review candidate whose artifact contains one exact field.  The
-- persisted graph is intentionally changed after the artifact is compiled.
insert into platform_private.cms_content_type_versions(
  id, owner_id, state, version, content_type_id, version_no, labels,
  workflow_key, workflow_version, source_locale, default_locale,
  supported_locales, fallback_chains, locale_config_hash,
  schema_artifact_id, definition_hash, compatibility, dry_run_id, created_by
) values (
  'a9090000-0000-4000-8000-000000000150',
  (select owner_id from platform_private.cms_content_type_versions
   where id = (select version_id from s09_type_ids)),
  'review', 1, (select content_type_id from s09_type_ids), 5,
  '{"label":"Article X exact"}'::jsonb, 'editorial', 1, 'en-US', 'en-US',
  '["en-US"]'::jsonb, '{}'::jsonb, '604d53ba01396a82109c25c8a156b96d1ccf3af7cda0777b55579ef6d1a38860',
  'a9090000-0000-4000-8000-000000000151', repeat('9', 64), 'conditional',
  'a9090000-0000-4000-8000-000000000405',
  'a9090000-0000-4000-8000-000000000001'
);
insert into platform_private.cms_field_definition_versions(
  id, owner_id, state, version, content_type_version_id, stable_field_id,
  field_key, kind, constraints, required, default_mode, localization_mode,
  editor_config, created_by
) values (
  'a9090000-0000-4000-8000-000000000152',
  (select owner_id from platform_private.cms_content_type_versions
   where id = 'a9090000-0000-4000-8000-000000000150'),
  'active', 1, 'a9090000-0000-4000-8000-000000000150',
  'a9090000-0000-4000-8000-000000000152', 'title', 'short_text', '{}'::jsonb,
  false, 'none', 'none', '{"label":"Title","order":0}'::jsonb,
  'a9090000-0000-4000-8000-000000000001'
);
insert into platform_private.cms_schema_artifacts(
  id, owner_id, state, version, content_type_version_id, compiler_version,
  zod_contract_ref, editor_manifest, renderer_manifest, artifact_hash, compiled_at
) values (
  'a9090000-0000-4000-8000-000000000151',
  (select owner_id from platform_private.cms_content_type_versions
   where id = 'a9090000-0000-4000-8000-000000000150'),
  'compiled', 1, 'a9090000-0000-4000-8000-000000000150', '1',
  'cms/content-type/articlex/v1',
  jsonb_build_object(
    'schema', jsonb_build_object(
      'typeKey', 'articlex', 'label', 'Article X exact',
      'ownerCapability', 'cms.schema_designer', 'sourceLocale', 'en-US',
      'defaultLocale', 'en-US', 'workflowKey', 'editorial',
      'workflowVersion', '1', 'defaultTemplateVersionId', null,
      'fields', jsonb_build_array(jsonb_build_object(
        'stableFieldId', 'a9090000-0000-4000-8000-000000000152',
        'key', 'title', 'kind', 'short_text', 'constraints', '{}'::jsonb,
        'required', false, 'validatorKey', null, 'validatorVersion', null,
        'defaultMode', 'none', 'localizationMode', 'none',
        'editorConfig', jsonb_build_object('label', 'Title', 'order', 0),
        'lifecycle', 'active'
      )),
      'relations', '[]'::jsonb, 'templateBindings', '[]'::jsonb,
      'capabilityBindings', '[]'::jsonb
    ),
    'fields', jsonb_build_array(jsonb_build_object(
      'stableFieldId', 'a9090000-0000-4000-8000-000000000152',
      'key', 'title', 'kind', 'short_text', 'constraints', '{}'::jsonb,
      'required', false, 'validatorKey', null, 'validatorVersion', null,
      'defaultMode', 'none', 'localizationMode', 'none',
      'editorConfig', jsonb_build_object('label', 'Title', 'order', 0),
      'lifecycle', 'active'
    ))
  ),
  jsonb_build_object(
    'relations', '[]'::jsonb, 'templateBindings', '[]'::jsonb,
    'capabilityBindings', '[]'::jsonb
  ), repeat('9', 64), clock_timestamp()
);
select ok(
  platform_private.cms_activation_references_valid(
    'a9090000-0000-4000-8000-000000000150'
  ),
  'AC095 exact artifact and persisted graph pass before an extra child appears'
);
create or replace function pg_temp.s09_forged_graph_invalid(p_sql text) returns boolean language plpgsql as $forge$
declare result boolean;
begin
  begin
    execute p_sql;
    result := not platform_private.cms_activation_references_valid('a9090000-0000-4000-8000-000000000150');
    raise exception 'S09_ROLLBACK';
  exception when others then
    if sqlerrm = 'S09_ROLLBACK' then return result; end if;
    raise;
  end;
end;
$forge$;
select ok(
  pg_temp.s09_forged_graph_invalid($forge$
insert into platform_private.cms_field_definition_versions(
  id, owner_id, state, version, content_type_version_id, stable_field_id,
  field_key, kind, constraints, required, default_mode, localization_mode,
  editor_config, created_by
) values (
  'a9090000-0000-4000-8000-000000000153',
  (select owner_id from platform_private.cms_content_type_versions
   where id = 'a9090000-0000-4000-8000-000000000150'),
  'active', 1, 'a9090000-0000-4000-8000-000000000150',
  'a9090000-0000-4000-8000-000000000153', 'subtitle', 'short_text', '{}'::jsonb,
  false, 'none', 'none', '{"label":"Subtitle","order":1}'::jsonb,
  'a9090000-0000-4000-8000-000000000001'
);
  $forge$),
  'AC095 rejects an extra persisted field outside the artifact manifest [P2-S09-AC-095]'
);
select ok(
  pg_temp.s09_forged_graph_invalid($forge$
insert into platform_private.cms_content_type_capability_bindings(
  id, owner_id, state, version, content_type_version_id,
  capability_key, capability_version
) values (
  'a9090000-0000-4000-8000-000000000154',
  (select owner_id from platform_private.cms_content_type_versions
   where id = 'a9090000-0000-4000-8000-000000000150'),
  'active', 1, 'a9090000-0000-4000-8000-000000000150',
  'cms.schema_designer', 1
);
  $forge$),
  'AC095 rejects an extra persisted capability binding outside the manifest'
);
select ok(
  pg_temp.s09_forged_graph_invalid($forge$
insert into platform_private.cms_relation_definitions(
  id, owner_id, state, version, field_definition_id, target_kind, target_type,
  projection_key, cardinality, min_count, max_count, ordered, on_unavailable,
  created_by
) values (
  'a9090000-0000-4000-8000-000000000157',
  (select owner_id from platform_private.cms_content_type_versions
   where id = 'a9090000-0000-4000-8000-000000000150'),
  'active', 1, 'a9090000-0000-4000-8000-000000000152', 'content', 'profile',
  'profile.summary', 'one', 0, 1, false, 'omit',
  'a9090000-0000-4000-8000-000000000001'
);
  $forge$),
  'AC095 rejects an extra persisted relation outside the artifact manifest [P2-S09-AC-095]'
);
select ok(
  pg_temp.s09_forged_graph_invalid($forge$
insert into platform_private.cms_content_type_template_bindings(
  id, owner_id, state, version, content_type_version_id,
  template_version_id, position
) values (
  'a9090000-0000-4000-8000-000000000158',
  (select owner_id from platform_private.cms_content_type_versions
   where id = 'a9090000-0000-4000-8000-000000000150'),
  'active', 1, 'a9090000-0000-4000-8000-000000000150',
  'a9090000-0000-4000-8000-000000000159', 0
);
  $forge$),
  'AC095 rejects an extra persisted template binding outside the manifest [P2-S09-AC-095]'
);

select ok(
  platform_private.cms_block_reference_valid(
    jsonb_build_object('blockKey', 'hero', 'blockVersion', 2, 'lifecycle', 'supported')
  ),
  'AC095 accepts the exact currently-derived block lifecycle'
);
select ok(
  not platform_private.cms_block_reference_valid(
    jsonb_build_object('blockKey', 'hero', 'blockVersion', 2, 'lifecycle', 'deprecated')
  )
  and not platform_private.cms_block_reference_valid(
    jsonb_build_object('blockKey', 'hero', 'blockVersion', 1, 'lifecycle', 'withdrawn')
  ),
  'AC095 rejects an unregistered block version and a withdrawn lifecycle [P2-S09-AC-095]'
);

-- A conditional plan exists only because CMS-03A-10 produced it, and activation
-- only advances it.  A missing or stand-in dry-run report is refused.
select throws_ok(
  format($q$select platform_private.cms_advance_activation_plan(
    %1$L::uuid, %2$L::uuid, null, 'a9090000-0000-4000-8000-000000000405'::uuid)$q$,
    'a9090000-0000-4000-8000-000000000150', :'y_version'),
  'P0001', 'VALIDATION_FAILED',
  'AC099 conditional plan advance requires a persisted independent dry-run report [P2-S09-AC-099]'
);
select throws_ok(
  format($q$select platform_private.cms_advance_activation_plan(
    %1$L::uuid, %2$L::uuid, null, %1$L::uuid)$q$,
    'a9090000-0000-4000-8000-000000000150', :'y_version'),
  'P0001', 'VALIDATION_FAILED',
  'AC096 rejects a candidate UUID used as its own dry-run evidence ID [P2-S09-AC-096]'
);

-- A real conditional successor with no affected rows: the clone is sealed
-- additively, its title constraint is tightened under that ready plan, and the
-- conditional attempt names the registered transform.
select pg_temp.s09d_guc_save();
select pg_temp.s09d_create_type('cn0', 'articlecn0');
select pg_temp.s09d_to_active('cn0');
select pg_temp.s09d_successor('cnd', 'cn0');
select pg_temp.s09d_dry_run('cnd');
select pg_temp.s09d_seal('cnd');
select pg_temp.s09w_tighten('cnd', 100);
select pg_temp.s09d_dry_run('cnd', 'owner', 'identity.revalidate', '1');
select pg_temp.s09w_dry_run('cnd');
select pg_temp.s09d_guc_restore();
select set_config('app.cms_rpc', 'true', true);
select is(
  platform_private.cms_advance_activation_plan(
    pg_temp.s09d_id('cnd:version'), pg_temp.s09d_id('cn0:version'),
    pg_temp.s09d_id('cnd:plan'), pg_temp.s09d_id('cnd:dryRun')),
  pg_temp.s09d_id('cnd:plan'),
  'AC099 advances a conditional plan only after exact sealed report evidence [P2-S09-AC-099]'
);
select ok(
  (select classification = 'conditional'
      and transform_key = 'identity.revalidate'
      and transform_version = 1
      and state = 'completed'
   from platform_private.cms_schema_migration_plans
   where id = pg_temp.s09d_id('cnd:plan')),
  'AC099 persists the conditional plan and advances its zero-row state'
);

-- Worker evidence is the real CMS review chain: a candidate approved through
-- the named producers is valid for the worker hand-off until the evidence
-- drifts.  An earlier decision's MFA age is NOT re-required (DEC-108 G10), so a
-- stale binding never invalidates a recorded approval.
select pg_temp.s09d_guc_save();
select pg_temp.s09d_create_type('wk', 'articlewk');
select pg_temp.s09d_to_approved('wk', array['rev1']);
select pg_temp.s09d_guc_restore();
select set_config('app.cms_rpc', 'true', true);
select set_config('app.cfg_rpc', 'true', true);
select ok(
  platform_private.cms_worker_human_approval_valid(pg_temp.s09d_id('wk:version')),
  'AC102 worker accepts a real approved CMS review with current assignment authority'
);
update platform_private.acting_context_binding
set last_seen_at = clock_timestamp() - interval '11 minutes'
where id = pg_temp.s09d_actor_id('rev1', 'binding')::uuid
   or id = pg_temp.s09d_actor_id('owner', 'binding')::uuid;
select ok(
  platform_private.cms_worker_human_approval_valid(pg_temp.s09d_id('wk:version')),
  'AC102 worker does not re-require MFA freshness for a recorded decision'
);
update platform_private.acting_context_binding
set last_seen_at = clock_timestamp()
where id = pg_temp.s09d_actor_id('rev1', 'binding')::uuid
   or id = pg_temp.s09d_actor_id('owner', 'binding')::uuid;
update platform_private.cms_content_types
set owner_capability = 'cms.schema_registry.read'
where id = pg_temp.s09d_id('wk:type');
update platform_private.cms_content_types
set owner_capability = 'cms.schema_designer'
where id = pg_temp.s09d_id('wk:type');
select ok(
  not platform_private.cms_worker_human_approval_valid(pg_temp.s09d_id('wk:version')),
  'AC102 worker rejects an approval whose review evidence drifted and was invalidated [P2-S09-AC-102]'
);
