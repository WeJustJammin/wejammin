-- A non-zero CONDITIONAL migration through the real producer and worker
-- protocol.  Article NZ is activated by the named producers, three real entries
-- are created under its bound editorial policy, and its successor tightens the
-- title constraint.  The worker pages the affected rows, posts per-row evidence
-- and the database derives every counter; a row the stricter constraint refuses
-- blocks the plan.  Nothing is inserted by hand.
\ir ../phase_02_slice_09_dec108/04-worker.sqlinc
\ir ../phase_02_slice_09_dec119/00-support.sqlinc
select pg_temp.s09d_guc_save();
select pg_temp.s09d_create_type('nz', 'articlenz');
select pg_temp.s09d_to_active('nz');
select pg_temp.s09g_grant('nz:author', 'owner', 'owner', 'cms.author', pg_temp.s09g_day(5));
select pg_temp.s09w_entry('nz:e1', 'nz', 'Short');
select pg_temp.s09w_entry('nz:e2', 'nz', 'A title that clearly exceeds twelve characters');
select pg_temp.s09w_entry('nz:e3', 'nz', 'Mid title');
select pg_temp.s09d_successor('nzb', 'nz');
select pg_temp.s09d_dry_run('nzb');
select pg_temp.s09w_dry_run('nzb');
select pg_temp.s09w_tighten('nzb', 12);
select pg_temp.s09d_dry_run('nzb', 'owner', 'identity.revalidate', '1');
select pg_temp.s09w_dry_run('nzb');
select pg_temp.s09d_guc_restore();
select pg_temp.set_jwt_claim('role', 'service_role', true);
-- a Worker request of its own: nothing a previous (human) command published is still set
select set_config('app.cms_session_actor', '', true), set_config('app.cms_session_party', '', true), set_config('app.mfa_session_subject', '', true);
select is(pg_temp.s09d_outcome('nz:e1') || pg_temp.s09d_outcome('nz:e2') || pg_temp.s09d_outcome('nz:e3'), 'OKOKOK',
  'S09 non-zero fixture: three real entries exist on the active source version');
select ok(
  (select state = 'blocked' and classification = 'conditional' and transform_key = 'identity.revalidate'
          and source_count = 3 and target_count = 2 and row_error_count = 1 and cursor = 3
          and migrated_count = 0 and failed_count = 0
   from platform_private.cms_schema_migration_plans where id = pg_temp.s09d_id('nzb:plan')),
  'S09 non-zero scan derives 3 source, 2 passing and 1 refused row from posted evidence and blocks the plan'
);
select ok(
  (select count(*) = 3 and count(*) filter (where error_code is not null) = 1
          and bool_and(error_code is null or error_code = 'TRANSFORM_TARGET_VIOLATION')
   from platform_private.cms_schema_dry_run_row_evidence where plan_id = pg_temp.s09d_id('nzb:plan')),
  'S09 non-zero scan stores one evidence row per source row with the refused row''s typed error code'
);
select ok(
  (select report.state = 'completed' and report.result = 'fail' and report.row_error_count = 1
          and report.source_count = 3 and report.sealed_at is not null
   from platform_private.cms_schema_dry_run_reports report where report.id = pg_temp.s09d_id('nzb:dryRun')),
  'S09 non-zero scan seals a failing report whose row-error count equals the error evidence rows'
);
create temp table s09_nz_claim on commit drop as
select pg_temp.s09w_claim('nzb') as response;
select ok(
  (select (response->>'acquired')::boolean is not true
   from s09_nz_claim)
  and (select state = 'blocked' and cursor = 3 and migrated_count = 0
       from platform_private.cms_schema_migration_plans where id = pg_temp.s09d_id('nzb:plan')),
  'S09 a blocked non-zero plan cannot be leased for backfill and stays unchanged'
);
-- definer helper called outside a command: it reads the forced tables under the RPC context, as a command does
select set_config('app.cms_rpc', 'true', true);
select ok(
  not platform_private.cms_migration_plan_ready(pg_temp.s09d_id('nzb:plan'),
    pg_temp.s09d_id('nzb:type'), pg_temp.s09d_id('nzb:version')),
  'S09 a blocked plan is never ready for activation'
);
select set_config('app.cms_rpc', '', true);
select ok(
  (select state = 'active' from platform_private.cms_content_type_versions where id = pg_temp.s09d_id('nz:version')),
  'S09 the old active version keeps serving while its successor plan is blocked'
);
