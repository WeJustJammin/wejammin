-- DEC-108 activation fixture.  The articlex candidate reaches `approved` and
-- then `active` ONLY through the named producers (dry-run -> worker seal ->
-- submit -> assign -> decide -> activate); no review, decision, dry-run,
-- approved-state or completed-plan row is inserted by hand, and no artifact is
-- rebuilt by hand.  Evidence is the CMS review chain (BE03a), never a CFG
-- setting_value review.
-- Fragment 002 leaves the session on the second tenant while proving
-- owner-scoped mutations. Restore the original actor and tenant before
-- constructing activation evidence so the gate tests reach their intended
-- step-up/approval branches instead of the candidate owner lookup.
select set_config('request.jwt.claim.role', 'authenticated', true);
select set_config('request.jwt.claim.sub', 'a9090000-0000-4000-8000-000000000001', true);
select set_config('app.auth_user_id', 'a9090000-0000-4000-8000-000000000001', true);
select set_config('app.actor_auth_user_id', 'a9090000-0000-4000-8000-000000000001', true);
select set_config('app.actor_person_id', (
  select person_id::text from identity.auth_user_bindings
  where auth_user_id = 'a9090000-0000-4000-8000-000000000001'
), true);
select set_config('app.acting_party_id', (
  select organization_id::text from s09_fixture_org
), true);
create temp table s09_activation_context on commit drop as
select 'a9090000-0000-4000-8000-000000000090'::uuid as context_id,
       (select person_id from identity.auth_user_bindings
        where auth_user_id = 'a9090000-0000-4000-8000-000000000001') as person_id,
       (select organization_id from s09_fixture_org) as organization_id;
insert into platform_private.acting_context_binding(
  id, person_id, acting_party_id, context_kind, client_binding_id,
  state, selected_at, last_seen_at, expires_at, projection_version, version
)
select context_id, person_id, organization_id, 'organization', 's09-activation-client',
       'active', clock_timestamp(), clock_timestamp(), clock_timestamp() + interval '2 hours', 1, 1
from s09_activation_context;

\ir ../phase_02_slice_09_dec108/00-helpers.sqlinc
\ir ../phase_02_slice_09_dec108/02-chain.sqlinc
\ir ../phase_02_slice_09_dec108/03-support.sqlinc
-- Actors: the fixture owner (designer, org context) plus two independently
-- authenticated reviewers (users 002/003, own person context).
select pg_temp.s09d_guc_save();
select pg_temp.s09d_legacy_owner_receipt('a9090000-0000-4000-8000-000000000001',
  (select organization_id from s09_fixture_org));
select pg_temp.s09d_legacy_actor('owner', 'a9090000-0000-4000-8000-000000000001',
  (select organization_id from s09_fixture_org), (select context_id from s09_activation_context));
select pg_temp.s09d_legacy_actor('rev1', 'a9090000-0000-4000-8000-000000000002', null);
select pg_temp.s09d_remember('x:type', (select content_type_id from s09_type_ids));
select pg_temp.s09d_remember('x:version', (select version_id from s09_type_ids));
select pg_temp.s09d_guc_restore();

-- The draft aggregate (title + related relation field) goes through the real
-- dry-run, which compiles the candidate and creates its report, plan and job.
select pg_temp.s09d_dry_run('x');
select pg_temp.s09d_seal('x');
select pg_temp.s09d_submit('x');
select pg_temp.s09d_assign('x', 'rev1');
select is(pg_temp.s09d_outcome('x:assign:rev1'), 'OK',
  'AC095 the owner assigns an independent reviewer to the frozen review');
-- First review cycle: the reviewer rejects, the candidate returns to draft and
-- the unchanged sealed evidence is frozen again as a second review.  The first
-- review's decision is foreign evidence for the final approval.
select pg_temp.s09d_decide('x', 'rev1', 'reject');
select pg_temp.s09d_remember('x:rejectDecision', pg_temp.s09d_id('x:decision:rev1'));
select ok(pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('x:review')) = 'rejected'
  and pg_temp.s09d_read('cms_content_type_versions', 'state', pg_temp.s09d_id('x:version')) = 'draft',
  'AC095 a rejection returns the candidate to an editable draft through an audited transition');
select pg_temp.s09d_submit('x');
select pg_temp.s09d_assign('x', 'rev1');
select pg_temp.s09d_decide('x', 'rev1');
select is(pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('x:review')), 'approved',
  'AC095 the independent reviewer approved the resubmitted review through CMS-03A-12');

select throws_ok(
  pg_temp.s09d_activate_sql('x', 'owner', jsonb_build_object('actingContextId', null,
    'stepUpVerified', 'true', 'stepUpAt', clock_timestamp()::text)),
  'P0001', 'STEP_UP_REQUIRED',
  'CMS-03A-04 rejects caller-supplied step-up flags without a bound server context'
);
select throws_ok(
  pg_temp.s09d_activate_sql('x', 'owner', '{}'::jsonb, jsonb_build_object(
    'approvalIds', pg_temp.s09d_approval_ids('x') || pg_temp.s09d_approval_ids('x'))),
  'P0001', 'VALIDATION_FAILED',
  'CMS-03A-04 rejects duplicate supplied approval decision IDs'
);
select throws_ok(
  pg_temp.s09d_activate_sql('x', 'owner', '{}'::jsonb, jsonb_build_object(
    'approvalIds', pg_temp.s09d_approval_ids('x') || jsonb_build_array('a9090000-0000-4000-8000-000000000999'))),
  'P0001', 'APPROVAL_INVALID',
  'CMS-03A-04 rejects an unknown extra decision ID instead of counting a subset'
);
select throws_ok(
  pg_temp.s09d_activate_sql('x', 'owner', '{}'::jsonb, jsonb_build_object(
    'approvalIds', jsonb_build_array(pg_temp.s09d_id('x:rejectDecision')))),
  'P0001', 'APPROVAL_INVALID',
  'CMS-03A-04 rejects a decision that belongs to a different (rejected) review of the candidate'
);
create temp table s09_forged_cfg_review on commit drop as select extensions.gen_random_uuid() as review_id;
select pg_temp.s09d_try(format($q$insert into platform_private.cfg_config_change_reviews(
    id, candidate_type, candidate_id, candidate_version, frozen_hash, impact_manifest,
    impact_manifest_hash, effective_context_hash, risk_class, required_approvals,
    state, submitted_by, submitted_at, version_no)
  select %1$L, 'setting_value', version.id, version.version, version.definition_hash, '{}'::jsonb,
         platform_private.cfg_hash_json('{}'::jsonb), null, 'high', 1, 'approved',
         'a9090000-0000-4000-8000-000000000001', clock_timestamp(), 1
  from platform_private.cms_content_type_versions version where version.id = %2$L$q$,
  (select review_id from s09_forged_cfg_review), (select version_id from s09_type_ids)));
select throws_ok(
  pg_temp.s09d_activate_sql('x', 'owner', '{}'::jsonb, jsonb_build_object(
    'approvalIds', jsonb_build_array((select review_id from s09_forged_cfg_review)))),
  'P0001', 'APPROVAL_INVALID',
  'CMS-03A-04 rejects a CFG setting_value review: schema approval is CMS review evidence only'
);
update platform_private.acting_context_binding
set last_seen_at = clock_timestamp() - interval '11 minutes'
where id = (select context_id from s09_activation_context);
select throws_ok(
  pg_temp.s09d_activate_sql('x'),
  'P0001', 'STEP_UP_REQUIRED',
  'CMS-03A-04 rejects an active context whose recent MFA observation is stale'
);
update platform_private.acting_context_binding
set last_seen_at = clock_timestamp()
where id = (select context_id from s09_activation_context);
select throws_ok(
  pg_temp.s09d_activate_sql('x', 'owner', '{}'::jsonb, jsonb_build_object(
    'expectedActivationEvidenceHash', repeat('f', 64))),
  'P0001', 'CONFLICT',
  'CMS-03A-04 rejects a mismatching expected activation-evidence hash'
);

-- An approval recorded long ago still counts: the ten-minute decision-age
-- shortcut is replaced (DEC-108); only the activator's own MFA is rechecked.
select pg_temp.s09d_timewarp('cms_schema_review_decisions', format($q$update platform_private.cms_schema_review_decisions
  set decided_at = decided_at - interval '30 minutes', created_at = created_at - interval '30 minutes',
      updated_at = updated_at - interval '30 minutes', mfa_verified_at = mfa_verified_at - interval '30 minutes'
  where review_id = %L$q$, pg_temp.s09d_id('x:review')));
select pg_temp.s09d_timewarp('cms_schema_reviews', format($q$update platform_private.cms_schema_reviews
  set submitted_at = submitted_at - interval '45 minutes', decided_at = decided_at - interval '30 minutes'
  where id = %L$q$, pg_temp.s09d_id('x:review')));
create temp table s09_activation_request on commit drop as
select pg_temp.s09d_activation_request('x', 'owner', jsonb_build_object('requestId', extensions.gen_random_uuid(),
  'correlationId', extensions.gen_random_uuid()), jsonb_build_object('idempotencyKey', 's09-activate-0001')) as request;
create temp table s09_activation_created on commit drop as
select pg_temp.s09d_call('x:activation', 'platform_api.cms_activate_schema', request) as response
from s09_activation_request;
select pg_temp.s09d_guc_restore();
select ok(
  (select response ?& array['id','version','contentHash','createdAt','updatedAt','contentTypeVersionId','state','activationEvidence','eventType']
   and not (response ? 'eventId')
   and response->>'state' = 'active'
   and response->>'eventType' = 'cms.schema.activated.v1'
   and response->'activationEvidence'->>'riskClass' = 'ordinary'
   and response->'activationEvidence'->>'approvalEvidenceHash' =
       (select activation_approval_evidence_hash::text
        from platform_private.cms_content_type_versions
        where id = (select version_id from s09_type_ids))
   and (response->'activationEvidence'->>'requiredDecisionCount')::integer = 1
   from s09_activation_created),
  'CMS-03A-04 resolves the approved independent human/capability and activates atomically (30-minute-old decision)'
);
select ok(
  platform_private.cms_worker_human_approval_valid(
    (select version_id from s09_type_ids)
  ),
  'CMS-03A-04 persists the full wrapped evidence hash accepted by the worker validator'
);
select ok(
  (select event.payload->'activationEvidence'->>'riskClass' = 'ordinary'
      and event.payload->'activationEvidence'->>'approvalEvidenceHash' =
          response->'activationEvidence'->>'approvalEvidenceHash'
      and event.payload->'activationEvidence'->>'approvalEvidenceHash' =
          (select activation_approval_evidence_hash::text
           from platform_private.cms_content_type_versions
           where id = (select version_id from s09_type_ids))
   from platform_private.outbox_events event
   cross join s09_activation_created response
   where event.event_type = 'cms.schema.activated.v1'
     and event.aggregate_id = (select version_id from s09_type_ids)
   order by event.occurred_at desc, event.id desc
   limit 1),
  'CMS-03A-04 event carries the persisted outer activation-evidence hash and risk class [P2-S09-AC-101]'
);
select ok(
  (select resource->'activationEvidence'->>'riskClass' = 'ordinary'
      and resource->'activationEvidence'->>'approvalEvidenceHash' =
          (select activation_approval_evidence_hash::text
           from platform_private.cms_content_type_versions
           where id = (select version_id from s09_type_ids))
   from platform_private.cms_type_version_resource(
     (select version_id from s09_type_ids)
   ) resource),
  'CMS-03A-04 resource exposes the persisted outer activation-evidence hash and risk class'
);
select pg_temp.s09d_session('owner');
select ok(
  (select response is not null
     and pg_temp.s09d_call('x:replay', 'platform_api.cms_activate_schema', request) = response
   from s09_activation_created cross join s09_activation_request),
  'CMS-03A-04 replay returns the exact original activation resource'
);
select is(
  (select count(*)::integer from platform_private.outbox_events
   where event_type = 'cms.schema.activated.v1'
     and aggregate_id = (select version_id from s09_type_ids)),
  1,
  'CMS-03A-04 commits one activation outbox event and does not duplicate it on replay [P2-S09-AC-101]'
);
select throws_ok(
  pg_temp.s09d_activate_sql('x', 'owner', '{}'::jsonb, jsonb_build_object(
    'approvalIds', jsonb_build_array('a9090000-0000-4000-8000-000000000999'))),
  'P0001', 'CONFLICT',
  'CMS-03A-04 stale active candidate is rejected after the one-shot CAS [P2-S09-AC-097]'
);
select pg_temp.s09d_guc_restore();
