select ok(
  (select response->>'nextCursor' is not null and response->>'nextCursor' !~ E'[\\r\\n]' from s09_cursor_page),
  'CMS-03A-06 emits a bounded newline-free opaque cursor'
);
select ok(
  (select (next_page.response->'items'->0->>'id') is distinct from (first_page.response->'items'->0->>'id')
   from s09_cursor_page first_page
   cross join lateral (
     select platform_api.cms_list_content_types(jsonb_build_object(
       'limit', 1, 'sort', 'key', 'direction', 'asc', 'cursor', first_page.response->>'nextCursor'
     )) as response
   ) next_page),
  'CMS-03A-06 advances deterministically past the cursor boundary'
);
select throws_ok(
  $$select platform_api.cms_list_content_types(jsonb_build_object(
    'limit', 1, 'sort', 'key', 'direction', 'desc',
    'cursor', (select response->>'nextCursor' from s09_cursor_page)
  ))$$,
  'P0001', 'INVALID_REQUEST',
  'CMS-03A-06 rejects a cursor reused with different sort direction or scope'
);

-- The migration plan is created by CMS-03A-10 (the dry-run producer); the worker
-- protocol below advances only that plan.  Version 2 of Article X is the real
-- successor draft of the activated version 1: nothing is inserted by hand.
select pg_temp.s09d_guc_save();
select pg_temp.s09d_successor('y', 'x');
select pg_temp.s09d_dry_run('y');
select pg_temp.s09d_guc_restore();
select is(pg_temp.s09d_outcome('y:successor') || pg_temp.s09d_outcome('y:dryRun'), 'OKOK',
  'S09 fixture: CMS-03A-09 and CMS-03A-10 produce the version 2 candidate and its migration plan');
select pg_temp.s09d_id('y:version') as y_version, pg_temp.s09d_id('y:plan') as y_plan,
       pg_temp.s09d_id('y:dryRun') as y_dry_run \gset
-- definer helper called outside a command: it reads the forced tables under the RPC context, as a command does
select set_config('app.cms_rpc', 'true', true);
select ok(
  not platform_private.cms_migration_plan_ready(
    :'y_plan', (select content_type_id from s09_type_ids), :'y_version'
  ),
  'S09 readiness rejects a plan before its independent producer report is sealed'
);
select set_config('app.cms_rpc', '', true);

-- The worker contract is executable, not catalog-only. Exercise the full
-- service-role sequence against the real zero-row plan so every transition
-- remains deterministic while proving lease/CAS, fingerprint, idempotency,
-- event, and DLQ behavior.
select pg_temp.set_jwt_claim('role', 'service_role', true);
-- a Worker request of its own: nothing a previous (human) command published is still set
select set_config('app.cms_session_actor', '', true), set_config('app.cms_session_party', '', true), set_config('app.mfa_session_subject', '', true);

create temp table s09_worker_plan_read on commit drop as
select platform_api.cms_get_schema_migration_plan(jsonb_build_object(
  'migrationPlanId', :'y_plan', 'schemaVersionId', :'y_version', 'expectedVersion', '1'
)) as response;
select ok(
  (select response->>'id' = :'y_plan'
    and response->>'state' = 'draft'
    and response ?& array[
      'contentTypeId','fromVersionId','toVersionId','version','cursor','progress',
      'sourceCount','targetCount','rowErrorCount','migratedCount','failedCount',
      'classification','compilerHash','sourceHash','targetHash','activeVersionId'
    ] from s09_worker_plan_read),
  'S09 worker get-plan returns the complete durable migration-plan contract'
);
select response->>'compilerHash' as y_compiler, response->>'sourceHash' as y_source,
       response->>'targetHash' as y_target from s09_worker_plan_read \gset
select (select compiler_version from platform_private.cms_schema_artifacts
        where content_type_version_id = :'y_version' and state = 'compiled') as y_compiler_version \gset

-- Model a separate PostgREST transaction: the worker RPC must open its own
-- guarded write context after service-role admission.
select set_config('app.cms_rpc', 'false', true);
create temp table s09_worker_dry_claim on commit drop as
select platform_api.cms_claim_schema_migration_lease(jsonb_build_object(
  'migrationPlanId', :'y_plan', 'schemaVersionId', :'y_version',
  'expectedVersion', '1', 'cursor', '0', 'leaseOwner', 's09-worker-dry',
  'workerId', 's09-worker-dry', 'leaseDurationMs', '30000',
  'now', clock_timestamp()::text, 'transformKey', null, 'transformVersion', null,
  'compilerHash', :'y_compiler', 'sourceHash', :'y_source', 'targetHash', :'y_target'
)) as response;
select ok(
  (select (response->>'acquired')::boolean
    and response->>'leaseToken' is not null
    and response->'plan'->>'state' = 'dry_running'
    and response->'plan'->>'version' = '2' from s09_worker_dry_claim),
  'S09 worker claim acquires a durable dry-run lease with a CAS version bump'
);
select is(
  (select response->>'renewed' from (
    select platform_api.cms_heartbeat_schema_migration_lease(jsonb_build_object(
      'migrationPlanId', :'y_plan',
      'expectedVersion', '2', 'cursor', '0', 'leaseToken', 'stale-token-0001',
      'workerId', 's09-worker-dry', 'now', clock_timestamp()::text,
      'leaseDurationMs', '30000'
    )) response
  ) stale),
  'false',
  'S09 worker heartbeat rejects a stale lease token without mutating the plan'
);

create temp table s09_worker_dry_batch on commit drop as
select platform_api.cms_process_schema_migration_dry_run_batch(jsonb_build_object(
  'migrationPlanId', :'y_plan', 'schemaVersionId', :'y_version',
  'expectedVersion', '2', 'cursor', '0', 'limit', '1',
  'leaseToken', (select response->>'leaseToken' from s09_worker_dry_claim),
  'rowEvidence', '[]'::jsonb,
  'transformKey', null, 'transformVersion', null, 'compilerHash', :'y_compiler',
  'sourceHash', :'y_source', 'targetHash', :'y_target',
  'correlationId', 'a9090000-0000-4000-8000-000000000601', 'causationId', null
)) as response;
select ok(
  (select (response->>'done')::boolean and response->>'cursor' = '0'
    and response->>'migratedCount' = '0' from s09_worker_dry_batch),
  'S09 worker dry-run batch is bounded, cursor-safe, and complete for an empty source'
);

create temp table s09_worker_dry_final on commit drop as
select platform_api.cms_finalize_schema_migration_dry_run(jsonb_build_object(
  'migrationPlanId', :'y_plan',
  'expectedVersion', '2', 'cursor', '0', 'sourceCount', '0', 'targetCount', '0',
  'rowErrorCount', '0', 'transformKey', null, 'transformVersion', null,
  'compilerHash', :'y_compiler', 'sourceHash', :'y_source', 'targetHash', :'y_target'
)) as response;
select ok(
  (select response->>'state' = 'ready' and response->>'version' = '3'
    from s09_worker_dry_final),
  'S09 worker dry-run finalization commits ready state with a CAS version bump'
);
-- definer helper called outside a command: it reads the forced tables under the RPC context, as a command does
select set_config('app.cms_rpc', 'true', true);
select ok(
  platform_private.cms_persisted_dry_run_report_valid(
    :'y_dry_run',
    (select owner_id from platform_private.cms_content_type_versions where id = :'y_version'),
    (select content_type_id from s09_type_ids),
    (select version_id from s09_type_ids), :'y_version',
    'additive', null, null, :'y_source', :'y_target', :'y_compiler', :'y_compiler_version'
  ),
  'S09 worker finalization persists an independent immutable dry-run report'
);
select set_config('app.cms_rpc', '', true);

-- The independent review of the sealed evidence (CMS-03A-11/14/12): the
-- candidate becomes `approved` only through the named producers.
select pg_temp.s09d_guc_save();
select pg_temp.s09d_submit('y');
select pg_temp.s09d_assign('y', 'rev1');
select pg_temp.s09d_decide('y', 'rev1');
select pg_temp.s09d_guc_restore();
select is(pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('y:review')), 'approved',
  'S09 fixture: the independent assigned reviewer approved the sealed evidence');
select pg_temp.set_jwt_claim('role', 'service_role', true);
-- a Worker request of its own: nothing a previous (human) command published is still set
select set_config('app.cms_session_actor', '', true), set_config('app.cms_session_party', '', true), set_config('app.mfa_session_subject', '', true);

create temp table s09_worker_run_claim on commit drop as
select platform_api.cms_claim_schema_migration_lease(jsonb_build_object(
  'migrationPlanId', :'y_plan', 'schemaVersionId', :'y_version',
  'expectedVersion', '3', 'cursor', '0', 'leaseOwner', 's09-worker-dry',
  'workerId', 's09-worker-dry', 'leaseDurationMs', '30000',
  'now', clock_timestamp()::text, 'transformKey', null, 'transformVersion', null,
  'compilerHash', :'y_compiler', 'sourceHash', :'y_source', 'targetHash', :'y_target'
)) as response;
select ok(
  (select (response->>'acquired')::boolean and response->'plan'->>'state' = 'running'
    and response->'plan'->>'version' = '4' from s09_worker_run_claim),
  'S09 worker claim starts the live backfill with a fresh lease and CAS'
);
select ok(
  (select (platform_api.cms_heartbeat_schema_migration_lease(jsonb_build_object(
    'migrationPlanId', :'y_plan',
    'expectedVersion', '4', 'cursor', '0',
    'leaseToken', response->>'leaseToken', 'workerId', 's09-worker-dry',
    'now', clock_timestamp()::text, 'leaseDurationMs', '30000'
  ))->>'renewed')::boolean from s09_worker_run_claim),
  'S09 worker heartbeat renews the live lease without changing its CAS version'
);

create temp table s09_worker_run_batch on commit drop as
select platform_api.cms_process_schema_migration_batch(jsonb_build_object(
  'migrationPlanId', :'y_plan', 'schemaVersionId', :'y_version',
  'expectedVersion', '4', 'cursor', '0', 'limit', '1',
  'leaseToken', (select response->>'leaseToken' from s09_worker_run_claim),
  'rowEvidence', '[]'::jsonb,
  'transformKey', null, 'transformVersion', null, 'compilerHash', :'y_compiler',
  'sourceHash', :'y_source', 'targetHash', :'y_target',
  'correlationId', 'a9090000-0000-4000-8000-000000000602', 'causationId', null
)) as response;
select ok(
  (select (response->>'done')::boolean and response->>'cursor' = '0'
    from s09_worker_run_batch),
  'S09 worker backfill batch processes a bounded live page atomically'
);

create temp table s09_worker_verification_started on commit drop as
select platform_api.cms_begin_schema_migration_verification(jsonb_build_object(
  'migrationPlanId', :'y_plan',
  'expectedVersion', '4', 'cursor', '0', 'sourceCount', '0', 'targetCount', '0',
  'rowErrorCount', '0', 'migratedCount', '0', 'failedCount', '0',
  'transformKey', null, 'transformVersion', null, 'compilerHash', :'y_compiler',
  'sourceHash', :'y_source', 'targetHash', :'y_target'
)) as response;
select ok(
  (select response->>'state' = 'verifying' and response->>'version' = '5'
    from s09_worker_verification_started),
  'S09 worker verification begin enforces zero-error counters and advances state'
);
select ok(
  (select (platform_api.cms_verify_schema_migration(jsonb_build_object(
    'migrationPlanId', :'y_plan', 'schemaVersionId', :'y_version',
    'expectedVersion', '5', 'cursor', '0',
    'leaseToken', (select response->>'leaseToken' from s09_worker_run_claim),
    'sourceCount', '0', 'targetCount', '0', 'rowErrorCount', '0',
    'migratedCount', '0', 'failedCount', '0', 'transformKey', null,
    'transformVersion', null, 'compilerHash', :'y_compiler',
    'sourceHash', :'y_source', 'targetHash', :'y_target'
  ))->>'valid')::boolean),
  'S09 worker verification proves the current fingerprints and counters'
);

create temp table s09_worker_completed on commit drop as
select platform_api.cms_complete_schema_migration(jsonb_build_object(
  'migrationPlanId', :'y_plan',
  'expectedVersion', '5',
  'leaseToken', (select response->>'leaseToken' from s09_worker_run_claim)
)) as response;
select ok(
  (select response->>'state' = 'completed' and response->>'version' = '6'
    from s09_worker_completed),
  'S09 worker completion persists the terminal completed plan state'
);
