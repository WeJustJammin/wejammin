
-- A04 activation-gate regressions.  These checks exercise the private
-- server-side seams directly so a malformed persisted child/reference cannot
-- be hidden behind a successful API-shaped request.
select set_config('app.cms_rpc', 'true', true);
select set_config('app.cfg_rpc', 'true', true);
select ok(
  platform_private.cms_activation_references_valid(
    (select version_id from s09_type_ids)
  ),
  'AC095 activation preflight accepts the complete persisted reference graph [P2-S09-AC-095]'
);
select throws_ok(
  $$update platform_private.cms_field_definition_versions
    set editor_config = jsonb_build_object('label', 'Tampered title', 'order', 0)
    where content_type_version_id = (select version_id from s09_type_ids)
      and field_key = 'title'$$,
  'P0001', 'IMMUTABLE_RECORD',
  'AC095 rejects edits to a child whose parent version is already superseded'
);

select throws_ok(
  $$update platform_private.cms_relation_definitions
    set projection_key = 'public.summary'
    where id = (select (response->>'id')::uuid from s09_relation_created)$$,
  'P0001', 'IMMUTABLE_RECORD',
  'AC102 rejects relation edits after the parent version leaves draft/review'
);
-- AC189 over real evidence: an approved CMS review (built only through the
-- named producers on a fresh candidate in the same owner organization) is
-- invalidated when the owning type's capability authority changes.
select pg_temp.s09d_guc_save();
select pg_temp.s09d_create_type('dep', 'articledep');
select pg_temp.s09d_to_approved('dep', array['rev1']);
select pg_temp.s09d_guc_restore();
select set_config('app.cms_rpc', 'true', true);
select set_config('app.cfg_rpc', 'true', true);
select is(pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('dep:review')), 'approved',
  'AC189 fixture: the dependency candidate holds a real approved CMS review');
update platform_private.cms_content_types
set owner_capability = 'cms.schema_registry.read'
where id = pg_temp.s09d_id('dep:type');
select ok(
  (select state = 'invalidated'
   from platform_private.cms_schema_reviews
   where id = pg_temp.s09d_id('dep:review')),
  'AC189 owner-capability authority changes invalidate approved activation review evidence [P2-S09-AC-102]'
);
update platform_private.cms_content_types
set owner_capability = 'cms.schema_designer'
where id = pg_temp.s09d_id('dep:type');

-- Plan creation belongs to CMS-03A-10 and activation only advances the bound
-- plan (G1).  The candidate is the real additive successor of an active
-- version with no live successor draft (Article AD0); its plan and sealed
-- report come from the named producers.
select pg_temp.s09d_guc_save();
select pg_temp.s09d_create_type('ad0', 'articlead0');
select pg_temp.s09d_to_active('ad0');
select pg_temp.s09d_successor('adv', 'ad0');
select pg_temp.s09d_dry_run('adv');
select pg_temp.s09d_seal('adv');
select pg_temp.s09d_guc_restore();
select pg_temp.s09d_id('adv:version') as adv_version, pg_temp.s09d_id('adv:plan') as adv_plan,
       pg_temp.s09d_id('adv:dryRun') as adv_dry_run, pg_temp.s09d_id('ad0:version') as adv_source \gset
select set_config('app.cms_rpc', 'true', true);
select ok(
  platform_private.cms_activation_references_valid(:'adv_version'),
  'AC095 accepts the persisted reference graph of a real successor clone'
);
select throws_ok(
  format($q$select platform_private.cms_advance_activation_plan(%1$L::uuid, %2$L::uuid, null, %1$L::uuid)$q$,
    :'adv_version', :'adv_source'),
  'P0001', 'VALIDATION_FAILED',
  'AC096 additive activation rejects a candidate UUID standing in for the independent dry-run report [P2-S09-AC-087]'
);
select throws_ok(
  format($q$select platform_private.cms_advance_activation_plan(%1$L::uuid, %2$L::uuid,
    extensions.gen_random_uuid(), %3$L::uuid)$q$, :'adv_version', :'adv_source', :'adv_dry_run'),
  'P0001', 'VALIDATION_FAILED',
  'AC096 additive activation rejects a plan that is not the dry-run attempt''s own plan [P2-S09-AC-096]'
);
select is(
  platform_private.cms_advance_activation_plan(:'adv_version', :'adv_source', :'adv_plan', :'adv_dry_run'),
  :'adv_plan'::uuid,
  'AC099 A04 advances the CMS-03A-10 plan only after independent sealed additive evidence [P2-S09-AC-099]'
);
select is(
  (select state from platform_private.cms_schema_migration_plans where id = :'adv_plan'),
  'completed',
  'AC099 the advanced plan completes only after exact zero-row evidence [P2-S09-AC-099]'
);
select ok(
  platform_private.cms_migration_plan_ready(
    :'adv_plan', pg_temp.s09d_id('adv:type'), :'adv_version'
  ),
  'AC096 durable plan carries matching source/target/artifact/compiler evidence [P2-S09-AC-096]'
);
select pg_temp.s09d_guc_save();
select pg_temp.s09d_dry_run('adv', 'owner', null, null, 's09d-adv-redry-0001');
select pg_temp.s09d_guc_restore();
select is(pg_temp.s09d_outcome('adv:dryRun'), 'CONFLICT',
  'AC096 a completed attempt is immutable evidence: a new dry-run cannot supersede it');
select set_config('app.cms_rpc', 'true', true);
select throws_ok(
  format($q$update platform_private.cms_schema_migration_plans
    set dry_run_report = dry_run_report || jsonb_build_object('sourceCount', '1')
    where id = %L$q$, :'adv_plan'),
  'P0001', 'IMMUTABLE_RECORD',
  'AC096 completed dry-run evidence rejects a counter tamper attempt'
);
select throws_ok(
  format($q$delete from platform_private.cms_schema_migration_plans where id = %L$q$, :'adv_plan'),
  'P0001', 'IMMUTABLE_RECORD',
  'AC096 completed dry-run evidence cannot be deleted'
);
select throws_ok(
  format($q$update platform_private.cms_schema_dry_run_reports
    set report = report || jsonb_build_object('result', 'pass')
    where id = %L$q$, :'adv_dry_run'),
  'P0001', 'IMMUTABLE_RECORD',
  'AC096 independent dry-run report rejects an evidence tamper attempt [P2-S09-AC-096]'
);
select throws_ok(
  format($q$delete from platform_private.cms_schema_dry_run_reports where id = %L$q$, :'adv_dry_run'),
  'P0001', 'IMMUTABLE_RECORD',
  'AC096 independent dry-run report cannot be deleted'
);
select ok(
  platform_private.cms_migration_plan_ready(
    :'adv_plan', pg_temp.s09d_id('adv:type'), :'adv_version'
  ),
  'AC096 tamper attempts leave the immutable completed evidence ready'
);
