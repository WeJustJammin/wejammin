select ok(
  (select response->>'typeKey' = 'articley'
   and response->>'version' = '1'
   from s09_second_type_created),
  'CMS-03A-00 creates a target fixture in the second tenant'
);
select pg_temp.set_jwt_claim('sub', 'a9090000-0000-4000-8000-000000000001', true);
select set_config('app.auth_user_id', 'a9090000-0000-4000-8000-000000000001', true);
select set_config('app.actor_auth_user_id', 'a9090000-0000-4000-8000-000000000001', true);
select set_config('app.actor_person_id', (
  select person_id::text from identity.auth_user_bindings
  where auth_user_id = 'a9090000-0000-4000-8000-000000000001'
), true);
select set_config('app.acting_party_id', (select organization_id::text from s09_fixture_org), true);
create temp table s09_second_type_ids on commit drop as
select (response->>'id')::uuid as version_id,
       (response->>'contentTypeId')::uuid as content_type_id
from s09_second_type_created;
create temp table s09_second_field_id on commit drop as
select field.id as field_id
from platform_private.cms_field_definition_versions field
where field.content_type_version_id = (select version_id from s09_second_type_ids)
  and field.field_key = 'title';
select throws_ok(
  $$select platform_api.cms_add_field_definition(jsonb_build_object(
    'contentTypeId', (select content_type_id from s09_second_type_ids),
    'versionId', (select version_id from s09_second_type_ids),
    'field', jsonb_build_object(
      'key', 'cross_tenant', 'kind', 'short_text', 'constraints', '{}'::jsonb,
      'required', false, 'validatorKey', null, 'validatorVersion', null,
      'defaultMode', 'none', 'localizationMode', 'none',
      'editorConfig', jsonb_build_object('label', 'Cross tenant', 'order', 1),
      'lifecycle', 'active'
    ),
    'migrationPlanId', null, 'expectedVersion', '1',
    'idempotencyKey', 's09-cross-tenant-field-0001'
  ))$$,
  'P0001', 'NOT_FOUND',
  'CMS-03A-02 rejects a cross-tenant target without disclosing its existence'
);
select is(
  (select count(*)::integer
   from platform_private.cms_field_definition_versions
   where content_type_version_id = (select version_id from s09_second_type_ids)),
  1,
  'CMS-03A-02 cross-tenant rejection leaves the target fields unchanged'
);
select throws_ok(
  $$select platform_api.cms_bind_relation(jsonb_build_object(
    'contentTypeId', (select content_type_id from s09_second_type_ids),
    'versionId', (select version_id from s09_second_type_ids),
    'fieldId', (select field_id from s09_second_field_id),
    'targetKind', 'domain', 'targetType', 'profile',
    'projectionKey', 'profile.summary', 'cardinality', 'many',
    'min', 0, 'max', 3, 'ordered', false, 'onUnavailable', 'placeholder',
    'expectedVersion', '1', 'idempotencyKey', 's09-cross-tenant-relation-0001'
  ))$$,
  'P0001', 'NOT_FOUND',
  'CMS-03A-03 rejects a cross-tenant relation target without disclosure'
);
select is(
  (select count(*)::integer
   from platform_private.cms_relation_definitions relation
   where relation.field_definition_id = (select field_id from s09_second_field_id)),
  0,
  'CMS-03A-03 cross-tenant rejection leaves target relations unchanged'
);
select throws_ok(
  $$select platform_api.cms_activate_schema(jsonb_build_object(
    'contentTypeId', (select content_type_id from s09_second_type_ids),
    'versionId', (select version_id from s09_second_type_ids),
    'expectedVersion', '1',
    'dryRunId', 'a9090000-0000-4000-8000-000000000499',
    'approvalIds', jsonb_build_array('a9090000-0000-4000-8000-000000000499'),
    'migrationPlanId', null, 'idempotencyKey', 's09-cross-tenant-activate-0001',
    'context', jsonb_build_object('actingContextId', 'a9090000-0000-4000-8000-000000000090')
  ))$$,
  'P0001', 'NOT_FOUND',
  'CMS-03A-04 rejects a cross-tenant activation target without disclosure'
);
select ok(
  (select state = 'draft' and version = 1
   from platform_private.cms_content_type_versions
   where id = (select version_id from s09_second_type_ids)),
  'CMS-03A-04 cross-tenant rejection leaves the target version unchanged'
);

-- Release-worker paths require the service-role execution context and retain
-- the verified wire receipt in durable nonce/lifecycle evidence.
create temp table s09_release_key on commit drop as
select (keypair).public as public_key, (keypair).secret as secret_key
from lateral (
  select pgsodium.crypto_sign_seed_new_keypair(decode(repeat('11', 32), 'hex')) as keypair
) generated;

-- This vector is generated by the Worker WebCrypto implementation using the
-- deterministic seed 000102...1f.  Keep the exact payload/signature here so
-- the database verifier is exercised against bytes produced by the other
-- runtime, rather than only against a SQL-generated signature.
create temp table s09_worker_vector_body on commit drop as
select $worker_vector${"blockKey":"hero","blockVersion":2,"propsSchemaRef":"cms/blocks/hero/1","propsSchemaHash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","propsSchemaSnapshot":{"schemaVersion":"1","fields":[{"name":"title","kind":"string","required":true,"constraints":{}}],"additionalProperties":false},"propsSnapshotHash":"e3cf3f6d67138d16c3a540ea60e83b92364800b1ae26647385d0ff6aa4301cc5","propsSnapshotAttestation":{"algorithm":"Ed25519","keyId":"release-key-v1","signature":"5N+OSsWz7zP39DneO5APJrbdeADbQLUmDsrt1aqw902tDqDU+2PxOFP67FHNV+NuuGvQlDWxkyghXcfKL4G3Cw=="},"rendererRef":"cms/renderers/hero/1","allowedChildren":[],"slotRules":{"maxDepth":1,"maxNodes":1},"dataSourcePermissions":[],"accessibility":{"nameRequired":true,"keyboard":true,"focusOrder":"document","statusAnnouncement":true},"compatibility":{"minSchemaCompiler":"1","maxSchemaCompiler":"1"},"lifecycle":"supported","releaseDigest":"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"}$worker_vector$::text as raw_body;

select is(
  (select encode(extensions.digest(convert_to(raw_body, 'utf8'), 'sha256'), 'hex')
   from s09_worker_vector_body),
  '180a1f2862b94670b2b238bad5e6dd8e38129391b35afec8eeaa5cf152b7ddc9',
  'CMS-03A-05 cross-runtime vector hashes the exact Worker request bytes'
);
select is(
  platform_private.cms_release_signing_payload(
    jsonb_build_object(
      'releaseKeyId', 'release-key-v1',
      'releaseIssuedAt', '2026-09-02T17:00:00.000Z',
      'releaseNonce', 'a9090000-0000-4000-8000-000000000505',
      'releaseRawBodyHash', '180a1f2862b94670b2b238bad5e6dd8e38129391b35afec8eeaa5cf152b7ddc9'
    ),
    'CMS-03A-05'
  ),
  E'WEJAMMIN-CMS-03A-05-RELEASE-V1\nrelease-key-v1\n2026-09-02T17:00:00.000Z\na9090000-0000-4000-8000-000000000505\n180a1f2862b94670b2b238bad5e6dd8e38129391b35afec8eeaa5cf152b7ddc9',
  'CMS-03A-05 SQL payload matches the Worker release-signing bytes'
);
select ok(
  pgsodium.crypto_sign_verify_detached(
    decode('P7U9TLKRE4o6jEgdoAVjeCuBuF41gdmn4h9ErefZdcWqM43mZs1NlB0z/TN6y0x+Jzvq4hFeV8TtlYZaDRvEDw==', 'base64'),
    convert_to(
      platform_private.cms_release_signing_payload(
        jsonb_build_object(
          'releaseKeyId', 'release-key-v1',
          'releaseIssuedAt', '2026-09-02T17:00:00.000Z',
          'releaseNonce', 'a9090000-0000-4000-8000-000000000505',
          'releaseRawBodyHash', '180a1f2862b94670b2b238bad5e6dd8e38129391b35afec8eeaa5cf152b7ddc9'
        ),
        'CMS-03A-05'
      ),
      'utf8'
    ),
    decode('A6EHv/POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg=', 'base64')
  ),
  'CMS-03A-05 accepts the signature generated by the Worker cross-runtime vector'
);
select is(
  encode(extensions.digest(
    decode('P7U9TLKRE4o6jEgdoAVjeCuBuF41gdmn4h9ErefZdcWqM43mZs1NlB0z/TN6y0x+Jzvq4hFeV8TtlYZaDRvEDw==', 'base64'),
    'sha256'
  ), 'hex'),
  'de43a6daa023b99c3ebc1ea7ec7a22f4045aa697c9e3e30e6014d50795ac2420',
  'CMS-03A-05 cross-runtime signature hash matches the Worker evidence'
);
insert into platform_private.cfg_release_principals(principal_id, key_id, scope, active, public_key)
select 'a9090000-0000-4000-8000-000000000003', 'release.ci', 'registry-release', true, public_key
from s09_release_key
on conflict (key_id) do update
set key_id = excluded.key_id, scope = excluded.scope, active = excluded.active,
    public_key = excluded.public_key;
insert into platform_private.cfg_release_principals(principal_id, key_id, scope, active, public_key)
values (
  'a9090000-0000-4000-8000-000000000002', 'release-key-v1', 'registry-release', true,
  decode('A6EHv/POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg=', 'base64')
)
on conflict (key_id) do update
set key_id = excluded.key_id, scope = excluded.scope, active = excluded.active,
    public_key = excluded.public_key;

-- This is the exact parsed body whose raw bytes the Worker verified.  The
-- RPC-only context and release evidence are added after verification, as in
-- production-context.ts; the private *_at seam freezes only the test clock.
create temp table s09_worker_vector_request on commit drop as
select body.raw_body::jsonb || jsonb_build_object(
  'releaseKeyId', 'release-key-v1',
  'releaseNonce', 'a9090000-0000-4000-8000-000000000505',
  'releaseIssuedAt', '2026-09-02T17:00:00.000Z',
  'releaseRawBodyHash', '180a1f2862b94670b2b238bad5e6dd8e38129391b35afec8eeaa5cf152b7ddc9',
  'releaseSignatureHash', 'de43a6daa023b99c3ebc1ea7ec7a22f4045aa697c9e3e30e6014d50795ac2420',
  'releaseSignature', 'P7U9TLKRE4o6jEgdoAVjeCuBuF41gdmn4h9ErefZdcWqM43mZs1NlB0z/TN6y0x+Jzvq4hFeV8TtlYZaDRvEDw==',
  'releaseVerifiedAt', '2026-09-02T17:00:00.000Z',
  'idempotencyKey', 's09-worker-vector-register-0001',
  'context', jsonb_build_object('releasePrincipalId', 'release-key-v1')
) as request
from s09_worker_vector_body body;

create temp table s09_block_base on commit drop as
with snapshot as (
  select jsonb_build_object(
    'schemaVersion', '1',
    'fields', jsonb_build_array(jsonb_build_object(
      'name', 'title', 'kind', 'string', 'required', true,
      'constraints', '{}'::jsonb
    )),
    'additionalProperties', false
  ) as value
)
select jsonb_build_object(
  'blockKey', 'hero', 'blockVersion', '1', 'propsSchemaRef', 'cms/blocks/hero/1',
  'propsSchemaHash', repeat('a', 64), 'propsSchemaSnapshot', snapshot.value,
  'propsSnapshotHash', platform_private.cms_jcs_sha256(snapshot.value),
  'propsSnapshotAttestation', jsonb_build_object(
    'algorithm', 'Ed25519', 'keyId', 'release.ci',
    'signature', repeat('A', 86) || '=='
  ),
  'rendererRef', 'cms/renderers/hero/1', 'allowedChildren', '[]'::jsonb,
  'slotRules', jsonb_build_object('maxDepth', 1, 'maxNodes', 1),
  'dataSourcePermissions', '[]'::jsonb,
  'accessibility', jsonb_build_object(
    'nameRequired', true, 'keyboard', true, 'focusOrder', 'document',
    'statusAnnouncement', true
  ),
  'compatibility', jsonb_build_object('minSchemaCompiler', '1', 'maxSchemaCompiler', '1'),
  'lifecycle', 'supported', 'releaseDigest', repeat('e', 64),
  'releaseKeyId', 'release.ci',
  'releaseNonce', 'a9090000-0000-4000-8000-000000000505',
  'releaseIssuedAt', release_time,
  'releaseRawBodyHash', repeat('0', 64), 'releaseSignatureHash', repeat('0', 64),
  'releaseSignature', repeat('A', 86) || '==',
  'releaseVerifiedAt', release_time,
  'idempotencyKey', 's09-block-register-0001',
  'context', jsonb_build_object('releasePrincipalId', 'release.ci')
) as request
from snapshot
cross join lateral (select clock_timestamp()::text as release_time) timing;

create temp table s09_block_request on commit drop as
with nested as (
  select base.request || jsonb_build_object(
    'propsSnapshotAttestation', jsonb_build_object(
      'algorithm', 'Ed25519', 'keyId', 'release.ci',
      'signature', replace(encode(
        pgsodium.crypto_sign_detached(
          convert_to(platform_private.cms_props_attestation_payload(base.request), 'utf8'),
          key.secret_key
        ), 'base64'
      ), E'\n', '')
    )
  ) as request, key.secret_key
  from s09_block_base base cross join s09_release_key key
), signed as (
  select nested.request,
    pgsodium.crypto_sign_detached(
      convert_to(platform_private.cms_release_signing_payload(nested.request, 'CMS-03A-05'), 'utf8'),
      nested.secret_key
    ) as signature
  from nested
)
select request || jsonb_build_object(
  'releaseSignature', replace(encode(signature, 'base64'), E'\n', ''),
  'releaseSignatureHash', encode(extensions.digest(signature, 'sha256'), 'hex')
) as request
from signed;

-- Keep later lifecycle requests independently signed while retaining the
-- production envelope helper as the single canonical payload definition.
create or replace function pg_temp.s09_sign_release(p_request jsonb, p_operation text)
returns jsonb
language plpgsql
as $body$
declare
  request_value jsonb;
  signature_value bytea;
  secret_key_value bytea;
begin
  select secret_key into secret_key_value from pg_temp.s09_release_key;
  request_value := p_request || jsonb_build_object(
    'releaseRawBodyHash', coalesce(p_request->>'releaseRawBodyHash', repeat('0', 64)),
    'releaseSignature', repeat('A', 86) || '==',
    'releaseSignatureHash', repeat('0', 64)
  );
  signature_value := pgsodium.crypto_sign_detached(
    convert_to(platform_private.cms_release_signing_payload(request_value, p_operation), 'utf8'),
    secret_key_value
  );
  return request_value || jsonb_build_object(
    'releaseSignature', replace(encode(signature_value, 'base64'), E'\n', ''),
    'releaseSignatureHash', encode(extensions.digest(signature_value, 'sha256'), 'hex')
  );
end;
$body$;

select pg_temp.set_jwt_claim('role', 'authenticated', true);
select throws_ok(
  $$select platform_api.cms_register_block(
    (select request || jsonb_build_object('idempotencyKey', 's09-block-auth-0001') from s09_block_request)
  )$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects authenticated callers before release-principal resolution'
);
select pg_temp.set_jwt_claim('role', 'service_role', true);
-- a Worker request of its own: nothing a previous (human) command published is still set
select set_config('app.cms_session_actor', '', true), set_config('app.cms_session_party', '', true), set_config('app.mfa_session_subject', '', true);
select throws_ok(
  $$select platform_api.cms_register_block(
    (select request || jsonb_build_object(
      'idempotencyKey', 's09-block-missing-principal-0001',
      'context', jsonb_build_object()
    ) from s09_block_request)
  )$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 requires the authenticated Worker release-principal input boundary'
);
