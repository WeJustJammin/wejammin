-- Full cross-runtime admission: the request, nested attestation, and outer
-- signature are all produced by the Worker vector in the preceding fragment.
-- The private *_at seam supplies only the vector's deterministic test clock;
-- the granted one-argument RPC always supplies clock_timestamp().
-- FIXTURE FORGERY: no command registers a release signing principal (the release key registry is operator-provisioned trust configuration); the rows only let the signed CMS-03A-05 / CMS-03A-08 commands verify, they claim no producer path.
insert into platform_private.cfg_release_principals(
  principal_id, key_id, scope, active, public_key
) values (
  'a9090000-0000-4000-8000-000000000002',
  'release-key-v1-next',
  'registry-release',
  true,
  decode('A6EHv/POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg=', 'base64')
)
on conflict (key_id) do update
set principal_id = excluded.principal_id,
    scope = excluded.scope,
    active = excluded.active,
    public_key = excluded.public_key;
select is(
  (select count(*)::integer
   from platform_private.cfg_release_principals
   where principal_id = 'a9090000-0000-4000-8000-000000000002'),
  2,
  'CMS-03A-05 permits old and new release keys to overlap for one principal'
);
create temp table s09_worker_vector_created on commit drop as
select platform_private.cms_register_block_at(
  request,
  '2026-09-02T17:00:00.000Z'::timestamptz
) as response
from s09_worker_vector_request;
select ok(
  (select response->>'resourceKind' = 'block_definition_version'
      and response->>'blockKey' = 'hero'
      and response->>'blockVersion' = '2'
      and response->>'releaseKeyId' = 'release-key-v1'
      and response->>'releaseRawBodyHash' = '180a1f2862b94670b2b238bad5e6dd8e38129391b35afec8eeaa5cf152b7ddc9'
      and response->>'releaseSignatureHash' = 'de43a6daa023b99c3ebc1ea7ec7a22f4045aa697c9e3e30e6014d50795ac2420'
      and response->>'lifecycle' = 'supported'
   from s09_worker_vector_created),
  'CMS-03A-05 persists the pinned Worker registration through the SQL RPC body'
);
select ok(
  platform_private.cms_valid_base64(
    'P7U9TLKRE4o6jEgdoAVjeCuBuF41gdmn4h9ErefZdcWqM43mZs1NlB0z/TN6y0x+Jzvq4hFeV8TtlYZaDRvEDw=='
  ),
  'CMS-03A-05 accepts canonical padded Worker signature base64'
);
select ok(
  not platform_private.cms_valid_base64(
    'P7U9TLKRE4o6jEgdoAVjeCuBuF41gdmn4h9ErefZdcWqM43mZs1NlB0z/TN6y0x+Jzvq4hFeV8TtlYZaDRvEDx=='
  ),
  'CMS-03A-05 rejects a Worker signature with non-zero base64 pad bits'
);
select ok(
  (select count(*) = 1
     from platform_private.cms_block_definition_versions block
    where block.id = (select (response->>'id')::uuid from s09_worker_vector_created)
      and block.release_principal_id = 'a9090000-0000-4000-8000-000000000002'
      and block.release_key_id = 'release-key-v1'
      and block.release_raw_body_hash = '180a1f2862b94670b2b238bad5e6dd8e38129391b35afec8eeaa5cf152b7ddc9'
      and block.release_signature_hash = 'de43a6daa023b99c3ebc1ea7ec7a22f4045aa697c9e3e30e6014d50795ac2420'
      and block.release_nonce_hash = encode(
        extensions.digest(convert_to('a9090000-0000-4000-8000-000000000505', 'utf8'), 'sha256'), 'hex'
      )
      and block.props_attestation_key_id = 'release-key-v1'
  )
  and (select count(*) = 1
     from platform_private.cms_release_nonce_receipts receipt
    where receipt.operation_id = 'CMS-03A-05'
      and receipt.release_key_id = 'release-key-v1'
      and receipt.nonce_hash = encode(
        extensions.digest(convert_to('a9090000-0000-4000-8000-000000000505', 'utf8'), 'sha256'), 'hex'
      )
      and receipt.raw_body_hash = '180a1f2862b94670b2b238bad5e6dd8e38129391b35afec8eeaa5cf152b7ddc9'
      and receipt.signature_hash = 'de43a6daa023b99c3ebc1ea7ec7a22f4045aa697c9e3e30e6014d50795ac2420'
      and receipt.outcome = 'consumed'
  )
  and (select count(*) = 1
     from platform_private.outbox_events event
    where event.event_type = 'cms.block.registered.v1'
      and event.aggregate_id = (select (response->>'id')::uuid from s09_worker_vector_created)
  ),
  'CMS-03A-05 persists Worker raw/signature/nonce evidence and one registration outbox row'
);
select is(
  (select platform_private.cms_register_block_at(
    request, '2026-09-02T17:00:00.000Z'::timestamptz
  ) from s09_worker_vector_request),
  (select response from s09_worker_vector_created),
  'CMS-03A-05 Worker vector replay returns its exact original response'
);
select throws_ok(
  $$select platform_private.cms_register_block_at(
    request || jsonb_build_object(
      'idempotencyKey', 's09-worker-vector-noncanonical-signature-0001',
      'releaseSignature', left(request->>'releaseSignature', 85) || 'x==',
      'releaseSignatureHash', encode(extensions.digest(
        decode(left(request->>'releaseSignature', 85) || 'x==', 'base64'),
        'sha256'
      ), 'hex')
    ),
    '2026-09-02T17:00:00.000Z'::timestamptz
  ) from s09_worker_vector_request$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects a non-canonical padded outer Worker signature before trust lookup'
);
select throws_ok(
  $$select platform_private.cms_register_block_at(
    request || jsonb_build_object('idempotencyKey', 's09-worker-vector-replay-0001'),
    '2026-09-02T17:00:00.000Z'::timestamptz
  ) from s09_worker_vector_request$$,
  'P0001', 'CONFLICT',
  'CMS-03A-05 rejects a Worker vector nonce replay before a second mutation'
);
select throws_ok(
  $$select platform_private.cms_register_block_at(
    request || jsonb_build_object(
      'idempotencyKey', 's09-worker-vector-tamper-0001',
      'releaseRawBodyHash', repeat('9', 64)
    ),
    '2026-09-02T17:00:00.000Z'::timestamptz
  ) from s09_worker_vector_request$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rolls back a parsed release envelope whose raw-body hash was tampered'
);
select is(
  (select count(*)::integer from platform_private.cms_block_definition_versions
   where block_key = 'hero' and block_version = 2),
  1,
  'CMS-03A-05 tampered Worker vector leaves no second immutable block row'
);
select is(
  (select count(*)::integer from platform_private.cms_release_nonce_receipts
   where release_key_id = 'release-key-v1'),
  1,
  'CMS-03A-05 tampered Worker vector leaves no second nonce receipt'
);
select ok(
  position(
    'for update' in lower(pg_get_functiondef(
      'platform_private.cms_release_nonce_claim_at(jsonb,text,uuid,timestamptz)'::regprocedure
    ))
  ) > 0
  and position(
    'cms_release_nonce_claim_at' in lower(pg_get_functiondef(
      'platform_private.cms_register_block_at(jsonb,timestamptz)'::regprocedure
    ))
  ) < position(
    'cms_verify_props_attestation' in lower(pg_get_functiondef(
      'platform_private.cms_register_block_at(jsonb,timestamptz)'::regprocedure
    ))),
  'CMS-03A-05 locks the current release key before nested attestation verification'
);
-- FIXTURE FORGERY: release key lifecycle (revocation / validity window) of an operator-provisioned principal has no command; the statement moves a window to reach the time-dependent branch, no producer path is claimed.
update platform_private.cfg_release_principals
set valid_from = '2026-09-02T17:01:00.000Z'::timestamptz
where key_id = 'release-key-v1';
select throws_ok(
  $$select platform_private.cms_register_block_at(
    request || jsonb_build_object('idempotencyKey', 's09-worker-vector-future-key-0001'),
    '2026-09-02T17:00:00.000Z'::timestamptz
  ) from s09_worker_vector_request$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects a rotated key that is not yet current at verification time'
);
-- FIXTURE FORGERY: release key lifecycle (revocation / validity window) of an operator-provisioned principal has no command; the statement moves a window to reach the time-dependent branch, no producer path is claimed.
update platform_private.cfg_release_principals
set valid_from = null
where key_id = 'release-key-v1';
-- FIXTURE FORGERY: release key lifecycle (revocation / validity window) of an operator-provisioned principal has no command; the statement moves a window to reach the time-dependent branch, no producer path is claimed.
update platform_private.cfg_release_principals
set public_key = (select public_key from s09_release_key)
where key_id = 'release-key-v1';
select throws_ok(
  $$select platform_private.cms_register_block_at(
    request || jsonb_build_object('idempotencyKey', 's09-worker-vector-rotated-key-0001'),
    '2026-09-02T17:00:00.000Z'::timestamptz
  ) from s09_worker_vector_request$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 verifies against the current rotated key rather than a stale key snapshot'
);
-- FIXTURE FORGERY: release key lifecycle (revocation / validity window) of an operator-provisioned principal has no command; the statement moves a window to reach the time-dependent branch, no producer path is claimed.
update platform_private.cfg_release_principals
set public_key = decode('A6EHv/POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg=', 'base64')
where key_id = 'release-key-v1';

select ok(
  (select on_commit from s09_release_lock_probe),
  'CMS-03A-05 blocks concurrent nonce verification on the exact release key row'
);

create temp table s09_block_created on commit drop as
select platform_api.cms_register_block(request) as response
from s09_block_request;
select ok(
  (select response ?& array[
      'resourceKind','id','version','blockKey','blockVersion','propsSchemaRef',
      'propsSchemaSnapshot','propsSnapshotHash','rendererRef','releaseDigest',
      'releaseKeyId','releaseRawBodyHash','releaseSignatureHash','releaseNonceHash',
      'releaseVerifiedAt','lifecycle'
    ]
    and response->>'resourceKind' = 'block_definition_version'
    and response->>'blockKey' = 'hero'
    and response->>'lifecycle' = 'supported'
    from s09_block_created),
  'CMS-03A-05 registers a fully attested block through the worker-only RPC'
);
select is(
  (select platform_api.cms_register_block(request) from s09_block_request),
  (select response from s09_block_created),
  'CMS-03A-05 replay returns the exact original block resource payload'
);
select ok(
  (select count(*) = 1
   from platform_private.outbox_events
   where event_type = 'cms.block.registered.v1'
     and aggregate_id = (select (response->>'id')::uuid from s09_block_created))
   and (select count(*) = 1
   from platform_private.cms_release_nonce_receipts
   where operation_id = 'CMS-03A-05'
     and release_key_id = 'release.ci'
     and outcome = 'consumed'),
  'CMS-03A-05 atomically appends one outbox event and consumes one durable nonce receipt'
);
select throws_ok(
  $$select platform_api.cms_register_block(
    (select request || jsonb_build_object(
      'idempotencyKey', 's09-block-unbound-key-0001',
      'context', jsonb_build_object('releasePrincipalId', 'not-the-bound-release-key')
    ) from s09_block_request)
  )$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects a release principal that is not bound by the worker session'
);
select throws_ok(
  $$select platform_api.cms_register_block(
    (select pg_temp.s09_sign_release(
      request || jsonb_build_object(
        'idempotencyKey', 's09-block-forged-attestation-0001',
        'releaseNonce', 'a9090000-0000-4000-8000-000000000510',
        'propsSnapshotAttestation', jsonb_build_object(
          'algorithm', 'Ed25519', 'keyId', 'release.ci',
          'signature', repeat('A', 86) || '=='
        )
      ), 'CMS-03A-05'
    ) from s09_block_request)
  )$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects a shape-valid forged nested Ed25519 attestation'
);
select throws_ok(
  $$select platform_api.cms_register_block(
    (select pg_temp.s09_sign_release(
      request || jsonb_build_object(
        'idempotencyKey', 's09-block-forged-digest-0001',
        'releaseNonce', 'a9090000-0000-4000-8000-000000000511',
        'releaseDigest', repeat('f', 64)
      ), 'CMS-03A-05'
    ) from s09_block_request)
  )$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects a releaseDigest that is not bound by the nested attestation payload'
);
select throws_ok(
  $$select platform_api.cms_register_block(request) from (
    select request || jsonb_build_object(
      'idempotencyKey', 's09-block-forged-outer-signature-0001',
      'releaseSignature', forged_signature,
      'releaseSignatureHash', encode(extensions.digest(decode(forged_signature, 'base64'), 'sha256'), 'hex')
    ) as request
    from (
      select request,
        (case when left(request->>'releaseSignature', 1) = 'A' then 'B' else 'A' end
          || substring(request->>'releaseSignature' from 2)) as forged_signature
      from s09_block_request
    ) signed
  ) forged$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects a forged outer Ed25519 signature even when its shape and hash are valid'
);
select throws_ok(
  $$select platform_api.cms_register_block(
    (select request || jsonb_build_object(
      'idempotencyKey', 's09-block-forged-raw-hash-0001',
      'releaseRawBodyHash', repeat('9', 64)
    ) from s09_block_request)
  )$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects a raw-body hash changed after worker signing'
);
select throws_ok(
  $$select platform_api.cms_register_block(
    (select request || jsonb_build_object(
      'idempotencyKey', 's09-block-clock-skew-0001',
      'releaseIssuedAt', (clock_timestamp() - interval '6 minutes')::text
    ) from s09_block_request)
  )$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects a release issued outside the five-minute clock-skew window'
);
