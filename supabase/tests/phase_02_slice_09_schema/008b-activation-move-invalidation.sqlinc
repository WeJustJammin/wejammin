-- AC189 move invalidation over REAL review evidence.  Every candidate below
-- reaches an open (or approved) CMS review only through the named producers;
-- real reviews are terminal once invalidated, so each scenario builds its own
-- candidates.  Non-review child rows (relation/binding rows being moved) are the
-- objects under test and are the only rows written by hand.
select pg_temp.s09d_guc_save();
select pg_temp.s09d_legacy_actor('two', 'a9090000-0000-4000-8000-000000000002',
  (select organization_id from s09_fixture_org_two));

-- A relation moved between two candidates' fields invalidates BOTH parents'
-- open reviews.  Both parents stay in review so the parent-state guard allows
-- the move while the trigger proves its two-sided scope.
select pg_temp.s09d_create_type('ma', 'articlemovea');
select pg_temp.s09d_add_relation('ma');
select pg_temp.s09d_create_type('mb', 'articlemoveb');
select pg_temp.s09d_add_field_only('mb');
select pg_temp.s09d_to_review('ma');
select pg_temp.s09d_to_review('mb');
select pg_temp.s09d_guc_restore();
select set_config('app.cms_rpc', 'true', true);
select set_config('app.cfg_rpc', 'true', true);
select ok(
  pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('ma:review')) = 'open'
  and pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('mb:review')) = 'open'
  and pg_temp.s09d_read('cms_content_type_versions', 'state', pg_temp.s09d_id('ma:version')) = 'review'
  and pg_temp.s09d_read('cms_content_type_versions', 'state', pg_temp.s09d_id('mb:version')) = 'review',
  'AC189 fixture: both move candidates hold real open reviews'
);
update platform_private.cms_relation_definitions
set field_definition_id = pg_temp.s09d_id('mb:fieldId')
where field_definition_id = pg_temp.s09d_id('ma:fieldId');
select ok(
  pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('ma:review')) = 'invalidated'
  and pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('mb:review')) = 'invalidated',
  'AC189 relation moves invalidate activation evidence for both old and new parents'
);

-- A template binding written into a candidate invalidates that candidate's open
-- review, and moving the binding invalidates the new parent's open review.  The
-- old parent's review is already terminal, so it must not be resurrected.
select pg_temp.s09d_guc_save();
select pg_temp.s09d_create_type('mc', 'articlemovec');
select pg_temp.s09d_create_type('md', 'articlemoved');
select pg_temp.s09d_to_review('mc');
select pg_temp.s09d_to_review('md');
select pg_temp.s09d_guc_restore();
select set_config('app.cms_rpc', 'true', true);
select set_config('app.cfg_rpc', 'true', true);
insert into platform_private.cms_content_type_template_bindings(
  id, owner_id, state, version, content_type_version_id,
  template_version_id, position
) values (
  'a9090000-0000-4000-8000-000000000179',
  (select owner_id from platform_private.cms_content_type_versions
   where id = pg_temp.s09d_id('mc:version')),
  'active', 1, pg_temp.s09d_id('mc:version'),
  'a9090000-0000-4000-8000-000000000179', 0
);
select ok(
  pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('mc:review')) = 'invalidated'
  and pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('md:review')) = 'open',
  'AC189 a new child binding invalidates only its own candidate''s open review'
);
update platform_private.cms_content_type_template_bindings
set content_type_version_id = pg_temp.s09d_id('md:version')
where id = 'a9090000-0000-4000-8000-000000000179';
select ok(
  pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('mc:review')) = 'invalidated'
  and pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('md:review')) = 'invalidated',
  'AC189 binding moves invalidate the new parent''s review and never revive the old parent''s'
);
select throws_ok(
  $$insert into platform_private.cms_content_type_template_bindings(
      id, owner_id, state, version, content_type_version_id,
      template_version_id, position
    ) values (
      'a9090000-0000-4000-8000-000000000180',
      (select owner_id from platform_private.cms_content_type_versions
       where id = pg_temp.s09d_id('x:version')),
      'active', 1, pg_temp.s09d_id('x:version'),
      'a9090000-0000-4000-8000-000000000180', 0
    )$$,
  'P0001', 'IMMUTABLE_RECORD',
  'AC189 active parent guard rejects a new child binding'
);

-- A moved organization authority row invalidates the open reviews of candidates
-- owned by both the old and the new organization.  The second candidate is
-- intentionally owned by tenant two so the new-owner side is observable.
select pg_temp.s09d_guc_save();
select pg_temp.s09d_create_type('me', 'articlemovetwo', 'editorial', 'two');
select pg_temp.s09d_dry_run('me', 'two');
select pg_temp.s09d_seal('me', '0', 'two');
select pg_temp.s09d_submit('me', 'two');
select pg_temp.s09d_create_type('mf', 'articlemoveone');
select pg_temp.s09d_to_review('mf');
select pg_temp.s09d_guc_restore();
select set_config('app.cms_rpc', 'true', true);
select set_config('app.cfg_rpc', 'true', true);
select ok(
  pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('me:review')) = 'open'
  and pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('mf:review')) = 'open',
  'AC189 fixture: one open review in each organization'
);
update identity_private.membership_tenure
set organization_id = (select organization_id from s09_fixture_org_two)
where id = 'a9090000-0000-4000-8000-000000000201';
select ok(
  pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('me:review')) = 'invalidated'
  and pg_temp.s09d_read('cms_schema_reviews', 'state', pg_temp.s09d_id('mf:review')) = 'invalidated',
  'AC189 organization moves invalidate activation evidence for old and new owners'
);
