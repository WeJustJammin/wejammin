-- A moved relation invalidates approvals on both the old and new candidate
-- parents. Both parents remain in review so the parent-state guard allows the
-- move while the trigger proves its two-sided scope.
insert into platform_private.cms_content_type_versions(
  id, owner_id, state, version, content_type_id, version_no, labels,
  workflow_key, workflow_version, source_locale, default_locale,
  schema_artifact_id, definition_hash, compatibility, dry_run_id, created_by
) values
  ('a9090000-0000-4000-8000-000000000170', (select owner_id from platform_private.cms_content_type_versions where id = 'a9090000-0000-4000-8000-000000000103'), 'review', 1, (select content_type_id from s09_type_ids), 8, '{"label":"Move A"}', 'editorial', 1, 'en-US', 'en-US', 'a9090000-0000-4000-8000-000000000172', repeat('1', 64), 'additive', 'a9090000-0000-4000-8000-000000000410', 'a9090000-0000-4000-8000-000000000001'),
  ('a9090000-0000-4000-8000-000000000171', (select owner_id from platform_private.cms_content_type_versions where id = 'a9090000-0000-4000-8000-000000000103'), 'review', 1, (select content_type_id from s09_type_ids), 9, '{"label":"Move B"}', 'editorial', 1, 'en-US', 'en-US', 'a9090000-0000-4000-8000-000000000173', repeat('2', 64), 'additive', 'a9090000-0000-4000-8000-000000000411', 'a9090000-0000-4000-8000-000000000001');
insert into platform_private.cms_schema_artifacts(
  id, owner_id, state, version, content_type_version_id, compiler_version,
  zod_contract_ref, editor_manifest, renderer_manifest, artifact_hash, compiled_at
)
select rows.id, version_row.owner_id, 'compiled', 1, rows.version_id, '1', 'cms/content-type/articlex/v1',
  jsonb_build_object('schema', jsonb_build_object(
    'typeKey','articlex','label',rows.label,'ownerCapability','cms.schema_designer',
    'sourceLocale','en-US','defaultLocale','en-US','workflowKey','editorial',
    'workflowVersion','1','defaultTemplateVersionId',null,'fields','[]'::jsonb,
    'relations','[]'::jsonb,'templateBindings','[]'::jsonb,'capabilityBindings','[]'::jsonb
  ), 'fields','[]'::jsonb),
  jsonb_build_object('relations','[]'::jsonb,'templateBindings','[]'::jsonb,'capabilityBindings','[]'::jsonb),
  rows.hash, clock_timestamp()
from (values
  ('a9090000-0000-4000-8000-000000000172'::uuid, 'a9090000-0000-4000-8000-000000000170'::uuid, 'Move A', repeat('1',64)),
  ('a9090000-0000-4000-8000-000000000173'::uuid, 'a9090000-0000-4000-8000-000000000171'::uuid, 'Move B', repeat('2',64))
) rows(id, version_id, label, hash)
join platform_private.cms_content_type_versions version_row on version_row.id = rows.version_id;
insert into platform_private.cms_field_definition_versions(
  id, owner_id, state, version, content_type_version_id, stable_field_id,
  field_key, kind, constraints, required, default_mode, localization_mode,
  editor_config, created_by
)
select rows.field_id, version_row.owner_id, 'active', 1, version_row.id, rows.field_id,
       rows.key_name, 'relation', '{}'::jsonb, false, 'none', 'none',
       jsonb_build_object('label', rows.key_name, 'order', 0),
       'a9090000-0000-4000-8000-000000000001'
from (values
  ('a9090000-0000-4000-8000-000000000174'::uuid, 'a9090000-0000-4000-8000-000000000170'::uuid, 'related_a'),
  ('a9090000-0000-4000-8000-000000000175'::uuid, 'a9090000-0000-4000-8000-000000000171'::uuid, 'related_b')
) rows(field_id, version_id, key_name)
join platform_private.cms_content_type_versions version_row on version_row.id = rows.version_id;
insert into platform_private.cms_relation_definitions(
  id, owner_id, state, version, field_definition_id, target_kind, target_type,
  projection_key, cardinality, min_count, max_count, ordered, on_unavailable, created_by
) values (
  'a9090000-0000-4000-8000-000000000176',
  (select owner_id from platform_private.cms_content_type_versions where id = 'a9090000-0000-4000-8000-000000000170'),
  'active', 1, 'a9090000-0000-4000-8000-000000000174', 'content', 'profile',
  'profile.summary', 'one', 0, 1, false, 'omit', 'a9090000-0000-4000-8000-000000000001'
);
insert into platform_private.cfg_config_change_reviews(
  id, candidate_type, candidate_id, candidate_version, frozen_hash,
  impact_manifest, impact_manifest_hash, risk_class, required_approvals,
  state, submitted_by, submitted_at, version_no
) values
  ('a9090000-0000-4000-8000-000000000177', 'setting_value', 'a9090000-0000-4000-8000-000000000170', 1, repeat('1',64), '{}'::jsonb, platform_private.cfg_hash_json('{}'::jsonb), 'high', 1, 'approved', 'a9090000-0000-4000-8000-000000000001', clock_timestamp(), 1),
  ('a9090000-0000-4000-8000-000000000178', 'setting_value', 'a9090000-0000-4000-8000-000000000171', 1, repeat('2',64), '{}'::jsonb, platform_private.cfg_hash_json('{}'::jsonb), 'high', 1, 'approved', 'a9090000-0000-4000-8000-000000000001', clock_timestamp(), 1);
update platform_private.cms_relation_definitions
set field_definition_id = 'a9090000-0000-4000-8000-000000000175'
where id = 'a9090000-0000-4000-8000-000000000176';
select ok(
  (select state = 'review' from platform_private.cfg_config_change_reviews where id = 'a9090000-0000-4000-8000-000000000177')
  and (select state = 'review' from platform_private.cfg_config_change_reviews where id = 'a9090000-0000-4000-8000-000000000178'),
  'AC189 relation moves invalidate activation evidence for both old and new parents'
);

-- Binding moves have the same two-sided invalidation scope.  Reset the two
-- reviews to a known approved baseline, move one binding, and require both
-- parent reviews to return to review.
update platform_private.cfg_config_change_reviews
set state = 'approved', updated_at = clock_timestamp()
where id in (
  'a9090000-0000-4000-8000-000000000177',
  'a9090000-0000-4000-8000-000000000178'
);
insert into platform_private.cms_content_type_template_bindings(
  id, owner_id, state, version, content_type_version_id,
  template_version_id, position
) values (
  'a9090000-0000-4000-8000-000000000179',
  (select owner_id from platform_private.cms_content_type_versions
   where id = 'a9090000-0000-4000-8000-000000000170'),
  'active', 1, 'a9090000-0000-4000-8000-000000000170',
  'a9090000-0000-4000-8000-000000000179', 0
);
update platform_private.cfg_config_change_reviews
set state = 'approved', updated_at = clock_timestamp()
where id in (
  'a9090000-0000-4000-8000-000000000177',
  'a9090000-0000-4000-8000-000000000178'
);
update platform_private.cms_content_type_template_bindings
set content_type_version_id = 'a9090000-0000-4000-8000-000000000171'
where id = 'a9090000-0000-4000-8000-000000000179';
select ok(
  (select state = 'review' from platform_private.cfg_config_change_reviews where id = 'a9090000-0000-4000-8000-000000000177')
  and (select state = 'review' from platform_private.cfg_config_change_reviews where id = 'a9090000-0000-4000-8000-000000000178'),
  'AC189 binding moves invalidate activation evidence for both old and new parents'
);
select throws_ok(
  $$insert into platform_private.cms_content_type_template_bindings(
      id, owner_id, state, version, content_type_version_id,
      template_version_id, position
    ) values (
      'a9090000-0000-4000-8000-000000000180',
      (select owner_id from platform_private.cms_content_type_versions
       where id = 'a9090000-0000-4000-8000-000000000103'),
      'active', 1, 'a9090000-0000-4000-8000-000000000103',
      'a9090000-0000-4000-8000-000000000180', 0
    )$$,
  'P0001', 'IMMUTABLE_RECORD',
  'AC189 active parent guard rejects a new child binding'
);

