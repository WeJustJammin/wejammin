-- A real non-zero BREAKING migration (title kind change) keeps its source
-- version active while proving worker lease recovery, bounded execution (one row
-- per page), retryable rollback with a durable cursor, resume and completion.
-- Worker activation itself is covered by 005b.  Every row comes from a named
-- producer; the target rows are written by the database from the registered
-- executor contract and verified against the sealed evidence.
\ir ../phase_02_slice_09_dec108/04-worker.sqlinc
\ir ../phase_02_slice_09_dec119/00-support.sqlinc
select pg_temp.s09d_guc_save();
select pg_temp.s09d_create_type('bk', 'articlebk');
select pg_temp.s09d_to_active('bk');
select pg_temp.s09w_entry('bk:e1', 'bk', 'Alpha');
select pg_temp.s09w_entry('bk:e2', 'bk', 'Beta');
select pg_temp.s09w_entry('bk:e3', 'bk', 'Gamma');
select pg_temp.s09d_successor('bkb', 'bk');
select pg_temp.s09d_dry_run('bkb');
select pg_temp.s09w_dry_run('bkb');
select pg_temp.s09w_redefine('bkb', 'long_text', '{}'::jsonb);
select pg_temp.s09d_dry_run('bkb', 'owner', 'identity.revalidate', '1');
select pg_temp.s09w_dry_run('bkb', '1');
select pg_temp.s09d_guc_restore();
select pg_temp.set_jwt_claim('role', 'service_role', true);
-- a Worker request of its own: nothing a previous (human) command published is still set
select set_config('app.cms_session_actor', '', true), set_config('app.cms_session_party', '', true), set_config('app.mfa_session_subject', '', true);
select ok(
  (select classification = 'breaking' and transform_key = 'identity.revalidate' and transform_version = 1
          and state = 'ready' and source_count = 3 and target_count = 3 and row_error_count = 0 and cursor = 3
   from platform_private.cms_schema_migration_plans where id = pg_temp.s09d_id('bkb:plan')),
  'S09 BREAKING worker scans three real rows in one-row pages and seals the plan ready'
);
-- definer helper called outside a command: it reads the forced tables under the RPC context, as a command does
select set_config('app.cms_rpc', 'true', true);
select ok(
  (select platform_private.cms_persisted_dry_run_report_valid(
    report.id, report.owner_id, report.content_type_id, report.source_version_id,
    report.target_version_id, 'breaking', 'identity.revalidate', 1, report.source_hash,
    report.target_hash, report.compiler_hash, report.compiler_version)
   from platform_private.cms_schema_dry_run_reports report where report.id = pg_temp.s09d_id('bkb:dryRun')),
  'S09 BREAKING worker persists an independent producer report with exact fingerprints'
);
select set_config('app.cms_rpc', '', true);

-- Backfill: one bounded page, then a retryable rollback keeps the cursor and rows.
select pg_temp.s09w_claim('bkb');
select ok((select state = 'running' and cursor = 0 from platform_private.cms_schema_migration_plans
           where id = pg_temp.s09d_id('bkb:plan')),
  'S09 BREAKING backfill restarts the cursor at the first row after the sealed dry run');
select pg_temp.s09w_batch('bkb', 'bkb:first', pg_temp.s09w_evidence('identity.revalidate',
  pg_temp.s09w_read('bkb', 'bkb:first.read', '1')), false, '1');
select ok((select cursor = 1 and migrated_count = 1 and target_count = 3
           from platform_private.cms_schema_migration_plans where id = pg_temp.s09d_id('bkb:plan'))
  and (select count(*) = 1 from platform_private.cms_schema_migration_target_rows
       where plan_id = pg_temp.s09d_id('bkb:plan')),
  'S09 BREAKING bounded page writes exactly one target row and advances the cursor to 1');
select pg_temp.s09w_rollback('bkb', 'bk', true);
select ok((select state = 'failed_retryable' and cursor = 1 and migrated_count = 1
           from platform_private.cms_schema_migration_plans where id = pg_temp.s09d_id('bkb:plan'))
  and (select count(*) = 1 from platform_private.cms_schema_migration_target_rows
       where plan_id = pg_temp.s09d_id('bkb:plan'))
  and (select state = 'active' from platform_private.cms_content_type_versions where id = pg_temp.s09d_id('bk:version')),
  'S09 BREAKING retryable rollback keeps the cursor, the written row and the active fallback version [P2-S09-AC-217]');

-- Resume from the durable cursor with a replacement worker and complete.
-- The rolled-back lease is fenced for 15 minutes; the replacement worker's clock is past it.
select pg_temp.s09w_claim('bkb', 's09w-worker-2', clock_timestamp() + interval '1 hour');
select ok((select state = 'running' and cursor = 1 from platform_private.cms_schema_migration_plans
           where id = pg_temp.s09d_id('bkb:plan')),
  'S09 BREAKING replacement worker resumes the failed plan at its durable cursor [P2-S09-AC-217]');
select pg_temp.s09w_pass('bkb', false, '1');
select ok((select cursor = 3 and migrated_count = 3 and failed_count = 0
           from platform_private.cms_schema_migration_plans where id = pg_temp.s09d_id('bkb:plan'))
  and (select count(*) = 3 and count(distinct source_row_id) = 3
       from platform_private.cms_schema_migration_target_rows where plan_id = pg_temp.s09d_id('bkb:plan')),
  'S09 BREAKING resume finishes the remaining rows without duplicating the written row');
select pg_temp.s09w_finish('bkb');
select ok((select state = 'completed' and migrated_count = 3 and cursor = 3
           from platform_private.cms_schema_migration_plans where id = pg_temp.s09d_id('bkb:plan'))
  and (select state = 'active' from platform_private.cms_content_type_versions where id = pg_temp.s09d_id('bk:version')),
  'S09 BREAKING verification proves the target rows and completes the plan; the source stays active until the switch');
