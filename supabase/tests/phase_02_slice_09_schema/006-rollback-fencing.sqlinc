select is(
  (select platform_api.cms_dead_letter_schema_migration_event(jsonb_build_object(
    'eventId', 'a9090000-0000-4000-8000-000000000107',
    'eventType', 'cms.schema.activated.v1', 'schemaVersion', '1',
    'aggregateType', 'cms.schema.migration',
    'aggregateId', :'y_plan',
    'aggregateVersion', '1',
    'migrationPlanId', :'y_plan',
    'claimToken', 'a9090000-0000-4000-8000-000000000913',
    'reasonCode', 'WORKER_FAILURE'
  ))->>'accepted'),
  'true',
  'S09 worker DLQ persists a failed event and acknowledges acceptance'
);
select is(
  (select platform_api.cms_claim_schema_migration_event(jsonb_build_object(
    'eventId', 'a9090000-0000-4000-8000-000000000107',
    'eventType', 'cms.schema.activated.v1', 'schemaVersion', '1',
    'aggregateType', 'cms.schema.migration',
    'aggregateId', :'y_plan',
    'aggregateVersion', '1',
    'migrationPlanId', :'y_plan',
    'claimToken', 'a9090000-0000-4000-8000-000000000114', 'replay', true
  ))->>'status'),
  'replayable',
  'S09 worker DLQ claim permits an explicit replay of a dead-lettered event'
);
select throws_ok(
  format($q$select platform_api.cms_dead_letter_schema_migration_event(jsonb_build_object(
    'eventId', 'a9090000-0000-4000-8000-000000000107',
    'eventType', 'cms.schema.activated.v1', 'schemaVersion', '1',
    'aggregateType', 'cms.schema.migration',
    'aggregateId', %1$L,
    'aggregateVersion', '1',
    'migrationPlanId', %1$L,
    'claimToken', 'a9090000-0000-4000-8000-000000000114',
    'reasonCode', 'bad'
  ))$q$, :'y_plan'),
  'P0001', 'INVALID_REQUEST',
  'S09 worker DLQ rejects an unbounded/lowercase reason code'
);
-- A second plan exercises rollback without disturbing the completed activation
-- above. It proves the fallback version is tied to the same tenant and source
-- and target fingerprints, rather than accepted as a UUID-only hint.  The
-- candidate is the real successor of the activated version 2 and its plan is
-- created and sealed by the named producers.
select pg_temp.s09d_guc_save();
select pg_temp.s09d_successor('z', 'y');
select pg_temp.s09d_dry_run('z');
select pg_temp.s09d_seal('z');
select pg_temp.s09d_guc_restore();
select pg_temp.s09d_id('z:version') as z_version, pg_temp.s09d_id('z:plan') as z_plan \gset
select set_config('request.jwt.claim.role', 'service_role', true);
select is(pg_temp.s09d_read('cms_schema_migration_plans', 'state', :'z_plan'), 'ready',
  'S09 fixture: the rollback candidate plan is sealed ready by the worker producers');
create temp table s09_z_plan on commit drop as
select platform_api.cms_get_schema_migration_plan(jsonb_build_object(
  'migrationPlanId', :'z_plan', 'schemaVersionId', :'z_version',
  'expectedVersion', pg_temp.s09d_read('cms_schema_migration_plans', 'version', :'z_plan')
)) as response;
select response->>'compilerHash' as z_compiler, response->>'sourceHash' as z_source,
       response->>'targetHash' as z_target, response->>'version' as z_ready_version
  from s09_z_plan \gset
create temp table s09_worker_rollback_claim on commit drop as
select platform_api.cms_claim_schema_migration_lease(jsonb_build_object(
  'migrationPlanId', :'z_plan', 'schemaVersionId', :'z_version',
  'expectedVersion', :'z_ready_version', 'cursor', '0', 'leaseOwner', 's09-worker-rollback',
  'workerId', 's09-worker-rollback', 'leaseDurationMs', '30000',
  'now', clock_timestamp()::text, 'transformKey', null, 'transformVersion', null,
  'compilerHash', :'z_compiler', 'sourceHash', :'z_source', 'targetHash', :'z_target'
)) as response;
create temp table s09_worker_rolled_back on commit drop as
select platform_api.cms_rollback_schema_migration(jsonb_build_object(
  'migrationPlanId', :'z_plan', 'schemaVersionId', :'z_version',
  'expectedVersion', (select response->'plan'->>'version' from s09_worker_rollback_claim),
  'cursor', '0',
  'leaseToken', (select response->>'leaseToken' from s09_worker_rollback_claim),
  'reasonCode', 'TEST_FAILURE', 'retryable', false,
  'fallbackVersionId', :'y_version',
  'preserveOldActive', true, 'deleteRows', false, 'transformKey', null,
  'transformVersion', null, 'compilerHash', :'z_compiler',
  'sourceHash', :'z_source', 'targetHash', :'z_target'
)) as response;
select ok(
  (select response->'plan'->>'state' = 'failed_terminal'
    and response->'plan'->>'version' = ((select response->'plan'->>'version' from s09_worker_rollback_claim)::bigint + 1)::text
    and (select state = 'active' from platform_private.cms_content_type_versions
         where id = :'y_version')
    from s09_worker_rolled_back),
  'S09 worker rollback records terminal failure while preserving the active fallback version'
);

select throws_ok(
  format($q$update platform_private.cms_schema_migration_plans
    set dry_run_report = dry_run_report || jsonb_build_object('targetDefinitionHash', repeat('d', 64))
    where id = %L$q$, :'y_plan'),
  'P0001', 'IMMUTABLE_RECORD',
  'S09 completed migration plans reject trusted SQL tampering'
);
select ok(
  platform_private.cms_migration_plan_ready(
    :'y_plan',
    (select content_type_id from s09_type_ids),
    :'y_version'
  ),
  'CMS-03A completed migration evidence remains ready after tamper refusal'
);
