-- Release-key validity and lifecycle transition boundaries continue the
-- cross-runtime release contract after the admission vectors in 003b.
-- The preceding fragment creates the signed request and block fixtures used
-- here; keeping this continuation separate preserves the pgTAP file cap.
select throws_ok(
  $$select platform_api.cms_register_block(
    (select request || jsonb_build_object(
      'idempotencyKey', 's09-block-verified-skew-0001',
      'releaseVerifiedAt', (clock_timestamp() + interval '6 minutes')::text
    ) from s09_block_request)
  )$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects a release verification timestamp outside the five-minute window'
);
-- A key can be valid for the historical issuedAt yet outside its current
-- rotation window.  The SQL verifier must reject that direct service-role RPC
-- instead of treating issuedAt as the only validity check.
-- FIXTURE FORGERY: release key lifecycle (revocation / validity window) of an operator-provisioned principal has no command; the statement moves a window to reach the time-dependent branch, no producer path is claimed.
update platform_private.cfg_release_principals
set valid_through = clock_timestamp() - interval '1 minute'
where key_id = 'release.ci';
select throws_ok(
  $$select platform_api.cms_register_block(request) from (
    select pg_temp.s09_sign_release(
      request || jsonb_build_object(
        'idempotencyKey', 's09-block-expired-key-0001',
        'releaseNonce', 'a9090000-0000-4000-8000-000000000509',
        'releaseIssuedAt', (clock_timestamp() - interval '2 minutes')::text,
        'releaseVerifiedAt', (clock_timestamp() - interval '2 minutes')::text
      ), 'CMS-03A-05'
    ) as request
    from s09_block_request
  ) signed$$,
  'P0001', 'UNAUTHENTICATED',
  'CMS-03A-05 rejects a key outside its current valid-through window even when issuedAt remains valid'
);
-- FIXTURE FORGERY: release key lifecycle (revocation / validity window) of an operator-provisioned principal has no command; the statement moves a window to reach the time-dependent branch, no producer path is claimed.
update platform_private.cfg_release_principals
set valid_through = null
where key_id = 'release.ci';
select throws_ok(
  $$select platform_api.cms_register_block(
    (select request || jsonb_build_object(
      'idempotencyKey', 's09-block-signature-trailing-0001',
      'propsSnapshotAttestation', jsonb_build_object(
        'algorithm', 'Ed25519', 'keyId', 'release.ci',
        'signature', repeat('A', 86) || '==!'
      )
    ) from s09_block_request)
  )$$,
  'P0001', 'VALIDATION_FAILED',
  'CMS-03A-05 rejects an attestation signature with a trailing character'
);
select throws_ok(
  $$select platform_api.cms_register_block(
    (select pg_temp.s09_sign_release(
      request || jsonb_build_object(
        'idempotencyKey', 's09-block-noncanonical-attestation-0001',
        'propsSnapshotAttestation', jsonb_build_object(
          'algorithm', 'Ed25519', 'keyId', 'release.ci',
          'signature', repeat('A', 85) || 'B=='
        )
      ), 'CMS-03A-05'
    ) from s09_block_request)
  )$$,
  'P0001', 'VALIDATION_FAILED',
  'CMS-03A-05 rejects a non-canonical padded nested attestation signature'
);

create temp table s09_lifecycle_request on commit drop as
select pg_temp.s09_sign_release(request || jsonb_build_object(
  'blockDefinitionVersionId', (select (response->>'id')::uuid from s09_block_created),
  'fromLifecycle', 'supported', 'toLifecycle', 'deprecated', 'expectedVersion', '1',
  'releaseDigest', repeat('e', 64), 'releaseNonce', 'a9090000-0000-4000-8000-000000000508',
  'releaseIssuedAt', clock_timestamp()::text, 'releaseRawBodyHash', repeat('f', 64),
  'releaseSignatureHash', repeat('1', 64), 'releaseVerifiedAt', clock_timestamp()::text,
  'idempotencyKey', 's09-block-lifecycle-0001'
) , 'CMS-03A-08') as request
from s09_block_request;
select pg_temp.set_jwt_claim('role', 'authenticated', true);
select throws_ok(
  $$select platform_api.cms_advance_block_lifecycle(
    (select request from s09_lifecycle_request)
  )$$,
  'P0001', 'FORBIDDEN',
  'CMS-03A-08 rejects authenticated callers (a human or admin session) with 403 before release-principal resolution [P2-S09-AC-034]'
);
select pg_temp.set_jwt_claim('role', 'service_role', true);
-- a Worker request of its own: nothing a previous (human) command published is still set
select set_config('app.cms_session_actor', '', true), set_config('app.cms_session_party', '', true), set_config('app.mfa_session_subject', '', true);
create temp table s09_lifecycle_created on commit drop as
select platform_api.cms_advance_block_lifecycle(request) as response
from s09_lifecycle_request;
