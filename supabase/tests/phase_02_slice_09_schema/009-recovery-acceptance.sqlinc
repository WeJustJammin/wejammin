-- AC217 recovery drill against the real PostgreSQL worker authority.  The
-- target is a complete 128-field definition created through CMS-03A-01 (the
-- named producer compiles and persists the artifact), dry-run by CMS-03A-10 and
-- sealed by the worker; the recovery drill then leases the backfill, loses the
-- worker, and takes the plan over with a replacement worker through durable CAS.
-- The type is a first version, so its application-content row count is truthfully
-- zero; a non-zero cursor recovery is covered by the non-zero fragments.
select pg_temp.s09d_guc_save();
create temp table s09_ac217_field_manifest on commit drop as
select jsonb_agg(
  jsonb_build_object(
    'stableFieldId', extensions.gen_random_uuid(),
    'key', 'field_' || lpad(number::text, 3, '0'),
    'kind', 'short_text',
    'constraints', '{}'::jsonb,
    'required', false,
    'validatorKey', null,
    'validatorVersion', null,
    'defaultMode', 'none',
    'localizationMode', 'none',
    'editorConfig', jsonb_build_object('label', 'Field ' || number, 'order', number),
    'lifecycle', 'active'
  ) order by number
) as fields
from generate_series(1, 128) generated(number);
select pg_temp.s09d_rpc('big:create', 'platform_api.cms_create_type_draft', 'owner',
  jsonb_build_object(
    'typeKey', 'articlebig', 'label', 'Article X recovery 128',
    'ownerCapability', 'cms.schema_designer', 'sourceLocale', 'en-US',
    'defaultLocale', 'en-US', 'workflowKey', 'editorial', 'workflowVersion', '1',
    'defaultTemplateVersionId', null,
    'fields', (select fields from s09_ac217_field_manifest),
    'relations', '[]'::jsonb, 'templateBindings', '[]'::jsonb,
    'capabilityBindings', '[]'::jsonb, 'idempotencyKey', 's09-ac217-create-0001'));
select pg_temp.s09d_remember('big:type', (pg_temp.s09d_resp('big:create')->>'contentTypeId')::uuid);
select pg_temp.s09d_remember('big:version', (pg_temp.s09d_resp('big:create')->>'id')::uuid);
select pg_temp.s09d_dry_run('big');
select pg_temp.s09d_seal('big');
select pg_temp.s09d_guc_restore();
select set_config('request.jwt.claim.role', 'service_role', true);
select pg_temp.s09d_id('big:version') as big_version, pg_temp.s09d_id('big:plan') as big_plan,
       pg_temp.s09d_id('big:dryRun') as big_dry_run \gset
create temp table s09_ac217_plan on commit drop as
select platform_api.cms_get_schema_migration_plan(jsonb_build_object(
  'migrationPlanId', :'big_plan', 'schemaVersionId', :'big_version',
  'expectedVersion', pg_temp.s09d_read('cms_schema_migration_plans', 'version', :'big_plan')
)) as response;
select response->>'compilerHash' as big_compiler, response->>'sourceHash' as big_source,
       response->>'targetHash' as big_target, response->>'version' as big_ready_version
  from s09_ac217_plan \gset
select ok(
  (select count(*) = 128
     from platform_private.cms_field_definition_versions
    where content_type_version_id = :'big_version')
  and (select version_row.definition_hash = artifact.artifact_hash
         and pg_catalog.octet_length(artifact.editor_manifest::text) between 8193 and 524288
         and pg_catalog.jsonb_array_length(artifact.editor_manifest->'schema'->'fields') = 128
         and platform_private.cms_compiled_manifest_bounded(artifact.editor_manifest)
         and platform_private.cms_compiled_manifest_bounded(artifact.renderer_manifest)
         and (select jsonb_agg(value order by value->>'stableFieldId', value->>'key')
                from jsonb_array_elements((select fields from s09_ac217_field_manifest)) entry(value))
           = (select jsonb_agg(jsonb_build_object(
                'stableFieldId', field.stable_field_id, 'key', field.field_key,
                'kind', field.kind, 'constraints', field.constraints,
                'required', field.required, 'validatorKey', field.validator_key,
                'validatorVersion', field.validator_version,
                'defaultMode', field.default_mode,
                'localizationMode', field.localization_mode,
                'editorConfig', field.editor_config, 'lifecycle', 'active'
              ) order by field.stable_field_id::text, field.field_key)
                from platform_private.cms_field_definition_versions field
               where field.content_type_version_id = :'big_version')
       from platform_private.cms_content_type_versions version_row
       join platform_private.cms_schema_artifacts artifact
         on artifact.id = version_row.schema_artifact_id
      where version_row.id = :'big_version'),
  'AC217 the producer persists a complete 128-field target definition and matching bounded artifact'
);
select ok(
  (select platform_private.cms_persisted_dry_run_report_valid(
     report.id, report.owner_id, report.content_type_id, report.source_version_id,
     report.target_version_id, 'additive', null, null, report.source_hash,
     report.target_hash, report.compiler_hash, report.compiler_version)
   from platform_private.cms_schema_dry_run_reports report where report.id = :'big_dry_run'),
  'AC217 the worker seal persists an independent immutable dry-run report for the 128-field target'
);

-- The sealed plan is ready; the first worker leases the backfill for 1 ms.
create temp table s09_ac217_claim_one on commit drop as
select platform_api.cms_claim_schema_migration_lease(jsonb_build_object(
  'migrationPlanId', :'big_plan', 'schemaVersionId', :'big_version',
  'expectedVersion', :'big_ready_version', 'cursor', '0', 'leaseOwner', 's09-ac217-worker-1',
  'workerId', 's09-ac217-worker-1', 'leaseDurationMs', '1',
  'now', clock_timestamp()::text, 'transformKey', null, 'transformVersion', null,
  'compilerHash', :'big_compiler', 'sourceHash', :'big_source', 'targetHash', :'big_target'
)) as response;
select ok(
  (select response->>'acquired' = 'true'
      and response->'plan'->>'state' = 'running'
      and response->'plan'->>'version' = (:'big_ready_version'::bigint + 1)::text
      and response->'plan'->>'cursor' = '0'
   from s09_ac217_claim_one),
  'AC217 records the first bounded lease before simulated worker loss'
);

-- A second worker observes server-time expiry and takes over the same durable
-- plan through the real lease/CAS path.
create temp table s09_ac217_claim_two on commit drop as
select platform_api.cms_claim_schema_migration_lease(jsonb_build_object(
  'migrationPlanId', :'big_plan', 'schemaVersionId', :'big_version',
  'expectedVersion', (:'big_ready_version'::bigint + 1)::text, 'cursor', '0',
  'leaseOwner', 's09-ac217-worker-2',
  'workerId', 's09-ac217-worker-2', 'leaseDurationMs', '30000',
  'now', (clock_timestamp() + interval '1 hour')::text,
  'transformKey', null, 'transformVersion', null,
  'compilerHash', :'big_compiler', 'sourceHash', :'big_source', 'targetHash', :'big_target'
)) as response;
select ok(
  (select response->>'acquired' = 'true'
      and response->'plan'->>'state' = 'running'
      and response->'plan'->>'version' = (:'big_ready_version'::bigint + 2)::text
      and response->'plan'->>'cursor' = '0'
   from s09_ac217_claim_two),
  'AC217 replacement worker resumes the expired lease through durable CAS'
);

create temp table s09_ac217_batch on commit drop as
select platform_api.cms_process_schema_migration_batch(jsonb_build_object(
  'migrationPlanId', :'big_plan', 'schemaVersionId', :'big_version',
  'expectedVersion', (:'big_ready_version'::bigint + 2)::text, 'cursor', '0', 'limit', '32',
  'leaseToken', (select response->>'leaseToken' from s09_ac217_claim_two),
  'rowEvidence', '[]'::jsonb, 'transformKey', null,
  'transformVersion', null, 'compilerHash', :'big_compiler',
  'sourceHash', :'big_source', 'targetHash', :'big_target',
  'correlationId', 'a9090000-0000-4000-8000-000000000706',
  'causationId', null
)) as response;
select ok(
  (select response->>'done' = 'true'
      and response->>'cursor' = '0'
      and response->>'sourceCount' = '0'
      and response->>'migratedCount' = '0'
   from s09_ac217_batch),
  'AC217 replacement worker completes the truthful zero-row batch'
);

create temp table s09_ac217_verification_begin on commit drop as
select platform_api.cms_begin_schema_migration_verification(jsonb_build_object(
  'migrationPlanId', :'big_plan',
  'expectedVersion', (:'big_ready_version'::bigint + 2)::text, 'cursor', '0',
  'sourceCount', '0', 'targetCount', '0', 'rowErrorCount', '0',
  'migratedCount', '0', 'failedCount', '0', 'transformKey', null,
  'transformVersion', null, 'compilerHash', :'big_compiler',
  'sourceHash', :'big_source', 'targetHash', :'big_target'
)) as response;
select is(
  (select response->>'state' from s09_ac217_verification_begin),
  'verifying',
  'AC217 recovered zero-row plan enters verification'
);
select ok(
  (select (platform_api.cms_verify_schema_migration(jsonb_build_object(
      'migrationPlanId', :'big_plan', 'schemaVersionId', :'big_version',
      'expectedVersion', (:'big_ready_version'::bigint + 3)::text, 'cursor', '0',
      'leaseToken', claim.response->>'leaseToken',
      'sourceCount', '0', 'targetCount', '0', 'rowErrorCount', '0',
      'migratedCount', '0', 'failedCount', '0', 'transformKey', null,
      'transformVersion', null, 'compilerHash', :'big_compiler',
      'sourceHash', :'big_source', 'targetHash', :'big_target'
    ))->>'valid')::boolean
   from s09_ac217_claim_two claim),
  'AC217 verification accepts exact zero-row counters and fingerprints'
);

create temp table s09_ac217_completed on commit drop as
select platform_api.cms_complete_schema_migration(jsonb_build_object(
  'migrationPlanId', :'big_plan', 'expectedVersion', (:'big_ready_version'::bigint + 3)::text,
  'leaseToken', claim.response->>'leaseToken'
)) as response
from s09_ac217_claim_two claim;
select ok(
  (select response->>'state' = 'completed'
      and response->>'version' = (:'big_ready_version'::bigint + 4)::text
      and response->>'cursor' = '0'
   from s09_ac217_completed)
  and (select count(*) = 128
       from platform_private.cms_field_definition_versions
       where content_type_version_id = :'big_version')
  and (select count(*) = 0 from platform_private.cms_schema_migration_target_rows
       where plan_id = :'big_plan'),
  'AC217 completes recovered plan without fabricating application-content rows'
);
