-- CMS-03C-13 selector (limit 50 of 65 active versions: a first and a cursor page), cmsPatternLatestRead on 512-node versions and
-- CMS-03C-14 at its bound of 128 paths.  Thirty samples each; the p95 is taken over at least twenty.  The pgTAP-transaction-only
-- Vault key signs the selector cursors; it is never an operational value.
select vault.create_secret(repeat('b2', 32), 'cms_editorial_history_cursor_active', 'pgTAP transaction-only perf bench key');

create or replace function pg_temp.g12pp_selector_req(p_cursor text default null) returns jsonb language sql volatile as $body$
  select jsonb_build_object('contentTypeId', pg_temp.g12pp_type(1), 'limit', 50, 'correlationId', 'a9120000-0000-4000-8000-00000000c0d3')
    || case when p_cursor is null then '{}'::jsonb else jsonb_build_object('cursor', p_cursor) end $body$;
create or replace function pg_temp.g12pp_diff_req() returns jsonb language plpgsql volatile as $body$
begin
  perform set_config('app.cms_rpc', 'true', true);
  return jsonb_build_object('instanceId', (select id from platform_private.cms_composition_instances
      where revision_id = pg_temp.s12pl_rev('dw') and path = '/wide' order by version desc limit 1),
    'correlationId', 'a9120000-0000-4000-8000-00000000c0d1');
end;
$body$;

select pg_temp.g12p_call('shape_selector', 'platform_api.cms_list_pattern_selector', 'owner', pg_temp.g12pp_selector_req(), pg_temp.g12pp_ctx('owner'));
select pg_temp.g12p_call('shape_latest', 'platform_api.cms_pattern_latest', 'owner',
  jsonb_build_object('patternKey', 'gp-nest-01'), pg_temp.g12pp_ctx('owner'));
select pg_temp.g12p_call('shape_diff', 'platform_api.cms_get_instance_update_diff', 'owner', pg_temp.g12pp_diff_req(), pg_temp.g12pp_ctx('owner'));
select ok(pg_temp.g12p_out('shape_selector#1') = 'ok' and jsonb_array_length(pg_temp.g12p_body('shape_selector#1')->'items') = 50
    and pg_temp.g12p_body('shape_selector#1')->>'nextCursor' is not null,
  'the selector returns the maximum page of 50 items and a cursor from 65 active versions [P2-S12-AC-109]');
select ok(pg_temp.g12p_out('shape_latest#1') = 'ok' and jsonb_array_length(pg_temp.g12p_body('shape_latest#1')->'blockTree') = 32
    and (pg_temp.g12p_body('shape_latest#1')->>'nodeCount')::integer = 512,
  'cmsPatternLatestRead returns the latest version with its tree of 32 references expanding to 512 nodes [P2-S12-AC-174]');
select ok(pg_temp.g12p_out('shape_diff#1') = 'ok' and jsonb_array_length(pg_temp.g12p_body('shape_diff#1')->'paths') = 128
    and octet_length(convert_to(pg_temp.g12p_body('shape_diff#1')::text, 'UTF8')) <= 262144
    and pg_temp.g12p_body('shape_diff#1')->>'targetPatternVersion' = '2',
  'the update diff returns the bound of 128 changed paths within 256 KiB against pattern version 2 [P2-S12-AC-115]');

do $bench$
declare v_run integer; v_cursor text := pg_temp.g12p_body('shape_selector#1')->>'nextCursor';
begin
  for v_run in 1..30 loop
    perform pg_temp.g12p_call('selector_page1', 'platform_api.cms_list_pattern_selector', 'owner', pg_temp.g12pp_selector_req(), pg_temp.g12pp_ctx('owner'));
    perform pg_temp.g12p_call('selector_cursor_page', 'platform_api.cms_list_pattern_selector', 'owner',
      pg_temp.g12pp_selector_req(v_cursor), pg_temp.g12pp_ctx('owner'));
    perform pg_temp.g12p_call('latest_flat512', 'platform_api.cms_pattern_latest', 'owner',
      jsonb_build_object('patternKey', 'gp-flat-01'), pg_temp.g12pp_ctx('owner'));
    perform pg_temp.g12p_call('latest_nested512', 'platform_api.cms_pattern_latest', 'owner',
      jsonb_build_object('patternKey', 'gp-nest-01'), pg_temp.g12pp_ctx('owner'));
    perform pg_temp.g12p_call('diff128', 'platform_api.cms_get_instance_update_diff', 'owner', pg_temp.g12pp_diff_req(), pg_temp.g12pp_ctx('owner'));
  end loop;
end;
$bench$;
select ok(pg_temp.g12p_out('selector_cursor_page#1') = 'ok' and jsonb_array_length(pg_temp.g12p_body('selector_cursor_page#1')->'items') = 15
    and pg_temp.g12p_body('selector_cursor_page#1')->'nextCursor' = 'null'::jsonb,
  'the cursor page returns the remaining 15 versions and no further cursor [P2-S12-AC-109]');
