-- Lane claude_s12_db10 (DEC-247): patterns exactly AT the CMS-03C-12 bounds still place (CMS-03C-02) and still pass the publication provider, and the provider
-- aggregates the two re-proved reasons.  Include after phase_02_slice_12_gaps_db9b_legacy_forest/000-world.sqlinc (p1..p9, roots32, l-deep, l-wide, src-valid).
-- The at-bound patterns are REAL producer output: p9 is nested eight levels deep (the deepest nesting CMS-03C-12 accepts) and w16 holds 16 pins of the
-- 32-root pattern roots32 (512 expanded roots, the exact maximum).

-- the same two measurements the db9b facts take (nesting depth by the producer's own closure; block roots by the placement expander)
create or replace function pg_temp.d10_depth(p_label text) returns integer language plpgsql as $body$
declare result integer;
begin
  perform set_config('app.cms_rpc', 'true', true);
  select coalesce(max(closure.nested_depth), 0) into result
    from platform_private.cms_pattern_nested_closure(pg_temp.s09d_id('ownerOrg'),
      (select block_tree from platform_private.cms_pattern_versions where id = (pg_temp.s12pd_body(p_label)->>'id')::uuid)) closure;
  perform set_config('app.cms_rpc', '', true);
  return result;
end;
$body$;
create or replace function pg_temp.d10_roots(p_label text) returns integer language plpgsql as $body$
declare result integer;
begin
  perform set_config('app.cms_rpc', 'true', true);
  select count(*) filter (where nodes.is_root)::integer into result
    from platform_private.cms_pattern_placement_nodes(pg_temp.s09d_id('ownerOrg'),
      (select block_tree from platform_private.cms_pattern_versions where id = (pg_temp.s12pd_body(p_label)->>'id')::uuid),
      array[(pg_temp.s12pd_body(p_label)->>'patternId')::uuid]) nodes;
  perform set_config('app.cms_rpc', '', true);
  return result;
end;
$body$;

select * from pg_temp.s12pl_pattern('w16', 'd10-w16', pg_temp.s12pl_refs('roots32', 16, 'w'));

select pg_temp.s12pl_entry('pl-p9');
select pg_temp.s12pl_run('pl-p9', pg_temp.s12pl_request('pl-p9', 'p9', '/', '{}'::jsonb, 'd10-place-p9'));
select pg_temp.s12pl_entry('pl-w16');
select pg_temp.s12pl_run('pl-w16', pg_temp.s12pl_request('pl-w16', 'w16', '/', '{}'::jsonb, 'd10-place-w16'));

select pg_temp.s12pl_entry('seed-p9');
select * from pg_temp.s12pc_seed('seed-p9', 'seed-p9', pg_temp.s12pu_head('src-valid', '/hero'),
  jsonb_build_object('pattern_id', pg_temp.s12pd_body('p9')->'patternId', 'pattern_version', 1, 'path', '/' || repeat('n1/', 8) || 'hero'));
select pg_temp.s12pl_entry('seed-w16');
select * from pg_temp.s12pc_seed('seed-w16', 'seed-w16', pg_temp.s12pu_head('src-valid', '/hero'),
  jsonb_build_object('pattern_id', pg_temp.s12pd_body('w16')->'patternId', 'pattern_version', 1, 'path', '/w1/root1'));
-- one revision that pins BOTH over-bound patterns (two offending live pins)
select pg_temp.s12pl_entry('seed-both');
select * from pg_temp.s12pc_seed('seed-both-deep', 'seed-both', pg_temp.s12pu_head('src-valid', '/hero'),
  jsonb_build_object('pattern_id', pg_temp.s12pd_body('l-deep')->'patternId', 'pattern_version', 1, 'path', '/' || repeat('n1/', 9) || 'hero'));
select * from pg_temp.s12pc_seed('seed-both-wide', 'seed-both', pg_temp.s12pu_head('src-valid', '/hero'),
  jsonb_build_object('pattern_id', pg_temp.s12pd_body('l-wide')->'patternId', 'pattern_version', 1, 'path', '/w1/root1'));

create temp table d10_provider_out(tag text primary key, result jsonb not null) on commit drop;
insert into d10_provider_out select 'seed-p9', pg_temp.d9l_provider('seed-p9');
insert into d10_provider_out select 'seed-w16', pg_temp.d9l_provider('seed-w16');
insert into d10_provider_out select 'seed-both', pg_temp.d9l_provider('seed-both');
create or replace function pg_temp.d10_pattern(p_tag text) returns jsonb language sql stable as $body$
  select result->'pattern' from d10_provider_out where tag = p_tag $body$;

-- fixtures are what they claim
select is(pg_temp.d10_roots('w16'), 512, 'fixture: w16 expands to exactly 512 block roots, the CMS-03C-12 maximum [P2-S12-AC-211]');
select is(pg_temp.d10_depth('p9'), 8, 'fixture: p9 reaches its deepest nested pin eight levels below it, the CMS-03C-12 maximum [P2-S12-AC-211]');

-- placement: at the bounds is still placed
select is((select state || ':' || coalesce(message, '') from s12pl_out where label = 'pl-p9'), '00000:',
  'CMS-03C-02 still places the pattern nested exactly eight levels deep (the 9th level is the refused one) [P2-S12-AC-211]');
select is((select state || ':' || coalesce(message, '') from s12pl_out where label = 'pl-w16'), '00000:',
  'CMS-03C-02 still places the pattern that expands to exactly 512 block roots (the 513th is the refused one) [P2-S12-AC-211]');
select ok((select after_rows is distinct from before_rows from s12pl_out where label = 'pl-p9')
    and (select after_rows is distinct from before_rows from s12pl_out where label = 'pl-w16'),
  'both at-bound placements wrote rows (the refusals of the RED suite write nothing) [P2-S12-AC-211]');

-- provider: at the bounds still passes
select is(pg_temp.d10_pattern('seed-p9'), '{"outcome": "passed", "category": "pattern", "reasonCode": null, "providerKey": "cms.pattern.active_digest", "blockingCount": 0, "providerVersion": "1"}'::jsonb,
  'the pattern provider still passes a live pin nested exactly eight levels deep [P2-S12-AC-211]');
select is(pg_temp.d10_pattern('seed-w16'), '{"outcome": "passed", "category": "pattern", "reasonCode": null, "providerKey": "cms.pattern.active_digest", "blockingCount": 0, "providerVersion": "1"}'::jsonb,
  'the pattern provider still passes a live pin that expands to exactly 512 block roots [P2-S12-AC-211]');

-- provider aggregation (BE03c 1585): the first reason present in the order, one blocking unit per offending live pin
select is(pg_temp.d10_pattern('seed-both')->>'outcome' || ':' || (pg_temp.d10_pattern('seed-both')->>'reasonCode'), 'failed:pattern_depth_exceeded',
  'two over-bound pins (one too deep, one too wide) report pattern_depth_exceeded first: the order is depth, then nodes [P2-S12-AC-211]');
select is((pg_temp.d10_pattern('seed-both')->>'blockingCount')::integer, 2,
  'each offending live pin is one blocking unit: two over-bound pins count two [P2-S12-AC-211]');
