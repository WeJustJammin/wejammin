-- TEST ONLY: real signed registry/governed/placement producers; no production hooks.
-- Rejected UUID samples roll the COMPLETE real draft call back, never override IDs.
-- Runtime clients reload these pg_temp helpers and the closed fixture actor copies.

create or replace function pg_temp.s12wr_assert(p_ok boolean, p_label text)
returns void language plpgsql as $body$
begin
  if p_ok is distinct from true then raise exception 'writer race fixture: %', p_label; end if;
end;
$body$;

create or replace function pg_temp.s12wr_ordered_draft(
  p_label text, p_expected text, p_low boolean)
returns void language plpgsql as $body$
declare attempt integer; made uuid;
begin
  for attempt in 1..128 loop
    begin
      perform pg_temp.s12pd_run(p_label, pg_temp.s12pd_request('s12wr-race',
        jsonb_build_array(pg_temp.s12pd_block('hero', '[]',
          jsonb_build_object('title', p_label))), p_expected,
        's12wr-' || p_label || '-create', null, p_expected));
      perform pg_temp.s12wr_assert(pg_temp.s12pd_state(p_label) = '00000',
        p_label || ' real CMS-03C-12 draft succeeds');
      made := (pg_temp.s12pd_body(p_label)->>'id')::uuid;
      if (p_low and made < '40000000-0000-0000-0000-000000000000'::uuid)
        or (not p_low and made >= '80000000-0000-0000-0000-000000000000'::uuid) then
        return;
      end if;
      raise exception 'fixture UUID sample rejected' using errcode = 'Z1201';
    exception when sqlstate 'Z1201' then
      -- This subtransaction removes draft, receipt, audit, and captured helper row.
      null;
    end;
  end loop;
  raise exception 'writer race fixture: bounded real-draft UUID sampling exhausted';
end;
$body$;

-- Same submit/assign/approve chain as s12pl_activate, deliberately not activated yet.
create or replace function pg_temp.s12wr_approve(p_label text) returns jsonb
language plpgsql as $body$
declare subject jsonb := pg_temp.s12pd_body(p_label); review jsonb; decision jsonb;
begin
  perform pg_temp.s12pd_run(p_label || ':submit',
    jsonb_build_object('subjectKind', 'pattern_version', 'subjectId', subject->'id',
      'subjectHash', subject->'contentHash', 'idempotencyKey', 's12wr-' || p_label || '-submit',
      'context', pg_temp.s09d_context('owner', true)), 'owner', 'service_role', 'submit');
  perform pg_temp.s12wr_assert(pg_temp.s12pd_state(p_label || ':submit') = '00000', 'V3 submit');
  review := pg_temp.s12pd_body(p_label || ':submit');
  perform pg_temp.s12pd_run(p_label || ':assign',
    jsonb_build_object('reviewId', review->'id', 'action', 'create',
      'expectedVersion', review->'version', 'ifMatch', review->'version',
      'reviewerPersonId', pg_temp.s09d_actor_id('rev1', 'person'),
      'expiresAt', to_char((clock_timestamp() + interval '1 day') at time zone 'UTC',
        'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'), 'reason', 'Writer race fixture',
      'idempotencyKey', 's12wr-' || p_label || '-assign',
      'context', pg_temp.s09d_context('owner', true)), 'owner', 'service_role', 'assign');
  perform pg_temp.s12wr_assert(pg_temp.s12pd_state(p_label || ':assign') = '00000', 'V3 assign');
  perform pg_temp.s12pd_run(p_label || ':decide',
    jsonb_build_object('reviewId', review->'id', 'decision', 'approve',
      'reason', 'Writer race fixture approved', 'expectedVersion', review->'version',
      'ifMatch', review->'version', 'idempotencyKey', 's12wr-' || p_label || '-decide',
      'context', pg_temp.s09d_context('rev1', true)), 'rev1', 'service_role', 'decide');
  perform pg_temp.s12wr_assert(pg_temp.s12pd_state(p_label || ':decide') = '00000', 'V3 approve');
  decision := pg_temp.s12pd_body(p_label || ':decide');
  return jsonb_build_object('reviewId', review->'id', 'action', 'activate',
    'expectedVersion', decision->'version', 'ifMatch', decision->'version',
    'idempotencyKey', 's12wr-' || p_label || '-activate',
    'context', pg_temp.s09d_context('owner', true));
end;
$body$;

-- Real public transport under its effective service role. Only its exception is caught.
create or replace function pg_temp.s12wr_call(p_operation text, p_request jsonb)
returns jsonb language plpgsql as $body$
declare prior_role text := current_setting('role'); prior_user text := current_user;
  answer jsonb; code text := '00000'; msg text; details text; invoked_as text; header_text text;
begin
  if p_operation not in ('writer', 'activate') then raise exception 'unknown writer race operation'; end if;
  perform pg_temp.s09d_session('owner', 'service_role');
  perform set_config('response.headers', '', true);
  begin
    perform set_config('role', 'service_role', true);
    invoked_as := current_user;
    if invoked_as <> 'service_role' then raise exception 'writer race effective role mismatch'; end if;
    begin
      if p_operation = 'writer' then
        answer := platform_api.cms_apply_pattern_update(p_request);
      else
        answer := platform_api.cms_activate_governed_subject(p_request);
      end if;
    exception when others then
      get stacked diagnostics code = returned_sqlstate, msg = message_text, details = pg_exception_detail;
      answer := null;
    end;
    perform set_config('role', prior_role, true);
  exception when others then
    perform set_config('role', prior_role, true);
    raise;
  end;
  perform pg_temp.s12wr_assert(current_user::text = prior_user
    and current_setting('role') = prior_role, 'effective role restored');
  header_text := nullif(current_setting('response.headers', true), '');
  return jsonb_build_object('state', code, 'message', msg, 'detail', details,
    'response', answer, 'headers', header_text, 'callRole', invoked_as, 'roleRestored', true);
end;
$body$;

-- Whole-row images of all existing pattern/entry/authority/effect stores, hashed
-- only for concise private-safe diagnostics. Never compare merely row counts.
create or replace function pg_temp.s12wr_snapshot() returns jsonb
language plpgsql as $body$
declare previous_rpc text := coalesce(current_setting('app.cms_rpc', true), ''); image jsonb; answer jsonb;
begin
  perform set_config('app.cms_rpc', 'true', true);
  image := pg_temp.s12pl_snapshot() || jsonb_build_object('platform_private.person_party',
    (select coalesce(jsonb_agg(to_jsonb(r) order by to_jsonb(r)::text collate "C"), '[]'::jsonb)
      from platform_private.person_party r));
  select jsonb_object_agg(item.key,
    encode(extensions.digest(convert_to(item.value::text, 'UTF8'), 'sha256'), 'hex'))
    into answer from jsonb_each(image) item;
  perform set_config('app.cms_rpc', previous_rpc, true);
  return answer;
exception when others then
  perform set_config('app.cms_rpc', previous_rpc, true);
  raise;
end;
$body$;

create or replace function pg_temp.s12wr_facts() returns jsonb
language plpgsql as $body$
declare world jsonb := (select ids from public.s12wr_world); previous_rpc text := coalesce(current_setting('app.cms_rpc', true), '');
  answer jsonb;
begin
  perform set_config('app.cms_rpc', 'true', true);
  select jsonb_build_object('patterns', (select jsonb_agg(jsonb_build_object(
      'id', p.id, 'version', p.version, 'state', p.state, 'tree', p.block_tree) order by p.version)
    from platform_private.cms_pattern_versions p where p.pattern_id = (world->>'lineage')::uuid),
    'entryVersion', (select version::text from platform_private.cms_content_entries where id = (world->>'entry')::uuid),
    'instances', (select jsonb_agg(jsonb_build_object('id', c.id, 'version', c.version::text,
      'state', c.state, 'pin', c.pattern_version, 'mode', c.link_mode, 'props', c.props,
      'tree', c.detached_tree) order by c.version) from platform_private.cms_composition_instances c
      where c.revision_id = (world->>'revision')::uuid)) into answer;
  perform set_config('app.cms_rpc', previous_rpc, true);
  return answer;
exception when others then
  perform set_config('app.cms_rpc', previous_rpc, true);
  raise;
end;
$body$;
