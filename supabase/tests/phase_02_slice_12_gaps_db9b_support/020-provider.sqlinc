-- Lane claude_s12_db9b shared helper: pg_temp.d9l_provider(tag, phase) runs the real dependency-manifest builder, the frozen-status check and the real
-- preflight evaluator on the revision of a placement tag and returns {code, message, status, pattern} where `pattern` is the result of the pattern category
-- (the cms.pattern.active_digest provider).
create or replace function pg_temp.d9l_provider(p_tag text, p_phase text default 'publish') returns jsonb language plpgsql as $body$
declare manifest jsonb; status text; report jsonb; code text := '00000'; msg text; prior_rpc text := coalesce(current_setting('app.cms_rpc', true), '');
begin
  perform set_config('app.cms_rpc', 'true', true);
  begin
    manifest := platform_private.cms_build_dependency_manifest(pg_temp.s12pl_rev(p_tag));
    status := platform_private.cms_frozen_dependencies_status(pg_temp.s12pl_rev(p_tag), manifest);
    report := platform_private.cms_evaluate_preflight(jsonb_build_object('phase', p_phase, 'revisionId', pg_temp.s12pl_rev(p_tag),
      'actingPartyId', pg_temp.s09d_id('ownerOrg'), 'actorPersonId', pg_temp.s09d_actor_id('owner', 'person'), 'frozenManifest', manifest,
      'effectiveAt', to_char(clock_timestamp() at time zone 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.US"Z"')));
  exception when others then get stacked diagnostics code = returned_sqlstate, msg = message_text;
  end;
  perform set_config('app.cms_rpc', prior_rpc, true);
  return jsonb_build_object('code', code, 'message', msg, 'status', status,
    'pattern', (select item from jsonb_array_elements(coalesce(report->'results', '[]'::jsonb)) item where item->>'category' = 'pattern'));
end;
$body$;
