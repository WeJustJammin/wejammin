-- CS-PAYLOAD guarded consumer bootstrap BEGIN
-- Consumer-only copy of the existing guarded bootstrap. These revisions have
-- zero field values: payload_hash is JCS({}) at INSERT, never a later mutation.
create or replace function pg_temp.s12pl_entry(
  p_tag text, p_template uuid default null, p_assignee text default 'owner', p_type_ordinal integer default 1)
returns uuid
language plpgsql
as $body$
declare
  entry_uuid uuid := extensions.gen_random_uuid();
  revision_uuid uuid := extensions.gen_random_uuid();
  org uuid := pg_temp.s09d_id('ownerOrg');
  stamp timestamptz := timestamptz '2026-10-08T12:00:00Z';
begin
  perform set_config('app.cms_rpc', 'true', true);
  insert into platform_private.cms_content_entries(
    id, owner_id, content_type_id, owner_party_id, lifecycle, current_draft_revision_id, version,
    created_by, created_at, updated_at)
  values (entry_uuid, org, (select id from s12pd_types where ordinal = p_type_ordinal), org, 'active', null, 1,
    (select auth_user_id from s09d_actor where key = 'owner'), stamp, stamp);
  insert into platform_private.cms_entry_revisions(
    id, owner_id, entry_id, revision_number, schema_version_id, template_version_id, taxonomy_version_ids,
    parent_revision_ids, locale, payload_hash, author_person_id, acting_party_id, state, version,
    validation_state, validation_report, created_at, updated_at)
  values (revision_uuid, org, entry_uuid, 1, (select version_id from s12pd_types where ordinal = p_type_ordinal),
    p_template, '[]'::jsonb, '[]'::jsonb, 'en-US',
    platform_private.cms_jcs_sha256('{}'::jsonb),
    (select person_id from s09d_actor where key = 'owner'), org, 'draft', 1, 'valid', '{}'::jsonb, stamp, stamp);
  update platform_private.cms_content_entries set current_draft_revision_id = revision_uuid where id = entry_uuid;
  if p_assignee is not null then
    insert into platform_private.cms_entry_assignments(
      owner_id, entry_id, assignee_person_id, capability_key, state, version, created_at, updated_at)
    values (org, entry_uuid, (select person_id from s09d_actor where key = p_assignee), 'cms.author', 'active', 1,
      stamp, stamp);
  end if;
  insert into s12pl_ids(key, value) values (p_tag || ':entry', entry_uuid::text), (p_tag || ':revision', revision_uuid::text);
  return revision_uuid;
end;
$body$;

