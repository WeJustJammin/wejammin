-- Shared world helpers for the governed-a suites (CMS-03C-07, -08, -10, -11).  Include AFTER the S09 DEC-108
-- fragments (00-helpers, 01-actors, 02-chain), the DEC-119 support and governed_submit/000-fixtures.sqlinc +
-- 005-real-type-chains.sqlinc (real owner initialization, real designer/specialist grants, two real active
-- types).  Everything here is pg_temp and dies with the rolled-back transaction; nothing writes a governed row
-- except through the named platform_api RPCs, called under the real service_role.

create temp table s12ga_rcpt(
  ordinal bigint generated always as identity, label text not null, body jsonb, state text, message text,
  detail text, rpc_user text, before_user text, after_user text) on commit drop;

-- Verified server-actor envelope exactly as the Worker sends it (no acting-context binding id is needed by the
-- governed commands; the step-up claim is the recent binding-bound MFA proof).
create or replace function pg_temp.s12ga_ctx(
  p_actor text, p_step_age interval default interval '1 minute', p_step boolean default true
) returns jsonb language sql volatile as $body$
  select jsonb_strip_nulls(jsonb_build_object(
    'authUserId', a.auth_user_id, 'sessionId', extensions.gen_random_uuid(),
    'actorPersonId', a.person_id, 'actingPartyId', a.party_id,
    'requestId', extensions.gen_random_uuid(), 'correlationId', extensions.gen_random_uuid())
    || case when p_step then jsonb_build_object('stepUpVerified', true, 'stepUpAt', clock_timestamp() - p_step_age)
            else '{}'::jsonb end)
  from s09d_actor a where a.key = p_actor
$body$;

-- One command under the REAL service_role.  Only the RPC call is caught; the role switch and its restoration
-- are outside the handler.  SQLSTATE, message and DETAIL are retained.
create or replace function pg_temp.s12ga_rpc(
  p_label text, p_function text, p_actor text, p_request jsonb, p_ctx jsonb default null
) returns void language plpgsql security invoker as $body$
declare
  v_user text := current_user; v_role text := current_setting('role'); v_rpc_user text;
  v_response jsonb; v_state text := '00000'; v_message text; v_detail text; v_request jsonb;
begin
  perform pg_temp.s09d_session(p_actor);
  v_request := p_request || jsonb_build_object('context', coalesce(p_ctx, pg_temp.s12ga_ctx(p_actor)));
  execute 'set local role service_role';
  v_rpc_user := current_user;
  begin
    execute format('select %s($1)', p_function) into v_response using v_request;
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_message = message_text, v_detail = pg_exception_detail;
  end;
  perform set_config('role', v_role, true);
  if current_user is distinct from v_user or current_setting('role') is distinct from v_role then
    raise exception 'governed-a RPC role restoration failed';
  end if;
  insert into pg_temp.s12ga_rcpt(label, body, state, message, detail, rpc_user, before_user, after_user)
  values (p_label, v_response, v_state, v_message, v_detail, v_rpc_user, v_user, current_user);
end;
$body$;

-- Latest receipt of a label.
create or replace function pg_temp.s12ga_state(p_label text) returns text language sql stable as $body$
  select state from s12ga_rcpt where label = p_label order by ordinal desc limit 1 $body$;
create or replace function pg_temp.s12ga_msg(p_label text) returns text language sql stable as $body$
  select message from s12ga_rcpt where label = p_label order by ordinal desc limit 1 $body$;
create or replace function pg_temp.s12ga_det(p_label text) returns text language sql stable as $body$
  select detail from s12ga_rcpt where label = p_label order by ordinal desc limit 1 $body$;
create or replace function pg_temp.s12ga_body(p_label text) returns jsonb language sql stable as $body$
  select body from s12ga_rcpt where label = p_label order by ordinal desc limit 1 $body$;
-- 'ok' for a success, else '<sqlstate>:<message>' (the whole refusal identity in one string).
create or replace function pg_temp.s12ga_out(p_label text) returns text language sql stable as $body$
  select case when state = '00000' then 'ok' else state || ':' || message end
    from s12ga_rcpt where label = p_label order by ordinal desc limit 1 $body$;

create or replace function pg_temp.s12ga_person(p_actor text) returns uuid language sql stable as $body$
  select person_id from s09d_actor where key = p_actor $body$;
create or replace function pg_temp.s12ga_auth(p_actor text) returns uuid language sql stable as $body$
  select auth_user_id from s09d_actor where key = p_actor $body$;
create or replace function pg_temp.s12ga_org() returns uuid language sql stable as $body$
  select pg_temp.s09d_id('ownerOrg') $body$;
create or replace function pg_temp.s12ga_iso(p_at timestamptz) returns text language sql stable as $body$
  select to_char(p_at at time zone 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') $body$;
create or replace function pg_temp.s12ga_rver(p_review uuid) returns text language sql stable as $body$
  select version::text from platform_private.cms_governed_reviews where id = p_review $body$;

-- A draft template through the real CMS-03C-01 command, minted by p_creator (a designer in the owner party).
create or replace function pg_temp.s12ga_mint(p_tag text, p_creator text, p_types text[])
returns uuid language plpgsql as $body$
declare v_response jsonb; v_subject uuid;
begin
  perform pg_temp.s12ga_rpc('mint:' || p_tag, 'platform_api.cms_define_template', p_creator, jsonb_build_object(
    'templateKey', 's12ga-' || p_tag,
    'compatibleTypeIds', (select jsonb_agg(bound.id order by bound.id) from (
       select (select value::uuid from s12gov_ids where key = k) as id from unnest(p_types) k) bound),
    'slots', '[]'::jsonb,
    'reservedRegions', jsonb_build_array('header', 'now', 'record', 'detail', 'provenance'),
    'bindings', '{}'::jsonb, 'locale', 'en-US', 'audience', 'public', 'expectedVersion', null,
    'idempotencyKey', 's12ga-mint-' || p_tag));
  v_response := pg_temp.s12ga_body('mint:' || p_tag);
  if v_response is null or v_response->>'state' is distinct from 'draft' then
    raise exception 'governed-a fixture: the real template producer did not return a draft for %: %',
      p_tag, pg_temp.s12ga_out('mint:' || p_tag);
  end if;
  v_subject := (v_response->>'id')::uuid;
  insert into s12gov_ids(key, value) values (p_tag || ':subject', v_subject::text)
    on conflict (key) do update set value = excluded.value;
  return v_subject;
end;
$body$;

-- CMS-03C-06 submit of a minted template by p_submitter; records '<tag>:review'.
create or replace function pg_temp.s12ga_submit(p_tag text, p_submitter text)
returns uuid language plpgsql as $body$
declare v_subject uuid := (select value::uuid from s12gov_ids where key = p_tag || ':subject'); v_review uuid;
begin
  perform pg_temp.s12ga_rpc('submit:' || p_tag, 'platform_api.cms_submit_governed_review', p_submitter,
    jsonb_build_object('subjectKind', 'template_version', 'subjectId', v_subject,
      'subjectHash', (select content_hash::text from platform_private.cms_template_versions where id = v_subject),
      'idempotencyKey', 's12ga-submit-' || p_tag));
  if pg_temp.s12ga_state('submit:' || p_tag) <> '00000' then
    raise exception 'governed-a fixture: the real submit producer failed for %: %', p_tag, pg_temp.s12ga_out('submit:' || p_tag);
  end if;
  v_review := (pg_temp.s12ga_body('submit:' || p_tag)->>'id')::uuid;
  insert into s12gov_ids(key, value) values (p_tag || ':review', v_review::text)
    on conflict (key) do update set value = excluded.value;
  return v_review;
end;
$body$;

create or replace function pg_temp.s12ga_open(p_tag text, p_creator text, p_types text[], p_submitter text)
returns uuid language plpgsql as $body$
begin
  perform pg_temp.s12ga_mint(p_tag, p_creator, p_types);
  return pg_temp.s12ga_submit(p_tag, p_submitter);
end;
$body$;
create or replace function pg_temp.s12ga_review(p_tag text) returns uuid language sql stable as $body$
  select value::uuid from s12gov_ids where key = p_tag || ':review' $body$;
create or replace function pg_temp.s12ga_subject(p_tag text) returns uuid language sql stable as $body$
  select value::uuid from s12gov_ids where key = p_tag || ':subject' $body$;

-- CMS-03C-08 create.  expectedVersion = ifMatch = the review's current version unless patched.
create or replace function pg_temp.s12ga_assign(
  p_label text, p_actor text, p_review uuid, p_reviewer text, p_for interval default interval '1 hour',
  p_patch jsonb default '{}'::jsonb, p_unset text[] default array[]::text[], p_ctx jsonb default null
) returns void language plpgsql as $body$
declare v_version text := pg_temp.s12ga_rver(p_review);
begin
  perform pg_temp.s12ga_rpc(p_label, 'platform_api.cms_assign_governed_reviewer', p_actor,
    (jsonb_build_object('reviewId', p_review, 'action', 'create', 'expectedVersion', v_version, 'ifMatch', v_version,
       'reviewerPersonId', pg_temp.s12ga_person(p_reviewer),
       'expiresAt', pg_temp.s12ga_iso(clock_timestamp() + p_for), 'idempotencyKey', 's12ga-' || p_label) || p_patch)
      - p_unset, p_ctx);
end;
$body$;

-- CMS-03C-08 revoke of the active assignment of p_reviewer on the review.
create or replace function pg_temp.s12ga_revoke(
  p_label text, p_actor text, p_review uuid, p_assignment uuid,
  p_patch jsonb default '{}'::jsonb, p_unset text[] default array[]::text[], p_ctx jsonb default null
) returns void language plpgsql as $body$
declare v_version text := pg_temp.s12ga_rver(p_review);
begin
  perform pg_temp.s12ga_rpc(p_label, 'platform_api.cms_assign_governed_reviewer', p_actor,
    (jsonb_build_object('reviewId', p_review, 'action', 'revoke', 'expectedVersion', v_version, 'ifMatch', v_version,
       'assignmentId', p_assignment, 'idempotencyKey', 's12ga-' || p_label) || p_patch) - p_unset, p_ctx);
end;
$body$;

-- CMS-03C-07.
create or replace function pg_temp.s12ga_decide(
  p_label text, p_actor text, p_review uuid, p_decision text,
  p_reason text default 'Reviewed against the frozen policy basis.',
  p_patch jsonb default '{}'::jsonb, p_unset text[] default array[]::text[], p_ctx jsonb default null
) returns void language plpgsql as $body$
declare v_version text := pg_temp.s12ga_rver(p_review);
begin
  perform pg_temp.s12ga_rpc(p_label, 'platform_api.cms_record_governed_decision', p_actor,
    (jsonb_build_object('reviewId', p_review, 'decision', p_decision, 'reason', p_reason,
       'expectedVersion', v_version, 'ifMatch', v_version, 'idempotencyKey', 's12ga-' || p_label) || p_patch)
      - p_unset, p_ctx);
end;
$body$;

-- CMS-03C-10 and CMS-03C-11 (reads: no step-up claim is sent).
create or replace function pg_temp.s12ga_get(p_label text, p_actor text, p_review uuid, p_patch jsonb default '{}'::jsonb)
returns void language plpgsql as $body$
begin
  perform pg_temp.s12ga_rpc(p_label, 'platform_api.cms_get_governed_review', p_actor,
    jsonb_build_object('reviewId', p_review) || p_patch, pg_temp.s12ga_ctx(p_actor, interval '1 minute', false));
end;
$body$;
create or replace function pg_temp.s12ga_list(p_label text, p_actor text, p_query jsonb default '{}'::jsonb)
returns void language plpgsql as $body$
begin
  perform pg_temp.s12ga_rpc(p_label, 'platform_api.cms_list_governed_reviews', p_actor, p_query,
    pg_temp.s12ga_ctx(p_actor, interval '1 minute', false));
end;
$body$;

-- Scoped store digest a refusal or a safe read must leave identical.  Review, assignments, decisions and the
-- subject row are hashed by FULL content in deterministic order; idempotency rows by full content; audit and
-- outbox by count (append-only).  A scoped no-effect check, not a universal atomicity proof.
create or replace function pg_temp.s12ga_snap(p_review uuid)
returns text language sql stable security definer set search_path = '' as $body$
  select jsonb_build_object(
    'review', (select pg_catalog.to_jsonb(r)::text from platform_private.cms_governed_reviews r where r.id = p_review),
    'assignments', (select coalesce(pg_catalog.string_agg(pg_catalog.to_jsonb(a)::text, '|' order by a.id), '')
                      from platform_private.cms_governed_review_assignments a where a.review_id = p_review),
    'decisions', (select coalesce(pg_catalog.string_agg(pg_catalog.to_jsonb(d)::text, '|' order by d.id), '')
                    from platform_private.cms_governed_review_decisions d where d.review_id = p_review),
    'dependencies', (select coalesce(pg_catalog.string_agg(pg_catalog.to_jsonb(d)::text, '|' order by d.kind, d.ref_id), '')
                       from platform_private.cms_governed_review_dependencies d where d.review_id = p_review),
    'subject', (select pg_catalog.to_jsonb(t)::text from platform_private.cms_template_versions t
                 where t.id = (select r.subject_id from platform_private.cms_governed_reviews r where r.id = p_review)),
    'idempotency', (select pg_catalog.md5(coalesce(pg_catalog.string_agg(pg_catalog.to_jsonb(i)::text, '|' order by i.id), ''))
                      from platform_private.idempotency_records i),
    'audit', (select pg_catalog.count(*) from audit_private.audit_events),
    'outbox', (select pg_catalog.count(*) from platform_private.outbox_events)
  )::text
$body$;

create temp table s12ga_snaps(label text primary key, snapshot text not null) on commit drop;
create or replace function pg_temp.s12ga_mark(p_label text, p_review uuid) returns void language sql as $body$
  insert into s12ga_snaps(label, snapshot) values (p_label, pg_temp.s12ga_snap(p_review))
  on conflict (label) do update set snapshot = excluded.snapshot $body$;
create or replace function pg_temp.s12ga_same(p_label text, p_review uuid) returns boolean language sql stable as $body$
  select pg_temp.s12ga_snap(p_review) = (select snapshot from s12ga_snaps where label = p_label) $body$;

-- Number of idempotency records a key left for an operation (the reservation oracle).
create or replace function pg_temp.s12ga_reserved(p_operation text, p_key text) returns bigint language sql stable as $body$
  select count(*) from platform_private.idempotency_records
   where operation = p_operation and key_hash = platform_private.cms_key_hash('s12ga-' || p_key) $body$;
create or replace function pg_temp.s12ga_audit(p_action text, p_target uuid) returns bigint language sql stable as $body$
  select count(*) from audit_private.audit_events where action = p_action and target_id = p_target $body$;

-- Direct grants of a capability to a test human through the real CMS-03A-15 command (membership provisioning
-- is the labelled fixture forgery of s09d_grant_via_rpc).
create or replace function pg_temp.s12ga_grant(p_actor text, p_capability text, p_days integer default 1)
returns text language sql as $body$
  select pg_temp.s09d_grant_via_rpc(p_actor, p_capability, p_days) $body$;

-- Bodies kept under a name so a later replay can be compared with the original.
create temp table s12ga_keep(name text primary key, body jsonb) on commit drop;
create or replace function pg_temp.s12ga_keep(p_name text, p_label text) returns void language sql as $body$
  insert into s12ga_keep(name, body) values (p_name, pg_temp.s12ga_body(p_label))
  on conflict (name) do update set body = excluded.body $body$;
create or replace function pg_temp.s12ga_kept(p_name text) returns jsonb language sql stable as $body$
  select body from s12ga_keep where name = p_name $body$;

-- SQLSTATE of calling a statement as another database role ('00000' when it ran), role restored.
create or replace function pg_temp.s12ga_denied(p_role text, p_call text)
returns text language plpgsql as $body$
declare v_role text := current_setting('role'); v_state text := '00000';
begin
  execute 'set local role ' || quote_ident(p_role);
  begin
    execute p_call;
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate;
  end;
  perform set_config('role', v_role, true);
  return v_state;
end;
$body$;

-- Thirteen more owner-party humans (x01 .. x13), each bootstrapped through the real account command, a
-- confirmed member of the owner organization and granted cms.reviewer by the real CMS-03A-15 command.
create or replace function pg_temp.s12ga_pool(p_count integer) returns integer language plpgsql as $body$
declare v_n integer; v_key text; v_id uuid; v_ok integer := 0;
begin
  for v_n in 1..p_count loop
    v_key := 'x' || lpad(v_n::text, 2, '0');
    v_id := ('a12a0000-0000-4000-8000-' || lpad(v_n::text, 10, '0') || '00')::uuid;
    insert into auth.users(id, email, email_confirmed_at)
    values (v_id, 's12ga-' || v_key || '@example.test', clock_timestamp());
    perform platform_api.auth_bootstrap(v_id,
      decode(md5('s12ga-k' || v_n) || md5('s12ga-K' || v_n), 'hex'),
      decode(md5('s12ga-r' || v_n) || md5('s12ga-R' || v_n), 'hex'),
      ('a12a0000-0000-4000-8000-' || lpad(v_n::text, 10, '0') || '10')::uuid,
      ('a12a0000-0000-4000-8000-' || lpad(v_n::text, 10, '0') || '20')::uuid);
    insert into s09d_actor(key, auth_user_id, person_id, party_id)
    select v_key, v_id, binding.person_id, pg_temp.s09d_id('ownerOrg')
      from identity.auth_user_bindings binding where binding.auth_user_id = v_id;
    if pg_temp.s09d_grant_via_rpc(v_key, 'cms.reviewer', 1) = 'OK' then v_ok := v_ok + 1; end if;
  end loop;
  return v_ok;
end;
$body$;

-- The id of the active assignment of a reviewer on a review.
create or replace function pg_temp.s12ga_aid(p_review uuid, p_reviewer text) returns uuid language sql stable as $body$
  select id from platform_private.cms_governed_review_assignments
   where review_id = p_review and reviewer_person_id = pg_temp.s12ga_person(p_reviewer) and state = 'active' $body$;
-- The (single) decision row of a reviewer on a review.
create or replace function pg_temp.s12ga_drow(p_review uuid, p_reviewer text)
returns platform_private.cms_governed_review_decisions language sql stable as $body$
  select d.* from platform_private.cms_governed_review_decisions d
   where d.review_id = p_review and d.reviewer_person_id = pg_temp.s12ga_person(p_reviewer) $body$;
-- Rows of the GovernedReviewResource, in key order, as one string.
create or replace function pg_temp.s12ga_keys(p_body jsonb) returns text language sql immutable as $body$
  select string_agg(key, ',' order by key collate "C") from jsonb_object_keys(p_body) key $body$;

-- Direct calls of the private SECURITY DEFINER helpers need the RPC context a command would hold (the forced-RLS tables answer no
-- row without it); s09d_scalar holds it for the statement only and restores it.
create or replace function pg_temp.s12ga_approvals(p_review uuid) returns integer language sql as $body$
  select pg_temp.s09d_scalar(format('select platform_private.cms_governed_review_distinct_approvals(%L)::text', p_review))::integer $body$;
create or replace function pg_temp.s12ga_frozen(p_review uuid) returns text language sql as $body$
  select pg_temp.s09d_scalar(format('select platform_private.cms_governed_frozen_status(%L)', p_review)) $body$;
