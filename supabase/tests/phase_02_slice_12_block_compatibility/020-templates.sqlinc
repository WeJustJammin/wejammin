-- CMS-03C-01 template definition over real chains.  IA03 45 and 66, BE03c 1606: every referenced block version is
-- registered and currently SUPPORTED; BE03c 209 and 321: an incompatible block fails closed.  Unknown or
-- incompatible: VALIDATION_FAILED; not supported (deprecated or withdrawn): CONFLICT.
create or replace function pg_temp.bc_template(p_label text, p_block text, p_types jsonb) returns void
language plpgsql as $body$
begin
  perform pg_temp.s09d_session('owner');
  perform pg_temp.s09d_call('tpl:' || p_label, 'platform_api.cms_define_template',
    jsonb_build_object('templateKey', 'bct-' || p_label,
      'compatibleTypeIds', p_types,
      'slots', jsonb_build_array(jsonb_build_object('key', 'primary', 'required', true,
        'allowedBlocks', jsonb_build_array(jsonb_build_object('blockKey', p_block, 'blockVersion', 1)),
        'maxCount', 1)),
      'reservedRegions', jsonb_build_array('header', 'now', 'record', 'detail', 'provenance'),
      'bindings', '{}'::jsonb, 'locale', 'en-US', 'audience', 'public', 'expectedVersion', null,
      'idempotencyKey', 'bct-' || p_label || '-0001',
      'context', pg_temp.s09d_context('owner', true)));
end;
$body$;
create or replace function pg_temp.bc_template_rows() returns integer language sql stable as $body$
  select count(*)::integer from platform_private.cms_template_versions $body$;

select pg_temp.bc_template('exact', 'bc.exact', pg_temp.bc_types(pg_temp.bc_t1()));
select is(pg_temp.s09d_outcome('tpl:exact'), 'OK',
  'a template slot over a block whose range covers the real type compiler_version is admitted [P2-S12-AC-001]');
select is(pg_temp.s09d_resp('tpl:exact')->>'blockRegistryDigest',
  platform_private.cms_jcs_sha256(jsonb_build_array(jsonb_build_object(
    'blockKey', 'bc.exact', 'blockVersion', 1, 'releaseDigest', repeat('e', 64),
    'propsSchemaHash', repeat('a', 64), 'rendererRef', 'cms/renderers/hero/1', 'lifecycle', 'supported'))),
  'the template digest is the unchanged server-derived safe tuple hash [P2-S12-AC-001]');
select pg_temp.bc_template('wide', 'bc.wide', pg_temp.bc_types(pg_temp.bc_t1(), pg_temp.bc_c19()));
select is(pg_temp.s09d_outcome('tpl:wide'), 'OK',
  'range 1.0.0..1.9 covers a real type (1) and a 1.9 type: dotted-numeric order [P2-S12-AC-001]');
select pg_temp.bc_template('two-real', 'bc.exact', pg_temp.bc_types(pg_temp.bc_t1(), pg_temp.bc_t2()));
select is(pg_temp.s09d_outcome('tpl:two-real'), 'OK',
  'two real compiled types that satisfy the range are both compatible [P2-S12-AC-001]');
select pg_temp.bc_template('high-c19', 'bc.high', pg_temp.bc_types(pg_temp.bc_c19()));
select is(pg_temp.s09d_outcome('tpl:high-c19'), 'OK',
  'range 1.9..1.9 covers a type compiled at 1.9 [P2-S12-AC-001]');

create temp table bc_template_baseline(rows integer) on commit drop;
insert into bc_template_baseline select pg_temp.bc_template_rows();
select pg_temp.bc_template('high-t1', 'bc.high', pg_temp.bc_types(pg_temp.bc_t1()));
select is(pg_temp.s09d_outcome('tpl:high-t1'), 'VALIDATION_FAILED',
  'range 1.9..1.9 does not cover compiler_version 1 [P2-S12-AC-001]');
select pg_temp.bc_template('exact-c19', 'bc.exact', pg_temp.bc_types(pg_temp.bc_c19()));
select is(pg_temp.s09d_outcome('tpl:exact-c19'), 'VALIDATION_FAILED',
  'range 1..1 does not cover a type compiled at 1.9 [P2-S12-AC-001]');
select pg_temp.bc_template('exact-one-of-two', 'bc.exact', pg_temp.bc_types(pg_temp.bc_t1(), pg_temp.bc_c19()));
select is(pg_temp.s09d_outcome('tpl:exact-one-of-two'), 'VALIDATION_FAILED',
  'EVERY compatibleTypeIds member must be covered: one out-of-range type refuses the template [P2-S12-AC-001]');
select pg_temp.bc_template('inverted', 'bc.inverted', pg_temp.bc_types(pg_temp.bc_t1()));
select is(pg_temp.s09d_outcome('tpl:inverted'), 'VALIDATION_FAILED',
  'an inverted range covers nothing [P2-S12-AC-001]');
select pg_temp.bc_template('wide-c2', 'bc.wide', pg_temp.bc_types(pg_temp.bc_c2()));
select is(pg_temp.s09d_outcome('tpl:wide-c2'), 'VALIDATION_FAILED',
  'an artifact compiler_version outside the closed compiler registry fails closed [P2-S12-AC-001]');
select pg_temp.bc_template('badvalue', 'bc.badvalue', pg_temp.bc_types(pg_temp.bc_t1()));
select is(pg_temp.s09d_outcome('tpl:badvalue'), 'VALIDATION_FAILED',
  'a range bound outside the closed compiler registry fails closed [P2-S12-AC-001]');
select pg_temp.bc_template('minonly', 'bc.minonly', pg_temp.bc_types(pg_temp.bc_t1()));
select is(pg_temp.s09d_outcome('tpl:minonly'), 'VALIDATION_FAILED',
  'a range lacking maxSchemaCompiler fails closed [P2-S12-AC-001]');
select pg_temp.bc_template('empty', 'bc.empty', pg_temp.bc_types(pg_temp.bc_t1()));
select is(pg_temp.s09d_outcome('tpl:empty'), 'VALIDATION_FAILED',
  'an empty range object fails closed [P2-S12-AC-001]');
select pg_temp.bc_template('missing', 'bc.nonesuch', pg_temp.bc_types(pg_temp.bc_t1()));
select is(pg_temp.s09d_outcome('tpl:missing'), 'VALIDATION_FAILED',
  'an unregistered block is refused [P2-S12-AC-001]');
select pg_temp.bc_template('deprecated', 'bc.dep', pg_temp.bc_types(pg_temp.bc_t1()));
select is(pg_temp.s09d_outcome('tpl:deprecated'), 'CONFLICT',
  'a template refuses a DEPRECATED block (supported only), unlike a pattern [P2-S12-AC-001]');
select pg_temp.bc_template('withdrawn', 'bc.wd', pg_temp.bc_types(pg_temp.bc_t1()));
select is(pg_temp.s09d_outcome('tpl:withdrawn'), 'CONFLICT',
  'a template refuses a WITHDRAWN block [P2-S12-AC-001]');
select is(pg_temp.bc_template_rows(), (select rows from bc_template_baseline),
  'every refused template stored nothing [P2-S12-AC-001]');
