-- CMS-03B-18 request builders and call probe (lane S11-3a).  Include after 000-world.sqlinc.

-- A well-formed assignment request for the review under its CURRENT version.  `create`
-- names reviewer rvA and an expiry six hours out; p_extra overrides any member and
-- p_drop removes members, so one function builds every malformed variant.
create or replace function pg_temp.r11_areq(
  p_review text, p_action text, p_extra jsonb default '{}'::jsonb, p_drop text[] default '{}'::text[]
)
returns jsonb
language sql
as $body$
  select ((
    jsonb_build_object(
      'reviewId', pg_temp.s11_id(p_review), 'action', p_action,
      'expectedVersion', review.version::text, 'ifMatch', review.version::text,
      'idempotencyKey', 'r11-' || replace(extensions.gen_random_uuid()::text, '-', ''),
      'context', pg_temp.r11_ctx()
    )
    || case when p_action = 'create' then jsonb_build_object(
         'reviewerPersonId', pg_temp.s11_id('rvA'),
         'expiresAt', to_char((clock_timestamp() + interval '6 hours') at time zone 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'))
       else '{}'::jsonb end
    || p_extra) - p_drop)
  from platform_private.cms_editorial_reviews review
  where review.id = pg_temp.s11_id(p_review)
$body$;

-- Call platform_api.cms_assign_editorial_reviewer as p_actor and record the probe.
create or replace function pg_temp.r11_acall(
  p_label text, p_actor text, p_request jsonb, p_keep boolean default true
)
returns void
language plpgsql
as $body$
begin
  perform pg_temp.r11_session(p_actor);
  perform pg_temp.r11_try(p_label,
    format('select platform_api.cms_assign_editorial_reviewer(%L::jsonb)', p_request::text), p_keep);
end;
$body$;
