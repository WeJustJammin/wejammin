-- The refs of a nested pattern node list pinning a defined pattern label p_count times is s12v4p_refs in the recheck suite; the pattern
-- fixtures here define their own to stay independent of it.
create or replace function pg_temp.g2p_refs(p_label text) returns jsonb language sql stable as $body$
  select jsonb_build_array(jsonb_build_object('kind', 'pattern', 'key', 'nested1',
    'patternId', pg_temp.s12pd_body(p_label)->'patternId', 'patternVersion', pg_temp.s12pd_body(p_label)->'patternVersion'))
$body$;
-- A governed command for a defined pattern label: p_op in submit, assign, decide, activate, schedule.
create or replace function pg_temp.g2p_cmd(p_label text, p_op text, p_actor text default 'owner') returns void language plpgsql as $body$
declare
  body jsonb := pg_temp.s12pd_body(p_label);
  review jsonb := pg_temp.s12pd_body(p_label || ':submit');
  decision jsonb := pg_temp.s12pd_body(p_label || ':decide');
  at_utc timestamp := (clock_timestamp() + interval '120 seconds') at time zone 'UTC';
begin
  if p_op = 'submit' then
    perform pg_temp.s12pd_run(p_label || ':submit', jsonb_build_object('subjectKind', 'pattern_version', 'subjectId', body->'id',
      'subjectHash', body->'contentHash', 'idempotencyKey', 'g2p-' || p_label || '-submit',
      'context', pg_temp.s09d_context('owner', true)), 'owner', 'service_role', 'submit');
  elsif p_op = 'assign' then
    perform pg_temp.s12pd_run(p_label || ':assign', jsonb_build_object('reviewId', review->'id', 'action', 'create',
      'expectedVersion', review->'version', 'ifMatch', review->'version',
      'reviewerPersonId', pg_temp.s09d_actor_id('rev1', 'person'),
      'expiresAt', to_char((clock_timestamp() + interval '1 day') at time zone 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
      'reason', 'gap fixture', 'idempotencyKey', 'g2p-' || p_label || '-assign',
      'context', pg_temp.s09d_context('owner', true)), 'owner', 'service_role', 'assign');
  elsif p_op = 'decide' then
    perform pg_temp.s12pd_run(p_label || ':decide', jsonb_build_object('reviewId', review->'id', 'decision', 'approve',
      'reason', 'gap fixture approved', 'expectedVersion', review->'version', 'ifMatch', review->'version',
      'idempotencyKey', 'g2p-' || p_label || '-decide', 'context', pg_temp.s09d_context('rev1', true)), 'rev1', 'service_role', 'decide');
  elsif p_op in ('activate', 'schedule') then
    perform pg_temp.s12pd_run(p_label || ':' || p_op, jsonb_build_object('reviewId', review->'id', 'action', p_op,
      'expectedVersion', decision->'version', 'ifMatch', decision->'version',
      'idempotencyKey', 'g2p-' || p_label || '-' || p_op, 'context', pg_temp.s09d_context('owner', true))
      || case when p_op = 'schedule' then jsonb_build_object('activateAt', jsonb_build_object(
          'localDateTime', to_char(at_utc, 'YYYY-MM-DD"T"HH24:MI:SS.US'), 'timezone', 'UTC',
          'resolvedUtc', to_char(at_utc, 'YYYY-MM-DD"T"HH24:MI:SS.US"Z"'),
          'tzdbVersion', platform_private.cms_tzdb_version(), 'disambiguation', 'none')) else '{}'::jsonb end,
      'owner', 'service_role', 'activate');
  else
    raise exception 'unknown governed pattern command %', p_op;
  end if;
end;
$body$;
-- define + submit + assign + decide (approved), then optionally activate.
create or replace function pg_temp.g2p_step(p_label text, p_upto text) returns void language plpgsql as $body$
begin
  perform pg_temp.g2p_cmd(p_label, 'submit');
  if p_upto = 'submit' then return; end if;
  perform pg_temp.g2p_cmd(p_label, 'assign');
  perform pg_temp.g2p_cmd(p_label, 'decide');
  if p_upto = 'activate' then perform pg_temp.g2p_cmd(p_label, 'activate'); end if;
end;
$body$;
create or replace function pg_temp.g2p_review(p_label text) returns uuid language sql stable as $body$
  select (pg_temp.s12pd_body(p_label || ':submit')->>'id')::uuid $body$;
create or replace function pg_temp.g2p_rv(p_label text) returns platform_private.cms_governed_reviews language sql stable as $body$
  select r from platform_private.cms_governed_reviews r where r.id = pg_temp.g2p_review(p_label) $body$;
create or replace function pg_temp.g2p_pattern_state(p_label text) returns text language sql stable as $body$
  select state from platform_private.cms_pattern_versions where id = (pg_temp.s12pd_body(p_label)->>'id')::uuid $body$;
-- A rolled-back direct statement probe in the RPC context: '<sqlstate>:<message>' or '00000:'.
create or replace function pg_temp.g2p_try(p_sql text) returns text language plpgsql as $body$
declare prior text := coalesce(pg_catalog.current_setting('app.cms_rpc', true), '');
begin
  perform pg_catalog.set_config('app.cms_rpc', 'true', true);
  begin
    execute p_sql;
    raise exception 'g2p probe ran' using errcode = 'G2OK0';
  exception when others then
    perform pg_catalog.set_config('app.cms_rpc', prior, true);
    if sqlstate = 'G2OK0' then return '00000:'; end if;
    return sqlstate || ':' || sqlerrm;
  end;
end;
$body$;
-- A direct copy of a draft pattern row (RPC context) with a patch; returns the new row id.
create or replace function pg_temp.g2p_raw_copy(p_label text, p_key text, p_patch jsonb) returns uuid language plpgsql as $body$
declare v_id uuid := extensions.gen_random_uuid(); prior text := coalesce(pg_catalog.current_setting('app.cms_rpc', true), '');
begin
  perform pg_catalog.set_config('app.cms_rpc', 'true', true);
  insert into platform_private.cms_pattern_versions
    select (jsonb_populate_record(null::platform_private.cms_pattern_versions,
      to_jsonb(p) || jsonb_build_object('id', v_id, 'pattern_id', v_id, 'pattern_key', p_key, 'supersedes_id', null, 'version', 1,
        'lifecycle_version', 1, 'content_hash', md5(p_key) || md5(p_key || 'x')) || p_patch)).*
      from platform_private.cms_pattern_versions p where p.id = (pg_temp.s12pd_body(p_label)->>'id')::uuid;
  perform pg_catalog.set_config('app.cms_rpc', prior, true);
  return v_id;
end;
$body$;
create or replace function pg_temp.g2p_effects() returns jsonb language sql stable as $body$
  select jsonb_build_object('reviews', (select count(*) from platform_private.cms_governed_reviews),
    'deps', (select count(*) from platform_private.cms_governed_review_dependencies),
    'audit', (select count(*) from audit_private.audit_events), 'outbox', (select count(*) from platform_private.outbox_events),
    'idem', (select count(*) from platform_private.idempotency_records)) $body$;
-- The latest-read request (a copy of the helper in phase_02_slice_12_pattern_definition/080-latest-read.sqlinc, which is not included).
create or replace function pg_temp.s12pd_latest_request(p_key text, p_actor text default 'owner',
  p_override jsonb default '{}'::jsonb) returns jsonb language sql stable as $body$
  select jsonb_build_object('patternKey',p_key,'context',pg_temp.s09d_context(p_actor,true,p_override))
$body$;
-- A raw pattern row statement (a copy of the helper in phase_02_slice_12_pattern_definition/070-storage.sqlinc, which is not included).
create or replace function pg_temp.s12pd_raw_row(p_id uuid, p_owner uuid, p_key text, p_version integer,
  p_tree jsonb, p_types jsonb, p_nodes integer, p_supersedes uuid default null, p_lineage uuid default null)
returns text language sql stable as $body$
  select format($f$insert into platform_private.cms_pattern_versions(
      id, owner_id, version, pattern_key, block_tree, block_registry_digest, content_hash, owner_capability,
      created_by, compatible_type_ids, node_count, supersedes_id, pattern_id)
    values (%L, %L, %s, %L, %L::jsonb, %L, %L, 'cms.template_designer', %L, %L::jsonb, %s, %L, %L)$f$,
    p_id, p_owner, p_version, p_key, p_tree::text, repeat('a',64), repeat('b',64),
    pg_temp.s09d_actor_id('owner','auth')::uuid, p_types::text, p_nodes, p_supersedes, p_lineage)
$body$;

-- A direct statement run inside the CMS RPC context that is NOT rolled back when it succeeds (g2p_try rolls every outcome back).
create or replace function pg_temp.g2p_persist(p_sql text) returns text language plpgsql as $body$
declare prior text := coalesce(pg_catalog.current_setting('app.cms_rpc', true), '');
begin
  perform pg_catalog.set_config('app.cms_rpc', 'true', true);
  begin
    execute p_sql;
    perform pg_catalog.set_config('app.cms_rpc', prior, true);
    return '00000:';
  exception when others then
    perform pg_catalog.set_config('app.cms_rpc', prior, true);
    return sqlstate || ':' || sqlerrm;
  end;
end;
$body$;
