-- TEST ONLY. Invoker helpers; every target entry/review/pattern/schedule uses its public producer.
create or replace function pg_temp.s12pr_assert(p_ok boolean, p_label text) returns void
language plpgsql as $body$
begin
  if p_ok is distinct from true then raise exception 'publication race fixture: %', p_label; end if;
end;
$body$;

create or replace function pg_temp.s12pr_context() returns jsonb language plpgsql as $body$
declare setting_name text; answer jsonb := '{}'::jsonb;
begin
  foreach setting_name in array array[
    'request.jwt.claims','request.jwt.claim.role','request.jwt.claim.sub',
    'app.auth_user_id','app.actor_auth_user_id','app.actor_person_id',
    'app.acting_party_id','app.acting_context_id','app.cms_session_actor','app.cms_session_party',
    'app.mfa_session_subject','app.step_up_verified','app.cms_rpc','app.cfg_rpc',
    'app.correlation_id','app.idempotency_key_hash','app.request_hash','app.release_principal_id',
    'response.headers','role','app.cms_governed_lifecycle','search_path','request.headers'] loop
    answer := answer || jsonb_build_object(setting_name, coalesce(current_setting(setting_name,true),''));
  end loop;
  return answer;
end;
$body$;
create or replace function pg_temp.s12pr_restore(p_context jsonb) returns void
language plpgsql as $body$
declare item record;
begin
  perform set_config('role',p_context->>'role',true);
  for item in select key,value from jsonb_each_text(p_context) where key<>'role' loop
    perform set_config(item.key,item.value,true);
  end loop;
end;
$body$;

create or replace function pg_temp.s12pr_call(p_operation text,p_request jsonb,p_actor text default 'owner')
returns jsonb language plpgsql as $body$
declare before_context jsonb:=pg_temp.s12pr_context(); before_user text:=current_user;
  response jsonb; code text:='00000'; msg text; detail text; headers text; invoked text; function_name text;
begin
  function_name := case p_operation
    when 'register' then 'cms_register_block' when 'pattern' then 'cms_create_pattern_version'
    when 'gov-submit' then 'cms_submit_governed_review' when 'gov-assign' then 'cms_assign_governed_reviewer'
    when 'gov-decide' then 'cms_record_governed_decision' when 'activate' then 'cms_activate_governed_subject'
    when 'entry' then 'cms_create_entry' when 'place' then 'cms_insert_pattern_instance'
    when 'submit' then 'cms_submit_review' when 'assign' then 'cms_assign_editorial_reviewer'
    when 'decide' then 'cms_record_review_decision' when 'schedule' then 'cms_schedule_publication'
    when 'publish' then 'cms_publish_revision' else null end;
  perform pg_temp.s12pr_assert(function_name is not null,'closed public operation');
  if p_actor is not null then
    perform pg_temp.s09d_session(p_actor,'service_role');
    if not p_request ? 'context' then
      p_request := p_request || jsonb_build_object('context',pg_temp.s09d_context(p_actor,true));
    end if;
  else
    -- Signed release context must not inherit a human's bindings.
    perform pg_temp.s12pr_restore(jsonb_build_object('role',before_context->>'role') ||
      (select jsonb_object_agg(key,''::text) from jsonb_each(before_context) where key<>'role'));
  end if;
  perform pg_temp.set_jwt_claim('role','service_role',true);
  perform set_config('response.headers','',true);
  perform set_config('role','service_role',true);
  invoked := current_user;
  begin
    execute format('select platform_api.%I($1)',function_name) into response using p_request;
  exception when others then
    get stacked diagnostics code=returned_sqlstate,msg=message_text,detail=pg_exception_detail;
    response := null;
  end;
  headers := nullif(current_setting('response.headers',true),'');
  perform pg_temp.s12pr_restore(before_context);
  perform pg_temp.s12pr_assert(invoked='service_role' and current_user=before_user
    and pg_temp.s12pr_context()=before_context,'full23-setting/effective-user restoration');
  return jsonb_build_object('state',code,'message',msg,'detail',detail,'response',response,
    'headers',headers,'callRole',invoked,'scopeRestored',true);
exception when others then
  perform pg_temp.s12pr_restore(before_context);
  raise;
end;
$body$;
create or replace function pg_temp.s12pr_ok(p_operation text,p_request jsonb,p_actor text default 'owner')
returns jsonb language plpgsql as $body$
declare result jsonb:=pg_temp.s12pr_call(p_operation,p_request,p_actor);
begin
  perform pg_temp.s12pr_assert(result->>'state'='00000' and jsonb_typeof(result->'response')='object'
    and result->'response'->>'kind' is distinct from 'refusal',p_operation||' actual public success: '||result::text);
  return result->'response';
end;
$body$;

create or replace function pg_temp.s12pr_governed(p_subject jsonb,p_activate boolean) returns jsonb
language plpgsql as $body$
declare review jsonb; decision jsonb; request jsonb;
begin
  review:=pg_temp.s12pr_ok('gov-submit',jsonb_build_object('subjectKind','pattern_version',
    'subjectId',p_subject->'id','subjectHash',p_subject->'contentHash','idempotencyKey','s12pr-submit-'||(p_subject->>'id')));
  perform pg_temp.s12pr_ok('gov-assign',jsonb_build_object('reviewId',review->'id','action','create',
    'expectedVersion',review->'version','ifMatch',review->'version',
    'reviewerPersonId',pg_temp.s09d_actor_id('rev1','person'),
    'expiresAt',platform_private.auth_iso_time(clock_timestamp()+interval '12 hours'),
    'reason','Publication race fixture','idempotencyKey','s12pr-assign-'||(review->>'id')));
  decision:=pg_temp.s12pr_ok('gov-decide',jsonb_build_object('reviewId',review->'id','decision','approve',
    'reason','Independent fixture approval','expectedVersion',review->'version','ifMatch',review->'version',
    'idempotencyKey','s12pr-decide-'||(review->>'id')),'rev1');
  request:=jsonb_build_object('reviewId',review->'id','action','activate',
    'expectedVersion',decision->'version','ifMatch',decision->'version',
    'idempotencyKey','s12pr-activate-'||(review->>'id'),'correlationId',extensions.gen_random_uuid(),
    'context',pg_temp.s09d_context('owner',true));
  if p_activate then perform pg_temp.s12pr_ok('activate',request); end if;
  return request;
end;
$body$;
create or replace function pg_temp.s12pr_pattern(p_key text,p_tree jsonb,p_previous text default null)
returns jsonb language plpgsql as $body$
begin
  return pg_temp.s12pr_ok('pattern',jsonb_build_object('patternKey',p_key,
    'compatibleTypeIds',jsonb_build_array(pg_temp.s09d_id('pr-type:type')),'blockTree',p_tree,
    'expectedVersion',p_previous,'idempotencyKey','s12pr-pattern-'||p_key||coalesce(p_previous,'first'))
    ||case when p_previous is null then '{}'::jsonb else jsonb_build_object('ifMatch',p_previous) end);
end;
$body$;
create or replace function pg_temp.s12pr_evidence(p_revision uuid,p_dependency_hash text) returns jsonb
language sql as $body$
  select jsonb_build_object('category','accessibility','providerKey','cms.a11y.structural',
    'providerVersion','1','outcome','healthy','blockingCount',0,'inputHash',repeat('a',64),
    'bindingHash',platform_private.cms_accessibility_binding_hash(p_revision,p_dependency_hash),
    'evaluatedAt',platform_private.auth_iso_time(clock_timestamp()))
$body$;

create or replace function pg_temp.s12pr_case(p_tag text) returns jsonb language plpgsql as $body$
declare block jsonb:=jsonb_build_object('kind','block','key','leaf','blockKey','s12pr.block',
    'blockVersion',1,'props',jsonb_build_object('title','Nested fixture'),'children','[]'::jsonb);
  child jsonb; parent jsonb; successor jsonb; activation jsonb; made jsonb; entry_id uuid; revision_id uuid;
  schema_row platform_private.cms_content_type_versions; artifact platform_private.cms_schema_artifacts;
  field_row platform_private.cms_field_definition_versions; review platform_private.cms_editorial_reviews;
  manifest jsonb; response jsonb; request jsonb; fire timestamptz:=date_trunc('second',clock_timestamp()+interval '2 hours');
begin
  child:=pg_temp.s12pr_pattern('s12pr-child-'||p_tag,jsonb_build_array(block));
  perform pg_temp.s12pr_governed(child,true);
  parent:=pg_temp.s12pr_pattern('s12pr-parent-'||p_tag,jsonb_build_array(jsonb_build_object(
    'kind','block','key','panel','blockKey','s12pr.block','blockVersion',1,
    'props',jsonb_build_object('title','Parent fixture'),'children',jsonb_build_array(jsonb_build_object(
      'kind','pattern','key','nested','patternId',child->'patternId','patternVersion',1)))));
  perform pg_temp.s12pr_governed(parent,true);
  successor:=pg_temp.s12pr_pattern('s12pr-child-'||p_tag,jsonb_build_array(block),'1');
  activation:=pg_temp.s12pr_governed(successor,false);
  perform set_config('app.cms_rpc','true',true);
  select * into strict schema_row from platform_private.cms_content_type_versions where id=pg_temp.s09d_id('pr-type:version');
  select * into strict artifact from platform_private.cms_schema_artifacts where id=schema_row.schema_artifact_id;
  select * into strict field_row from platform_private.cms_field_definition_versions
    where content_type_version_id=schema_row.id and field_key='title';
  made:=pg_temp.s12pr_ok('entry',jsonb_build_object('contentTypeId',schema_row.content_type_id,
    'contentTypeVersionId',schema_row.id,'locale','en-US','changedPaths',jsonb_build_array('/fields/'||field_row.stable_field_id),
    'values',jsonb_build_object(field_row.stable_field_id::text,'Publication race '||p_tag),
    'schemaArtifact',jsonb_build_object('id',artifact.id,'contentTypeVersionId',schema_row.id,
      'artifactHash',artifact.artifact_hash,'compilerVersion',artifact.compiler_version,'zodContractRef',artifact.zod_contract_ref),
    'validatorRefs','[]'::jsonb,'workflowPolicy',platform_private.cms_editorial_workflow_policy_evidence(schema_row.id),
    'activationEvidence',platform_private.cms_type_version_resource(schema_row.id)->'activationEvidence',
    'idempotencyKey','s12pr-entry-'||p_tag));
  entry_id:=(made->'entry'->>'id')::uuid; revision_id:=(made->'revision'->>'id')::uuid;
  response:=pg_temp.s12pr_ok('place',jsonb_build_object('revisionId',revision_id,
    'patternId',parent->'patternId','patternVersion',1,'linkMode','linked','slotPath','/','overrides','{}'::jsonb,
    'expectedVersion','1','ifMatch','1','idempotencyKey','s12pr-place-'||p_tag));
  perform pg_temp.s12pr_assert(jsonb_array_length(response->'items')=1 and response->'items'->0->>'path'='/panel',
    'one actual parent placement');
  manifest:=platform_private.cms_build_dependency_manifest(revision_id);
  perform pg_temp.s12pr_assert(manifest->'patterns'=jsonb_build_array(jsonb_build_object(
    'id',parent->'id','hash',parent->'contentHash')),'only direct parent version in frozen manifest');
  response:=pg_temp.s12pr_ok('submit',jsonb_build_object('entryId',entry_id,'revisionId',revision_id,
    'frozenHash',made->'contentHash','dependencyManifest',manifest,'expectedVersion','2','ifMatch','2',
    'evidence',pg_temp.s12pr_evidence(revision_id,platform_private.cms_jcs_sha256(manifest)),
    'idempotencyKey','s12pr-review-'||p_tag));
  select * into strict review from platform_private.cms_editorial_reviews where id=(response->>'id')::uuid;
  perform pg_temp.s12pr_ok('assign',jsonb_build_object('reviewId',review.id,'action','create',
    'expectedVersion',review.version::text,'ifMatch',review.version::text,
    'reviewerPersonId',pg_temp.s09d_actor_id('rev1','person'),
    'expiresAt',platform_private.auth_iso_time(clock_timestamp()+interval '12 hours'),
    'reason','Independent publication reviewer','idempotencyKey','s12pr-review-assign-'||p_tag));
  perform pg_temp.s12pr_ok('decide',jsonb_build_object('reviewId',review.id,'decision','approve',
    'reason','Public fixture approval','expectedVersion',review.version::text,'ifMatch',review.version::text,
    'idempotencyKey','s12pr-review-decide-'||p_tag),'rev1');
  select r.* into strict review from platform_private.cms_editorial_reviews r where r.id=review.id;
  perform pg_temp.s12pr_assert(review.state='approved' and review.version=2
    and review.recorded_decision_count=1,'real public approved review');
  request:=jsonb_build_object('entryId',entry_id,'revisionId',revision_id,'frozenHash',review.frozen_hash,
    'expectedVersionSet',platform_private.cms_revision_version_set(revision_id,review.dependency_manifest),
    'audience','public','expectedVersion',review.version::text,'ifMatch',review.version::text,
    'idempotencyKey','s12pr-publish-'||p_tag,'correlationId',extensions.gen_random_uuid(),
    'context',pg_temp.s09d_context('designer2',true));
  response:=pg_temp.s12pr_ok('schedule',jsonb_build_object('revisionId',revision_id,'action','publish',
    'localDateTime',to_char(fire at time zone 'UTC','YYYY-MM-DD"T"HH24:MI:SS'),'timezone','UTC',
    'resolvedUtc',platform_private.auth_iso_time(fire),'tzdbVersion',platform_private.cms_tzdb_version(),
    'disambiguation','none','audience','public','expectedVersion','2','ifMatch','2',
    'evidence',pg_temp.s12pr_evidence(revision_id,review.dependency_hash),
    'idempotencyKey','s12pr-schedule-'||p_tag),'designer2');
  return jsonb_build_object('entry',entry_id,'revision',revision_id,'review',review.id,'schedule',response->'id',
    'child',child->'id','next',successor->'id','parent',parent->'id','activation',activation,'publish',request,
    'schema',schema_row.id,'manifest',manifest,'parentHash',parent->'contentHash');
end;
$body$;

create or replace function pg_temp.s12pr_request(p_tag text) returns jsonb language plpgsql as $body$
declare item jsonb:=(select ids->p_tag from public.s12pr_world); review platform_private.cms_editorial_reviews;
  before_context jsonb:=pg_temp.s12pr_context(); answer jsonb;
begin
  perform set_config('app.cms_rpc','true',true);
  select * into strict review from platform_private.cms_editorial_reviews where id=(item->>'review')::uuid;
  answer:=(item->'publish')||jsonb_build_object('evidence',pg_temp.s12pr_evidence(review.revision_id,review.dependency_hash));
  perform pg_temp.s12pr_restore(before_context);
  return answer;
exception when others then perform pg_temp.s12pr_restore(before_context); raise;
end;
$body$;
