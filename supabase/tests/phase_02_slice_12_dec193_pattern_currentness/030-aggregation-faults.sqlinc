select * from pg_temp.s12pu_place('pca-fault','pca-fault-pattern');
select * from pg_temp.s12pc_seed('PA-F08','pca-fault',pg_temp.s12pu_head('pca-donor','/left'),
 jsonb_build_object('block_registry_digest',repeat('0',64),'position',1));
select * from pg_temp.s12pl_pattern('pca-a2','s12pca-a',jsonb_build_array(
 pg_temp.s12cs_block('left','s12cs.root',1,'PA2-LEFT'),pg_temp.s12cs_block('right','s12cs.root',1,'PA2-RIGHT')),null,true,'1');
select * from pg_temp.s12pl_pattern('pca-b2','s12pca-b',jsonb_build_array(pg_temp.s12cs_block('third','s12cs.root',2,'PB2')),null,true,'1');
select * from pg_temp.s12pl_pattern('pca-child2','s12pca-child',jsonb_build_array(pg_temp.s12cs_block('leaf','s12cs.leaf',2,'PC2')),null,true,'1');
select is((select jsonb_agg(p.state order by k) from (values (1,'pca-a1'),(2,'pca-b1'),(3,'pca-child1')) wanted(k,label)
 join platform_private.cms_pattern_versions p on p.id=(pg_temp.s12pd_body(label)->>'id')::uuid),
 '["superseded","superseded","superseded"]'::jsonb,'PA-F09: real governed successors supply inactive roots and child');
select is(pg_temp.s12pu_pattern_row('pca-parent')->>'state','active','PA-F10: nested-only offender has an active parent');

-- Bulk READ fixture, not1001 public writes or1001 assertions. Valid canonical
-- content remains exact; only copied identity/path/order and known wrong digest differ.
create function pg_temp.s12pa_bulk() returns setof text language plpgsql as $body$
declare donor platform_private.cms_composition_instances; target uuid; stamp timestamptz:=clock_timestamp();
 prior_rpc text:=current_setting('app.cms_rpc',true); source_before jsonb:=pg_temp.s12pu_row(pg_temp.s12pu_head('pca-donor','/left'));
begin
 perform set_config('app.cms_rpc','true',true); target:=pg_temp.s12pl_entry('pca-cap');
 select * into strict donor from platform_private.cms_composition_instances where id=(source_before->>'id')::uuid;
 insert into platform_private.cms_composition_instances
 select (jsonb_populate_record(null::platform_private.cms_composition_instances,to_jsonb(donor)||jsonb_build_object(
 'id',extensions.gen_random_uuid(),'revision_id',target,'version',1,'path','/bulk/r'||lpad(n::text,4,'0'),
 'position',n-1,'block_registry_digest',repeat('0',64),'created_at',stamp,'updated_at',stamp))).*
 from generate_series(1,1001) n;
 perform set_config('app.cms_rpc',coalesce(prior_rpc,''),true);
 return next extensions.is((select count(*)::integer from platform_private.cms_composition_instances where revision_id=target),1001,
  'PA-CAP01: exactly1001 guarded canonical READ rows, not a producer-count claim');
 return next extensions.is((select count(distinct path)::integer from platform_private.cms_composition_instances where revision_id=target),1001,
  'PA-CAP02: every canonical offender occupies a distinct path/head');
 return next extensions.is((select count(*)::integer from platform_private.cms_composition_instances c where c.revision_id=target
  and c.state='active' and c.version=1 and c.link_mode='detached' and c.props='{}'::jsonb
  and c.detached_tree=donor.detached_tree and c.bindings=donor.bindings and c.pattern_id=donor.pattern_id
  and c.pattern_version=1 and c.block_registry_digest=repeat('0',64) and c.position between 0 and 1000),1001,
  'PA-CAP03: all rows retain the independently checked canonical donor and literal bad digest');
 return next extensions.is(pg_temp.s12pu_row(donor.id),source_before,'PA-CAP04: actual producer source remains byte-identical');
 return next extensions.is(coalesce(current_setting('app.cms_rpc',true),''),coalesce(prior_rpc,''),'PA-CAP05: exact fixture RPC context restored');
exception when others then
 perform set_config('app.cms_rpc',coalesce(prior_rpc,''),true);
 return next extensions.fail('PA-CAP guarded bulk fixture succeeds'); return next extensions.diag(sqlstate||':'||sqlerrm);
end;
$body$;
select * from pg_temp.s12pa_bulk();
select * from pg_temp.s12pc_check('PA-A01-dedup-live','pca-shared','pattern_not_active',false,
 array['pca-a1'],'[["s12cs.root",1]]','submit',null,null,1);
