-- DEC-199 root-owned integration units: one distinct live pin / bad canonical
-- row; frozen identity anomalies merge into those units. No producer forgery.
select * from pg_temp.s12pl_pattern('pca-a1','s12pca-a',jsonb_build_array(
 pg_temp.s12cs_block('left','s12cs.root',1,'PA-LEFT'),pg_temp.s12cs_block('right','s12cs.root',1,'PA-RIGHT')));
select * from pg_temp.s12pl_pattern('pca-b1','s12pca-b',jsonb_build_array(pg_temp.s12cs_block('third','s12cs.root',2,'PB')));
select setup.* from (values ('pca-shared'),('pca-distinct'),('pca-donor'),('pca-mixed')) cases(tag)
 cross join lateral pg_temp.s12pu_place(tag,'pca-a1') setup;
select pg_temp.s12pl_run('pca-distinct-b',pg_temp.s12pl_request('pca-distinct','pca-b1','/','{}','s12pca-distinct-b','linked'));
select is(pg_temp.s12pl_state('pca-distinct-b'),'00000','PA-F01: second distinct real live pin placed in the same revision');
select pg_temp.s12pu_update('pca-detach-donor',pg_temp.s12pu_update_request('pca-donor','detach',
 jsonb_build_array(pg_temp.s12pu_target('pca-donor','/left'),pg_temp.s12pu_target('pca-donor','/right')),'s12pca-detach-donor'));
select pg_temp.s12pu_update('pca-detach-mixed',pg_temp.s12pu_update_request('pca-mixed','detach',
 jsonb_build_array(pg_temp.s12pu_target('pca-mixed','/left')),'s12pca-detach-mixed'));
select is(pg_temp.s12pu_oc(label),'ok',label||': actual canonical producer succeeds')
 from (values ('pca-detach-donor'),('pca-detach-mixed')) calls(label);
select is(pg_temp.s12pu_row(pg_temp.s12pu_head('pca-donor','/left'))->'detached_tree',
 '{"format":"cms.detached_tree.v1","nodes":[{"parent":null,"keySegments":["left"],
 "blockKey":"s12cs.root","blockVersion":1,"props":{"title":"PA-LEFT","accessible_name":"PA-LEFT"}}]}'::jsonb,
 'PA-F02: actual detached donor is the independent literal canonical tree');
select is(pg_temp.s12pu_row(pg_temp.s12pu_head('pca-donor','/left'))->>'block_registry_digest',
 platform_private.cms_jcs_sha256(jsonb_build_array(jsonb_build_object('blockKey','s12cs.root','blockVersion',1,
 'releaseDigest',repeat('e',64),'propsSchemaHash',repeat('a',64),'rendererRef','cms/renderers/hero/1','lifecycle','supported'))),
 'PA-F03: actual one-block donor digest equals independent literal safe tuple');
select pg_temp.s12pl_entry('pca-double-bad');
select * from pg_temp.s12pc_seed('PA-F04-left','pca-double-bad',pg_temp.s12pu_head('pca-donor','/left'),
 jsonb_build_object('block_registry_digest',repeat('0',64)));
select * from pg_temp.s12pc_seed('PA-F04-right','pca-double-bad',pg_temp.s12pu_head('pca-donor','/right'),
 jsonb_build_object('block_registry_digest',repeat('0',64)));
select * from pg_temp.s12pc_seed('PA-F05-mixed','pca-mixed',pg_temp.s12pu_head('pca-mixed','/left'),
 jsonb_build_object('block_registry_digest',repeat('0',64)));

-- Independent nested-only offender and root/nested/digest precedence worlds.
select * from pg_temp.s12pl_pattern('pca-child1','s12pca-child',jsonb_build_array(pg_temp.s12cs_block('leaf','s12cs.leaf',2,'PC1')));
select * from pg_temp.s12pl_pattern('pca-parent','s12pca-parent',jsonb_build_array(
 pg_temp.s12cs_block('nested','s12cs.root',1,'PARENT',jsonb_build_array(jsonb_build_object(
 'kind','pattern','key','child','patternId',pg_temp.s12pd_body('pca-child1')->'patternId','patternVersion',1)))));
select * from pg_temp.s12pu_place('pca-nested-bad','pca-parent');
select * from pg_temp.s12pu_place('pca-priority','pca-parent');
select pg_temp.s12pl_run('pca-priority-b',pg_temp.s12pl_request('pca-priority','pca-b1','/','{}','s12pca-priority-b','linked'));
select is(pg_temp.s12pl_state('pca-priority-b'),'00000','PA-F06: real second live pin for root/nested/digest priority');
select seeded.* from (values ('pca-nested-bad'),('pca-priority')) cases(tag)
 cross join lateral pg_temp.s12pc_seed('PA-F07-'||tag,tag,pg_temp.s12pu_head('pca-donor','/left'),
 jsonb_build_object('block_registry_digest',repeat('0',64),'position',10)) seeded;
