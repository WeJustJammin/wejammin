select * from pg_temp.s12pc_seed('PC-F05-right','pc-one-bad',pg_temp.s12pu_head('pc-both','/right'),
  jsonb_build_object('block_registry_digest',repeat('0',64)));
select * from pg_temp.s12pc_seed('PC-F06-live','pc-retired-live',pg_temp.s12pu_head('cs-legacy','/panel'));
select * from pg_temp.s12pc_seed('PC-F06-tombstone','pc-retired-live',pg_temp.s12pu_head('cs-legacy','/panel'),
  '{"state":"retired"}');
select * from pg_temp.s12pc_check('PC-P06-bad-own-digest','pc-bad-digest','pattern_digest_changed',false,
  array['s12cs-outer1'],'[["s12cs.root",1],["s12cs.leaf",2],["s12cs.tail",1]]');
select * from pg_temp.s12pc_check('PC-P02-legacy-active','pc-legacy-single',null,true,
  array['s12pc-two1'],'[["s12cs.root",1],["s12cs.leaf",2],["s12cs.tail",1]]');
select * from pg_temp.s12pc_check('PC-P09-check-both-trees','pc-one-bad','pattern_digest_changed',false,
  array['s12pc-two1'],'[["s12cs.root",1],["s12cs.root",2],["s12cs.leaf",2],["s12cs.tail",1]]');
select * from pg_temp.s12pc_check('PC-P10-no-resurrection','pc-retired-live',null,true,array[]::text[],'[]');

-- A new governed version makes only the retained root pin inactive. Canonical
-- copies elsewhere must not inherit the live right-hand row's classification.
select * from pg_temp.s12pl_pattern('s12pc-two2','s12pc-two',jsonb_build_array(
  pg_temp.s12cs_block('left','s12cs.root',1,'LEFT',jsonb_build_array(pg_temp.s12cs_ref('s12cs-inner2'))),
  pg_temp.s12cs_block('right','s12cs.root',2,'RIGHT',jsonb_build_array(pg_temp.s12cs_ref('s12cs-inner2')))),null,true,'1');
select is(pg_temp.s12pu_pattern_row('s12pc-two1')->>'state','superseded',
  'PC-PREMISE-05: actual governed successor superseded the common pin');
select is(pg_temp.s12pu_pattern_row('s12cs-inner2')->>'state','active',
  'PC-PREMISE-06: pinned nested child stays active, so root failure is the only offender');
select * from pg_temp.s12pc_check('PC-P02-legacy-inactive','pc-legacy-single','pattern_not_active',false,
  array['s12pc-two1'],'[["s12cs.root",1],["s12cs.leaf",2],["s12cs.tail",1]]');
select * from pg_temp.s12pc_check('PC-P07-latest-tree','pc-history',null,true,
  array['s12pc-two1'],'[["s12cs.root",1],["s12cs.leaf",2],["s12cs.tail",1]]');
select * from pg_temp.s12pc_check('PC-P08-latest-live','pc-reverse','pattern_not_active',false,
  array['s12pc-two1'],'[["s12cs.root",1],["s12cs.leaf",2],["s12cs.tail",1]]');
select * from pg_temp.s12pc_check('PC-P11-mixed-pin','pc-mixed','pattern_not_active',false,
