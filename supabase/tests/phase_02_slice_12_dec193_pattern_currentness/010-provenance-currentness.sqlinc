select * from pg_temp.s12pc_check('PC-P12-cross-revision','pc-only',null,true,
  array['s12pc-two1'],'[["s12cs.root",1],["s12cs.leaf",2],["s12cs.tail",1]]');
select * from pg_temp.s12pc_check('PC-P13-both-provenance','pc-both',null,true,
  array['s12pc-two1'],'[["s12cs.root",1],["s12cs.root",2],["s12cs.leaf",2],["s12cs.tail",1]]');

-- A strict, well-shaped frozen manifest with the wrong pin hash is not current.
select * from pg_temp.s12pc_check('PC-P14-frozen-hash','cs-linked','pattern_digest_changed',false,
  array['s12cs-outer2'],'[["s12cs.root",2],["s12cs.leaf",2],["s12cs.tail",1]]','submit',
  jsonb_set((select manifest from s12pc_out where label='PC-P03-live'),'{patterns,0,hash}',to_jsonb(repeat('0',64))));
select checked.* from (values('PC-S01-sql-null',null::jsonb),('PC-S02-json-null','null'::jsonb),
  ('PC-S03-scalar','42'::jsonb),('PC-S04-shape','{}'::jsonb)) malformed(label,manifest)
  cross join lateral pg_temp.s12pc_stale(label,'cs-linked',manifest) checked;
select * from pg_temp.s12pc_stale('PC-S05-malformed-patterns','cs-linked',jsonb_set(
  (select manifest from s12pc_out where label='PC-P03-live'),'{patterns}','null'::jsonb));
select * from pg_temp.s12pc_stale('PC-S06-orphan-identity','cs-linked',jsonb_set(
  (select manifest from s12pc_out where label='PC-P03-live'),'{patterns,0,id}',
  to_jsonb('a9d19999-0000-4000-8000-000000000002'::text)));

-- Actual API cross-owner and same-owner wrong-entry revision concealment. The
-- request is fully formed before role switching, so temp-table permissions
-- cannot impersonate an API denial. No private helper is granted to API roles.
create function pg_temp.s12pc_conceal(p_label text,p_actor text,p_revision uuid)
returns setof text language plpgsql as $body$
declare prior_role text:=current_setting('role'); prior_user text:=current_user;
  prior_rpc text:=current_setting('app.cms_rpc',true); code text:='00000'; message text; called text;
  before_rows jsonb:=pg_temp.s12pc_snapshot(); request jsonb; answer jsonb;
begin
  if to_regprocedure('platform_api.cms_get_entry_workflow(jsonb)') is null then
    return next extensions.fail(p_label||': actual workflow RPC available'); return;
  end if;
  request:=jsonb_build_object('entryId',pg_temp.s12pl_entry_id('cs-detached'),'revisionId',p_revision,
    'context',pg_temp.s09d_context(p_actor,true));
  perform pg_temp.s09d_session(p_actor,'service_role');
  perform set_config('role','service_role',true); called:=current_user;
  begin
    execute 'select platform_api.cms_get_entry_workflow($1)' into answer using request;
  exception when others then get stacked diagnostics code=returned_sqlstate,message=message_text;
  end;
  perform set_config('role',prior_role,true);
  perform set_config('app.cms_rpc',coalesce(prior_rpc,''),true);
  return next extensions.is(code||coalesce(':'||message,''),'P0001:NOT_FOUND',p_label||': uniform actual no-disclosure refusal');
  return next extensions.is(answer,null::jsonb,p_label||': no dependency/provider details disclosed');
  return next extensions.ok(called='service_role' and current_user=prior_user and current_setting('role')=prior_role,
    p_label||': actual API role and caller restoration');
  return next extensions.is(pg_temp.s12pc_snapshot(),before_rows,p_label||': full persistent image unchanged');
  return next extensions.is(coalesce(current_setting('app.cms_rpc',true),''),coalesce(prior_rpc,''),p_label||': scoped context restored');
end;
$body$;
select * from pg_temp.s12pc_conceal('PC-A01-foreign-owner','other',pg_temp.s12pl_rev('cs-detached'));
select * from pg_temp.s12pc_conceal('PC-A02-wrong-entry-revision','owner',pg_temp.s12pl_rev('cs-linked'));
select * from pg_temp.s12pc_conceal('PC-A03-absent','other','a9d19999-0000-4000-8000-000000000001');
select checked.* from (values('platform_private.cms_evaluate_preflight(jsonb)'),
  ('platform_private.cms_frozen_dependencies_status(uuid,jsonb)')) signatures(identity)
  cross join (values('anon'),('authenticated'),('service_role')) roles(role_name)
  cross join lateral pg_temp.s12pc_acl(signatures.identity,roles.role_name) checked;
