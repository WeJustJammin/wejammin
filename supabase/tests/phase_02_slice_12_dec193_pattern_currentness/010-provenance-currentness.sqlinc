select * from pg_temp.s12pc_seed('PC-F03-latest-tree','pc-history',pg_temp.s12pu_head('pc-both','/left'));
select * from pg_temp.s12pc_seed('PC-F04-old-tree','pc-reverse',pg_temp.s12pu_head('pc-both','/left'));
select * from pg_temp.s12pc_seed('PC-F04-latest-live','pc-reverse',pg_temp.s12pu_head('pc-legacy-two','/left'));
