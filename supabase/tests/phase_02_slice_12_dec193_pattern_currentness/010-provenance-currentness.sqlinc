-- Independent reachable sets: selected = B root, T leaf, retained local tail.
select is((select jsonb_build_object('version',version,'provider',provider_key,'providerVersion',provider_version,
  'kind',provider_kind,'referenceKind',reference_kind) from platform_private.cms_preflight_registry
  where category='pattern' order by version desc limit 1),
  '{"version":2,"provider":"cms.pattern.active_digest","providerVersion":1,"kind":"database","referenceKind":null}'::jsonb,
  'PC-REG-01: real current immutable registry row replaces only the pattern reference gate');
select is((select count(*) from platform_private.cms_preflight_registry where category='pattern' and version=1
  and provider_key='preflight.reference_gate' and provider_kind='reference_gate' and reference_kind='pattern'),
  1::bigint,'PC-REG-02: original immutable pattern registry row remains intact');
select is((pg_temp.s12pu_row(pg_temp.s12pu_head('cs-detached','/panel'))->>'block_registry_digest'),
  pg_temp.s12cs_digest(1,2),'PC-PREMISE-01: real mixed snapshot has independent selected-tree digest');
select is(pg_temp.s12pu_pattern_row('s12cs-outer1')->>'state','superseded',
  'PC-PREMISE-02: canonical and legacy controls retain the same nonactive real pin');
select checked.* from unnest(array['submit','schedule','publish','execute']) phases(phase)
  cross join lateral pg_temp.s12pc_check('PC-P01-'||phase,'cs-detached',null,true,
    array['s12cs-outer1'],'[["s12cs.root",1],["s12cs.leaf",2],["s12cs.tail",1]]',phase) checked;
select * from pg_temp.s12pc_check('PC-P01-repeat','cs-detached',null,true,
  array['s12cs-outer1'],'[["s12cs.root",1],["s12cs.leaf",2],["s12cs.tail",1]]','submit',null,'PC-P01-submit');
select * from pg_temp.s12pc_check('PC-P03-live','cs-linked',null,true,
  array['s12cs-outer2'],'[["s12cs.root",2],["s12cs.leaf",2],["s12cs.tail",1]]');
select * from pg_temp.s12pc_check('PC-P04-retired','cs-retired',null,true,array[]::text[],'[]');
select * from pg_temp.s12pc_check('PC-P05-target-snapshot','cs-progress',null,true,
  array['s12cs-outer2'],'[["s12cs.root",2],["s12cs.leaf",2],["s12cs.tail",1]]');

-- Several roots of one real placement produce distinct legal paths and two
-- independently materializable trees; no fabricated slot or placement identity.
select * from pg_temp.s12pl_pattern('s12pc-two1','s12pc-two',jsonb_build_array(
  pg_temp.s12cs_block('left','s12cs.root',1,'LEFT',jsonb_build_array(pg_temp.s12cs_ref('s12cs-inner2'))),
  pg_temp.s12cs_block('right','s12cs.root',2,'RIGHT',jsonb_build_array(pg_temp.s12cs_ref('s12cs-inner2')))));
select * from pg_temp.s12pu_place('pc-mixed','s12pc-two1');
select * from pg_temp.s12pu_place('pc-both','s12pc-two1');
select * from pg_temp.s12pu_place('pc-legacy-two','s12pc-two1','{}','detached');
select pg_temp.s12pu_update('pc-detach-left',pg_temp.s12pu_update_request('pc-mixed','detach',
  jsonb_build_array(pg_temp.s12pu_target('pc-mixed','/left')),'s12pc-detach-left'));
select pg_temp.s12pu_update('pc-detach-both',pg_temp.s12pu_update_request('pc-both','detach',
  jsonb_build_array(pg_temp.s12pu_target('pc-both','/left'),pg_temp.s12pu_target('pc-both','/right')),
  's12pc-detach-both'));
select is(pg_temp.s12pu_oc(label),'ok',label||': actual public detach succeeds')
  from unnest(array['pc-detach-left','pc-detach-both']) label;
select is((select jsonb_agg(jsonb_build_object('path',i.path,'tree',i.detached_tree is not null) order by i.path)
  from platform_private.cms_composition_instances i where i.id in (
    pg_temp.s12pu_head('pc-mixed','/left'),pg_temp.s12pu_head('pc-mixed','/right'))),
  '[{"path":"/left","tree":true},{"path":"/right","tree":false}]'::jsonb,
  'PC-PREMISE-03: same pin has one actual snapshot and one live NULL-tree head');
select isnt(pg_temp.s12pu_row(pg_temp.s12pu_head('pc-both','/left'))->'block_registry_digest',
  pg_temp.s12pu_row(pg_temp.s12pu_head('pc-both','/right'))->'block_registry_digest',
  'PC-PREMISE-04: same pin has two actual canonical trees with different reachable root versions');

select pg_temp.s12pl_entry(tag) from unnest(array['pc-only','pc-bad-digest','pc-history',
  'pc-reverse','pc-one-bad','pc-retired-live','pc-legacy-single']) tag;
select * from pg_temp.s12pc_seed('PC-F01','pc-only',pg_temp.s12pu_head('pc-mixed','/left'));
select * from pg_temp.s12pc_seed('PC-F01-legacy','pc-legacy-single',pg_temp.s12pu_head('pc-legacy-two','/left'));
