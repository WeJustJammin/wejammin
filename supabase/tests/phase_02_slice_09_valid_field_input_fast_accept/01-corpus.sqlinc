  jsonb_build_object('label', 'X', 'order', 1, 'helpText', repeat(E'é', 300))::text, jsonb_build_object('label', 'X', 'order', 1, 'helpText', repeat(E'é', 501))::text,
  '{"label":"Zeichen äöü 日本語 😀","order":7}', '@absent']);
-- Every word cms_reserved_key refuses, read from the function itself, as a key in three spellings.
insert into fi_dim select 'key', 1000 + row_number() over (order by w.word, s.k), to_jsonb(case s.k when 1 then w.word when 2 then upper(w.word) else initcap(w.word) end), false
from (select m[1] as word from regexp_matches(pg_get_functiondef('platform_private.cms_reserved_key(text)'::regprocedure), '''([a-z_]+)''', 'g') m) w
cross join (values (1), (2), (3)) s(k);

-- (a) the base and (b) every variant alone.
insert into fi_cases(label, value)
select 'base', jsonb_object_agg(d.dim, d.v) from fi_dim d where d.ord = 1 and not d.absent;
insert into fi_cases(label, value)
select d.dim || '#' || d.ord, pg_temp.fi_apply((select jsonb_object_agg(b.dim, b.v) from fi_dim b where b.ord = 1 and not b.absent), d.dim, d.v, d.absent)
from fi_dim d where d.ord > 1 order by d.dim, d.ord;

-- (c) deterministic mixtures: every member keeps its base value with probability 0.85 (the reserved-word spellings, ord >= 1000, are used one at a time only), else takes a random variant.
create or replace function pg_temp.fi_mix(p_count integer) returns void language plpgsql as $body$
declare i integer; d record; v record; doc jsonb; pick integer; total integer;
begin
  perform setseed(0.4242);
  for i in 1..p_count loop
    doc := (select jsonb_object_agg(b.dim, b.v) from fi_dim b where b.ord = 1 and not b.absent);
    for d in select distinct dim from fi_dim order by dim loop
      if random() < 0.15 then
        select count(*) into total from fi_dim where dim = d.dim and ord > 1 and ord < 1000;
        pick := 1 + floor(random() * total)::integer;
        select x.* into v from (select f.*, row_number() over (order by f.ord) rn from fi_dim f where f.dim = d.dim and f.ord > 1 and f.ord < 1000) x where x.rn = pick;
        doc := pg_temp.fi_apply(doc, d.dim, v.v, v.absent);
      end if;
    end loop;
    insert into fi_cases(label, value) values ('mix#' || i, doc);
  end loop;
end $body$;
select pg_temp.fi_mix(3000);

-- (d) values that are not field objects.
insert into fi_cases(label, value) values
  ('not an object: SQL NULL', null), ('not an object: JSON null', 'null'), ('not an object: array', '[]'), ('not an object: string', '"x"'),
  ('not an object: number', '5'), ('not an object: boolean', 'true'), ('empty object', '{}'),
  ('array of the base', jsonb_build_array((select value from fi_cases where label = 'base')));
