  jsonb_build_object('label', rpad('a', 120, 'a'), 'order', 1)::text, jsonb_build_object('label', rpad('a', 121, 'a'), 'order', 1)::text,
  jsonb_build_object('label', repeat(E'é', 61), 'order', 1)::text, jsonb_build_object('label', repeat(E'é', 121), 'order', 1)::text,
