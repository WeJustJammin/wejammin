-- Corpus of the fast-accept equivalence suite: field-definition inputs for platform_private.cms_valid_field_input.
-- fi_dim lists, per top-level member of a field definition, an ordered list of variants; variant 1 is the base
-- (valid) value.  The corpus is (a) the base, (b) every variant alone on the base (one-factor-at-a-time),
-- (c) a deterministic mixture of variants (fixed seed) and (d) inputs that are not objects.  Nothing is
-- expected of a case here: the suite compares the current function with the verbatim previous body on all of them.
create temp table fi_dim(dim text not null, ord integer not null, v jsonb, absent boolean not null default false, primary key (dim, ord)) on commit drop;
create temp table fi_cases(n serial primary key, label text not null, value jsonb) on commit drop;

-- Adds the variants of one member in order; the literal '@absent' removes the member.
create or replace function pg_temp.fi_dim(p_dim text, p_items text[]) returns void language plpgsql as $body$
declare i integer;
begin
  for i in 1..cardinality(p_items) loop
    if p_items[i] = '@absent' then insert into fi_dim values (p_dim, i, null, true);
    else insert into fi_dim values (p_dim, i, p_items[i]::jsonb, false); end if;
  end loop;
end $body$;

create or replace function pg_temp.fi_apply(p_base jsonb, p_dim text, p_v jsonb, p_absent boolean) returns jsonb language sql as $body$
  select case when p_absent then p_base - p_dim else jsonb_set(p_base, array[p_dim], p_v, true) end $body$;

select pg_temp.fi_dim('stableFieldId', array[
  '"a9f10000-0000-4000-8000-000000000001"', '"a9f10000-0000-4000-8000-000000000002"',
  '"a9f10000-0000-0000-8000-000000000001"', '"a9f10000-0000-1000-8000-000000000001"', '"a9f10000-0000-8000-8000-000000000001"', '"a9f10000-0000-9000-8000-000000000001"',
  '"a9f10000-0000-4000-7000-000000000001"', '"a9f10000-0000-4000-9000-000000000001"', '"a9f10000-0000-4000-a000-000000000001"', '"a9f10000-0000-4000-b000-000000000001"',
  '"a9f10000-0000-4000-c000-000000000001"', '"A9F10000-0000-4000-8000-000000000001"', '"a9f10000-0000-4000-8000-00000000001"', '"a9f10000-0000-4000-8000-0000000000011"',
  '"{a9f10000-0000-4000-8000-000000000001}"', '"a9f10000000040008000000000000001"', '" a9f10000-0000-4000-8000-000000000001"', '"a9f10000-0000-4000-8000-00000000000g"',
  '"a9f10000-0000-4000-8000-000000000001\n"', 'null', '5', 'true', '""', '[]', '@absent']);
