-- All-or-nothing under an injected fault (BE03c 1587 "rollback no pattern"): an audit insert that fails after the
-- draft row and the idempotency reservation were written must leave no row, no reservation and no audit, and the
-- same key and request must succeed afterwards.  The fault is a trigger created and dropped inside this
-- rolled-back suite; no existing trigger is disabled.
create schema s12pd_fault;
create function s12pd_fault.fail_audit() returns trigger language plpgsql as $f$
begin
  raise exception 'injected audit fault' using errcode = 'XX000';
end;
$f$;
create trigger s12pd_fault_audit before insert on audit_private.audit_events
for each row when (new.action = 'cms.pattern.define') execute function s12pd_fault.fail_audit();
select pg_temp.s12pd_run('fault',pg_temp.s12pd_request('s12pd-fault',pg_temp.s12pd_forest(1),null,'s12pd-fault-0001'));
drop trigger s12pd_fault_audit on audit_private.audit_events;
select is(pg_temp.s12pd_state('fault'),'XX000','the injected fault reaches the caller unmasked [P2-S12-AC-104]');
select is((select message from s12pd_out where label='fault'),'injected audit fault',
  'the injected fault is the failure observed [P2-S12-AC-104]');
select ok((select before_rows=after_rows from s12pd_out where label='fault'),
  'a fault after the row, the reservation and the audit statement leaves every captured full row unchanged [P2-S12-AC-104]');
select is((select count(*)::integer from platform_private.cms_pattern_versions where pattern_key='s12pd-fault'),0,
  'no pattern row survives the fault [P2-S12-AC-104]');
select pg_temp.s12pd_run('fault-retry',(select request from s12pd_out where label='fault'));
select is(pg_temp.s12pd_state('fault-retry'),'00000',
  'the same key and the identical request succeed once the fault is gone: nothing was reserved [P2-S12-AC-104]');
select is(pg_temp.s12pd_body('fault-retry')->>'patternKey','s12pd-fault',
  'the retry creates the definition the failed call would have created [P2-S12-AC-104]');
