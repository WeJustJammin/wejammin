-- Test infrastructure only. No producer/policy replacement, disabled guard or
-- fabricated activation/signature. Entry/value/history bootstraps are labeled.
create temp table s12cc_out(label text primary key, operation text, request jsonb,
  response jsonb, state text, message text, detail text, headers text,
  before_rows jsonb, after_rows jsonb, call_role text) on commit drop;
create temp table s12cc_world(tag text primary key, source_id uuid, current_id uuid,
  source_rows jsonb, expected_heads jsonb, carry_source_id uuid) on commit drop;
create temp table s12cc_literal(tree jsonb) on commit drop;
insert into s12cc_literal values ('{"format":"cms.detached_tree.v1","nodes":[
  {"parent":null,"keySegments":["local"],"blockKey":"s12cc.root","blockVersion":1,"props":{"title":"LOCAL-ROOT"}},
  {"parent":0,"keySegments":["child"],"blockKey":"s12cc.child","blockVersion":1,"props":{"title":"LOCAL-CHILD"}}]}');

-- Private diagnostic only: the real policy projection requires trusted CMS
-- context. Never change its implementation or the public request/session seam.
create or replace function pg_temp.s12cc_policy_valid(p_version uuid) returns boolean
language plpgsql as $body$
declare prior_rpc text := current_setting('app.cms_rpc',true); answer boolean;
begin
  perform set_config('app.cms_rpc','true',true);
  begin
    answer := platform_private.cms_editorial_workflow_policy_valid(p_version);
  exception when others then
    perform set_config('app.cms_rpc',coalesce(prior_rpc,''),true);
    raise;
  end;
  perform set_config('app.cms_rpc',coalesce(prior_rpc,''),true);
  return answer;
end;
$body$;

-- Independent JCS for this controlled zero-edge manifest: only canonical UUID
-- strings and [] occur; fixed keys below are already in UTF-16 lexical order.
create or replace function pg_temp.s12cc_manifest_hash(p_type uuid,p_source uuid,p_target uuid)
returns text language sql immutable as $body$
  select encode(extensions.digest(convert_to('{"contentTypeId":"' || p_type::text || '","planIds":[],"sourceSchemaVersionId":"'
    || p_source::text || '","targetSchemaVersionId":"' || p_target::text || '"}','UTF8'),'sha256'),'hex') $body$;

create or replace function pg_temp.s12cc_snapshot() returns jsonb
language plpgsql volatile as $body$
declare answer jsonb := pg_temp.s12pl_snapshot(); store text; rows_json jsonb;
begin
  foreach store in array array['cms_entry_field_values','cms_entry_relations',
    'cms_conflict_records','cms_edit_presence','cms_restore_chain_manifests'] loop
    execute format('select coalesce(jsonb_agg(to_jsonb(r) order by to_jsonb(r)::text),''[]''::jsonb) from platform_private.%I r',store)
      into rows_json;
    answer := answer || jsonb_build_object('platform_private.' || store, rows_json);
  end loop;
  return answer;
end;
$body$;
create or replace function pg_temp.s12cc_call(p_label text, p_operation text, p_request jsonb)
returns void language plpgsql as $body$
declare fn text; proc oid; answer jsonb; code text := '00000'; msg text; details text;
  before_rows jsonb; prior_role text := current_setting('role'); invoked text;
begin
  fn := case p_operation when 'append' then 'cms_create_revision'
    when 'resolve' then 'cms_resolve_conflict' when 'restore' then 'cms_restore_revision' end;
  if fn is null then raise exception 'unknown carry test command'; end if;
  perform pg_temp.s09d_session('owner','service_role');
  perform set_config('response.headers','',true);
  before_rows := pg_temp.s12cc_snapshot();
  proc := to_regprocedure('platform_api.' || fn || '(jsonb)');
  if proc is null or not exists(select 1 from pg_proc where oid=proc
    and prorettype='jsonb'::regtype and not proretset and prokind='f') then
    code := '42883'; msg := 'exact public (jsonb) returning jsonb unavailable';
  else
    begin
      perform set_config('role','service_role',true);
      invoked := current_user;
      if invoked <> 'service_role' then raise exception 'carry effective role mismatch'; end if;
      begin
        execute format('select platform_api.%I($1)',fn) into answer using p_request;
      exception when others then
        get stacked diagnostics code=returned_sqlstate,msg=message_text,details=pg_exception_detail;
      end;
      perform set_config('role',prior_role,true);
    exception when others then
      perform set_config('role',prior_role,true);
      raise;
    end;
  end if;
  insert into s12cc_out values(p_label,p_operation,p_request,answer,code,msg,details,
    nullif(current_setting('response.headers',true),''),before_rows,pg_temp.s12cc_snapshot(),invoked);
end;
$body$;
create or replace function pg_temp.s12cc_body(p_label text) returns jsonb language sql stable as $body$
  -- Restore's locked public RPC envelope is retained raw in s12cc_out. Only
  -- resource consumers unwrap it; append/resolve keep their direct DTO.
  select case when operation='restore' then response->'resource' else response end
    from s12cc_out where label=p_label $body$;
create or replace function pg_temp.s12cc_request(p_tag text,p_operation text,p_key text,
  p_value text default 'EDITED',p_expected text default null) returns jsonb
language plpgsql stable as $body$
declare answer jsonb; field_id text; source_id uuid; version_id uuid; type_id uuid;
  expected text := coalesce(p_expected,pg_temp.s12pl_version(p_tag));
begin
  select w.source_id into source_id from s12cc_world w where tag=p_tag;
  select schema_version_id into version_id from platform_private.cms_entry_revisions where id=source_id;
  select content_type_id into type_id from platform_private.cms_content_entries where id=pg_temp.s12pl_entry_id(p_tag);
  select stable_field_id::text into field_id from platform_private.cms_field_definition_versions
    where content_type_version_id=version_id and field_key='title';
  answer := jsonb_build_object('entryId',pg_temp.s12pl_entry_id(p_tag),'expectedVersion',expected,
    'ifMatch',expected,'idempotencyKey',p_key,'context',pg_temp.s09d_context('owner',true));
  if p_operation='restore' then
    return answer || jsonb_build_object('revisionId',source_id,'migrationChainId',
      platform_private.cms_restore_chain_manifest_id(platform_private.cms_restore_chain_derive(type_id,version_id,version_id)->>'hash'));
  elsif p_operation='append' then
    return answer || jsonb_build_object('baseRevision','1','changedPaths',jsonb_build_array('/fields/' || field_id),
      'values',jsonb_build_object(field_id,p_value),'locale','en-US');
  end if;
  return answer || jsonb_build_object('baseRevision','1','conflictId',
    (select id from platform_private.cms_conflict_records where entry_id=pg_temp.s12pl_entry_id(p_tag) and state='open'),
    'choices',jsonb_build_array(jsonb_build_object('path','/fields/' || field_id,'choice','yours')));
end;
$body$;

-- Guarded initial entry/value bootstrap, as S10 restore-transform fixtures do.
-- Pattern placement remains the real public command; only the empty entry is seeded.
create or replace function pg_temp.s12cc_world(p_tag text,p_link text default 'linked',p_template text default null)
returns setof text language plpgsql as $body$
declare rev uuid := extensions.gen_random_uuid(); entry_id uuid := extensions.gen_random_uuid();
  field_row platform_private.cms_field_definition_versions; values_json jsonb; template_id uuid;
begin
  select f.* into field_row from platform_private.cms_field_definition_versions f
    where content_type_version_id=(select version_id from s12pd_types where ordinal=1)
      and field_key='title';
  values_json := jsonb_build_object(field_row.stable_field_id::text,'SOURCE');
  template_id := (pg_temp.s09d_resp(p_template)->>'id')::uuid;
  perform set_config('app.cms_rpc','true',true);
  insert into platform_private.cms_content_entries(id,owner_id,content_type_id,owner_party_id,
    lifecycle,current_draft_revision_id,version,created_by)
  values(entry_id,pg_temp.s09d_id('ownerOrg'),(select id from s12pd_types where ordinal=1),
    pg_temp.s09d_id('ownerOrg'),'active',null,1,pg_temp.s09d_actor_id('owner','auth')::uuid);
  insert into platform_private.cms_entry_revisions(id,owner_id,entry_id,revision_number,schema_version_id,
    template_version_id,taxonomy_version_ids,parent_revision_ids,locale,payload_hash,author_person_id,
    acting_party_id,state,version,validation_state,validation_report)
  values(rev,pg_temp.s09d_id('ownerOrg'),entry_id,1,(select version_id from s12pd_types where ordinal=1),
    template_id,'[]','[]','en-US',platform_private.cms_jcs_sha256(values_json),
    pg_temp.s09d_actor_id('owner','person')::uuid,pg_temp.s09d_id('ownerOrg'),'draft',1,'valid','{}');
  insert into platform_private.cms_entry_field_values(owner_id,state,version,revision_id,field_id,
    field_definition_id,locale,value,provenance,value_hash)
  values(pg_temp.s09d_id('ownerOrg'),'active',1,rev,field_row.stable_field_id,field_row.id,
    'en-US','"SOURCE"','authored',platform_private.cms_jcs_sha256('"SOURCE"'::jsonb));
  update platform_private.cms_content_entries set current_draft_revision_id=rev where id=entry_id;
  insert into platform_private.cms_entry_assignments(owner_id,entry_id,assignee_person_id,capability_key,state,version)
  values(pg_temp.s09d_id('ownerOrg'),entry_id,pg_temp.s09d_actor_id('owner','person')::uuid,'cms.author','active',1);
  insert into s12pl_ids values(p_tag || ':entry',entry_id::text),(p_tag || ':revision',rev::text);
  insert into s12cc_world(tag,source_id,current_id) values(p_tag,rev,rev);
  perform pg_temp.s12pl_run('cc-place:' || p_tag,pg_temp.s12pl_request(p_tag,'cc-v1',
    case when p_template is null then '/' else '/main' end,
    '{"/local":{"title":"LOCAL-ROOT"},"/local/child":{"title":"LOCAL-CHILD"}}',
    's12cc-place-' || p_tag,p_link));
  return next extensions.is(pg_temp.s12pl_state('cc-place:' || p_tag),'00000',p_tag || ': real public placement succeeds');
end;
$body$;
create or replace function pg_temp.s12cc_capture(p_tag text) returns void language sql as $body$
  update s12cc_world w set source_rows=(select jsonb_agg(to_jsonb(i) order by path,version)
      from platform_private.cms_composition_instances i where revision_id=w.source_id),
    expected_heads=(select coalesce(jsonb_agg(to_jsonb(h) order by h.position,h.path),'[]') from
      (select distinct on(i.path) i.* from platform_private.cms_composition_instances i
        where i.revision_id=w.source_id order by i.path,i.version desc,i.id) h where h.state='active')
  where tag=p_tag $body$;

-- DEC-209: conflict resolution carries from the entry's current draft (theirs), so the
-- carry source of that world is the current draft, captured independently of the base.
create or replace function pg_temp.s12cc_capture_carry(p_tag text) returns void language sql as $body$
  update s12cc_world w set carry_source_id=w.current_id,
    source_rows=(select jsonb_agg(to_jsonb(i) order by path,version)
      from platform_private.cms_composition_instances i where revision_id=w.current_id),
    expected_heads=(select coalesce(jsonb_agg(to_jsonb(h) order by h.position,h.path),'[]') from
      (select distinct on(i.path) i.* from platform_private.cms_composition_instances i
        where i.revision_id=w.current_id order by i.path,i.version desc,i.id) h where h.state='active')
  where tag=p_tag $body$;

-- Historical second draft bootstrap ONLY, not a revision-command proof. Source
-- rows stay untouched; the current draft has a different field and no composition.
create or replace function pg_temp.s12cc_current(p_tag text,p_template uuid default null)
returns uuid language plpgsql as $body$
declare source_row platform_private.cms_entry_revisions; next_id uuid := extensions.gen_random_uuid();
  title_id uuid; values_json jsonb;
begin
  perform set_config('app.cms_rpc','true',true);
  select r.* into source_row from platform_private.cms_entry_revisions r
    where id=(select source_id from s12cc_world where tag=p_tag);
  select stable_field_id into title_id from platform_private.cms_field_definition_versions
    where content_type_version_id=source_row.schema_version_id and field_key='title';
  values_json := jsonb_build_object(title_id::text,'CURRENT');
  insert into platform_private.cms_entry_revisions select (jsonb_populate_record(
    null::platform_private.cms_entry_revisions,to_jsonb(source_row) || jsonb_build_object(
      'id',next_id,'revision_number',source_row.revision_number+1,'parent_revision_ids',jsonb_build_array(source_row.id),
      'template_version_id',p_template,'payload_hash',platform_private.cms_jcs_sha256(values_json)))).*;
  insert into platform_private.cms_entry_field_values select (jsonb_populate_record(
    null::platform_private.cms_entry_field_values,to_jsonb(f) || jsonb_build_object('id',extensions.gen_random_uuid(),
      'revision_id',next_id,'value','CURRENT','value_hash',platform_private.cms_jcs_sha256('"CURRENT"'::jsonb)))).*
    from platform_private.cms_entry_field_values f where revision_id=source_row.id;
  update platform_private.cms_content_entries set current_draft_revision_id=next_id,version=version+1
    where id=pg_temp.s12pl_entry_id(p_tag);
  update s12cc_world set current_id=next_id where tag=p_tag;
  update s12pl_ids set value=next_id::text where key=p_tag || ':revision';
  return next_id;
end;
$body$;

-- DEC-209: a conflict-resolution world keeps its composition on the CURRENT draft (theirs), because
-- composition commands write only to the current draft. The conflict base (revision 1) stays composition-empty
-- and the helper makes the current draft the carry source every later helper and assertion reads.
create or replace function pg_temp.s12cc_theirs_first(p_tag text) returns void language plpgsql as $body$
begin
  perform pg_temp.s12cc_current(p_tag);
  update s12cc_world set source_id=current_id where tag=p_tag;
end;
$body$;

create or replace function pg_temp.s12cc_refused(p_label text,p_operation text,p_request jsonb,p_token text)
returns setof text language plpgsql as $body$
begin
  perform pg_temp.s12cc_call(p_label,p_operation,p_request);
  return next extensions.is((select state || ':' || coalesce(message,'') from s12cc_out where label=p_label),
    'P0001:' || p_token,p_label || ': exact application refusal');
  return next extensions.ok((select before_rows=after_rows from s12cc_out where label=p_label),
    p_label || ': atomic refusal preserves complete rows, including reservation/audit/outbox/composition');
end;
$body$;
create or replace function pg_temp.s12cc_copied(p_label text,p_tag text)
returns setof text language plpgsql as $body$
declare result jsonb := pg_temp.s12cc_body(p_label); expected jsonb; actual jsonb; history jsonb;
  call_row s12cc_out; source_row platform_private.cms_entry_revisions; active_id uuid; entry_type uuid; expected_hash text;
  verification jsonb; expected_verification jsonb;
  generated text[] := array['id','revision_id','version','created_at','updated_at','carried_from_id'];
begin
  return next extensions.is((select state from s12cc_out where label=p_label),'00000',p_label || ': public command succeeds');
  return next extensions.is((select call_role from s12cc_out where label=p_label),'service_role',p_label || ': actual service-role boundary');
  select * into call_row from s12cc_out where label=p_label;
  if call_row.operation='restore' then
    return next extensions.is((select jsonb_agg(k order by k collate "C") from jsonb_object_keys(
      case when jsonb_typeof(call_row.response)='object' then call_row.response else '{}'::jsonb end) k),
      '["resource","restoreVerification"]'::jsonb,p_label || ': exact locked restore envelope, not a direct revision DTO');
    return next extensions.is(jsonb_typeof(call_row.response->'resource'),'object',p_label || ': envelope resource is an object');
    select r.* into source_row from platform_private.cms_entry_revisions r
      where id=(select source_id from s12cc_world where tag=p_tag);
    select content_type_id into entry_type from platform_private.cms_content_entries where id=pg_temp.s12pl_entry_id(p_tag);
    select v.id into active_id from platform_private.cms_content_type_versions v where v.content_type_id=entry_type and v.state='active';
    expected_hash := pg_temp.s12cc_manifest_hash(entry_type,source_row.schema_version_id,active_id);
    expected_verification := jsonb_build_object('request',jsonb_build_object(
      'entryId',pg_temp.s12pl_entry_id(p_tag),'revisionId',source_row.id,
      'migrationChainId',call_row.request->'migrationChainId','expectedVersion',call_row.request->'expectedVersion'),
      'registry',jsonb_build_object('revisionId',source_row.id,'migrationChainId',call_row.request->'migrationChainId',
        'sourceSchemaVersionId',source_row.schema_version_id,'activeSchemaVersionId',active_id,
        'chainSchemaVersionIds',jsonb_build_array(source_row.schema_version_id),'entryVersion',call_row.request->'expectedVersion'));
    verification := case when jsonb_typeof(call_row.response->'restoreVerification')='object'
      then call_row.response->'restoreVerification' else '{}'::jsonb end;
    return next extensions.is(verification-'seams',expected_verification,
      p_label || ': complete locked request/registry evidence matches named source, actual active schema and zero-edge chain');
    return next extensions.is((select jsonb_agg(s order by s collate "C") from jsonb_array_elements_text(
      case when jsonb_typeof(verification->'seams')='array' then verification->'seams' else '[]'::jsonb end) s),
      '["active_schema_compatibility_recheck","entry_version_cas","migration_chain_covers_source_to_active_schema", "migration_chain_registered_and_ordered","new_draft_revision_only_never_activates_source","non_fabricating_defaults_and_relations_translation","restore_idempotency_and_epoch_fencing","source_revision_readable_and_immutable"]'::jsonb,
      p_label || ': all eight distinct locked seams, without imposing array order');
    return next extensions.is(call_row.request->>'migrationChainId',substr(expected_hash,1,8) || '-' || substr(expected_hash,9,4)
      || '-4' || substr(expected_hash,13,3) || '-8' || substr(expected_hash,17,3) || '-' || substr(expected_hash,21,12),
      p_label || ': requested chain UUID independently derives from exact zero-edge manifest hash');
    return next extensions.ok(exists(select 1 from platform_private.cms_restore_chain_manifests m
      where m.manifest_hash::text=expected_hash and m.owner_id=source_row.owner_id and m.content_type_id=entry_type
        and m.source_schema_version_id=source_row.schema_version_id and m.target_schema_version_id=active_id
        and m.edge_count=0 and m.plan_ids='[]'::jsonb and m.state='active' and m.version=1),
      p_label || ': actual persisted zero-edge manifest matches independent hash and scope, not generated PK UUID');
  end if;
  select expected_heads into expected from s12cc_world where tag=p_tag;
  select coalesce(jsonb_agg(to_jsonb(i) order by position,path),'[]') into actual
    from platform_private.cms_composition_instances i where revision_id=(result->>'id')::uuid;
  return next extensions.is(jsonb_array_length(actual),jsonb_array_length(expected),p_label || ': exactly newest active heads, no retired resurrection/history duplicates');
  return next extensions.ok(not exists(select 1 from jsonb_array_elements(expected) e where not exists(
    select 1 from jsonb_array_elements(actual) a where a->>'path'=e->>'path'
      and a-generated=e-generated and a->>'carried_from_id'=e->>'id'
      and a->>'id'<>e->>'id' and a->>'version'='1')),
    p_label || ': fresh append-only rows preserve every semantic column, exact position/tree/bindings and carried_from_id');
  select jsonb_agg(to_jsonb(i) order by path,version) into history
    from platform_private.cms_composition_instances i
    where revision_id=(select coalesce(carry_source_id,source_id) from s12cc_world where tag=p_tag);
  return next extensions.is(history,(select source_rows from s12cc_world where tag=p_tag),p_label || ': complete source history immutable');
  return next extensions.ok(not exists(select 1 from jsonb_array_elements((select before_rows->'platform_private.cms_composition_instances'
    from s12cc_out where label=p_label)) old where not exists(select 1 from platform_private.cms_composition_instances i where to_jsonb(i)=old)),
    p_label || ': every preexisting composition row unchanged');
  return next extensions.is(result->>'entryVersion',((select request->>'expectedVersion' from s12cc_out where label=p_label)::bigint+1)::text,
    p_label || ': exactly one real entry CAS advance');
  return next extensions.ok((select current_draft_revision_id=(result->>'id')::uuid from platform_private.cms_content_entries
    where id=pg_temp.s12pl_entry_id(p_tag)),p_label || ': returned new revision is the persisted current draft');
end;
$body$;
create or replace function pg_temp.s12cc_replay(p_original text,p_tag text)
returns setof text language plpgsql as $body$
declare r s12cc_out; v_label text := p_original || ':replay';
begin
  select * into r from s12cc_out where s12cc_out.label=p_original;
  perform pg_temp.s12cc_call(v_label,r.operation,r.request);
  return next extensions.is((select response from s12cc_out where label=v_label),r.response,
    v_label || ': exact complete body/envelope, even after entry advanced');
  return next extensions.ok((select state='00000' and before_rows=after_rows and headers::jsonb @> '[{"x-cms-idempotent-replay":"true"}]'
    from s12cc_out where s12cc_out.label=v_label),v_label || ': replay signal and no repeated effect');
  return query select * from pg_temp.s12cc_refused(p_original || ':key-mismatch',r.operation,
    r.request || jsonb_build_object('expectedVersion',((r.request->>'expectedVersion')::bigint+1)::text,
      'ifMatch',((r.request->>'expectedVersion')::bigint+1)::text),'IDEMPOTENCY_MISMATCH');
  if r.operation <> 'resolve' then
    return query select * from pg_temp.s12cc_refused(p_original || ':stale',r.operation,
      r.request || jsonb_build_object('idempotencyKey',(r.request->>'idempotencyKey') || '-stale'),'VERSION_MISMATCH');
  end if;
end;
$body$;
