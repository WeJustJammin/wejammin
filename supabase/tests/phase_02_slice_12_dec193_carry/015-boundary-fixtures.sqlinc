-- Ordinary carry TEST infrastructure only. All storage fixtures use real owner,
-- schema, revision and row guards; no public placement/activation claim is made.
create temp table s12cb_rows(tag text, path text, id uuid, primary key(tag,path)) on commit drop;
create temp table s12cb_literal(tree jsonb) on commit drop;

create function pg_temp.s12cb_world(p_tag text,p_actor text default 'owner',
  p_type uuid default null,p_schema uuid default null) returns void language plpgsql as $body$
declare rev uuid := extensions.gen_random_uuid(); entry_id uuid := extensions.gen_random_uuid();
  org uuid; actor uuid; person uuid; field_row platform_private.cms_field_definition_versions;
begin
  select party_id,auth_user_id,person_id into org,actor,person from s09d_actor where key=p_actor;
  p_type := coalesce(p_type,(select id from s12pd_types where ordinal=1));
  p_schema := coalesce(p_schema,(select version_id from s12pd_types where ordinal=1));
  select * into field_row from platform_private.cms_field_definition_versions
    where content_type_version_id=p_schema and field_key='title';
  perform set_config('app.cms_rpc','true',true);
  insert into platform_private.cms_content_entries(id,owner_id,content_type_id,owner_party_id,
    lifecycle,current_draft_revision_id,version,created_by)
  values(entry_id,org,p_type,org,'active',null,1,actor);
  insert into platform_private.cms_entry_revisions(id,owner_id,entry_id,revision_number,schema_version_id,
    template_version_id,taxonomy_version_ids,parent_revision_ids,locale,payload_hash,author_person_id,
    acting_party_id,state,version,validation_state,validation_report)
  values(rev,org,entry_id,1,p_schema,null,'[]','[]','en-US',
    platform_private.cms_jcs_sha256(jsonb_build_object(field_row.stable_field_id::text,'SOURCE')),
    person,org,'draft',1,'valid','{}');
  insert into platform_private.cms_entry_field_values(owner_id,state,version,revision_id,field_id,
    field_definition_id,locale,value,provenance,value_hash)
  values(org,'active',1,rev,field_row.stable_field_id,field_row.id,'en-US','"SOURCE"','authored',
    platform_private.cms_jcs_sha256('"SOURCE"'::jsonb));
  update platform_private.cms_content_entries set current_draft_revision_id=rev where id=entry_id;
  if p_actor='owner' then
    insert into platform_private.cms_entry_assignments(owner_id,entry_id,assignee_person_id,capability_key,state,version)
    values(org,entry_id,person,'cms.author','active',1);
  end if;
  insert into s12pl_ids values(p_tag || ':entry',entry_id::text),(p_tag || ':revision',rev::text);
  insert into s12cc_world(tag,source_id,current_id) values(p_tag,rev,rev);
end;
$body$;

-- Labelled scan-output fixture only: reuse the real v1 placement's linked pin,
-- then the existing guarded pending seam. No scan/activation producer is claimed.
create function pg_temp.s12cb_pending_source(p_tag text) returns void language plpgsql as $body$
declare donor platform_private.cms_composition_instances; pending_id uuid;
  stamp timestamptz := clock_timestamp();
begin
  perform pg_temp.s09d_session('owner','service_role');
  select i.* into donor from platform_private.cms_composition_instances i
    where revision_id=(select source_id from s12cc_world where tag='cc-linked-inactive')
      and path='/keep' order by version desc limit 1;
  perform set_config('app.cms_rpc','true',true);
  insert into platform_private.cms_composition_instances select (jsonb_populate_record(
    null::platform_private.cms_composition_instances,to_jsonb(donor) || jsonb_build_object(
      'id',extensions.gen_random_uuid(),'revision_id',pg_temp.s12pl_rev(p_tag),'version',1,
      'state','active','position',23,'parent_instance_id',null,'pending_pattern_version',null,
      'props','{"/keep":{"title":"LOCAL-PENDING"}}'::jsonb,
      'bindings','{"caption":{"literal":"PENDING-CAPTION"}}'::jsonb,
      'created_at',stamp,'updated_at',stamp,'carried_from_id',null))).*;
  pending_id := pg_temp.s12pu_pending(p_tag,'/keep',2);
  insert into s12cb_rows values(p_tag,'/keep',pending_id);
  -- Expected selection is this explicitly known pending identity, not a copy of
  -- the future production head-selection algorithm or the active-only old oracle.
  update s12cc_world w set source_rows=(select jsonb_agg(to_jsonb(i) order by path,version)
      from platform_private.cms_composition_instances i where revision_id=w.source_id),
    expected_heads=(select jsonb_build_array(to_jsonb(i))
      from platform_private.cms_composition_instances i where i.id=pending_id)
    where w.tag=p_tag;
end;
$body$;

-- Valid legacy row envelope, not a pattern producer. JSON population deliberately
-- ignores the future nullable provenance member when that column is absent.
create function pg_temp.s12cb_row(p_tag text,p_path text,p_position integer,
  p_parent uuid default null,p_tree jsonb default null,p_creator uuid default null)
returns uuid language plpgsql as $body$
declare donor platform_private.cms_composition_instances; target platform_private.cms_entry_revisions;
  row_id uuid := extensions.gen_random_uuid(); stamp timestamptz := clock_timestamp();
begin
  select i.* into donor from platform_private.cms_composition_instances i
    where revision_id=(select source_id from s12cc_world where tag='cc-append')
      and path='/local' order by version desc limit 1;
  select * into target from platform_private.cms_entry_revisions where id=pg_temp.s12pl_rev(p_tag);
  perform set_config('app.cms_rpc','true',true);
  insert into platform_private.cms_composition_instances select (jsonb_populate_record(
    null::platform_private.cms_composition_instances,to_jsonb(donor) || jsonb_build_object(
      'id',row_id,'owner_id',target.owner_id,'revision_id',target.id,'path',p_path,'slot_key','root',
      'version',1,'state','active','position',p_position,'parent_instance_id',p_parent,
      'pattern_id',null,'pattern_version',null,'pending_pattern_version',null,'link_mode','detached',
      'props','{}'::jsonb,'bindings',jsonb_build_object('literal',p_path),'detached_tree',p_tree,
      'block_key',case when p_tree is null then 's12pd.block' else 's12cc.root' end,
      'created_by',coalesce(p_creator,(select created_by from platform_private.cms_content_entries where id=target.entry_id)),
      'block_version',1,'created_at',stamp,'updated_at',stamp,'carried_from_id',null))).*;
  insert into s12cb_rows values(p_tag,p_path,row_id);
  return row_id;
end;
$body$;

-- Literal 512-node preorder, each value bounded independently, aggregate >256KiB.
insert into s12cb_literal select jsonb_build_object('format','cms.detached_tree.v1','nodes',
  jsonb_agg(jsonb_build_object('parent',case when n=0 then null else 0 end,
    'keySegments',jsonb_build_array(case when n=0 then 'wide' else 'n' || n::text end),
    'blockKey',case when n=0 then 's12cc.root' else 's12cc.child' end,'blockVersion',1,
    'props',case n when 1 then 'null'::jsonb when 2 then '42'::jsonb when 3 then '"scalar"'::jsonb
      else jsonb_build_object('title',repeat('x',600)) end) order by n))
  from generate_series(0,511) n;

create function pg_temp.s12cb_copied(p_label text,p_tag text) returns setof text language plpgsql as $body$
declare expected jsonb; actual jsonb; result jsonb := pg_temp.s12cc_body(p_label); history jsonb;
  generated text[] := array['id','revision_id','version','created_at','updated_at','carried_from_id','parent_instance_id'];
begin
  select expected_heads into expected from s12cc_world where tag=p_tag;
  select coalesce(jsonb_agg(to_jsonb(i) order by position,path),'[]') into actual
    from platform_private.cms_composition_instances i where revision_id=(result->>'id')::uuid;
  return next extensions.is((select state from s12cc_out where label=p_label),'00000',p_label || ': public success');
  return next extensions.is(jsonb_array_length(actual),jsonb_array_length(expected),p_label || ': exact head cardinality');
  return next extensions.ok(not exists(select 1 from jsonb_array_elements(expected) e where not exists(
    select 1 from jsonb_array_elements(actual) a where a->>'path'=e->>'path'
      and a-generated=e-generated and a->>'carried_from_id'=e->>'id'
      and a->>'id'<>e->>'id' and a->>'version'='1'
      and case when e->>'parent_instance_id' is null then a->>'parent_instance_id' is null else exists(
        select 1 from jsonb_array_elements(actual) parent
          where parent->>'carried_from_id'=e->>'parent_instance_id'
            and parent->>'id'=a->>'parent_instance_id') end)),
    p_label || ': every semantic member and exact selected-parent remap/provenance retained');
  select jsonb_agg(to_jsonb(i) order by path,version) into history
    from platform_private.cms_composition_instances i where revision_id=(select source_id from s12cc_world where tag=p_tag);
  return next extensions.is(history,(select source_rows from s12cc_world where tag=p_tag),p_label || ': complete source history immutable');
  return next extensions.ok(not exists(select 1 from jsonb_array_elements((select before_rows->
    'platform_private.cms_composition_instances' from s12cc_out where label=p_label)) old
    where not exists(select 1 from platform_private.cms_composition_instances i where to_jsonb(i)=old)),
    p_label || ': all preexisting composition rows immutable');
end;
$body$;

-- Each probe rolls back its INSERT even on success; an absent column is captured
-- as assertion evidence, never a driver/setup abort. The same envelope is reused.
create function pg_temp.s12cb_provenance(p_label text,p_target text,p_source uuid,p_expected text)
returns setof text language plpgsql as $body$
declare donor jsonb; observed jsonb; code text := '00000'; before_rows jsonb; actual_rows jsonb;
begin
  select to_jsonb(i) into donor from platform_private.cms_composition_instances i
    where id=(select id from s12cb_rows where tag=p_target and path='/legacy');
  donor := donor || jsonb_build_object('id',extensions.gen_random_uuid(),'path','/probe',
    'carried_from_id',p_source,'parent_instance_id',null);
  perform pg_temp.s09d_session('owner','service_role');
  perform set_config('app.cms_rpc','true',true);
  before_rows := pg_temp.s12cc_snapshot();
  begin
    execute 'insert into platform_private.cms_composition_instances select '
      || '(jsonb_populate_record(null::platform_private.cms_composition_instances,$1)).* '
      || 'returning to_jsonb(cms_composition_instances)' into observed using donor;
    raise exception 'S12CB_PROBE_ROLLBACK' using errcode='ZCB01';
  exception when sqlstate 'ZCB01' then null;
    when others then get stacked diagnostics code=returned_sqlstate;
  end;
  actual_rows := pg_temp.s12cc_snapshot();
  return next extensions.is(code,p_expected,p_label || ': exact storage outcome');
  if p_expected='00000' then
    return next extensions.ok(observed ? 'carried_from_id',p_label || ': real column assignment is nonvacuous');
    return next extensions.is(observed->>'carried_from_id',p_source::text,p_label || ': actual nullable/provenance assignment');
  end if;
  return next extensions.is(actual_rows,before_rows,p_label || ': complete stores unchanged after isolated probe');
end;
$body$;

create function pg_temp.s12cb_fault_image(p_text text) returns jsonb language plpgsql immutable as $body$
begin
  return coalesce(p_text::jsonb,'{}'::jsonb);
exception when invalid_text_representation then return '{}'::jsonb;
end;
$body$;

-- Real later-row fault, not a producer replacement. Its diagnostic contains the
-- first row actually visible in the destination transaction before row two fails.
create function pg_temp.s12cb_copy_fault() returns trigger language plpgsql as $body$
declare target text := nullif(current_setting('s12cc.boundary_fault_entry',true),''); first_row jsonb;
begin
  if target is not null and exists(select 1 from platform_private.cms_entry_revisions r
    where r.id=new.revision_id and r.entry_id::text=target and r.revision_number>1) then
    select to_jsonb(i) into first_row from platform_private.cms_composition_instances i
      where i.revision_id=new.revision_id order by i.id limit 1;
    if first_row->>'carried_from_id' is not null then
      raise exception 'S12CB_SECOND_CARRY_FAULT' using errcode='P0001',
        detail=jsonb_build_object('first',first_row,'second',to_jsonb(new))::text;
    end if;
  end if;
  return new;
end;
$body$;
create trigger s12cb_copy_fault before insert on platform_private.cms_composition_instances
  for each row execute function pg_temp.s12cb_copy_fault();
