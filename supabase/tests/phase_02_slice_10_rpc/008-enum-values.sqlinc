-- CMS-05/06 enum values are bound to the active immutable field choices.
-- This fragment runs after the positive create fixture under the same
-- transaction-only editorial-policy projection; no operational policy is
-- installed by these tests.
select pg_temp.s10_rpc_as(
  'a9100000-0000-4000-8000-000000000001'::uuid,
  (select value::uuid from s10_ids where key = 'organization')
);

select ok(
  platform_private.cms_draft_field_value_valid(
    (select value::uuid from s10_ids where key = 'draftVersionId'),
    (select value::uuid from s10_ids where key = 'typeEnumFieldId'),
    to_jsonb('jazz'::text), 'authored'
  )
  and not platform_private.cms_draft_field_value_valid(
    (select value::uuid from s10_ids where key = 'draftVersionId'),
    (select value::uuid from s10_ids where key = 'typeEnumFieldId'),
    to_jsonb('metal'::text), 'authored'
  ),
  'CMS enum value validation accepts only an immutable declared choice'
);
select ok(
  not platform_private.cms_draft_field_value_valid(
    (select value::uuid from s10_ids where key = 'draftVersionId'),
    (select value::uuid from s10_ids where key = 'typeUnboundedEnumFieldId'),
    to_jsonb('anything'::text), 'authored'
  ),
  'CMS enum kind without a nonempty choice set fails closed'
);

create temp table s10_enum_create_request on commit drop as
select jsonb_set(
  jsonb_set(
    request,
    '{changedPaths}',
    jsonb_build_array(
      '/fields/' || (select value from s10_ids where key = 'typeFieldId'),
      '/fields/' || (select value from s10_ids where key = 'typeEnumFieldId')
    )
  ),
  '{values}',
  jsonb_build_object(
    (select value from s10_ids where key = 'typeFieldId'), 'First draft title',
    (select value from s10_ids where key = 'typeEnumFieldId'), 'jazz'
  )
) || jsonb_build_object('idempotencyKey', 's10-enum-create-0001') as request
from s10_create_request;

select pg_temp.s10_rpc_probe(
  'enum-create-unbounded', null,
  'select platform_api.cms_create_entry('
    || quote_literal((
      select jsonb_set(
        jsonb_set(
          request, '{changedPaths}',
          (request->'changedPaths') ||
            jsonb_build_array('/fields/' ||
              (select value from s10_ids where key = 'typeUnboundedEnumFieldId'))
        ),
        '{values}',
        (request->'values') || jsonb_build_object(
          (select value from s10_ids where key = 'typeUnboundedEnumFieldId'),
          'anything'
        )
      ) || jsonb_build_object('idempotencyKey', 's10-enum-unbounded-0001')
      from s10_enum_create_request
    )::text) || '::jsonb)'
);
select is(
  pg_temp.s10_probe_message('enum-create-unbounded'), 'VALIDATION_FAILED',
  'CMS-03B-10 rejects an enum without declared choices before creating an entry'
);

create temp table s10_enum_create on commit drop as
select pg_temp.s10_rpc_exec(
  'select platform_api.cms_create_entry('
    || quote_literal((select request::text from s10_enum_create_request))
    || '::jsonb)'
) as response;
select is(
  pg_temp.s10_last_error_state(), '00000',
  'CMS-03B-10 creates a draft with an approved enum choice'
);
select is(
  (select value from platform_private.cms_entry_field_values
   where revision_id =
     (select (response->'revision'->>'id')::uuid from s10_enum_create)
     and field_id = (select value::uuid from s10_ids where key = 'typeEnumFieldId')),
  to_jsonb('jazz'::text),
  'CMS-03B-10 stores the approved enum as a schema-pinned first draft value'
);

create temp table s10_enum_revision_request on commit drop as
select jsonb_build_object(
  'entryId', (select response->'entry'->>'id' from s10_enum_create),
  'baseRevision', '1',
  'changedPaths', jsonb_build_array('/fields/' || ids_enum.value),
  'values', jsonb_build_object(ids_enum.value, 'rock'),
  'locale', 'en-US',
  'expectedVersion', '1', 'ifMatch', '1',
  'idempotencyKey', 's10-enum-revision-0001',
  'context', jsonb_build_object(
    'actingPartyId', ids_org.value,
    'actingContextId', 'a9100000-0000-4000-8000-000000000094',
    'correlationId', 'a9100000-0000-4000-8000-000000000095'
  )
) as request
from s10_ids ids_enum, s10_ids ids_org
where ids_enum.key = 'typeEnumFieldId' and ids_org.key = 'organization';

select pg_temp.s10_rpc_probe(
  'enum-revision-unknown', null,
  'select platform_api.cms_create_revision('
    || quote_literal((
      select jsonb_set(request, array['values',
        (select value from s10_ids where key = 'typeEnumFieldId')],
        to_jsonb('metal'::text))
      from s10_enum_revision_request
    )::text) || '::jsonb)'
);
select is(
  pg_temp.s10_probe_message('enum-revision-unknown'), 'VALIDATION_FAILED',
  'CMS-03B-01 rejects an enum value outside the active choice set'
);

create temp table s10_enum_revision on commit drop as
select pg_temp.s10_rpc_exec(
  'select platform_api.cms_create_revision('
    || quote_literal((select request::text from s10_enum_revision_request))
    || '::jsonb)'
) as response;
select is(
  (select response->>'revisionNumber' from s10_enum_revision), '2',
  'CMS-03B-01 appends an immutable enum edit against an explicit base'
);
select is(
  (select value from platform_private.cms_entry_field_values
   where revision_id = (select (response->>'id')::uuid from s10_enum_revision)
     and field_id = (select value::uuid from s10_ids where key = 'typeEnumFieldId')),
  to_jsonb('rock'::text),
  'CMS-03B-01 persists the allowed enum edit'
);
select is(
  (select value from platform_private.cms_entry_field_values
   where revision_id = (select (response->>'id')::uuid from s10_enum_revision)
     and field_id = (select value::uuid from s10_ids where key = 'typeFieldId')),
  to_jsonb('First draft title'::text),
  'CMS-03B-01 retains the unchanged title in the immutable enum revision'
);

create temp table s10_enum_conflict on commit drop as
select pg_temp.s10_rpc_exec(
  'select platform_api.cms_create_revision('
    || quote_literal((
      select jsonb_set(
        jsonb_set(
          jsonb_set(request, '{expectedVersion}', '"2"'::jsonb),
          '{ifMatch}', '"2"'::jsonb
        ),
        array['values', (select value from s10_ids where key = 'typeEnumFieldId')],
        to_jsonb('jazz'::text)
      ) || jsonb_build_object('idempotencyKey', 's10-enum-conflict-0001')
      from s10_enum_revision_request
    )::text) || '::jsonb)'
) as response;
select is(
  (select response->>'kind' from s10_enum_conflict), 'conflict',
  'CMS-03B-01 records a durable same-enum-field divergence'
);

create temp table s10_enum_resolve_request on commit drop as
select jsonb_build_object(
  'entryId', conflict.entry_id,
  'conflictId', conflict.id,
  'baseRevision', '1',
  'choices', jsonb_build_array(jsonb_build_object(
    'path', conflict.changed_paths->>0,
    'choice', 'explicit',
    'value', 'jazz'
  )),
  'expectedVersion', '2', 'ifMatch', '2',
  'idempotencyKey', 's10-enum-resolve-0001',
  'context', jsonb_build_object(
    'actingPartyId', (select value from s10_ids where key = 'organization'),
    'actingContextId', 'a9100000-0000-4000-8000-000000000094',
    'correlationId', 'a9100000-0000-4000-8000-000000000095'
  )
) as request
from platform_private.cms_conflict_records conflict
where conflict.entry_id =
  (select (response->'entry'->>'id')::uuid from s10_enum_create)
  and conflict.state = 'open';

select pg_temp.s10_rpc_probe(
  'enum-resolve-unknown', null,
  'select platform_api.cms_resolve_conflict('
    || quote_literal((
      select jsonb_set(request, '{choices,0,value}', to_jsonb('metal'::text))
      from s10_enum_resolve_request
    )::text) || '::jsonb)'
);
select is(
  pg_temp.s10_probe_message('enum-resolve-unknown'), 'VALIDATION_FAILED',
  'CMS-03B-02 rejects an explicit enum resolution outside approved choices'
);

create temp table s10_enum_resolved on commit drop as
select pg_temp.s10_rpc_exec(
  'select platform_api.cms_resolve_conflict('
    || quote_literal((select request::text from s10_enum_resolve_request))
    || '::jsonb)'
) as response;
select is(
  (select response->>'revisionNumber' from s10_enum_resolved), '3',
  'CMS-03B-02 resolves an enum conflict into a new immutable draft revision'
);
select is(
  (select value from platform_private.cms_entry_field_values
   where revision_id = (select (response->>'id')::uuid from s10_enum_resolved)
     and field_id = (select value::uuid from s10_ids where key = 'typeEnumFieldId')),
  to_jsonb('jazz'::text),
  'CMS-03B-02 persists only the explicit approved enum winner'
);
select is(
  (select state::text from platform_private.cms_conflict_records
   where id = (select (request->>'conflictId')::uuid
               from s10_enum_resolve_request)),
  'resolved',
  'CMS-03B-02 closes the durable enum conflict only after committing the winner'
);

create temp table s10_enum_detail on commit drop as
select pg_temp.s10_rpc_exec(
  'select platform_api.cms_get_entry_draft('
    || quote_literal(jsonb_build_object(
      'entryId', (select response->'entry'->>'id' from s10_enum_create),
      'context', jsonb_build_object(
        'actingPartyId', (select value from s10_ids where key = 'organization'),
        'actingContextId', 'a9100000-0000-4000-8000-000000000094',
        'correlationId', 'a9100000-0000-4000-8000-000000000095'
      )
    )::text) || '::jsonb)'
) as response;
select is(
  (select field.value->'value'
   from s10_enum_detail detail,
        jsonb_array_elements(detail.response->'fields') field(value)
   where field.value->>'fieldId' =
     (select value from s10_ids where key = 'typeEnumFieldId')),
  to_jsonb('jazz'::text),
  'CMS-03B-11 serves the authorized canonical enum winner without raw table access'
);
