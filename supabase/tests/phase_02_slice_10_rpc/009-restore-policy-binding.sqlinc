-- Editorial workflow-policy binding for the Slice 10 restore fixtures.
--
-- BE03b:546: restore re-fetches the editorial workflow-policy evidence (as
-- cms_create_revision does), so cms_restore_revision is DEPENDENCY_UNAVAILABLE for
-- a version whose projection is absent.  The shared Slice 10 fixture type is
-- activated by direct column writes (its activation envelope names a forged
-- policy), so the real projection cannot resolve it.  This fragment binds a policy
-- the way the 004b revision-write, presence and gallery suites do: it keeps the
-- REAL projection for every version it can resolve (the types built through the
-- real Slice 09 producers) and answers a complete, ordinary, transaction-local
-- evidence only for a version it cannot -- never an approved production policy.
-- Everything rolls back with the suite transaction.
--
-- Include AFTER the Slice 10 fixture and before the first restore probe.

alter function platform_private.cms_editorial_workflow_policy_evidence(uuid)
  rename to cms_editorial_workflow_policy_evidence_real;

create or replace function platform_private.cms_editorial_workflow_policy_evidence(p_version_id uuid)
returns jsonb
language sql
stable
security definer
set search_path = ''
as $body$
  select coalesce(
    platform_private.cms_editorial_workflow_policy_evidence_real(p_version_id),
    jsonb_build_object(
      'key', 'editorial', 'version', '1',
      'policyHash', repeat('c', 64), 'riskClass', 'ordinary',
      'requiredDecisionCount', 1,
      'requiredCapabilities', jsonb_build_array('cms.author'),
      'approvalEvidenceHash', repeat('d', 64)
    )
  )
  where p_version_id is not null
$body$;
