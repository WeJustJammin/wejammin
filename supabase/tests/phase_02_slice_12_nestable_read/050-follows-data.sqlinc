-- The list follows the data (BE03c 1528): an activation that WIDENS a lineage's types moves the version into a larger set's list and replaces
-- the predecessor; a retirement alone removes the item and moves the validator.  The retirement is the real governed command (CMS-03C-09
-- `retire`, DEC-190), the same flow the CMS-03C-13 suite uses.  [P2-S12-AC-105]

select pg_temp.s12nr_read('f-before12', array[1, 2]);
select pg_temp.s12nr_read('f-before1', array[1]);
select * from pg_temp.s12pl_pattern('p1b', 'nx-1', pg_temp.s12nr_tree('k2'), pg_temp.s12nr_types(1, 2), true, '1');
select pg_temp.s12nr_read('f-after12', array[1, 2]);
select pg_temp.s12nr_read('f-after1', array[1]);
select is(pg_temp.s12nr_keys(pg_temp.s12pu_body('f-after12')), array['nx-1@2', 'nx-12@1', 'nx-all@1', 'nx-ret@1', 'nx-sup@2'],
  'nx-1 v2 now lists T1 AND T2: it joins the two-type list, which it could not be in as v1 (T1 only)');
select is(pg_temp.s12nr_keys(pg_temp.s12pu_body('f-after1')), array['nx-1@2', 'nx-12@1', 'nx-all@1', 'nx-ret@1', 'nx-sup@2'],
  'in the single-type list nx-1 v2 replaces the superseded nx-1 v1');
select ok(pg_temp.s12pu_body('f-after12')->>'pageVersion' <> pg_temp.s12pu_body('f-before12')->>'pageVersion'
    and pg_temp.s12pu_body('f-after12')->>'pageVersion' = pg_temp.s12nr_page_version(1, 2)
    and (pg_temp.s12pu_body('f-after12')->>'pageVersion')::numeric > (pg_temp.s12pu_body('f-before12')->>'pageVersion')::numeric,
  'the pageVersion moved forward with the activation: it is the strong validator of the list');
select ok(pg_temp.s12pu_unchanged('f-after12') and pg_temp.s12pu_unchanged('f-after1'), 'the reads after the activation changed no store');

-- retirement -----------------------------------------------------------------------------------------------------------------------------
create temp table s12nr_ret_pre on commit drop as
select pg_temp.s12pu_body('f-after12') as page,
       (select count(*)::integer from platform_private.cms_pattern_versions) as version_rows,
       (select to_jsonb(review) from platform_private.cms_governed_reviews review
         where review.subject_id = (pg_temp.s12pd_body('pret')->>'id')::uuid) as review_row;
select ok((select page->'items' @> jsonb_build_array(pg_temp.s12nr_item('pret')) from s12nr_ret_pre)
    and (select review_row->>'state' from s12nr_ret_pre) = 'approved',
  'setup: nx-ret v1 is listed before the retirement and has an approved, activated governed review');
select pg_temp.s12pd_run('pret:retire', jsonb_build_object(
    'reviewId', (select review_row->>'id' from s12nr_ret_pre), 'action', 'retire',
    'expectedVersion', (select review_row->>'version' from s12nr_ret_pre), 'ifMatch', (select review_row->>'version' from s12nr_ret_pre),
    'reason', 'Nestable read retirement case', 'idempotencyKey', 's12nr-ret-retire-0001', 'context', pg_temp.s09d_context('owner', true)),
  'owner', 'service_role', 'activate');
select is(pg_temp.s12pd_state('pret:retire'), '00000', 'setup: the owner retires nx-ret v1 through the real governed command');
select diag(coalesce((select message || ' ' || coalesce(detail, '') from s12pd_out where label = 'pret:retire' and state <> '00000'), 'retire accepted'));
select is(pg_temp.s12pd_row('pret')->>'state', 'retired', 'setup: the pattern row is retired');
select is((select count(*)::integer from platform_private.cms_pattern_versions), (select version_rows from s12nr_ret_pre),
  'the retirement added no pattern version row: only the state of an existing row changed');
select pg_temp.s12nr_read('f-ret12', array[1, 2]);
select pg_temp.s12nr_read('f-ret1', array[1]);
select is(pg_temp.s12nr_keys(pg_temp.s12pu_body('f-ret12')), array['nx-1@2', 'nx-12@1', 'nx-all@1', 'nx-sup@2'],
  'the retired version leaves the list: exactly the previous items without nx-ret@1');
select ok(not (pg_temp.s12nr_keys(pg_temp.s12pu_body('f-ret1')) @> array['nx-ret@1']), 'and it leaves the single-type list too');
select ok((pg_temp.s12pu_body('f-ret12')->>'pageVersion')::numeric > (select (page->>'pageVersion')::numeric from s12nr_ret_pre)
    and pg_temp.s12pu_body('f-ret12')->>'pageVersion' = pg_temp.s12nr_page_version(1, 2),
  'a retirement ALONE moves pageVersion forward to the new high-water update instant of the compatible versions');
select ok(pg_temp.s12pu_unchanged('f-ret12'), 'the read after the retirement changed no store');
