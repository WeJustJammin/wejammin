-- Slice 12 linked-update scan: definer posture, grants, the lock order of BE03c "Slice 12 lock order" (row `cms.pattern.linked_update_scan`)
-- and every refusal of the request.  [P2-S12-AC-212, AC-213]

-- ------------------------------------------------------------------------------------------------------------- posture and grants --
create temp table s12ls_fn(sig text primary key, schema_name text not null, oid oid) on commit drop;
insert into s12ls_fn(sig, schema_name, oid) values
  ('platform_api.cms_scan_linked_pattern_updates(jsonb)', 'api', to_regprocedure('platform_api.cms_scan_linked_pattern_updates(jsonb)')),
  ('platform_private.cms_scan_linked_pattern_updates(jsonb)', 'private', to_regprocedure('platform_private.cms_scan_linked_pattern_updates(jsonb)')),
  ('platform_api.cms_linked_scan_resolve_event(uuid)', 'api', to_regprocedure('platform_api.cms_linked_scan_resolve_event(uuid)')),
  ('platform_private.cms_linked_scan_event_ref(uuid)', 'private', to_regprocedure('platform_private.cms_linked_scan_event_ref(uuid)')),
  ('platform_private.cms_linked_scan_request(jsonb)', 'private', to_regprocedure('platform_private.cms_linked_scan_request(jsonb)'));
select is((select count(*)::integer from s12ls_fn where oid is not null), 5,
  'the scan and its event resolver exist, each as a private function and a platform_api wrapper, beside the private request validator [P2-S12-AC-212]');
select is((select string_agg(pg_get_userbyid(proc.proowner), ',' order by fn.sig) from s12ls_fn fn join pg_proc proc on proc.oid = fn.oid),
  'wejammin_cms_definer,wejammin_cms_definer,wejammin_cms_definer,wejammin_cms_definer,wejammin_cms_definer',
  'all five functions are owned by the CMS definer role (SEC-2)');
select ok((select coalesce(bool_and(proc.prosecdef), false) from s12ls_fn fn join pg_proc proc on proc.oid = fn.oid),
  'all five functions are SECURITY DEFINER');
select ok((select coalesce(bool_and(coalesce(proc.proconfig, array[]::text[]) && array['search_path=""', 'search_path=']), false)
             from s12ls_fn fn join pg_proc proc on proc.oid = fn.oid),
  'all five functions pin an empty search_path');
select ok((select coalesce(bool_and(has_function_privilege('service_role', fn.oid, 'EXECUTE')), false) from s12ls_fn fn where fn.schema_name = 'api'),
  'service_role may execute both platform_api wrappers');
select ok((select not bool_or(has_function_privilege(role_name, fn.oid, 'EXECUTE'))
             from s12ls_fn fn, unnest(array['anon', 'authenticated']) role_name where fn.schema_name = 'api'),
  'anon and authenticated may execute neither wrapper');
select ok((select not bool_or(has_function_privilege(role_name, fn.oid, 'EXECUTE'))
             from s12ls_fn fn, unnest(array['anon', 'authenticated', 'service_role']) role_name where fn.schema_name = 'private'),
  'no application role may execute either private function');
select is((select count(*)::integer || ':' || (count(*) filter (where exists (select 1 from aclexplode(coalesce(proc.proacl, acldefault('f', proc.proowner))) acl
                                                                       where acl.grantee = 0)))::integer
            from s12ls_fn fn join pg_proc proc on proc.oid = fn.oid), '5:0',
  'PUBLIC holds EXECUTE on none of the five functions');

-- ----------------------------------------------------------------------------------------------------------------- lock order --
-- BE03c "Slice 12 lock order", row `cms.pattern.linked_update_scan`: the positions of a composition write (0 the entry row, 3 the pattern
-- version rows the write pins, 4 the entry's content-type version row, 5 the revision's live editorial review rows), taking entries in
-- ascending entry id order within a run of at most 500 instances.  A single session cannot observe the acquisition order of two
-- transactions (the deadlock itself belongs to the race module run by root), so this is a STATIC check on the stored function source, the
-- precedent of the pattern-updates suite: each full lock clause occurs once, in code, in the order the function acquires the locks, and the
-- candidate list that fixes the entry order is sorted ascending by entry id.
create temp table s12ls_lock_src(src text not null) on commit drop;
insert into s12ls_lock_src
select pg_catalog.regexp_replace(prosrc, '\s+', ' ', 'g') from pg_proc where oid = to_regprocedure('platform_private.cms_scan_linked_pattern_updates(jsonb)');
create temp table s12ls_lock_pos(position_no integer primary key, anchor text not null, at integer, occurrences integer) on commit drop;
insert into s12ls_lock_pos(position_no, anchor)
values (0, 'from platform_private.cms_content_entries entry_row where entry_row.id = v_entry_id for update'),
       (3, 'from platform_private.cms_pattern_versions locked where locked.id = v_target.id and locked.state = ''active'' for share'),
       (4, 'from platform_private.cms_content_type_versions type_version where type_version.id = v_revision.schema_version_id for share'),
       (5, 'from platform_private.cms_editorial_reviews review_row where review_row.revision_id = v_revision.id and review_row.state in (''open'', ''approved'') '
           || 'order by review_row.id for update');
update s12ls_lock_pos set at = pg_catalog.strpos((select src from s12ls_lock_src), anchor),
  occurrences = (pg_catalog.length((select src from s12ls_lock_src))
                 - pg_catalog.length(pg_catalog.replace((select src from s12ls_lock_src), anchor, ''))) / pg_catalog.length(anchor);
select is((select count(*)::integer from s12ls_lock_src), 1, 'the scan function source was read once');
select ok((select coalesce(bool_and(at > 0), false) from s12ls_lock_pos), 'the scan source names every full lock clause of the lock-order row (positions 0, 3, 4 and 5)');
select is((select string_agg(position_no::text || ':' || occurrences::text, ' ' order by position_no) from s12ls_lock_pos), '0:1 3:1 4:1 5:1',
  'each full lock clause occurs exactly once in the stored source');
select is((select string_agg(position_no::text, ' < ' order by at) from s12ls_lock_pos where at > 0), '0 < 3 < 4 < 5',
  'the scan acquires position 0 (entry), 3 (pattern version), 4 (content-type version) and 5 (live reviews) in that order [BE03c Slice 12 lock order]');
select ok((select position('order by candidate.entry_id, candidate.path collate "C"' in src) > 0 from s12ls_lock_src),
  'the candidate instances are taken in ascending entry id order (then bytewise path), the order the entry locks are taken in');
select ok((select position('and platform_private.cms_revision_effective_state(head.revision_id) = ''draft''' in src) > 0
                  and position('if platform_private.cms_revision_effective_state(v_revision.id) is distinct from ''draft''' in src) > 0 from s12ls_lock_src),
  'a revision is draft exactly when the one derived EntryRevisionState function (BE03b E2) says draft, in the candidate query and again under the entry lock (a predicate on any other state fails here)');
select ok((select position('v_new := platform_private.cms_pattern_update_next_row(' in src) > 0 and position('v_new.pending_pattern_version' in src) = 0
                  and position('v_new.state' in src) = 0 and position('v_new := v_head' in src) = 0 from s12ls_lock_src),
  'the scan appends through the shared helper cms_pattern_update_next_row and holds no second copy of the head copy (review V6-01)');

-- ------------------------------------------------------------------------------------------------------------------- the request --
-- Exactly { patternId, patternVersionId, cursor } plus the optional batch (1..500) and correlationId; nothing in a refusal changes a store.
select * from pg_temp.s12ls_refused('r-null', null, 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-array', '[]'::jsonb, 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-unknown-key', pg_temp.s12ls_req('la2') || '{"ownerId":"forged"}'::jsonb, 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-missing-cursor', pg_temp.s12ls_req('la2') - 'cursor', 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-missing-pattern', pg_temp.s12ls_req('la2') - 'patternId', 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-pattern-not-uuid', pg_temp.s12ls_req('la2') || '{"patternId":"not-a-uuid"}'::jsonb, 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-version-number', pg_temp.s12ls_req('la2') || '{"patternVersionId":7}'::jsonb, 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-cursor-garbage', pg_temp.s12ls_req('la2', 'garbage'), 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-cursor-uuid-only', pg_temp.s12ls_req('la2', 'a9120000-0000-4000-8000-00000000c0c0'), 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-cursor-odd-hex', pg_temp.s12ls_req('la2', 'a9120000-0000-4000-8000-00000000c0c0.2f6'), 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-cursor-upper-hex', pg_temp.s12ls_req('la2', 'a9120000-0000-4000-8000-00000000c0c0.2F68'), 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-cursor-not-a-path', pg_temp.s12ls_req('la2', 'a9120000-0000-4000-8000-00000000c0c0.6865726f'), 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-batch-zero', pg_temp.s12ls_req('la2') || '{"batch":0}'::jsonb, 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-batch-501', pg_temp.s12ls_req('la2') || '{"batch":501}'::jsonb, 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-batch-text', pg_temp.s12ls_req('la2') || '{"batch":"5"}'::jsonb, 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-batch-fraction', pg_temp.s12ls_req('la2') || '{"batch":1.5}'::jsonb, 'INVALID_REQUEST');
select * from pg_temp.s12ls_refused('r-correlation', pg_temp.s12ls_req('la2') || '{"correlationId":"x"}'::jsonb, 'INVALID_REQUEST');
-- the pair must name one real version of that lineage: an unknown version and a version of another lineage are NOT_FOUND
select * from pg_temp.s12ls_refused('r-unknown-version', pg_temp.s12ls_req('la2') || '{"patternVersionId":"a9120000-0000-4000-8000-0000000000ff"}'::jsonb, 'NOT_FOUND');
select * from pg_temp.s12ls_refused('r-other-lineage', pg_temp.s12ls_req('la2') || jsonb_build_object('patternId', pg_temp.s12pd_body('lb1')->'patternId'), 'NOT_FOUND');
-- only the service role runs the job: the other database roles are refused at the privilege check and nothing changes
select pg_temp.s12ls_call('role-anon', 'platform_api.cms_scan_linked_pattern_updates', pg_temp.s12ls_req('la2'), 'anon');
select is(pg_temp.s12ls_state('role-anon'), '42501', 'anon is refused at the privilege check (42501)');
select ok(pg_temp.s12ls_unchanged('role-anon'), 'the anon refusal changes nothing');
select pg_temp.s12ls_call('role-authenticated', 'platform_api.cms_scan_linked_pattern_updates', pg_temp.s12ls_req('la2'), 'authenticated');
select is(pg_temp.s12ls_state('role-authenticated'), '42501', 'authenticated is refused at the privilege check (42501)');
select ok(pg_temp.s12ls_unchanged('role-authenticated'), 'the authenticated refusal changes nothing');
select pg_temp.s12ls_call('role-private', 'platform_private.cms_scan_linked_pattern_updates', pg_temp.s12ls_req('la2'), 'service_role');
select is(pg_temp.s12ls_state('role-private'), '42501', 'service_role cannot call the private function: only the wrapper is its entry point');
