-- Slice 12 lane linked-scan: helpers of the linked-update scan suite (P2-S12-AC-212, AC-213).
-- Include after phase_02_slice_09_dec108/00-helpers, 01-actors, 02-chain, phase_02_slice_09_p240/01-block,
-- phase_02_slice_12_pattern_definition/000-fixtures, 010-oracles, phase_02_slice_12_pattern_placement/000-fixtures, 010-oracles and
-- phase_02_slice_12_pattern_updates_common/000-helpers (s12pu_place and its fixtures).
-- The scan is a system-initiated job (BE03c "Job transport"): it has no human actor, so no actor or acting party is set.

create temp table s12ls_out(label text primary key, request jsonb, response jsonb, state text, message text, detail text,
  before_rows jsonb, after_rows jsonb, rpc_before text, rpc_after text, call_role text, role_restored boolean) on commit drop;

-- One call as the named database role with the RPC context CLEARED first (PAT-031): every fixture of this suite runs under
-- `app.cms_rpc = 'true'` for the rest of the transaction, which would hide an entry point that depends on the caller holding the flag.
-- The runner empties the flag and every actor setting, records the flag it called with and the flag it left behind, and captures the
-- SQLSTATE, message and DETAIL of a refusal.  p_snapshot false skips the full-row before/after image (the 500-row runs).
create or replace function pg_temp.s12ls_call(
  p_label text, p_function text, p_request jsonb, p_role text default 'service_role', p_snapshot boolean default true)
returns void
language plpgsql as $body$
declare before_rows jsonb; after_rows jsonb; answer jsonb; code text := '00000'; msg text; details text; call_sql text;
  prior_role text := current_setting('role'); prior_user text := current_user; invoked_as text; restored boolean;
  rpc_before text; rpc_after text; setting text;
begin
  if p_function not in ('platform_api.cms_scan_linked_pattern_updates', 'platform_api.cms_linked_scan_resolve_event',
                        'platform_private.cms_scan_linked_pattern_updates') then
    raise exception 'unknown linked-scan function %', p_function;
  end if;
  if p_role not in ('service_role', 'anon', 'authenticated') then raise exception 'unknown database role %', p_role; end if;
  call_sql := case when p_function = 'platform_api.cms_linked_scan_resolve_event'
    then format('select %s(($1 #>> ''{}'')::uuid)', p_function) else format('select %s($1)', p_function) end;
  perform set_config('app.cms_rpc', '', true);
  foreach setting in array array['app.auth_user_id', 'app.actor_auth_user_id', 'app.actor_person_id', 'app.acting_party_id',
                                 'app.acting_context_id', 'request.jwt.claims', 'response.headers'] loop
    perform set_config(setting, '', true);
  end loop;
  rpc_before := coalesce(current_setting('app.cms_rpc', true), '');
  before_rows := case when p_snapshot then pg_temp.s12pl_snapshot() end;
  begin
    perform set_config('role', p_role, true);
    invoked_as := current_user;
    if invoked_as is distinct from p_role then raise exception 'linked-scan test effective role mismatch'; end if;
    begin
      execute call_sql into answer using p_request;
    exception when others then
      get stacked diagnostics code = returned_sqlstate, msg = message_text, details = pg_exception_detail;
      answer := null;
    end;
    rpc_after := coalesce(current_setting('app.cms_rpc', true), '');
    perform set_config('role', prior_role, true);
  exception when others then
    perform set_config('role', prior_role, true);
    raise;
  end;
  restored := current_user::text = prior_user and current_setting('role') = prior_role;
  if restored is not true then raise exception 'linked-scan test role restoration failed'; end if;
  after_rows := case when p_snapshot then pg_temp.s12pl_snapshot() end;
  insert into s12ls_out values (p_label, p_request, answer, code, msg, details, before_rows, after_rows, rpc_before, rpc_after,
    invoked_as, restored)
  on conflict (label) do update set request = excluded.request, response = excluded.response, state = excluded.state,
    message = excluded.message, detail = excluded.detail, before_rows = excluded.before_rows, after_rows = excluded.after_rows,
    rpc_before = excluded.rpc_before, rpc_after = excluded.rpc_after, call_role = excluded.call_role;
end;
$body$;
create or replace function pg_temp.s12ls_state(p_label text) returns text language sql stable as $body$
  select coalesce((select state from s12ls_out where label = p_label), 'UNRUN') $body$;
create or replace function pg_temp.s12ls_body(p_label text) returns jsonb language sql stable as $body$
  select response from s12ls_out where label = p_label $body$;
create or replace function pg_temp.s12ls_unchanged(p_label text) returns boolean language sql stable as $body$
  select coalesce((select before_rows = after_rows from s12ls_out where label = p_label), false) $body$;
-- one run's answer as a short text: examined/appended/has-cursor
create or replace function pg_temp.s12ls_sum(p_label text) returns text language sql stable as $body$
  select case when state = '00000' then (response->>'examined') || '/' || (response->>'appended') || '/'
                                       || case when response->'nextCursor' = 'null'::jsonb then 'end' else 'more' end
         else state || ':' || coalesce(message, '') end
    from s12ls_out where label = p_label $body$;

-- A refusal: SQLSTATE P0001, the exact message token, the exact DETAIL when given, and NO effect on any captured store.
create or replace function pg_temp.s12ls_refused(
  p_label text, p_request jsonb, p_token text, p_function text default 'platform_api.cms_scan_linked_pattern_updates')
returns setof text
language plpgsql as $body$
begin
  perform pg_temp.s12ls_call(p_label, p_function, p_request);
  return next extensions.is(pg_temp.s12ls_state(p_label), 'P0001', p_label || ': SQLSTATE is the application refusal');
  return next extensions.is((select message from s12ls_out where label = p_label), p_token, p_label || ': exact SQL message token ' || p_token);
  return next extensions.ok(pg_temp.s12ls_unchanged(p_label), p_label || ': the refusal preserves every captured full row of every store');
end;
$body$;

-- The scan request of a created pattern version (label of s12pl_pattern): the job payload plus the continuation cursor.
create or replace function pg_temp.s12ls_req(p_label text, p_cursor text default null) returns jsonb language sql stable as $body$
  select jsonb_build_object('patternId', pg_temp.s12pd_body(p_label)->'patternId', 'patternVersionId', pg_temp.s12pd_body(p_label)->'id',
    'cursor', coalesce(to_jsonb(p_cursor), 'null'::jsonb)) $body$;

-- The head (newest version) row of every path of a tag's revision, as one text: path=state:vN:pPIN:qPENDING, oldest path first.
create or replace function pg_temp.s12ls_heads(p_tag text) returns text language sql stable as $body$
  select coalesce(string_agg(h.path || '=' || h.state || ':v' || h.version || ':p' || coalesce(h.pattern_version::text, '-')
    || ':q' || coalesce(h.pending_pattern_version::text, '-'), ' ' order by h.path collate "C"), '')
    from (select distinct on (path) path, state, version, pattern_version, pending_pattern_version
            from platform_private.cms_composition_instances where revision_id = pg_temp.s12pl_rev(p_tag)
           order by path, version desc) h $body$;
-- the same for the head `position`s, so a scan that moved a row is visible
create or replace function pg_temp.s12ls_positions(p_tag text) returns text language sql stable as $body$
  select coalesce(string_agg(h.path || '@' || h.position, ' ' order by h.path collate "C"), '')
    from (select distinct on (path) path, position from platform_private.cms_composition_instances
           where revision_id = pg_temp.s12pl_rev(p_tag) order by path, version desc) h $body$;

-- The composition rows that existed before a run, in full: the oracle of what a run may append and of what it may never touch.
create temp table s12ls_pre(id uuid primary key, row jsonb not null) on commit drop;
create or replace function pg_temp.s12ls_mark() returns void language plpgsql as $body$
begin
  truncate s12ls_pre;
  insert into s12ls_pre select i.id, to_jsonb(i) from platform_private.cms_composition_instances i;
end;
$body$;
-- the rows appended since the mark
create or replace function pg_temp.s12ls_appended() returns bigint language sql stable as $body$
  select count(*) from platform_private.cms_composition_instances i where i.id not in (select id from s12ls_pre) $body$;
-- every marked row is still present with identical content (append-only)
create or replace function pg_temp.s12ls_history_intact() returns boolean language sql stable as $body$
  select (select count(*) from s12ls_pre) = (select count(*) from s12ls_pre p join platform_private.cms_composition_instances i
    on i.id = p.id where to_jsonb(i) = p.row) $body$;
-- How many appended rows follow the contract of the linked-update scan exactly: the copy of the head row they follow (the row of the same
-- revision and path one version lower, taken from the mark) at the next version, state pending_diff, pinned to the UNCHANGED pattern
-- version, carrying pending_pattern_version p_target, with the position, slot, block, props, bindings, digest, parent and author of that
-- head unchanged and created_at = updated_at.  A copy is compared member by member against the marked head, never against itself.
create or replace function pg_temp.s12ls_conforming(p_target integer) returns bigint language sql stable as $body$
  select count(*) from platform_private.cms_composition_instances n
    join s12ls_pre p on p.row->>'revision_id' = n.revision_id::text and p.row->>'path' = n.path
                    and (p.row->>'version')::bigint = n.version - 1
   where n.id not in (select id from s12ls_pre)
     and n.state = 'pending_diff' and n.pending_pattern_version = p_target
     and p.row->>'state' in ('active', 'pending_diff')
     and n.created_at = n.updated_at
     and (to_jsonb(n) - array['id', 'state', 'version', 'pending_pattern_version', 'created_at', 'updated_at'])
       = (p.row - array['id', 'state', 'version', 'pending_pattern_version', 'created_at', 'updated_at']) $body$;

-- A linked head in a state no CMS-03C producer writes for a linked instance (retired, draft, superseded): a guarded direct insert under
-- app.cms_rpc that copies the head row at the next version in the named state (the labelled fixture of the pattern-updates suite).
create or replace function pg_temp.s12ls_staterow(p_tag text, p_path text, p_state text) returns uuid
language plpgsql as $body$
declare head_row platform_private.cms_composition_instances; row_id uuid := extensions.gen_random_uuid(); stamp timestamptz := clock_timestamp();
begin
  perform set_config('app.cms_rpc', 'true', true);
  select * into head_row from platform_private.cms_composition_instances
   where revision_id = pg_temp.s12pl_rev(p_tag) and path = p_path order by version desc limit 1;
  insert into platform_private.cms_composition_instances
  select (jsonb_populate_record(null::platform_private.cms_composition_instances, to_jsonb(head_row)
    || jsonb_build_object('id', row_id, 'state', p_state, 'version', head_row.version + 1, 'created_at', stamp, 'updated_at', stamp))).*;
  return row_id;
end;
$body$;

-- A newer revision of the same entry that becomes the entry's current draft pointer (the labelled fixture of the placement suite's
-- editability cases): the rows of the earlier revision are then history of a revision that is no longer the entry's current draft.
create or replace function pg_temp.s12ls_extra_revision(p_tag text, p_new_tag text, p_number bigint, p_state text)
returns uuid language plpgsql as $body$
declare revision_uuid uuid := extensions.gen_random_uuid(); org uuid := pg_temp.s09d_id('ownerOrg');
  stamp timestamptz := timestamptz '2026-10-08T12:00:00Z';
begin
  perform set_config('app.cms_rpc', 'true', true);
  insert into platform_private.cms_entry_revisions(
    id, owner_id, entry_id, revision_number, schema_version_id, template_version_id, taxonomy_version_ids,
    parent_revision_ids, locale, payload_hash, author_person_id, acting_party_id, state, version,
    validation_state, validation_report, created_at, updated_at)
  select revision_uuid, org, base.entry_id, p_number, base.schema_version_id, base.template_version_id, '[]'::jsonb,
    jsonb_build_array(base.id), 'en-US', encode(extensions.digest(convert_to('s12ls:' || p_new_tag, 'utf8'), 'sha256'), 'hex'),
    base.author_person_id, org, p_state, 1, 'valid', '{}'::jsonb, stamp, stamp
  from platform_private.cms_entry_revisions base where base.id = pg_temp.s12pl_rev(p_tag);
  update platform_private.cms_content_entries set current_draft_revision_id = revision_uuid
   where id = pg_temp.s12pl_entry_id(p_tag);
  insert into s12pl_ids(key, value) values (p_new_tag || ':revision', revision_uuid::text),
    (p_new_tag || ':entry', pg_temp.s12pl_entry_id(p_tag)::text);
  return revision_uuid;
end;
$body$;
