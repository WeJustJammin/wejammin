select * from pg_temp.s12pl_refused('root-path-with-root-slot', pg_temp.s12pl_request('tr', 'pa', '/', '{}'::jsonb, 's12pl-tr-0001'),
  'VALIDATION_FAILED', '["/slotPath"]'::jsonb);
select * from pg_temp.s12pl_refused('main-not-in-root-template', pg_temp.s12pl_request('tr', 'pa', '/main', '{}'::jsonb, 's12pl-tr-0002'),
  'VALIDATION_FAILED', '["/slotPath"]'::jsonb);
