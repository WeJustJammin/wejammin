  where revision_id = pg_temp.s12pl_rev('tr')), array['/root/hero', '/root/cta'],
  'the templated entry holds only the rows its named slot root produced: the path / never shares that slot [F6]');

-- ------------------------------------------------------ path uniqueness and all-or-nothing --------------------
select pg_temp.s12pl_tentry('cl');
select pg_temp.s12pl_run('cl-first', pg_temp.s12pl_request('cl', 'pa', '/main', '{}'::jsonb, 's12pl-cl1-0001'));
select is(pg_temp.s12pl_state('cl-first'), '00000', 'control: the first placement into main succeeds');
select * from pg_temp.s12pl_refused('cl-second', pg_temp.s12pl_request('cl', 'pa', '/main', '{}'::jsonb, 's12pl-cl2-0001'), 'CONFLICT');
select pg_temp.s12pl_tentry('at');
select pg_temp.s12pl_row('at', '/main/tail', 'main', 3);
select * from pg_temp.s12pl_refused('collide-on-last-root', pg_temp.s12pl_request('at', 'pn', '/main', '{}'::jsonb, 's12pl-at-0001'), 'CONFLICT');
select is((select count(*)::integer from platform_private.cms_composition_instances where revision_id = pg_temp.s12pl_rev('at')), 1,
  'the placement whose LAST root collides wrote none of its five rows: all-or-nothing [P2-S12-AC-218]');
