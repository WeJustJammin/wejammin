-- Typed refusals of CMS-03C-02 (BE03c 375-378 validation, 1289 catalog, 1304 typed refusals, 1355 pinned
-- definitions).  Every refusal is asserted by exact SQLSTATE and message token, the exact DETAIL where the
-- transport reads it, and by NO effect on any store (full before/after images equal).  Each group uses its own
-- entry so a refusal is never explained by an earlier placement.

-- A container nest of n levels around a leaf (JSON depth counts containers only).
create or replace function pg_temp.s12pl_nest(p_levels integer) returns jsonb language plpgsql immutable as $body$
declare value jsonb := '1'::jsonb; n integer;
begin
  for n in 1..p_levels loop value := jsonb_build_object('k', value); end loop;
  return value;
end;
$body$;
-- A newer (or differently stated) revision of the same entry that becomes the entry's current draft pointer.
create or replace function pg_temp.s12pl_extra_revision(p_tag text, p_new_tag text, p_number bigint, p_state text)
returns uuid language plpgsql as $body$
declare revision_uuid uuid := extensions.gen_random_uuid(); org uuid := pg_temp.s09d_id('ownerOrg');
  stamp timestamptz := timestamptz '2026-10-08T12:00:00Z';
begin
  perform set_config('app.cms_rpc', 'true', true);
  insert into platform_private.cms_entry_revisions(
    id, owner_id, entry_id, revision_number, schema_version_id, template_version_id, taxonomy_version_ids,
    parent_revision_ids, locale, payload_hash, author_person_id, acting_party_id, state, version,
    validation_state, validation_report, created_at, updated_at)
  select revision_uuid, org, base.entry_id, p_number, base.schema_version_id, base.template_version_id, '[]'::jsonb,
    jsonb_build_array(base.id), 'en-US', encode(extensions.digest(convert_to('s12pl:' || p_new_tag, 'utf8'), 'sha256'), 'hex'),
    base.author_person_id, org, p_state, 1, 'valid', '{}'::jsonb, stamp, stamp
  from platform_private.cms_entry_revisions base where base.id = pg_temp.s12pl_rev(p_tag);
  update platform_private.cms_content_entries set current_draft_revision_id = revision_uuid
   where id = pg_temp.s12pl_entry_id(p_tag);
  insert into s12pl_ids(key, value) values (p_new_tag || ':revision', revision_uuid::text),
    (p_new_tag || ':entry', pg_temp.s12pl_entry_id(p_tag)::text);
  return revision_uuid;
end;
$body$;

