-- ----------------------------------------------------------- row path bound: 248 octets (DEC-186) -------------
-- A template slot is flat and exact (BE03c 1511: the slotPath must exist in the revision's template; slot key grammar
-- `^[a-z][a-z0-9_-]{1,63}$`, template.ts:25; DEC-193 slot binding), so the slot path `/main` is 5 octets and a row path
-- reaches the 248-octet bound only through the key chain of nested pattern references (DEC-181, DEC-186):
-- `/main` + `/k1` + `/k2` + `/k3` + `/k4`, three 60-character reference keys and a leaf root key.
-- 5 + 3 * (1 + 60) + (1 + 59) = 248 octets accepted; a 60-character leaf key makes 249 octets, refused at /slotPath.
-- The key grammar is ASCII, so no row path can hold a multi-byte character and octets equal characters: the two former
-- multi-byte controls (a nested `/main/ééé...` slotPath) were slot paths that no longer exist and are replaced by the
-- exact-slot refusal below.
create or replace function pg_temp.s12pl_chain(p_label text, p_keys text[]) returns setof text language plpgsql as $body$
declare n integer := cardinality(p_keys); i integer;
begin
  return query select * from pg_temp.s12pl_pattern(p_label || '-' || n, 's12pl-' || p_label || '-' || n,
    jsonb_build_array(pg_temp.s12pd_block(p_keys[n])));
  for i in reverse n - 1 .. 1 loop
    return query select * from pg_temp.s12pl_pattern(p_label || '-' || i, 's12pl-' || p_label || '-' || i,
      jsonb_build_array(jsonb_build_object('kind', 'pattern', 'key', p_keys[i],
        'patternId', pg_temp.s12pd_body(p_label || '-' || (i + 1))->'patternId',
        'patternVersion', pg_temp.s12pd_body(p_label || '-' || (i + 1))->'patternVersion')));
  end loop;
end;
$body$;
select * from pg_temp.s12pl_chain('ch248', array['a' || repeat('x', 59), 'b' || repeat('x', 59), 'c' || repeat('x', 59),
  'd' || repeat('x', 58)]);
select * from pg_temp.s12pl_chain('ch249', array['a' || repeat('x', 59), 'b' || repeat('x', 59), 'c' || repeat('x', 59),
  'd' || repeat('x', 59)]);
select pg_temp.s12pl_tentry('len1');
select pg_temp.s12pl_run('path-248', pg_temp.s12pl_request('len1', 'ch248-1', '/main', '{}'::jsonb, 's12pl-l248-0001'));
select * from pg_temp.s12pl_check('path-248', 'len1', 'ch248-1', array['/main/a' || repeat('x', 59) || '/b' || repeat('x', 59)
  || '/c' || repeat('x', 59) || '/d' || repeat('x', 58)], 0);
select is((select max(octet_length(path)) from platform_private.cms_composition_instances
  where revision_id = pg_temp.s12pl_rev('len1')), 248, 'the longest accepted row path is exactly 248 octets [DEC-186]');
select pg_temp.s12pl_tentry('len2');
select * from pg_temp.s12pl_refused('path-249', pg_temp.s12pl_request('len2', 'ch249-1', '/main', '{}'::jsonb,
  's12pl-l249-0001'), 'VALIDATION_FAILED', '["/slotPath"]'::jsonb);
select is((select count(*)::integer from platform_private.cms_composition_instances
  where revision_id = pg_temp.s12pl_rev('len2')), 0, 'the 249-octet placement wrote nothing [DEC-186]');
select pg_temp.s12pl_tentry('len3');
select * from pg_temp.s12pl_refused('multibyte-nested-slot', pg_temp.s12pl_request('len3', 'pa', '/main/' || repeat('é', 119),
  '{}'::jsonb, 's12pl-l249b-0001'), 'VALIDATION_FAILED', '["/slotPath"]'::jsonb);
-- R1-009: octets, not characters (DEC-186). No producer can place a multi-byte slot (slot and node keys are ASCII), so the
-- bound is pinned on the private plan helper directly, as the test owner, with no insert and no trigger change.
-- '/main/' (6) + 119 two-octet characters (238) + the selected root '/cta' (4) = exactly 248 octets: accepted.
-- 120 characters make 250 octets and are refused at /slotPath; a char_length regression would count 130 and accept them.
select is((select jsonb_array_length(platform_private.cms_pattern_placement_selected_plan(
    pg_temp.s09d_id('ownerOrg'), v, '/main/' || repeat('é', 119), '{}'::jsonb, '["/cta"]'::jsonb))
  from platform_private.cms_pattern_versions v
  where v.pattern_id = (pg_temp.s12pd_body('pa')->>'patternId')::uuid
    and v.version = (pg_temp.s12pd_body('pa')->>'patternVersion')::integer),
  1, 'R1-009: a 248-octet row path built from 119 two-octet characters is accepted by the plan helper');
select is((select octet_length('/main/' || repeat('é', 119) || '/cta')), 248, 'R1-009 premise: that path is exactly 248 octets');
select throws_ok(format($sql$
    select platform_private.cms_pattern_placement_selected_plan(%L::uuid, v, %L, '{}'::jsonb, '["/cta"]'::jsonb)
      from platform_private.cms_pattern_versions v
     where v.pattern_id = %L::uuid and v.version = %s$sql$,
    pg_temp.s09d_id('ownerOrg'), '/main/' || repeat('é', 120),
    pg_temp.s12pd_body('pa')->>'patternId', pg_temp.s12pd_body('pa')->>'patternVersion'),
  'P0001', 'VALIDATION_FAILED', 'R1-009: 120 two-octet characters make 250 octets and are refused (octet_length, not char_length)');

-- ------------------------------------------------------------------ slotPath against the entry's template ----
-- BE03c 1365 / P2-S12-AC-218 (root ruling, strict reading): the slotPath must exist in the revision's template, or be
-- a root path when the entry has no template.  An entry with NO template accepts only `/`; an entry WITH a template
-- must name one of the template's slots and `/` is refused there, even when a template slot is literally named root.
select pg_temp.s12pl_tentry('tp');
select * from pg_temp.s12pl_refused('slot-not-in-template', pg_temp.s12pl_request('tp', 'pa', '/nope', '{}'::jsonb, 's12pl-tp1-0001'),
