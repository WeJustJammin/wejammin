-- Pinned definitions (BE03c lock order rule 2, 1355): a version that is no longer active is the typed refusal
-- pattern_version_not_active; a nested pinned version that is no longer active is nested_pattern_not_active.
-- Runs last: the successors supersede pa and pc for every later reader.
select * from pg_temp.s12pl_pattern('pa2', 's12pl-pa', jsonb_build_array(pg_temp.s12pd_block('hero'),
  pg_temp.s12pd_block('cta'), pg_temp.s12pd_block('footer')), null, true, '1');
select is(pg_temp.s12pd_row('pa')->>'state', 'superseded', 'setup: activating version 2 supersedes version 1 of the lineage');
select pg_temp.s12pl_tentry('sup');
select * from pg_temp.s12pl_refused('superseded-version', pg_temp.s12pl_request('sup', 'pa', '/main', '{}'::jsonb,
  's12pl-sup1-0001'), 'pattern_version_not_active', '["/patternVersion"]'::jsonb);
select pg_temp.s12pl_run('sup-v2', pg_temp.s12pl_request('sup', 'pa2', '/main', '{}'::jsonb, 's12pl-sup2-0001'));
select * from pg_temp.s12pl_check('sup-v2', 'sup', 'pa2', array['/main/hero', '/main/cta', '/main/footer'], 0);
select is((select jsonb_agg(item->'patternVersion') from jsonb_array_elements(pg_temp.s12pl_body('sup-v2')->'items') item),
  '[2,2,2]'::jsonb, 'every row is pinned to the placed definition version 2');
select * from pg_temp.s12pl_pattern('pc2', 's12pl-pc', jsonb_build_array(pg_temp.s12pd_block('a'),
  pg_temp.s12pd_block('b')), null, true, '1');
select pg_temp.s12pl_tentry('sup2');
select * from pg_temp.s12pl_refused('nested-superseded', pg_temp.s12pl_request('sup2', 'pn', '/main', '{}'::jsonb,
  's12pl-sup3-0001'), 'nested_pattern_not_active', '["/patternId"]'::jsonb);
