-- Actual instance CAS is separate from entry CAS and topology; all other inputs
-- use the valid all-theirs answer. The expected old row is not addressed again.
select * from pg_temp.s12pu_refused('rs-api-instance-cas','platform_api.cms_apply_pattern_update',
  pg_temp.s12pu_update_request('rs-stale','accept',jsonb_build_array(
    pg_temp.s12pu_target('rs-stale','/panel','[{"path":"/panel","choice":"theirs"}]')||'{"expectedVersion":"7"}'::jsonb),
    's12rs-instance-cas-0001',2),'VERSION_MISMATCH',jsonb_build_object('expectedVersion','7',
      'currentVersion','1','instanceId',pg_temp.s12pu_head('rs-stale','/panel')));
select * from pg_temp.s12pu_refused('rs-api-prior-instance','platform_api.cms_apply_pattern_update',
  pg_temp.s12pu_update_request('rs-theirs','accept',jsonb_build_array(jsonb_build_object(
    'instanceId',(select row_value->>'id' from s12rs_initial where tag='rs-theirs' and row_value->>'path'='/panel'),
    'expectedVersion','1','choices','[]'::jsonb)),'s12rs-prior-instance-0001',2),
  -- R1-007 (2026-10-22): BE03c 410 and 1416 (DEC-193) answer a named row that is not the newest version of its path
  -- as 422 COMPOSITION_VALIDATION_FAILED at /instances/{n}/instanceId; 409 is only the stale expectedVersion of the head row
  -- (rs-api-instance-cas above keeps 409).
  'VALIDATION_FAILED','["/instances/0/instanceId"]'::jsonb);

-- Retired/detached origin pins are readable provenance, not fabricated no-update
-- pins or permission to reopen the selected tree through its newer pattern.
select pg_temp.s12pu_diff_head('rs-api-retired-diff','rs-rm-t','/gone');
select pg_temp.s12pu_diff_head('rs-api-detached-diff','rs-yours','/panel');
select check_line.* from (values ('rs-api-retired-diff'),('rs-api-detached-diff')) probes(label)
cross join lateral (select extensions.is(pg_temp.s12pu_oc(label),'ok',label||': readable pattern-origin row diffs successfully') as tap
  union all select extensions.is(jsonb_build_object(
    'pin',pg_temp.s12pu_body(label)#>'{instance,pinnedPatternVersion}',
    'target',pg_temp.s12pu_body(label)->'targetPatternVersion','slot',pg_temp.s12pu_body(label)->'slotPath',
    'paths',pg_temp.s12pu_body(label)->'paths','newRoots',pg_temp.s12pu_body(label)->'newRoots',
    'collisions',pg_temp.s12pu_body(label)->'collisionCount','bulk',pg_temp.s12pu_body(label)->'bulkEligible'),
    '{"pin":1,"target":1,"slot":"/","paths":[],"newRoots":[],"collisions":0,"bulk":false}'::jsonb,
    label||': prior positive pin and exact no-update fields, never a target retirement pin')
  union all select extensions.ok(pg_temp.s12pu_unchanged(label),label||': read changes no store')) check_line;
