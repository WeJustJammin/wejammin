-- Complete answers can select an impossible graph. Reject atomically at the
-- existing /instances/0/choices pointer, never drop a descendant answer or silently
-- resurrect a node. The two all-consistent controls discriminate ordinary guards.
select check_line.* from s12rs_trees f cross join lateral pg_temp.s12rs_pure(
  'RESOLVE-25 parent excludes explicit present child',b,t,o,
  '[{"path":"/fork","choice":"theirs"},{"path":"/fork/child","choice":"yours"},{"path":"/fork/add","choice":"theirs"}]',
  null,'P0001:VALIDATION_FAILED') check_line where name='presence';
select check_line.* from s12rs_trees f cross join lateral pg_temp.s12rs_pure(
  'RESOLVE-26 parent requires explicit absent child',b,t,o,
  '[{"path":"/fork/add","choice":"yours"},{"path":"/fork/child","choice":"theirs"},{"path":"/fork","choice":"yours"}]',
  null,'P0001:VALIDATION_FAILED') check_line where name='presence';
select check_line.* from s12rs_trees f cross join lateral pg_temp.s12rs_pure(
  'RESOLVE-27 exact coverage refuses an unanswered props collision',b,t,o,
  '[{"path":"/panel","choice":"theirs"}]',null,'P0001:VALIDATION_FAILED') check_line where name='main';
select check_line.* from s12rs_trees f cross join lateral pg_temp.s12rs_pure(
  'RESOLVE-28 exact coverage refuses a noncolliding answer',b,t,o,
  '[{"path":"/panel","choice":"theirs"},{"path":"/panel/leaf","choice":"theirs"},{"path":"/panel/auto","choice":"yours"}]',
  null,'P0001:VALIDATION_FAILED') check_line where name='main';
select check_line.* from s12rs_trees f cross join lateral pg_temp.s12rs_pure(
  'RESOLVE-29 a suppressed descendant is not another answerable collision',b,t,o,
  '[{"path":"/fork","choice":"yours"},{"path":"/fork/child","choice":"yours"},{"path":"/fork/add","choice":"yours"},
    {"path":"/fork/child/deep","choice":"yours"}]',null,'P0001:VALIDATION_FAILED') check_line where name='presence';
select check_line.* from s12rs_trees f cross join lateral pg_temp.s12rs_pure(
  'RESOLVE-30 duplicate selectors are not sequential last-answer-wins patches',b,t,o,
  '[{"path":"/panel","choice":"yours"},{"path":"/panel","choice":"theirs"},{"path":"/panel/leaf","choice":"theirs"}]',
  null,'P0001:VALIDATION_FAILED') check_line where name='main';
select * from pg_temp.s12pu_refused('rs-api-inconsistent-one','platform_api.cms_apply_pattern_update',
  pg_temp.s12pu_update_request('rs-pc-one','accept',jsonb_build_array(pg_temp.s12pu_target('rs-pc-one','/fork',
    '[{"path":"/fork","choice":"theirs"},{"path":"/fork/child","choice":"yours"},{"path":"/fork/add","choice":"theirs"}]')),
    's12rs-inconsistent-one-0001',2),'VALIDATION_FAILED','["/instances/0/choices"]');
select * from pg_temp.s12pu_refused('rs-api-inconsistent-two','platform_api.cms_apply_pattern_update',
  pg_temp.s12pu_update_request('rs-pc-two','accept',jsonb_build_array(pg_temp.s12pu_target('rs-pc-two','/fork',
    '[{"path":"/fork/add","choice":"yours"},{"path":"/fork/child","choice":"theirs"},{"path":"/fork","choice":"yours"}]')),
    's12rs-inconsistent-two-0001',2),'VALIDATION_FAILED','["/instances/0/choices"]');
select pg_temp.s12pu_update('rs-api-pc-y',pg_temp.s12pu_update_request('rs-pc-y','accept',jsonb_build_array(
  pg_temp.s12pu_target('rs-pc-y','/fork','[{"path":"/fork","choice":"yours"},{"path":"/fork/child","choice":"yours"},{"path":"/fork/add","choice":"yours"}]')),
  's12rs-pc-y-0001',2));
select check_line.* from s12rs_trees f cross join lateral pg_temp.s12rs_check('rs-api-pc-y','rs-pc-y','/fork',
  'active','detached',1,'{}',local_tree) check_line where name='presence';
select pg_temp.s12pu_update('rs-api-pc-t',pg_temp.s12pu_update_request('rs-pc-t','accept',jsonb_build_array(
  pg_temp.s12pu_target('rs-pc-t','/fork','[{"path":"/fork/add","choice":"theirs"},{"path":"/fork/child","choice":"theirs"},{"path":"/fork","choice":"theirs"}]')),
  's12rs-pc-t-0001',2));
select * from pg_temp.s12rs_check('rs-api-pc-t','rs-pc-t','/fork','active','linked',2,'{}','null');

