-- BE03c 1487/1563: canonical snapshots, exact local values and real producers.
-- These literal expected trees do not consume the independent typed-diff lane.
create temp table s12rs_trees(name text primary key, b jsonb, t jsonb, o jsonb,
  local_tree jsonb, yours_tree jsonb, theirs_tree jsonb) on commit drop;
