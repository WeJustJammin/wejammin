-- Isolated statement probe.  Returns the refusal message, or ACCEPTED (the statement is always rolled back).
create or replace function pg_temp.s09t_probe_stmt(p_table text, p_trigger text, p_rpc boolean, p_stmt text) returns text
language plpgsql as $body$
declare
  rel regclass := format('platform_private.%I', p_table)::regclass;
  other record;
  outcome text;
  previous text := coalesce(pg_catalog.current_setting('app.cms_rpc', true), '');
begin
  for other in select tgname from pg_trigger where tgrelid = rel and not tgisinternal and tgname <> p_trigger loop
    execute format('alter table %s disable trigger %I', rel, other.tgname);
  end loop;
  perform pg_catalog.set_config('app.cms_rpc', case when p_rpc then 'true' else '' end, true);
  begin
    execute p_stmt;
    raise exception 'S09T_ACCEPTED';
  exception when others then
    outcome := case when sqlerrm = 'S09T_ACCEPTED' then 'ACCEPTED' else sqlerrm end;
  end;
  perform pg_catalog.set_config('app.cms_rpc', previous, true);
  for other in select tgname from pg_trigger where tgrelid = rel and not tgisinternal and tgname <> p_trigger loop
    execute format('alter table %s enable trigger %I', rel, other.tgname);
  end loop;
  return outcome;
end;
$body$;
create or replace function pg_temp.s09t_probe(p_table text, p_trigger text, p_rpc boolean, p_event text) returns text
language plpgsql as $body$
declare
  rel regclass := format('platform_private.%I', p_table)::regclass;
  first_column text;
begin
  select a.attname into first_column from pg_attribute a
   where a.attrelid = rel and a.attnum > 0 and not a.attisdropped and a.attgenerated = '' order by a.attnum limit 1;
  return pg_temp.s09t_probe_stmt(p_table, p_trigger, p_rpc, case p_event
    when 'insert' then format('insert into %s select * from %s limit 1', rel, rel)
    when 'update' then format('update %s set %I = %I where ctid = (select ctid from %s limit 1)', rel, first_column, first_column, rel)
    else format('delete from %s where ctid = (select ctid from %s limit 1)', rel, rel) end);
end;
$body$;
create or replace function pg_temp.s09t_rows(p_table text) returns bigint language plpgsql as $body$
declare n bigint;
begin
  execute format('select count(*) from platform_private.%I', p_table) into n;
  return n;
end;
$body$;


-- Pending deferred constraint triggers must fire before a table can be altered for isolation.
create or replace function pg_temp.s09t_run_generic() returns void language plpgsql as $body$
begin
  set constraints all immediate;
  create temp table s09t_generic on commit drop as
  select i.table_name, i.trigger_name, i.function_name, e.event,
         pg_temp.s09t_rows(i.table_name) as row_count,
         case when pg_temp.s09t_rows(i.table_name) = 0 then 'EMPTY'
              else pg_temp.s09t_probe(i.table_name, i.trigger_name, i.function_name = 'cms_immutable_guard', e.event) end as outcome,
         case i.function_name when 'cms_write_guard' then 'DIRECT_CMS_TABLE_WRITE' else 'IMMUTABLE_RECORD' end as expected
    from s09t_inventory i
    join (values ('insert', 4), ('update', 16), ('delete', 8)) e(event, bit) on i.trigger_type & e.bit = e.bit
   where i.function_name in ('cms_write_guard', 'cms_immutable_guard');
end;
$body$;
