    || pg_temp.s10_probe_message('restore_template_incompatible'),
  'P0001:template_incompatible',
  'a source template that is not compatible with the active content type refuses as template_incompatible'
);

-- Request admission: nothing is read before a malformed request is refused.
select pg_temp.s10_rpc_probe(
  'restore_no_idem_key',
  $setup$select pg_temp.s10r_forge(
    jsonb_build_object('a9100000-0000-4000-8000-000000000601', 'Title'))$setup$,
  $sql$select platform_api.cms_restore_revision(pg_temp.s10r_request(null))$sql$
);
select is(
  pg_temp.s10_probe_state('restore_no_idem_key') || ':'
    || pg_temp.s10_probe_message('restore_no_idem_key'),
  'P0001:INVALID_REQUEST',
  'a restore without an Idempotency-Key is refused before any read or write'
);

select pg_temp.s10_rpc_probe(
