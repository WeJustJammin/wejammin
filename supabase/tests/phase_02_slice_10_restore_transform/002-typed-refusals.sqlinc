-- Authority, concealment and lineage.
select pg_temp.s10_rpc_probe(
  'restore_stranger',
  $setup$select pg_temp.s10r_forge(
    jsonb_build_object('a9100000-0000-4000-8000-000000000601', 'Title'));
    select pg_temp.s10_rpc_as(
      (select value::uuid from s10_ids where key = 'strangerAuth'), null)$setup$,
  $sql$select platform_api.cms_restore_revision(pg_temp.s10r_request('s10-restore-stranger-0001'))$sql$
);
select is(
  pg_temp.s10_probe_state('restore_stranger') || ':'
    || pg_temp.s10_probe_message('restore_stranger'),
  'P0001:NOT_FOUND',
  'an actor outside the owning tenant cannot tell the entry exists (NOT_FOUND)'
);

select pg_temp.s10_rpc_probe(
  'restore_member_without_edit',
  $setup$select pg_temp.s10r_forge(
    jsonb_build_object('a9100000-0000-4000-8000-000000000601', 'Title'));
    select pg_temp.s10_rpc_as(
      (select value::uuid from s10_ids where key = 'outsiderAuth'),
      (select value::uuid from s10_ids where key = 'organization'))$setup$,
  $sql$select platform_api.cms_restore_revision(pg_temp.s10r_request('s10-restore-noedit-0001'))$sql$
);
select is(
  pg_temp.s10_probe_state('restore_member_without_edit') || ':'
    || pg_temp.s10_probe_message('restore_member_without_edit'),
  'P0001:FORBIDDEN',
  'a tenant member without edit authority over the entry is refused (FORBIDDEN)'
);

