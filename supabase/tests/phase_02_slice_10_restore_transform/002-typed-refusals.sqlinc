-- CMS-03B-04 restore: typed refusals end to end.
--
-- Every refusal asserts BOTH the SQLSTATE and the exact contract token, and is
-- paired with a positive control (a valid forgery that restores) in the next
-- fragment, so a refusal can never pass because an unrelated gate fired first.
-- Probes run inside rolled-back subtransactions; each forges its own source.

-- Each forged source violates exactly one rule.
select pg_temp.s10_rpc_probe(
  'restore_invalid_rich_text',
  $setup$select pg_temp.s10r_forge(jsonb_build_object(
    'a9100000-0000-4000-8000-000000000601', 'Title',
    'a9100000-0000-4000-8000-000000000602', jsonb_build_object(
      'format', 'rich_text.v1', 'blocks', jsonb_build_array(
        jsonb_build_object('type', 'scripture', 'text', 'not a block kind')))))$setup$,
  $sql$select platform_api.cms_restore_revision(pg_temp.s10r_request('s10-restore-rich-0001'))$sql$
);
select is(
  pg_temp.s10_probe_state('restore_invalid_rich_text') || ':'
    || pg_temp.s10_probe_message('restore_invalid_rich_text'),
  'P0001:migration_chain_incomplete',
  'a source value that violates rich_text.v1 refuses the restore as migration_chain_incomplete'
);

select pg_temp.s10_rpc_probe(
  'restore_invalid_object',
  $setup$select pg_temp.s10r_forge(jsonb_build_object(
    'a9100000-0000-4000-8000-000000000601', 'Title',
    'a9100000-0000-4000-8000-000000000603', jsonb_build_object(
      'nested', jsonb_build_object('tooDeep', true))))$setup$,
  $sql$select platform_api.cms_restore_revision(pg_temp.s10r_request('s10-restore-object-0001'))$sql$
);
select is(
  pg_temp.s10_probe_state('restore_invalid_object') || ':'
    || pg_temp.s10_probe_message('restore_invalid_object'),
  'P0001:migration_chain_incomplete',
  'a source object value outside its DEC-133 structure refuses the restore as migration_chain_incomplete'
);

