-- Derived-state evidence builders for the BE03b E2 suites (lane S11-3d).
--
-- The physical cms_entry_revisions.state is the constant `draft`; the
-- browser-visible EntryRevisionState is derived by
-- platform_private.cms_revision_effective_state from committed evidence
-- (published > scheduled > approved > rejected > submitted > draft).  A suite that
-- needs a revision in a non-draft state therefore seeds the revision as `draft`
-- and attaches guard-valid synthetic evidence through the same guards the named
-- RPCs pass -- not a byte-for-byte reproduction of an authenticated RPC call.
-- Include AFTER phase_02_slice_10_rpc/000-helpers.sqlinc and
-- 001-fixtures.sqlinc (it needs nothing but the revision row it is pointed at).
--
--   pg_temp.e2_evidence(revision, state)    attach the evidence of `state`
--   pg_temp.e2_revision(entry, revision, number, acting_party)
--                                           append one more physical-draft revision
--
-- Ordering rule: a revision INSERT invalidates every older live review of the
-- same entry and locale (S11-3s trigger cms_entry_revisions_review_invalidation),
-- so append all revisions of an entry BEFORE attaching evidence to any of them.
--
-- Reviews go through the real data-model guards: the review opens at v1, and a
-- decision-backed transition (approved | rejected) seeds the committed decision
-- chain the guards demand -- a qualifying reviewer, an active assignment and the
-- cms_editorial_decisions row -- BEFORE the CAS advance.  Schedules and
-- publication lineage rows are inserted with the user triggers of their table
-- disabled: only the columns the helper reads matter here, and the guards are
-- proven by the Slice 11 data-model suites.

create or replace function pg_temp.e2_hex(p_seed text)
returns text
language sql
immutable
as $body$
  select pg_catalog.encode(extensions.digest(p_seed, 'sha256'), 'hex')
$body$;

create or replace function pg_temp.e2_raw_insert(p_table text, p_row jsonb)
returns void
language plpgsql
as $body$
begin
  perform pg_catalog.set_config('app.cms_rpc', 'true', true);
  execute pg_catalog.format('alter table %s disable trigger user', p_table);
  begin
    execute pg_catalog.format(
      'insert into %s select * from jsonb_populate_record(null::%s, %L::jsonb)',
      p_table, p_table, p_row::text
    );
  exception when others then
    execute pg_catalog.format('alter table %s enable trigger user', p_table);
    raise;
  end;
  execute pg_catalog.format('alter table %s enable trigger user', p_table);
end;
$body$;

-- A shadow person that qualifies to hold a review decision: a confirmed,
-- in-window membership of the review's owner organization plus the standing
-- cms.reviewer grant.  cms_editorial_review_qualifying_decisions requires the
-- decider to still hold the satisfied slot's capability
-- (cms_person_holds_capability), so an approval only derives `approved` when the
-- reviewer holds that confirmed standing membership and grant.  The reviewer is a
-- shadow person (a fixture party), not a claimed or active usable Auth account,
-- and is deliberately neither the review submitter nor the revision author
-- (separation of duties).  Returns the id.
create or replace function pg_temp.e2_reviewer(p_owner uuid)
returns uuid
language plpgsql
as $body$
declare
  reviewer uuid := extensions.gen_random_uuid();
begin
  perform pg_catalog.set_config('app.cms_rpc', 'true', true);
  insert into platform_private.party(id, kind) values (reviewer, 'person');
  insert into platform_private.person_party(party_id, account_state) values (reviewer, 'shadow');
  insert into identity_private.membership_tenure(
    id, organization_id, person_id, state, provenance, governance_mode,
    starts_on, accepted_at, actor_id, version
  ) values (
    extensions.gen_random_uuid(), p_owner, reviewer, 'confirmed', 'invitation',
    'ungoverned', current_date, pg_catalog.clock_timestamp(), reviewer, 1
  );
  insert into identity_private.organization_actor_grant(
    organization_id, person_id, capability_code, valid_from, valid_through, active
  ) values (p_owner, reviewer, 'cms.reviewer', current_date, null, true);
  return reviewer;
end;
$body$;

-- An editorial review of the revision: open v1 through the guards, then moved to
-- `open` | `approved` | `rejected` | `invalidated` under the CAS rules (count + 1
-- for a decision, unchanged for an invalidation).  Returns the review id.
--
-- A decision-backed transition (approved | rejected) seeds the WHOLE committed
-- evidence chain the S11 guards demand, in the order cms_record_review_decision
-- uses it: a distinct shadow reviewer with a confirmed membership and the
-- standing cms.reviewer grant (e2_reviewer), an active assignment whose window
-- covers the decision instant, then the cms_editorial_decisions row, and only
-- then the review CAS to the target state.  Nothing is disabled and a count-only
-- advance is impossible: cms_decision_binding_guard and cms_review_cas_guard both
-- accept the row exactly as they accept the real RPC.
create or replace function pg_temp.e2_review(p_revision uuid, p_state text)
returns uuid
language plpgsql
as $body$
declare
  revision_row platform_private.cms_entry_revisions%rowtype;
  review_id uuid := extensions.gen_random_uuid();
  reviewer uuid;
  assignment_id uuid := extensions.gen_random_uuid();
  decision_id uuid := extensions.gen_random_uuid();
  submitted timestamptz := pg_catalog.clock_timestamp();
  decided timestamptz := pg_catalog.clock_timestamp();
begin
  perform pg_catalog.set_config('app.cms_rpc', 'true', true);
  select * into revision_row from platform_private.cms_entry_revisions where id = p_revision;
  insert into platform_private.cms_editorial_reviews
  select * from jsonb_populate_record(null::platform_private.cms_editorial_reviews,
    jsonb_build_object(
      'id', review_id, 'owner_id', revision_row.owner_id,
      'revision_id', revision_row.id, 'entry_id', revision_row.entry_id,
      'state', 'open', 'version', 1, 'risk_class', 'ordinary',
      'frozen_hash', pg_catalog.btrim(revision_row.payload_hash::text),
      'dependency_manifest', '{}'::jsonb,
      'dependency_hash', pg_temp.e2_hex('e2-dependency'),
      'activation_evidence', '{}'::jsonb,
      'workflow_policy_key', 'editorial', 'workflow_policy_version', 1,
      'workflow_policy_hash', pg_temp.e2_hex('e2-policy'),
      'required_capabilities', jsonb_build_array('cms.reviewer'),
      'required_decision_count', 1, 'recorded_decision_count', 0,
      'approval_evidence_hash', pg_temp.e2_hex('e2-approval'),
      'submitted_by', revision_row.author_person_id, 'submitted_at', submitted,
      'invalidated_reason', null, 'decided_at', null,
      'created_at', submitted, 'updated_at', submitted
    ));
  if p_state in ('approved', 'rejected') then
    reviewer := pg_temp.e2_reviewer(revision_row.owner_id);
    insert into platform_private.cms_editorial_review_assignments
    select * from jsonb_populate_record(null::platform_private.cms_editorial_review_assignments,
      jsonb_build_object(
        'id', assignment_id, 'owner_id', revision_row.owner_id,
        'review_id', review_id, 'reviewer_person_id', reviewer,
        'grantor_person_id', revision_row.author_person_id,
        'capability_key', 'cms.editorial_review',
        'actions', jsonb_build_array('read', 'decide'), 'state', 'active',
        'starts_at', submitted - interval '1 hour',
        'ends_at', submitted + interval '23 hours',
        'reason', null, 'version', 1,
        'created_at', submitted, 'updated_at', submitted
      ));
    insert into platform_private.cms_editorial_decisions
    select * from jsonb_populate_record(null::platform_private.cms_editorial_decisions,
      jsonb_build_object(
        'id', decision_id, 'owner_id', revision_row.owner_id,
        'state', 'recorded', 'version', 1,
        'review_id', review_id, 'reviewer_person_id', reviewer,
        'acting_party_id', revision_row.owner_id, 'capability', 'cms.reviewer',
        'assignment_id', assignment_id, 'assignment_version', 1,
        'decision', case p_state when 'approved' then 'approve' else 'reject' end,
        'reason', case p_state when 'approved' then 'Reads well; approved.'
                              else 'Needs work; rejected.' end,
        'comment_hash', null,
        'reviewed_hash', pg_catalog.btrim(revision_row.payload_hash::text),
        'step_up_at', decided - interval '60 seconds',
        'decided_at', decided, 'created_at', decided, 'updated_at', decided
      ));
    update platform_private.cms_editorial_reviews
       set state = p_state, recorded_decision_count = 1,
           decided_at = decided, version = 2, updated_at = decided
     where id = review_id;
  elsif p_state = 'invalidated' then
    update platform_private.cms_editorial_reviews
       set state = 'invalidated', invalidated_reason = 'dependency_changed',
           version = 2, updated_at = pg_catalog.clock_timestamp()
     where id = review_id;
  elsif p_state <> 'open' then
    raise exception 'e2_review: unsupported state %', p_state;
  end if;
  return review_id;
end;
$body$;

-- Attach the evidence that derives `p_state` (draft | submitted | approved |
-- rejected | scheduled | published); `invalidated` attaches an invalidated
-- review, which derives `draft`.
create or replace function pg_temp.e2_evidence(p_revision uuid, p_state text)
returns void
language plpgsql
as $body$
declare
  revision_row platform_private.cms_entry_revisions%rowtype;
  review_id uuid;
  stamp timestamptz := pg_catalog.clock_timestamp();
begin
  select * into revision_row from platform_private.cms_entry_revisions where id = p_revision;
  if not found then
    raise exception 'e2_evidence: absent revision %', p_revision;
  end if;
  if p_state = 'draft' then
    return;
  elsif p_state = 'submitted' then
    perform pg_temp.e2_review(p_revision, 'open');
  elsif p_state in ('approved', 'rejected', 'invalidated') then
    perform pg_temp.e2_review(p_revision, p_state);
  elsif p_state = 'scheduled' then
    review_id := pg_temp.e2_review(p_revision, 'approved');
    perform pg_temp.e2_raw_insert('platform_private.cms_publication_schedules', jsonb_build_object(
      'id', extensions.gen_random_uuid(), 'owner_id', revision_row.owner_id,
      'entry_id', revision_row.entry_id, 'revision_id', revision_row.id,
      'review_id', review_id, 'dependency_hash', pg_temp.e2_hex('e2-dependency'),
      'activation_evidence_hash', pg_temp.e2_hex('e2-activation'),
      'action', 'publish', 'local_datetime', '2027-01-15T09:00:00'::timestamp,
      'timezone', 'Europe/Paris', 'resolved_at_utc', timestamptz '2027-01-15T08:00:00Z',
      'local_datetime_submicro_ns', 0, 'resolved_utc_submicro_ns', 0,
      'tzdb_version', '2026e', 'disambiguation', 'none', 'audience', 'public',
      'state', 'pending', 'job_id', null, 'expected_version', 2,
      'attempt_count', 0, 'next_attempt_at', null, 'lease_id', null,
      'lease_until', null, 'reason_code', null, 'actual_at_utc', null,
      'deviation_seconds', null, 'version', 1,
      'created_by', revision_row.author_person_id, 'created_at', stamp, 'updated_at', stamp
    ));
  elsif p_state = 'published' then
    perform pg_temp.e2_raw_insert('platform_private.cms_publication_versions', (
      select jsonb_build_object(
        'id', publication_id, 'publication_id', publication_id,
        'owner_id', revision_row.owner_id, 'state', 'active', 'version', 1,
        'supersedes_id', null, 'action', 'publish',
        'entry_id', revision_row.entry_id, 'revision_id', revision_row.id,
        'schedule_id', null, 'publisher_person_id', revision_row.author_person_id,
        'dependency_hash', pg_temp.e2_hex('e2-dependency'),
        'activation_evidence_hash', pg_temp.e2_hex('e2-activation'),
        'schema_artifact_id', version_row.schema_artifact_id,
        'schema_artifact_hash', pg_catalog.btrim(version_row.definition_hash::text),
        'version_set', jsonb_build_object('settingsVersion', 1),
        'schema_version_id', revision_row.schema_version_id,
        'template_version_id', null, 'taxonomy_version_ids', '[]'::jsonb,
        'settings_version', 1, 'locale', revision_row.locale,
        -- one lineage per revision: (entry, locale, audience, version) is unique
        'audience', 'e2-' || pg_catalog.substr(pg_catalog.md5(revision_row.id::text), 1, 12),
        'publication_hash', pg_temp.e2_hex('e2-publication-' || publication_id::text),
        'activated_at', stamp, 'revoked_at', null,
        'created_at', stamp, 'updated_at', stamp
      )
      from (select extensions.gen_random_uuid() as publication_id) minted,
           platform_private.cms_content_type_versions version_row
      where version_row.id = revision_row.schema_version_id
    ));
  else
    raise exception 'e2_evidence: unsupported state %', p_state;
  end if;
end;
$body$;

-- One more PHYSICAL-draft revision of an entry (copies the entry's first revision
-- for the schema pin, locale and author), numbered p_number, optionally recorded
-- under another acting party.  The entry's current-draft pointer is not moved.
create or replace function pg_temp.e2_revision(
  p_entry uuid, p_revision uuid, p_number bigint, p_acting_party uuid default null
)
returns void
language plpgsql
as $body$
begin
  perform pg_catalog.set_config('app.cms_rpc', 'true', true);
  insert into platform_private.cms_entry_revisions(
    id, owner_id, entry_id, revision_number, schema_version_id,
    template_version_id, taxonomy_version_ids, parent_revision_ids, locale,
    payload_hash, author_person_id, acting_party_id, state, version,
    validation_state, validation_report, created_at, updated_at
  )
  select p_revision, base.owner_id, base.entry_id, p_number, base.schema_version_id,
         null, '[]'::jsonb, '[]'::jsonb, base.locale,
         platform_private.cms_jcs_sha256('{}'::jsonb)::char(64),
         base.author_person_id, coalesce(p_acting_party, base.acting_party_id), 'draft', 1,
         'valid', '{}'::jsonb,
         base.created_at + p_number * interval '1 second',
         base.created_at + p_number * interval '1 second'
  from platform_private.cms_entry_revisions base
  where base.entry_id = p_entry
  order by base.revision_number
  limit 1;
end;
$body$;
