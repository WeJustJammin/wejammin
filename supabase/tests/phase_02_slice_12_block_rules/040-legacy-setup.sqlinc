select pg_temp.brt_stub('plan');
select * from pg_temp.s12pu_place('brd-detach', 'brl-nodes');
select * from pg_temp.s12pu_place('brd-prov-live', 'brl-nodes');
select * from pg_temp.s12pu_place('brd-prov-canon', 'brl-nodes');
