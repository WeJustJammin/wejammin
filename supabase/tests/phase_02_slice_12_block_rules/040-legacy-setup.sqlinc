select pg_temp.brt_stub('save');
select * from pg_temp.s12pl_pattern('brm-v2', 'brm', jsonb_build_array(
  pg_temp.brb('ok', 'br.leaf') || jsonb_build_object('props', jsonb_build_object('title', 'T2')),
  pg_temp.brb('bad', 'br.tight', jsonb_build_array(pg_temp.brb('l1', 'br.leaf'), pg_temp.brb('l2', 'br.leaf'), pg_temp.brb('l3', 'br.leaf')))),
  null, true, '1');
select * from pg_temp.brt_restore('save');

-- a canonical detached tree that breaks its rules (CMS-03C-15 detach with the writer rule check off), then restored
select pg_temp.brt_stub('detached');
select pg_temp.s12pu_update('BR-L02', pg_temp.s12pu_update_request('brd-prov-canon', 'detach',
  jsonb_build_array(pg_temp.s12pu_target('brd-prov-canon', '/t')), 'br-l02-idem'));
select is(pg_temp.s12pu_oc('BR-L02'), 'ok', 'BR-L02: the pre-rule canonical detached tree is written by the real CMS-03C-15 producer');
select * from pg_temp.brt_restore('detached');

