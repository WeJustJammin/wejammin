-- In-test direct-write guard.  A BEFORE trigger on every producer-owned table
-- records WHO wrote the row from the PL/pgSQL call stack of the writing
-- statement (GET DIAGNOSTICS PG_CONTEXT), not from the top-level SQL text:
--
--   * a write is a PRODUCER write only when its innermost enclosing function is
--     a platform_private / platform_api function that already existed when the
--     guard was armed (the producer catalog snapshot below), or a trigger
--     function of that catalog reached from such a producer;
--   * everything else is a DIRECT write: a hand-written insert/update/delete,
--     a DO block (frame `inline_code_block`), a pg_temp helper (even one named
--     like a producer), a public-schema function, and a platform_private
--     function created after arming.
--
-- A DO block or helper that calls a real producer and then writes by hand is
-- still caught for the hand write: the innermost frame of that write is the
-- DO block or the helper.  Assertions count the direct kind (must be zero) and
-- the producer kind (positive precondition, so zero is never vacuous).
create temp table if not exists s09x_writes(
  table_name text, op text, top_level text, frame text, via_producer boolean not null default false,
  at timestamptz default clock_timestamp()
) on commit drop;
create temp table if not exists s09x_producers(fn text primary key) on commit drop;

-- SECURITY DEFINER: the producers run as the NOLOGIN definer role (SEC-2), which
-- holds no privilege on this session's temp tables; the recorder itself must
-- still be able to log the write it observes.
create or replace function pg_temp.s09x_record() returns trigger language plpgsql security definer as $body$
declare
  ctx text;
  frames text[];
  innermost text;
begin
  get diagnostics ctx = pg_context;
  select array_agg(m[1] order by ord) into frames
    from regexp_matches(ctx, 'PL/pgSQL function ([^( ]+)', 'g') with ordinality as t(m, ord);
  -- frames[1] is this trigger function; frames[2] is the writer.
  innermost := frames[2];
  insert into s09x_writes(table_name, op, top_level, frame, via_producer)
  values (tg_table_name, tg_op, left(regexp_replace(current_query(), '\s+', ' ', 'g'), 80), innermost,
          innermost is not null and exists (select 1 from s09x_producers where fn = innermost));
  return coalesce(new, old);
end;
$body$;

create or replace function pg_temp.s09x_arm() returns void language plpgsql as $body$
declare t text;
begin
  insert into s09x_producers(fn)
  select n.nspname || '.' || p.proname
    from pg_proc p join pg_namespace n on n.oid = p.pronamespace
   where n.nspname in ('platform_private', 'platform_api')
  on conflict do nothing;
  foreach t in array array['cms_schema_reviews', 'cms_schema_review_decisions',
    'cms_schema_review_assignments', 'cms_schema_dry_run_reports',
    'cms_schema_dry_run_row_evidence', 'cms_schema_migration_plans',
    'cms_schema_migration_target_rows'] loop
    execute format('create trigger s09x_record_%1$s before insert or update or delete on platform_private.%1$s
      for each row execute function pg_temp.s09x_record()', t);
  end loop;
end;
$body$;

-- Writes made by anything other than a catalogued producer function.
create or replace function pg_temp.s09x_direct(p_table text default null) returns bigint language sql stable as $body$
  select count(*) from s09x_writes
  where (p_table is null or table_name = p_table) and not via_producer $body$;
create or replace function pg_temp.s09x_via_rpc(p_table text) returns bigint language sql stable as $body$
  select count(*) from s09x_writes
  where table_name = p_table and via_producer $body$;
