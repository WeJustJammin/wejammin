{
  "name": "@wejammin/web",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --config wrangler.jsonc",
    "types:check": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --config wrangler.jsonc --check",
    "type-check": "pnpm types:check && astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "@astrojs/react": "6.0.4",
    "@wejammin/contracts": "workspace:*",
    "@wejammin/ui": "workspace:*",
    "astro": "7.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wrangler": "4.127.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3"
  }
}
