---
import { env } from 'cloudflare:workers';

import CmsEditorialDocument from '../../../../components/cms-editorial/CmsEditorialDocument.astro';
import CmsEditorialPageNotice from '../../../../components/cms-editorial-pages/CmsEditorialPageNotice';
import CmsGovernedReviewDetailIsland from '../../../../components/cms-governed-review/CmsGovernedReviewDetailIsland';
import { createCmsGovernedPageReads } from '../../../../components/cms-governed-review/governed-review-page-reads';
import { loadGovernedDetailPage } from '../../../../components/cms-governed-review/load-governed-detail-page';
import { cmsRedirectResponse } from '../../../../components/cms-editorial-pages/cms-editorial-page-outcome';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

/*
 * Protected definition-review detail for CMS-03C-10 with the decision
 * (CMS-03C-07) and the owner's assignment (CMS-03C-08) commands. All behavior
 * lives in the tested loader and island: the loader verifies the strict detail
 * for THIS review and returns one view, one closed state (a hidden, absent or
 * cross-owner review is one identical 404), or a sign-in redirect; the island
 * renders the evidence and exactly the forms `permittedNextActions` allows. No
 * reviewer, submitter or person identifier is serialized into the document
 * outside the island's data. Activation (CMS-03C-09) has no control here yet.
 */
const outcome = await loadGovernedDetailPage({
  request: Astro.request,
  reviewId: Astro.params.reviewId ?? '',
  reads: createCmsGovernedPageReads(env.PLATFORM_API),
});
if (outcome.kind === 'redirect') return cmsRedirectResponse(outcome.location);
Astro.response.status =
  outcome.kind === 'view' ? outcome.status : outcome.notice.status;
const title = outcome.kind === 'view' ? outcome.title : outcome.notice.title;
const heading =
  outcome.kind === 'view' ? outcome.heading : outcome.notice.heading;
---

<CmsEditorialDocument
  title={title}
  heading={heading}
  description="Read the frozen version and record your decision."
  systemStatusLink
>
  {
    outcome.kind === 'view' ? (
      <CmsGovernedReviewDetailIsland
        init={{
          review: outcome.view.review,
          reviewId: outcome.view.reviewId,
          verifiedAt: outcome.view.verifiedAt,
        }}
        client:load
      />
    ) : (
      <CmsEditorialPageNotice notice={outcome.notice} />
    )
  }
</CmsEditorialDocument>
