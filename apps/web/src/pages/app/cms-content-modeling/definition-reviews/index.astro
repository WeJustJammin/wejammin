---
import { env } from 'cloudflare:workers';

import CmsEditorialDocument from '../../../../components/cms-editorial/CmsEditorialDocument.astro';
import CmsEditorialPageNotice from '../../../../components/cms-editorial-pages/CmsEditorialPageNotice';
import CmsGovernedReviewQueue from '../../../../components/cms-governed-review/CmsGovernedReviewQueue';
import { createCmsGovernedPageReads } from '../../../../components/cms-governed-review/governed-review-page-reads';
import {
  GOVERNED_QUEUE_DESCRIPTION,
  loadGovernedQueuePage,
} from '../../../../components/cms-governed-review/load-governed-queue-page';
import { cmsRedirectResponse } from '../../../../components/cms-editorial-pages/cms-editorial-page-outcome';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

/*
 * Protected definition-review queue for CMS-03C-11. All behavior lives in the
 * tested loader and view: the URL owns the scope, state and kind filters, limit
 * and signed cursor, the loader verifies the strict page and returns one view,
 * one closed state, or a sign-in redirect, and the view renders native links with
 * the review state, risk class, decision counts and the caller's own decision as
 * text. No mutation exists on this surface and no row is cached offline.
 */
const outcome = await loadGovernedQueuePage({
  request: Astro.request,
  reads: createCmsGovernedPageReads(env.PLATFORM_API),
});
if (outcome.kind === 'redirect') return cmsRedirectResponse(outcome.location);
Astro.response.status =
  outcome.kind === 'view' ? outcome.status : outcome.notice.status;
const title = outcome.kind === 'view' ? outcome.title : outcome.notice.title;
const heading =
  outcome.kind === 'view' ? outcome.heading : outcome.notice.heading;
---

<CmsEditorialDocument
  title={title}
  heading={heading}
  description={GOVERNED_QUEUE_DESCRIPTION}
  systemStatusLink
>
  {
    outcome.kind === 'view' ? (
      <CmsGovernedReviewQueue
        page={outcome.view.page}
        routePath={outcome.view.routePath}
        query={outcome.view.query}
        announcement={outcome.view.announcement}
      />
    ) : (
      <CmsEditorialPageNotice notice={outcome.notice} />
    )
  }
</CmsEditorialDocument>
