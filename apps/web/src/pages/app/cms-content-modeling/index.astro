---
import { env } from 'cloudflare:workers';
import {
  ContentTypeVersionResourceSchema,
  createRequestId,
} from '@wejammin/contracts';

import ContentSchemaRegistryWorkbenchIsland from '../../../components/content-schema-registry/ContentSchemaRegistryWorkbenchIsland';
import '../../../components/content-schema-registry/content-schema-registry.css';
import {
  readContentSchemaRegistryPorts,
  resolveContentSchemaRegistryPage,
} from '../../../server/content-schema-registry-context';
import { applyContentSchemaRegistryRecoveryHeaders } from '../../../server/content-schema-registry-context-presentation';
import {
  contentSchemaRegistryMutationOperationFromRequest,
  forwardContentSchemaRegistryMutation,
} from '../../../server/content-schema-registry-platform-api';
import { safeContentSchemaRegistryReturnPath } from '../../../server/content-schema-registry-contracts';
import { probeCmsCapabilityGrantOwner } from '../../../server/cms-capability-grant-platform-api';
import {
  jsonContinuation,
  wantsJsonResponse,
} from '../../../server/content-schema-registry-mutation-outcome';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

const requestId = createRequestId(
  Astro.request.headers.get('x-request-id') ?? undefined,
);
const contentSchemaRegistryDetailPath = (resource: unknown): string => {
  const parsedResource = ContentTypeVersionResourceSchema.parse(resource);
  return `/app/cms-content-modeling/${encodeURIComponent(parsedResource.contentTypeId)}/versions/${encodeURIComponent(parsedResource.id)}`;
};
if (Astro.request.method === 'POST') {
  const operationId = await contentSchemaRegistryMutationOperationFromRequest(
    Astro.request,
  );
  if (operationId !== 'CMS-03A-01') {
    return new Response('Bad request', {
      status: 400,
      headers: { 'cache-control': 'no-store' },
    });
  }
  const mutation = await forwardContentSchemaRegistryMutation(
    Astro.request,
    env.PLATFORM_API,
    { operationId },
  );
  if (!mutation.ok) return mutation;
  try {
    const location = contentSchemaRegistryDetailPath(
      await mutation.clone().json(),
    );
    return wantsJsonResponse(Astro.request)
      ? jsonContinuation(mutation, location)
      : Astro.redirect(location, 303);
  } catch {
    return new Response('Bad gateway', {
      status: 502,
      headers: { 'cache-control': 'no-store' },
    });
  }
}
const result = await resolveContentSchemaRegistryPage({
  request: Astro.request,
  route: 'list',
  ports: readContentSchemaRegistryPorts(Astro.locals, env.PLATFORM_API),
  requestId,
});
if (result.kind === 'unauthenticated') {
  return Astro.redirect(
    `/auth/sign-in?returnTo=${encodeURIComponent(safeContentSchemaRegistryReturnPath(Astro.url))}`,
    303,
  );
}
if (result.kind === 'invalid_query') {
  return new Response('Bad request', {
    status: 400,
    headers: { 'cache-control': 'no-store' },
  });
}
if (result.kind === 'invalid_record' || result.kind === 'not_found') {
  return new Response('Not found', {
    status: 404,
    headers: { 'cache-control': 'no-store' },
  });
}
if (result.kind === 'forbidden') {
  return new Response('Forbidden', {
    status: 403,
    headers: { 'cache-control': 'no-store' },
  });
}
if (result.kind === 'degraded' || result.kind === 'error') {
  Astro.response.status = result.status;
}
const page = result.page;
applyContentSchemaRegistryRecoveryHeaders(Astro.response.headers, page);
// Navigation only: the grant console entry is shown solely to the owner, whose
// proof is a successful one-row CMS-03A-18 read. A failed probe hides the link.
const ownerNav =
  page.variant === 'ownerFull' &&
  (await probeCmsCapabilityGrantOwner(Astro.request, env.PLATFORM_API));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Review disclosure-safe content schema registry records."
    />
    <meta name="robots" content="noindex" />
    <title>Content schema registry | WeJammin</title>
  </head>
  <body class="content-schema-registry-page">
    <nav aria-label="Skip navigation">
      <a
        class="content-schema-registry-skip-link"
        href="#content-schema-registry-main"
      >
        Skip to main content
      </a>
    </nav>
    <header
      class="content-schema-registry-shell-header"
      aria-label="Application navigation"
    >
      <a href="/">WeJammin</a>
      <nav aria-label="Primary navigation">
        <a href="/app/cms-content-modeling" aria-current="page"
          >Content schema registry</a
        >
        {
          ownerNav ? (
            <a href="/app/cms-content-modeling/capability-grants">CMS access</a>
          ) : null
        }
        <a href="/system/degraded">System status</a>
      </nav>
    </header>
    <main id="content-schema-registry-main" tabindex="-1">
      <header class="content-schema-registry-page-heading">
        <p class="content-schema-registry-eyebrow">Authenticated workspace</p>
        <h1 id="page-title" tabindex="-1">Content schema registry</h1>
        <p>
          Inspect server-authorized schema metadata and safe block references.
        </p>
      </header>
      <ContentSchemaRegistryWorkbenchIsland
        {...page}
        canonicalRefetchUrl={page.retryUrl}
        client:load
      />
    </main>
    <script src="../../../lib/route-heading-focus.ts"></script>
  </body>
</html>
