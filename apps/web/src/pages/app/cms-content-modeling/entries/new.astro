---
import { env } from 'cloudflare:workers';

import CmsEditorialDocument from '../../../../components/cms-editorial/CmsEditorialDocument.astro';
import CmsEditorialEntryCreateForm from '../../../../components/cms-editorial/CmsEditorialEntryCreateForm.astro';
import CmsEditorialPageNotice from '../../../../components/cms-editorial-pages/CmsEditorialPageNotice';
import { createCmsEditorialPageReads } from '../../../../components/cms-editorial-pages/cms-editorial-page-reads';
import { loadEntryCreatePage } from '../../../../components/cms-editorial-pages/load-entry-create-page';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

/*
 * Protected create surface for CMS-03B-10. All behavior lives in the tested
 * loader: it reads the CMS-03B-14 AuthoringContext through the first-party
 * proxy and returns a verified view, one closed state, or a sign-in redirect.
 * The island echoes the frozen evidence back unmodified; the user never types
 * schema, policy or evidence.
 */
const outcome = await loadEntryCreatePage({
  request: Astro.request,
  reads: createCmsEditorialPageReads(env.PLATFORM_API),
});
if (outcome.kind === 'redirect') return Astro.redirect(outcome.location, 303);
Astro.response.status =
  outcome.kind === 'view' ? outcome.status : outcome.notice.status;
const title = outcome.kind === 'view' ? outcome.title : outcome.notice.title;
const heading =
  outcome.kind === 'view' ? outcome.heading : outcome.notice.heading;
---

<CmsEditorialDocument
  title={title}
  heading={heading}
  description="Create an entry."
  systemStatusLink
>
  {
    outcome.kind === 'view' ? (
      <section aria-labelledby="entry-create-title">
        <h2 id="entry-create-title" tabindex="-1">
          New entry
        </h2>
        <p>
          Choose an active content type, then author its fields. The server
          revalidates every value and derives authority on submit.
        </p>
        <CmsEditorialEntryCreateForm
          types={outcome.view.types}
          selected={outcome.view.selected}
          fields={outcome.view.fields}
        />
      </section>
    ) : (
      <CmsEditorialPageNotice notice={outcome.notice} />
    )
  }
</CmsEditorialDocument>
