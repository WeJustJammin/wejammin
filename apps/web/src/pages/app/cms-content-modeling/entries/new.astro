---
import CmsEditorialDocument from '../../../../components/cms-editorial/CmsEditorialDocument.astro';
import {
  CMS_EDITORIAL_ENTRY_CREATE_BOUNDARY,
  CMS_EDITORIAL_ENTRY_CREATE_DISABLED_REASON,
} from '../../../../components/cms-editorial/cms-editorial-entry-create';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.status = 503;

/*
 * Fail-closed create surface for CMS-03B-10.
 *
 * FE03 authorises the protected create, packages/contracts/src/cms-editorial
 * registers it, and apps/web/src/server/cms-editorial-platform-mutation.ts now
 * provides a real first-party proxy, and the Worker serves the protected
 * create route. The locked request still requires workflowPolicy evidence
 * that no protected served response exposes, while the private policy source
 * is unconfigured. A browser cannot populate it without fabrication.
 *
 * Rendering a form now would let an author fill in a draft that cannot be
 * committed, so every method answers one honest 503 instead. The precise reason
 * comes from CMS_EDITORIAL_ENTRY_CREATE_BOUNDARY below.
 */

/*
 * Both the safe copy and the reason come from the owning module, so the message
 * stays traceable to the boundary rather than drifting into the page, and so a
 * future edit to the blocker propagates without a second copy. Nothing here
 * names an entry, so the page cannot disclose whether one already exists. Astro
 * escapes both strings when it renders them.
 */
const reason = CMS_EDITORIAL_ENTRY_CREATE_BOUNDARY.blocker;
const copy = CMS_EDITORIAL_ENTRY_CREATE_DISABLED_REASON;
---

<CmsEditorialDocument
  title="Create entry"
  heading="Entry creation is unavailable"
  description="Entry creation is unavailable."
  systemStatusLink
>
  <p>{copy}</p>
  <p>{reason}</p>
</CmsEditorialDocument>
