---
import { env } from 'cloudflare:workers';

import CmsEditorialDocument from '../../../../components/cms-editorial/CmsEditorialDocument.astro';
import { cmsEditorialAppWorkflowPath } from '../../../../components/cms-editorial/cms-editorial-app-routes';
import CmsEditorialEntryEditorIsland from '../../../../components/cms-editorial/CmsEditorialEntryEditorIsland';
import CmsEditorialEntryEditUnavailable from '../../../../components/cms-editorial-pages/CmsEditorialEntryEditUnavailable';
import CmsEditorialPageNotice from '../../../../components/cms-editorial-pages/CmsEditorialPageNotice';
import { createCmsEditorialPageReads } from '../../../../components/cms-editorial-pages/cms-editorial-page-reads';
import { loadEntryEditPage } from '../../../../components/cms-editorial-pages/load-entry-edit-page';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

/*
 * Protected draft-editing surface for CMS-03B-11 / CMS-03B-14 / CMS-03B-01. All
 * behavior lives in the tested loader and island: the loader verifies the draft
 * and the field definitions of its schema version and returns one view, one
 * closed state, or a sign-in redirect; the island edits with autosave. No
 * entry id or value is echoed into the document outside the island's data.
 */
const outcome = await loadEntryEditPage({
  request: Astro.request,
  entryId: Astro.params.entryId ?? '',
  reads: createCmsEditorialPageReads(env.PLATFORM_API),
});
if (outcome.kind === 'redirect') return Astro.redirect(outcome.location, 303);
Astro.response.status =
  outcome.kind === 'view' ? outcome.status : outcome.notice.status;
const title = outcome.kind === 'view' ? outcome.title : outcome.notice.title;
const heading =
  outcome.kind === 'view' ? outcome.heading : outcome.notice.heading;
const workflowPath = cmsEditorialAppWorkflowPath(Astro.params.entryId ?? '');
---

<CmsEditorialDocument
  title={title}
  heading={heading}
  description="Edit an entry draft."
  systemStatusLink
>
  {
    outcome.kind === 'notice' ? (
      <CmsEditorialPageNotice notice={outcome.notice} />
    ) : outcome.view.kind === 'editor' ? (
      <>
        {workflowPath !== null && (
          <p>
            <a href={workflowPath}>Review and publish</a>
          </p>
        )}
        <CmsEditorialEntryEditorIsland init={outcome.view.init} client:load />
      </>
    ) : (
      <CmsEditorialEntryEditUnavailable view={outcome.view} />
    )
  }
</CmsEditorialDocument>
