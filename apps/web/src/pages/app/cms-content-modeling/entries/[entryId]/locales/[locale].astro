---
import { env } from 'cloudflare:workers';

import CmsEditorialDocument from '../../../../../../components/cms-editorial/CmsEditorialDocument.astro';
import { cmsEditorialAppEntryPath } from '../../../../../../components/cms-editorial/cms-editorial-app-routes';
import CmsEditorialPageNotice from '../../../../../../components/cms-editorial-pages/CmsEditorialPageNotice';
import CmsLocaleVariantForm from '../../../../../../components/cms-locale/CmsLocaleVariantForm';
import '../../../../../../components/cms-locale/cms-locale.css';
import { loadLocaleVariantPage } from '../../../../../../components/cms-locale/load-locale-variant-page';
import { createLocalePageReads } from '../../../../../../components/cms-locale/locale-variant-page-reads';
import { cmsRedirectResponse } from '../../../../../../components/cms-editorial-pages/cms-editorial-page-outcome';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
if (Astro.request.method !== 'GET') {
  return new Response('Method not allowed', {
    status: 405,
    headers: { allow: 'GET', 'cache-control': 'no-store' },
  });
}

/*
 * Protected locale variant page for CMS-03C-04 (FE03 :1073, :1641). All behavior lives in the tested loader
 * and island: the loader verifies the entry (CMS-03B-11), the author-safe field definitions (CMS-03B-14) and
 * the protected locale variant read (`cmsLocaleVariantRead`, DEC-205: the current variant, the resolutions, the
 * active order and the edit authority) and returns one view, one closed state or a sign-in redirect.
 * `:entryId` and `:locale` are the only URL state: any query on this address is a 400.
 */
const entryId = Astro.params.entryId ?? '';
const outcome = await loadLocaleVariantPage({
  request: Astro.request,
  entryId,
  locale: Astro.params.locale ?? '',
  reads: createLocalePageReads(env.PLATFORM_API),
});
if (outcome.kind === 'redirect') return cmsRedirectResponse(outcome.location);
Astro.response.status =
  outcome.kind === 'view' ? outcome.status : outcome.notice.status;
const title = outcome.kind === 'view' ? outcome.title : outcome.notice.title;
const heading =
  outcome.kind === 'view' ? outcome.heading : outcome.notice.heading;
const entryPath = cmsEditorialAppEntryPath(entryId);
---

<CmsEditorialDocument
  title={title}
  heading={heading}
  description="Translate the localizable fields and see how each one resolves."
  systemStatusLink
>
  {
    outcome.kind === 'view' ? (
      <>
        {entryPath !== null && (
          <p>
            <a href={entryPath}>Back to the draft</a>
          </p>
        )}
        <CmsLocaleVariantForm
          entry={outcome.view.entry}
          fallbackChain={outcome.view.fallbackChain}
          fields={outcome.view.fields}
          unavailableFields={outcome.view.unavailableFields}
          resolutions={outcome.view.resolutions}
          variant={outcome.view.variant}
          returnTo={outcome.view.path}
          csrfToken={outcome.view.csrfToken}
          client:load
        />
      </>
    ) : (
      <CmsEditorialPageNotice notice={outcome.notice} />
    )
  }
</CmsEditorialDocument>
