---
import { env } from 'cloudflare:workers';

import CmsEditorialDocument from '../../../../../components/cms-editorial/CmsEditorialDocument.astro';
import CmsEditorialRevisionCompare from '../../../../../components/cms-editorial/CmsEditorialRevisionCompare';
import CmsEditorialRevisionHistory from '../../../../../components/cms-editorial/CmsEditorialRevisionHistory';
import { cmsEditorialAppEntryPath } from '../../../../../components/cms-editorial/cms-editorial-app-routes';
import CmsEditorialPageNotice from '../../../../../components/cms-editorial-pages/CmsEditorialPageNotice';
import { createCmsEditorialPageReads } from '../../../../../components/cms-editorial-pages/cms-editorial-page-reads';
import { loadRevisionHistoryPage } from '../../../../../components/cms-editorial-pages/load-revision-history-page';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

/*
 * Protected revision history and comparison for CMS-03B-03 / CMS-03B-04. All
 * behavior lives in the tested loader and views: the loader verifies the page,
 * turns a typed comparison refusal into a state beside the list and reads the
 * entry version a restore needs; the views render safe summaries, the
 * domain-grouped comparison and the inline restore review. No draft value is
 * read or rendered here.
 */
const entryId = Astro.params.entryId ?? '';
const outcome = await loadRevisionHistoryPage({
  request: Astro.request,
  entryId,
  reads: createCmsEditorialPageReads(env.PLATFORM_API),
});
if (outcome.kind === 'redirect') return Astro.redirect(outcome.location, 303);
Astro.response.status =
  outcome.kind === 'view' ? outcome.status : outcome.notice.status;
const title = outcome.kind === 'view' ? outcome.title : outcome.notice.title;
const heading =
  outcome.kind === 'view' ? outcome.heading : outcome.notice.heading;
const draftPath = cmsEditorialAppEntryPath(entryId);
---

<CmsEditorialDocument title={title} heading={heading}>
  {
    outcome.kind === 'view' ? (
      <>
        <p>Authorized revision summaries and changes, without draft values.</p>
        {draftPath !== null && (
          <p>
            <a href={draftPath}>Back to the draft</a>
          </p>
        )}
        <CmsEditorialRevisionHistory
          page={outcome.view.page}
          entryId={outcome.view.entryId}
          routePath={outcome.view.routePath}
          query={outcome.view.query}
        />
        <CmsEditorialRevisionCompare
          compare={outcome.view.page.compare}
          refusal={outcome.view.refusal}
          entryId={outcome.view.entryId}
          expectedVersion={outcome.view.expectedVersion}
        />
      </>
    ) : (
      <CmsEditorialPageNotice notice={outcome.notice} />
    )
  }
</CmsEditorialDocument>
