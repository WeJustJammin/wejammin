---
import { env } from 'cloudflare:workers';

import CmsTemplateDesigner from '../../../../components/cms-composition/CmsTemplateDesigner';
import { templateCreatePageOutcome } from '../../../../components/cms-composition/cms-template-page-outcome';
import '../../../../components/cms-composition/cms-template-designer.css';
import '../../../../styles/cms-danger-action.css';
import { readCmsTemplateContext } from '../../../../server/cms-composition-platform-context';
import { cmsEditorialCsrfCookie } from '../../../../server/cms-editorial-platform-shared';
import { cmsRedirectResponse } from '../../../../components/cms-editorial-pages/cms-editorial-page-outcome';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
if (Astro.request.method !== 'GET') {
  return new Response('Method not allowed', {
    status: 405,
    headers: { allow: 'GET', 'cache-control': 'no-store' },
  });
}

// P2-S12-AC-164: no form unless the context was read and verified; the decision is tested in cms-template-page-outcome.
const outcome = await templateCreatePageOutcome(
  await readCmsTemplateContext(Astro.request, env.PLATFORM_API),
);
if (outcome.kind === 'redirect') return cmsRedirectResponse(outcome.location);
const context = outcome.kind === 'ready' ? outcome.context : null;
if (outcome.kind === 'unavailable') {
  Astro.response.status = outcome.status;
  if (outcome.retryAfter !== null)
    Astro.response.headers.set('Retry-After', outcome.retryAfter);
}
const unavailableCopy = outcome.kind === 'unavailable' ? outcome.copy : '';
const csrfToken = cmsEditorialCsrfCookie(Astro.request) ?? '';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="Define an authorized private CMS template draft."
    />
    <title>Define template | WeJammin</title>
  </head>
  <body class="cms-template-page">
    <nav aria-label="Skip navigation">
      <a class="cms-template-skip" href="#cms-template-main"
        >Skip to main content</a
      >
    </nav>
    <header class="cms-template-header" aria-label="Application navigation">
      <a href="/">WeJammin</a>
      <nav aria-label="Primary navigation">
        <a href="/app/cms-content-modeling">Content modeling</a>
        <a href="/system/degraded">System status</a>
      </nav>
    </header>
    <main id="cms-template-main" tabindex="-1">
      <header class="cms-template-page-heading">
        <p>Authenticated workspace · CMS composition</p>
        <h1 id="page-title" tabindex="-1">Template designer</h1>
        <p>
          Define a private, versioned template using authorized registry
          choices.
        </p>
      </header>
      {
        context === null ? (
          <section
            aria-labelledby="cms-template-unavailable-title"
            role="status"
          >
            <h2 id="cms-template-unavailable-title">Designer unavailable</h2>
            <p>{unavailableCopy}</p>
            <a href="/app/cms-content-modeling/templates/new">
              Reload template choices
            </a>
          </section>
        ) : null
      }
      {
        context !== null ? (
          <CmsTemplateDesigner
            context={context}
            csrfToken={csrfToken}
            client:load
          />
        ) : null
      }
    </main>
    <script src="../../../../lib/route-heading-focus.ts"></script>
    <script src="../../../../lib/auth-scope-sync.ts"></script>
  </body>
</html>
