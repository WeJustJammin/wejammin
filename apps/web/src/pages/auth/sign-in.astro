---
import { normalizeSafeReturnPath } from '@wejammin/ui/infrastructure/navigation';
import {
  AuthReturnTargetSchema,
  ProviderCatalogSchema,
  type ProviderCatalog,
} from '@wejammin/contracts';
import { env } from 'cloudflare:workers';
import '@wejammin/ui/styles.css';
import '../../styles/infrastructure.css';
import { forwardAuthRequest } from '../../server/auth-platform-api.ts';
import SignInEmailForm from '../../components/authentication/sign-in/SignInEmailForm.tsx';
import {
  SIGN_IN_ENTRY_HEADING,
  signInEntryFrom,
} from '../../components/authentication/sign-in/sign-in-entry.ts';

export const prerender = false;

const normalized = normalizeSafeReturnPath(
  Astro.url.searchParams.get('returnTo'),
);
const returnTo = AuthReturnTargetSchema.safeParse(normalized).success
  ? normalized
  : '/app';
const entry = signInEntryFrom(Astro.url.searchParams.get('intent'));
const outcome = Astro.url.searchParams.get('outcome');
const outcomeMessage =
  {
    email_sent:
      'If the address can receive recovery mail, a secure sign-in link is on its way.',
    invalid: 'Check the form and try again.',
    unavailable:
      'Authentication is temporarily unavailable. Your return target is preserved.',
  }[outcome ?? ''] ?? null;

let catalog: ProviderCatalog | null = null;
try {
  const response = await forwardAuthRequest(
    new Request(new URL('/api/v1/auth/providers', Astro.url), {
      headers: { cookie: Astro.request.headers.get('cookie') ?? '' },
    }),
    env.PLATFORM_API,
    '/api/v1/auth/providers',
    'GET',
  );
  if (response.ok) {
    const parsed = ProviderCatalogSchema.safeParse(await response.json());
    if (parsed.success) catalog = parsed.data;
  }
} catch {
  catalog = null;
}

const providers =
  catalog?.providers ??
  ([
    { code: 'google', label: 'Google', state: 'temporarily_unavailable' },
    { code: 'apple', label: 'Apple', state: 'temporarily_unavailable' },
    { code: 'facebook', label: 'Facebook', state: 'temporarily_unavailable' },
    {
      code: 'soundcloud',
      label: 'SoundCloud',
      state: 'temporarily_unavailable',
    },
  ] as const);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Sign in to continue to the requested WeJammin workspace."
    />
    <title>Sign in | WeJammin</title>
  </head>
  <body class="infra-page">
    <nav aria-label="Skip navigation">
      <a class="infra-skip-link" href="#main-content">Skip to main content</a>
    </nav>
    <main id="main-content" class="infra-main" tabindex="-1">
      <div class="infra-shell-header">
        <p class="infra-eyebrow">WeJammin account</p>
        <h1 id="page-title" tabindex="-1">Sign in</h1>
        <p>
          Sign in to continue. The requested return target is normalized on the
          server before any redirect.
        </p>
      </div>
      <section class="infra-workbench-header" aria-labelledby="sign-in-heading">
        <h2 id="sign-in-heading">{SIGN_IN_ENTRY_HEADING[entry]}</h2>
        {
          outcomeMessage !== null && (
            <p role="status" aria-live="polite">
              {outcomeMessage}
            </p>
          )
        }
        <SignInEmailForm returnTo={returnTo} entry={entry} />
        {
          entry === 'sign_in' && (
            <div class="infra-stack" aria-labelledby="social-sign-in-heading">
              <h3 id="social-sign-in-heading">Social sign-in</h3>
              {providers.map((provider) => (
                <form method="post" action="/auth/start">
                  <input type="hidden" name="returnTo" value={returnTo} />
                  <input type="hidden" name="intent" value="sign_in" />
                  <button
                    type="submit"
                    name="provider"
                    value={provider.code}
                    disabled={provider.state !== 'enabled'}
                    aria-describedby={
                      provider.state !== 'enabled'
                        ? `${provider.code}-status`
                        : undefined
                    }
                  >
                    Continue with {provider.label}
                  </button>
                  {provider.state !== 'enabled' && (
                    <span id={`${provider.code}-status`} class="infra-help">
                      Temporarily unavailable
                    </span>
                  )}
                </form>
              ))}
            </div>
          )
        }
        <p class="infra-help">
          Return target: <code>{returnTo}</code>. If authentication expires,
          your unsent local input remains in the current form and is never
          placed in the URL.
        </p>
      </section>
      <p><a href="/">Return to the public shell</a></p>
    </main>
    <script src="../../lib/route-heading-focus.ts"></script>
    <script
      src="../../components/identity-authority/step-up-mfa/clear-step-up-state-on-sign-in.ts"
    ></script>
    <script src="../../lib/auth-scope-sync.ts"></script>
  </body>
</html>
